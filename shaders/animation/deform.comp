#version 460
// Requests come from the VG cut/cache scheduler. Source geometry stays shared;
// only selected source vertices are morphed/skinned into a reusable output cache.
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Info {
    uint request_count, vertex_count, palette_count, morph_count;
    uint delta_count, output_count, weight_count, previous_palette_count;
} info;
struct SourceVertex {
    vec4 position, normal, tangent, uv;
    uvec4 joints_a, joints_b;
    vec4 weights_a, weights_b;
};
struct Affine { vec4 x,y,z; };
struct MorphDelta { vec4 position,normal,tangent; uvec4 target; };
struct Request { uvec4 current; uvec4 previous; };
struct DeformedVertex { vec4 position,normal,tangent,previous_position,previous_normal; };
layout(set=0,binding=1,std430) readonly buffer Vertices { SourceVertex values[]; } source;
layout(set=0,binding=2,std430) readonly buffer Palette { Affine values[]; } palette;
layout(set=0,binding=3,std430) readonly buffer PreviousPalette { Affine values[]; } previous_palette;
layout(set=0,binding=4,std430) readonly buffer MorphSpans { uvec2 values[]; } spans;
layout(set=0,binding=5,std430) readonly buffer MorphDeltas { MorphDelta values[]; } deltas;
layout(set=0,binding=6,std430) readonly buffer MorphWeights { vec2 values[]; } weights;
layout(set=0,binding=7,std430) readonly buffer Requests { Request values[]; } requests;
layout(set=0,binding=8,std430) writeonly buffer Output { DeformedVertex values[]; } output_cache;
layout(set=0,binding=9,std430) buffer Status { uint invalid; } status;
#ifdef GRAPHENE_SKIN_ALL
layout(set=0,binding=10,std430) readonly buffer AllVertices {
    uvec4 geometry; // source vertices, bones/instance, morphs/instance, epoch
    uint history[];
} all_vertices;
layout(set=0,binding=11,std430) buffer Tags {uint values[];} tags;
#endif
mat4 matrix(Affine a) {
    return mat4(vec4(a.x.x,a.y.x,a.z.x,0),vec4(a.x.y,a.y.y,a.z.y,0),
                vec4(a.x.z,a.y.z,a.z.z,0),vec4(a.x.w,a.y.w,a.z.w,1));
}
vec3 unit_vector(vec3 v) {float n=dot(v,v);return n>1e-20 ? v*inversesqrt(n) : vec3(0);}
void main() {
    uint index=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64u;
    if(index>=info.request_count)return;
#ifdef GRAPHENE_SKIN_ALL
    uint instance=index/all_vertices.geometry.x;
    Request request=Request(uvec4(index%all_vertices.geometry.x,instance*all_vertices.geometry.y,instance*all_vertices.geometry.z,index),uvec4(instance*all_vertices.geometry.y,all_vertices.history[instance],0,0));
#else
    Request request=requests.values[index];
#endif
    uint vertex=request.current.x, base=request.current.y, weight_base=request.current.z, out_index=request.current.w;
    if(vertex>=info.vertex_count || out_index>=info.output_count || base>=info.palette_count) {atomicAdd(status.invalid,1);return;}
    SourceVertex v=source.values[vertex];
    bool history=request.previous.y!=0;
    vec3 position=v.position.xyz,normal=v.normal.xyz,tangent=v.tangent.xyz,old_position=position,old_normal=normal;
    uvec2 span=spans.values[vertex];
    if(span.x>info.delta_count || span.y>info.delta_count-span.x){atomicAdd(status.invalid,1);return;}
    for(uint i=0;i<span.y;i++) {
        MorphDelta delta=deltas.values[span.x+i];uint target=delta.target.x;
        if(target>=info.morph_count || weight_base>=info.weight_count || target>=info.weight_count-weight_base){atomicAdd(status.invalid,1);return;}
        vec2 weight=weights.values[weight_base+target];
        position+=delta.position.xyz*weight.x;normal+=delta.normal.xyz*weight.x;tangent+=delta.tangent.xyz*weight.x;
        old_position+=delta.position.xyz*weight.y;old_normal+=delta.normal.xyz*weight.y;
    }
    mat4 current=mat4(0),previous=mat4(0);
    for(uint i=0;i<8;i++) {
        float w=i<4?v.weights_a[i]:v.weights_b[i-4];
        if(w==0)continue;
        uint joint=i<4?v.joints_a[i]:v.joints_b[i-4];
        if(joint>=info.palette_count-base){atomicAdd(status.invalid,1);return;}
        current+=matrix(palette.values[base+joint])*w;
        if(history) {
            if(request.previous.x>=info.previous_palette_count || joint>=info.previous_palette_count-request.previous.x)history=false;
            else previous+=matrix(previous_palette.values[request.previous.x+joint])*w;
        }
    }
    vec4 p=current*vec4(position,1);
    mat3 basis=mat3(current);float basis_determinant=determinant(basis);
    vec3 n=abs(basis_determinant)>1e-12 ? unit_vector(transpose(inverse(basis))*normal) : vec3(0);
    vec3 t=basis*tangent;t=unit_vector(t-n*dot(n,t));
    vec3 old=history?(previous*vec4(old_position,1)).xyz:p.xyz;
    mat3 old_basis=mat3(previous);float old_determinant=determinant(old_basis);
    vec3 old_n=history && abs(old_determinant)>1e-12 ? unit_vector(transpose(inverse(old_basis))*old_normal) : n;
    output_cache.values[out_index]=DeformedVertex(vec4(p.xyz,1),vec4(n,0),vec4(t,v.tangent.w*(basis_determinant<0?-1:1)),vec4(old,history?1:0),vec4(old_n,0));
#ifdef GRAPHENE_SKIN_ALL
    tags.values[out_index]=all_vertices.geometry.w;
#endif
}
