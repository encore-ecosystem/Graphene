#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, std430) readonly buffer SceneSdf {
    float values[];
} scene;
layout(set = 0, binding = 1, std430) readonly buffer SurfaceCache {
    float values[];
} surfaces;
layout(set = 0, binding = 2, std430) buffer RadianceHistory {
    float values[];
} history;

vec3 hemisphereDirection(vec3 normal, uint ray) {
    vec3 seed;
    if (ray == 0) seed = vec3(0.65, 0.22, 0.71);
    else if (ray == 1) seed = vec3(-0.48, 0.81, 0.33);
    else if (ray == 2) seed = vec3(0.18, -0.73, 0.66);
    else if (ray == 3) seed = vec3(-0.76, -0.18, 0.62);
    else if (ray == 4) seed = vec3(0.91, -0.37, 0.17);
    else seed = vec3(-0.24, 0.51, 0.83);
    if (dot(seed, normal) < 0.0) seed = -seed;
    return normalize(seed + normal * 0.55);
}

vec3 probeDirection(uint ray) {
    if (ray == 0) return vec3(1.0, 0.0, 0.0);
    if (ray == 1) return vec3(-1.0, 0.0, 0.0);
    if (ray == 2) return vec3(0.0, 1.0, 0.0);
    if (ray == 3) return vec3(0.0, -1.0, 0.0);
    if (ray == 4) return vec3(0.0, 0.0, 1.0);
    return vec3(0.0, 0.0, -1.0);
}

float sceneDistance(vec3 point, out vec3 closestEmission) {
    uint sphereCount = uint(scene.values[1]);
    float distance = 1e20;
    closestEmission = vec3(0.0);
    for (uint sphere = 0; sphere < sphereCount; ++sphere) {
        uint base = 8 + sphere * 8;
        vec3 center = vec3(scene.values[base], scene.values[base + 1], scene.values[base + 2]);
        float candidate = length(point - center) - scene.values[base + 3];
        if (candidate < distance) {
            distance = candidate;
            closestEmission = vec3(scene.values[base + 4],
                scene.values[base + 5], scene.values[base + 6]);
        }
    }
    uint boxCount = uint(scene.values[7]);
    uint boxStart = 8 + sphereCount * 8;
    for (uint box = 0; box < boxCount; ++box) {
        uint base = boxStart + box * 12;
        vec3 center = vec3(scene.values[base],
            scene.values[base + 1], scene.values[base + 2]);
        vec3 extent = vec3(scene.values[base + 4],
            scene.values[base + 5], scene.values[base + 6]);
        vec3 delta = abs(point - center) - extent;
        float candidate = length(max(delta, vec3(0.0))) +
            min(max(delta.x, max(delta.y, delta.z)), 0.0);
        if (candidate < distance) {
            distance = candidate;
            closestEmission = vec3(scene.values[base + 8],
                scene.values[base + 9], scene.values[base + 10]);
        }
    }
    return distance;
}

vec3 traceRadiance(vec3 origin, vec3 direction) {
    float maximumDistance = scene.values[3];
    float traveled = 0.0;
    vec3 closestEmission = vec3(0.0);
    for (uint step = 0; step < 48 && traveled < maximumDistance; ++step) {
        vec3 point = origin + direction * traveled;
        float distance = sceneDistance(point, closestEmission);
        if (distance < 0.004) {
            return closestEmission;
        }
        traveled += max(distance, 0.004);
    }
    return vec3(scene.values[4], scene.values[5], scene.values[6]);
}

void main() {
    uint sampleIndex = gl_GlobalInvocationID.x;
    uint sampleCount = uint(scene.values[0]);
    if (sampleIndex >= sampleCount) return;
    uint surface = sampleIndex * 12;
    vec3 position = vec3(surfaces.values[surface],
        surfaces.values[surface + 1], surfaces.values[surface + 2]);
    vec3 normal = normalize(vec3(surfaces.values[surface + 4],
        surfaces.values[surface + 5], surfaces.values[surface + 6]));
    bool worldProbe = surfaces.values[surface + 3] < 0.5;
    vec3 radiance = vec3(0.0);
    for (uint ray = 0; ray < 6; ++ray) {
        vec3 direction = worldProbe
            ? probeDirection(ray) : hemisphereDirection(normal, ray);
        radiance += traceRadiance(position + normal * 0.02, direction);
    }
    radiance /= 6.0;
    uint outputBase = sampleIndex * 4;
    vec3 previous = vec3(history.values[outputBase],
        history.values[outputBase + 1], history.values[outputBase + 2]);
    float historyWeight = clamp(scene.values[2], 0.0, 0.98);
    vec3 accumulated = mix(radiance, previous, historyWeight);
    history.values[outputBase] = accumulated.x;
    history.values[outputBase + 1] = accumulated.y;
    history.values[outputBase + 2] = accumulated.z;
    history.values[outputBase + 3] = min(history.values[outputBase + 3] + 1.0, 255.0);
}
