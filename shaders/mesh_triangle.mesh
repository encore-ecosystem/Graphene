#version 460
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1) in;
layout(triangles, max_vertices = 3, max_primitives = 1) out;

layout(location = 0) out vec3 color[];
layout(location = 1) out vec2 texture_coordinate[];

void main() {
    SetMeshOutputsEXT(3, 1);
    gl_MeshVerticesEXT[0].gl_Position = vec4(-0.8, -0.8, 0.0, 1.0);
    gl_MeshVerticesEXT[1].gl_Position = vec4(0.8, -0.8, 0.0, 1.0);
    gl_MeshVerticesEXT[2].gl_Position = vec4(0.0, 0.8, 0.0, 1.0);
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    color[0] = vec3(1.0, 0.0, 0.0);
    color[1] = vec3(0.0, 1.0, 0.0);
    color[2] = vec3(0.0, 0.0, 1.0);
    texture_coordinate[0] = vec2(0.1, 0.1);
    texture_coordinate[1] = vec2(0.9, 0.1);
    texture_coordinate[2] = vec2(0.5, 0.9);
}
