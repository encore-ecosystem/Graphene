                open_viewport_menu = if open_viewport_menu == "shading" {
                    ""
                } else {
                    "shading"
                }
                dirty = true
            } elif target == "viewport-sky" {
                open_viewport_menu = if open_viewport_menu == "skybox" {
                    ""
                } else {
                    "skybox"
                }
                dirty = true
            } elif target == "viewport-speed" {
                open_viewport_menu = if open_viewport_menu == "speed" {
                    ""
                } else {
                    "speed"
