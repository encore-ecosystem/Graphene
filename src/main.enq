        hero.push(Widget::label("Build worlds with Graphene").with_flex(28.0_f32, 0.0_f32).with_style(
                Style::default().with_foreground(Color::rgb(235_u8, 236_u8, 239_u8)).with_font_size(17.0_f32).with_font_weight(600_u32).with_pointer_events(false)))
        let mut actions = Widget::panel("browser-actions").with_direction(horizontal()).with_flex(38.0_f32,
            0.0_f32,).with_style(Style::default().with_gap(8.0_f32))
        actions.push(Widget::icon_button("browser-new", "New Project", icons.add).with_flex(132.0_f32,
                0.0_f32,).with_style(
