                dirty = true
            } elif target == "camera-perspective" || target == "camera-top" || target == "camera-front"
            || target == "camera-right" {
                if target == "camera-top" {
                    camera_mode = "top" camera.yaw = 0.0_f32 camera.pitch = 1.35_f32
                } elif target == "camera-front" {
                    camera_mode = "front" camera.yaw = 1.5707963_f32 camera.pitch = 0.0_f32
                } elif target == "camera-right" {
                    camera_mode = "right" camera.yaw = 0.0_f32 camera.pitch = 0.0_f32
                } else {
                    camera_mode = "perspective" camera.yaw = 0.64_f32 camera.pitch = 0.42_f32
                }
                camera.position = camera.target.add(Vec3::from_spherical(camera.yaw, camera.pitch).scale(camera.distance))
                open_viewport_menu = "" status_message = camera_mode_name(camera_mode) + " camera" dirty
                = true
            } elif is_shading_target(target) {
                shading_mode = shading_target_mode(target)
                viewport_renderer.set_shading_mode(
