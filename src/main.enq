                    icons.mesh, template == "starter", hovered,))
            root.push(templates)
            root.push(Widget::input("browser-project-name", name.value()).with_flex(38.0_f32, 0.0_f32).with_focus(true).with_style(
                    Style::default().with_background(Color::rgb(14_u8, 15_u8, 18_u8)).with_foreground(Color::rgb(225_u8,
                            228_u8, 232_u8,))
                    .with_border(1.0_f32, Color::rgb(55_u8, 58_u8, 65_u8)).with_radius(4.0_f32)))
        }
        root.push(picker.view(file_picker_icons(icons)))
        let mut footer = Widget::panel("browser-footer").with_direction(horizontal()).with_flex(38.0_f32,
            0.0_f32,).with_style(Style::default().with_gap(8.0_f32))
        footer.push(Widget::label(error).with_flex(0.0_f32, 1.0_f32).with_style(Style::default().with_foreground(Color::rgb(220_u8,
                        102_u8, 94_u8,)).with_font_size(10.0_f32)))
        footer.push(Widget::button("browser-confirm", if mode == "new" {
                    "Create Project"
                } else {
                    "Open Project"
                }
                ,
            ).with_flex(118.0_f32, 0.0_f32).with_style(
                Style::default().with_background(Color::rgb(24_u8, 119_u8, 177_u8)).with_foreground(Color::rgb(246_u8,
                        248_u8, 250_u8,))
                .with_border(1.0_f32, Color::rgb(52_u8, 151_u8, 208_u8)).with_radius(4.0_f32)))
        root.push(footer)
    }
    ret root
}

fn browse_for_project(window: Window, icons: EditorIcons) -> Option[str] {
    let mut mode = match env("GRAPHENE_BROWSER_MODE") {
        Option::Some(value) => {
            if value == "new" || value == "open" {
                value
            } else {
                "home"
            }
        }
        Option::None => {
            "home"
        }
    }
    let mut picker = FilePicker::new(home_dir())
    let mut name = TextEditor::new("GrapheneProject")
    let mut template = "empty"
    let mut focus = "name"
    let mut hovered = ""
    let mut error = ""
    let mut browser_ui = window.reactive(project_browser_view(mode, picker, name,
            template, hovered, error, icons, window.width() as f32,
            window.height() as f32,))
    let mut layout = browser_ui.layout()
    while window.is_open() {
        let event = window.wait(250_u32)
        if event.kind() == event_close() {
            ret Option[str]::None
        }
        let mut dirty = event.kind() == event_resize()
        if event.kind() == event_pointer_move() {
            let next_hovered = browser_ui.hit(event.x(), event.y())
            if next_hovered != hovered {
                hovered = next_hovered dirty = true
            }
        }
        if event.kind() == event_pointer_down() {
            let target = browser_ui.hit(event.x(), event.y())
            if target == "browser-new" {
                mode = "new" picker = FilePicker::new(home_dir()) template = "empty" focus = "name" error
                = ""
            } elif target == "browser-open" {
                mode = "open" picker = FilePicker::new(home_dir()) focus = "picker" error = ""
            } elif target == "browser-back" {
                mode = "home" error = ""
            } elif target == "template-empty" {
                template = "empty"
            } elif target == "template-starter" {
                template = "starter"
            } elif target == "browser-project-name" {
                focus = "name"
            } elif target == "file-picker-create-folder" {
                picker = picker.create_folder() focus = "picker"
            } elif target == "browser-confirm" {
                let path = if mode == "new" {
                    picker.directory() + "/" + name.value()
                } else {
                    picker.directory()
                }
                let ready = if mode == "new" {
                    create_project_with_template(path, template)
                } else {
                    project_valid(project_paths(path))
                }
                if ready {
                    remember_project(path) ret Option[str]::Some(path)
                }
                error = if mode == "new" {
                    "Unable to create project at this location"
                } else {
                    "This folder is not a Graphene project"
                }
            } else {
                let mut recent_index = 0_usize
                let recent = recent_projects()
                while recent_index < recent.len() {
                    if target == "recent-project-" + recent_index.fmt() {
                        match recent.get(recent_index) {
                            Option::Some(path) => {
                                remember_project(path) ret Option[str]::Some(path)
                            }
                            Option::None => {
                            }
                        }
                    }
                    recent_index = recent_index + 1_usize
                }
                picker = picker.click(target)
                focus = "picker"
            }
            dirty = true
        }
        if event.kind() == event_text_input() && event.text() != "" {
            if mode == "new" && focus == "name" {
                name = name.insert(event.text())
            } else {
                picker = picker.input(event.text())
            }
            dirty = true
        }
        if event.kind() == event_key_down() && event.key() == key_backspace() {
            if mode == "new" && focus == "name" {
                name = name.backspace()
            } else {
                picker = picker.backspace()
            }
            dirty = true
        }
        if event.kind() == event_key_down() && event.key() == key_enter() {
            if picker.creating_folder() && focus == "picker" {
                picker = picker.create_folder()
            } elif focus == "picker" {
                picker = picker.confirm_path()
            }
            dirty = true
        }
        if event.kind() == event_scroll() && mode != "home" {
            picker = picker.scroll_by(0.0_f32 - event.wheel_y() * 24.0_f32) dirty = true
        }
        if dirty {
            if event.kind() == event_resize() {
                browser_ui = window.relayout_reactive(browser_ui)
            } else {
                browser_ui = window.update_reactive(browser_ui,
                    project_browser_view(mode, picker, name, template, hovered,
                        error, icons, window.width() as f32,
                        window.height() as f32,),)
            }
            layout = browser_ui.layout()
        }
    }
    ret Option[str]::None
}

fn launch_project_browser() -> Option[str] {
    let window = Window::create("Graphene Project Browser", 1180_u32, 760_u32)
    .with_background(Color::rgb(13_u8, 13_u8, 15_u8))
    if !window.available() {
        println("Graphene: unable to create project browser: " + backend_error())
        ret Option[str]::None
    }
    let mut font_manager = FontManager::with_bundled("../Luma/assets/fonts")
    font_manager.register_all(window)
    font_manager = font_manager.activate(window, "Roboto", 12.0_f32, 400_u32)
    if font_manager.error() != "" {
        println("Graphene: unable to activate Roboto: " + font_manager.error())
    }
    let icons = EditorIcons::load(IconManager::with_bundled("../Luma/assets/icons"))
    let project = browse_for_project(window, icons)
    window.destroy()
    ret project
}

fn dock_tab(id: str, text: str, active: bool) -> Widget {
    let background = if active {
        Color::rgb(35_u8, 36_u8, 40_u8)
    } else {
        Color::rgb(22_u8, 22_u8, 25_u8)
    }
    let mut tab = Widget::panel(id + "-surface").with_direction(vertical()).with_flex(128.0_f32, 0.0_f32).with_style(
        Style::default().with_background(background).with_border(1.0_f32, Color::rgb(48_u8, 49_u8, 54_u8))
        .with_radius(1.0_f32).with_gap(0.0_f32))
    tab.push(Widget::panel("").with_flex(2.0_f32, 0.0_f32).with_style(
            Style::default().with_background(if active {
                    Color::rgb(32_u8, 143_u8, 207_u8)
                } else {
                    background
                }
            )
            .with_pointer_events(false)))
    tab.push(Widget::button(id, text).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_background(background).with_foreground(Color::rgb(218_u8, 219_u8, 223_u8))
            .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32)
