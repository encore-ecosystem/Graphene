fn section_title(text: str) -> Widget {
    let mut title = Widget::panel("section-" + text).with_added_classes("g-section-title")
    title.push(Widget::panel("").with_added_classes("g-section-accent"))
    title.push(Widget::label(text).with_added_classes("g-section-caption"))
    ret title
}

fn dock_badge(text: str, width: f32) -> Widget {
    ret Widget::label(text).with_flex(width, 0.0_f32).with_added_classes("g-dock-badge")
}

fn dock_header(text: str, context: str, context_width: f32) -> Widget {
    let mut header = Widget::panel("dock-header-" + text).with_added_classes("g-dock-header")
    let mut row = Widget::panel("").with_added_classes("g-dock-heading")
    row.push(Widget::label(text).with_added_classes("g-dock-caption"))
    if context != "" {
        row.push(dock_badge(context, context_width))
    }
    header.push(row)
    ret header
}

