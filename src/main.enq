    initial_frame = initial_frame.with_display_overlay(camera_overlay_style.display(layout, selected), retained_bounds(reactive_ui, "viewport").unwrap_or(Rect::new(0, 0, 0, 0)))
    match initial_frame.surface("viewport-surface") {
