        icons.hidden,)
}

struct ProjectPaths {
    root: str
    marker: str
    scene: str
    material: str
    script: str
    manifest: str
    build_log: str
    build_completion: str
}

struct ProjectContents {
    actor_ids: Vec[u64]
    parents: Vec[Option[u64]]
    positions: Vec[Vec3]
    rotations: Vec[Vec3]
    scales: Vec[Vec3]
    actor_names: Vec[str]
    mesh_names: Vec[str]
    visibilities: Vec[bool]
    material: StandardMaterial
    code: str
}

fn actor_mesh_name(kind: str) -> Option[str] {
    if kind == "cube" {
        ret Option[str]::Some("")
    }
    if kind == "plane" {
        ret Option[str]::Some("@plane")
    }
    if kind == "sphere" {
        ret Option[str]::Some("@sphere")
    }
    if kind.byte_len() > 5_usize && kind.slice(0_usize, 5_usize) == "mesh:" {
        ret Option[str]::Some(kind.slice(5_usize, kind.byte_len() - 5_usize))
    }
    ret Option[str]::None
}

fn trim_trailing_separator(path: str) -> str {
    let mut length = path.char_len()
    while length > 1_usize &&(path.slice(length - 1_usize, 1_usize) == "/" || path.slice(length - 1_usize,
            1_usize,) == "\\") {
        length = length - 1_usize
    }
    ret path.slice(0_usize, length)
}

fn parent_directory(path: str) -> str {
    let mut index = path.char_len()
    while index > 0_usize {
        let token = path.slice(index - 1_usize, 1_usize)
        if token == "/" || token == "\\" {
            ret path.slice(0_usize, index - 1_usize)
        }
        index = index - 1_usize
    }
    ret ""
}

fn project_paths(root: str) -> ProjectPaths {
    let base = trim_trailing_separator(root)
    ret ProjectPaths {
        base, base + "/graphene.project", base + "/scene.graphene.json", base + "/Content/Materials/Default.graphene-material.json",
        base + "/game/src/main.enq", base + "/game/encore.toml", base + "/game/.graphene-build.log",
        base + "/game/.graphene-build-complete"
    }
}

fn project_valid(paths: ProjectPaths) -> bool {
    ret file_exists(paths.marker) && file_exists(paths.scene) && file_exists(paths.manifest) && file_exists(paths.script)
}

fn create_project_with_template(root: str, template: str) -> bool {
    let paths = project_paths(root)
    if file_exists(paths.marker) || file_exists(paths.scene) || file_exists(paths.manifest) || file_exists(paths.script)
    {
        ret false
    }
    if mkdir_all(paths.root + "/game/src") != 0_i32 {
        ret false
    }
    if mkdir_all(paths.root + "/Content/Meshes") != 0_i32 {
        ret false
    }
    if mkdir_all(paths.root + "/Content/Materials") != 0_i32 {
        ret false
    }
    let mut positions = Vec[Vec3]::new()
    let mut rotations = Vec[Vec3]::new()
    let mut scales = Vec[Vec3]::new()
    if template == "starter" {
        positions.push(Vec3::zero())
        rotations.push(Vec3::zero())
        scales.push(Vec3::new(1.0_f32, 1.0_f32, 1.0_f32))
    }
    if write_file(paths.scene, scene_asset(positions, rotations, scales).stringify() + "\n") != 0_i32
    {
        ret false
    }
    if write_file(paths.material, material_asset_stringify(StandardMaterial::editor_default()) + "\n")
    != 0_i32 {
        ret false
    }
    if write_file(paths.manifest, "[project]\nname = \"graphene_game\"\nversion = \"0.1.0\"\ndependencies = []\n")
    != 0_i32 {
        ret false
    }
    if write_file(paths.script, "fn main() -> u32 {\n    ret 0_u32\n}\n") != 0_i32 {
        ret false
    }
    ret write_file(paths.marker, "[project]\nformat = 1\nscene = \"scene.graphene.json\"\ngame = \"game/encore.toml\"\n")
    == 0_i32
}

fn create_project(root: str) -> bool {
    ret create_project_with_template(root, "empty")
}

fn load_project(paths: ProjectPaths) -> Option[ProjectContents] {
    if !project_valid(paths) {
        ret Option[ProjectContents]::None
    }
    match SceneAsset::parse(read_file(paths.scene)) {
        Option::Some(asset) => {
            let mut positions = Vec[Vec3]::new()
            let mut actor_ids = Vec[u64]::new()
            let mut parents = Vec[Option[u64]]::new()
            let mut rotations = Vec[Vec3]::new()
            let mut scales = Vec[Vec3]::new()
            let mut actor_names = Vec[str]::new()
            let mut mesh_names = Vec[str]::new()
            let mut visibilities = Vec[bool]::new()
            let mut index = 0_usize
            while index < asset.len() {
                match asset.actor(index) {
                    Option::Some(actor) => {
                        match actor_mesh_name(actor.kind()) {
                            Option::Some(mesh_name) => {
                                actor_ids.push(actor.id())
                                parents.push(actor.parent())
                                positions.push(actor.transform().position())
                                rotations.push(actor.transform().rotation())
                                scales.push(actor.transform().scale())
                                actor_names.push(actor.name())
                                mesh_names.push(mesh_name)
                                visibilities.push(actor.visible())
                            }
                            Option::None => {
                            }
                        }
                    }
                    Option::None => {
                    }
                }
                index = index + 1_usize
            }
            let material = if file_exists(paths.material) {
                match material_asset_parse(read_file(paths.material)) {
                    Option::Some(value) => value Option::None => StandardMaterial::editor_default()
                }
            } else {
                StandardMaterial::editor_default()
            }
            ret Option[ProjectContents]::Some(ProjectContents {
                    actor_ids, parents, positions, rotations, scales, actor_names, mesh_names, visibilities,
                    material, read_file(paths.script)
                }
                ,)
        }
        Option::None => {
            ret Option[ProjectContents]::None
        }
    }
}

fn vec3_differs(lhs: Vec3, rhs: Vec3) -> bool {
    ret lhs.x() != rhs.x() || lhs.y() != rhs.y() || lhs.z() != rhs.z()
}

fn compile_game(compiler: str, manifest: str, log_path: str, completion_path: str) -> i32 {
    let mut args = Vec[str]::new()
    args.push("build")
    args.push("--manifest-path")
    args.push(manifest)
    let code = run_args_capture(compiler, args, log_path)
    write_file(completion_path, Debug::fmt(code))
    ret code
}

fn theme_surface() -> Color {
    ret Color::rgb(24_u8, 24_u8, 27_u8)
}
fn theme_surface_raised() -> Color {
    ret Color::rgb(31_u8, 32_u8, 36_u8)
}
fn theme_control() -> Color {
    ret Color::rgb(28_u8, 29_u8, 33_u8)
}
fn theme_control_hover() -> Color {
    ret Color::rgb(46_u8, 47_u8, 52_u8)
}
fn theme_border() -> Color {
    ret Color::rgb(43_u8, 44_u8, 49_u8)
}
fn theme_border_hover() -> Color {
    ret Color::rgb(70_u8, 72_u8, 79_u8)
}
fn theme_accent() -> Color {
    ret Color::rgb(32_u8, 143_u8, 207_u8)
}

fn panel_style() -> Style {
    ret Style::default().with_background(theme_surface())
    .with_foreground(Color::rgb(202_u8, 204_u8, 209_u8))
    .with_border(1.0_f32, theme_border())
    .with_radius(0.0_f32).with_padding(Insets::all(6.0_f32)).with_gap(4.0_f32)
}

fn label(text: str) -> Widget {
    ret Widget::label(text).with_flex(24.0_f32, 0.0_f32).with_style(
        Style::default().with_foreground(Color::rgb(188_u8, 190_u8, 196_u8)).with_font_size(11.0_f32))
}

fn section_title(text: str) -> Widget {
    let mut title = Widget::panel("section-" + text).with_direction(horizontal()).with_flex(24.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(Color::rgb(31_u8, 31_u8, 35_u8))
        .with_border(1.0_f32, Color::rgb(47_u8, 48_u8, 53_u8)).with_radius(0.0_f32).with_gap(0.0_f32))
    title.push(Widget::panel("").with_flex(3.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(31_u8, 132_u8, 194_u8)).with_pointer_events(false)))
    title.push(Widget::label(text).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(224_u8, 225_u8, 228_u8))
            .with_padding(Insets::symmetric(4.0_f32, 7.0_f32)).with_font_size(10.0_f32).with_font_weight(600_u32)
            .with_pointer_events(false)))
    ret title
}

fn dock_badge(text: str, width: f32) -> Widget {
    ret Widget::label(text).with_flex(width, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(27_u8, 28_u8, 32_u8)).with_foreground(Color::rgb(139_u8,
                142_u8, 149_u8,))
        .with_border(1.0_f32, theme_border()).with_radius(2.0_f32).with_padding(Insets::symmetric(2.0_f32,
                5.0_f32,))
        .with_font_size(8.0_f32).with_font_weight(600_u32).with_pointer_events(false))
}

fn dock_header(text: str, context: str, context_width: f32) -> Widget {
    let mut header = Widget::panel("dock-header-" + text).with_direction(vertical()).with_flex(26.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(theme_surface_raised())
        .with_border(1.0_f32, theme_border()).with_radius(1.0_f32).with_gap(0.0_f32))
    header.push(Widget::panel("").with_flex(2.0_f32, 0.0_f32).with_style(
            Style::default().with_background(theme_accent()).with_pointer_events(false)))
    let mut row = Widget::panel("").with_direction(horizontal()).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_padding(Insets::symmetric(2.0_f32, 7.0_f32)).with_gap(5.0_f32).with_pointer_events(false))
    row.push(Widget::label(text).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(220_u8, 222_u8, 226_u8))
            .with_font_size(10.0_f32).with_font_weight(600_u32)
            .with_pointer_events(false)))
    if context != "" {
        row.push(dock_badge(context, context_width))
    }
    header.push(row)
    ret header
}

fn menu_item(id: str, text: str, hovered: str) -> Widget {
    ret Widget::button(id, text).with_flex(if text == "Window" {
            52.0_f32
        } else {
            40.0_f32
        }
        , 0.0_f32,).with_style(
        Style::default().with_background(if hovered == id {
                Color::rgb(43_u8, 44_u8, 49_u8)
            } else {
                Color::rgb(15_u8, 15_u8, 17_u8)
            }
        )
        .with_foreground(Color::rgb(188_u8, 190_u8, 196_u8)).with_border(0.0_f32, Color::rgb(0_u8, 0_u8,
                0_u8,))
        .with_radius(2.0_f32).with_padding(Insets::symmetric(3.0_f32, 6.0_f32)).with_font_size(10.0_f32))
}

fn popup_action(id: str, text: str, icon: SvgDocument, hovered: str, disabled: bool, active: bool) ->
Widget {
    ret Widget::icon_button(id, text, icon).with_flex(21.0_f32, 0.0_f32).with_disabled(disabled).with_style(
        Style::default().with_background(if active {
                Color::rgb(30_u8, 66_u8, 89_u8)
            } else {
                if hovered == id {
                    Color::rgb(48_u8, 49_u8, 54_u8)
                } else {
                    Color::rgb(25_u8, 25_u8, 28_u8)
                }
            }
        ).with_foreground(Color::rgb(218_u8, 220_u8, 224_u8)).with_border(0.0_f32, Color::rgb(0_u8, 0_u8,
                0_u8,))
        .with_radius(1.0_f32).with_padding(Insets::symmetric(2.0_f32, 7.0_f32)).with_font_size(9.0_f32))
}

fn menu_popup(menu: str, hovered: str, project_loaded: bool, project_dirty: bool, can_undo: bool, can_redo:
    bool, selected_cube: u32,
    simulating: bool, building: bool, show_outliner: bool, show_details: bool, show_content: bool, icons:
    EditorIcons,) -> Widget {
    let left = if menu == "menu-file" {
        112.0_f32
    } else {
        if menu == "menu-edit" {
            154.0_f32
        } else {
            if menu == "menu-window" {
                196.0_f32
            } else {
                if menu == "menu-tools" {
                    250.0_f32
                } else {
                    292.0_f32
                }
            }
        }
    }
    let height = if menu == "menu-edit" {
        100.0_f32
    } else {
        if menu == "menu-file" {
            122.0_f32
        } else {
            if menu == "menu-window" {
                76.0_f32
            } else {
                29.0_f32
            }
        }
    }
    let mut popup = Widget::panel("menu-popup").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(25_u8, 25_u8, 28_u8)).with_border(1.0_f32, Color::rgb(65_u8,
                66_u8, 72_u8,))
        .with_radius(2.0_f32).with_padding(Insets::all(4.0_f32)).with_gap(2.0_f32).with_width(192.0_f32).with_height(height)
        .with_absolute(true).with_left(left).with_top(24.0_f32).with_z_index(90_i32)
        .with_shadow(0.0_f32, 5.0_f32, 14.0_f32, 0.0_f32, Color::rgba(0_u8, 0_u8, 0_u8, 170_u8), false))
    if menu == "menu-file" {
        popup.push(popup_action("menu-new-project-action", "New Project", icons.add, hovered, building
                || simulating, false,))
        popup.push(popup_action("menu-open-project-action", "Open Project", icons.folder, hovered, building
                || simulating, false,))
        popup.push(popup_action("menu-save-action", "Save Level", icons.save, hovered, !project_loaded
                || !project_dirty || simulating, false,))
        popup.push(popup_action("menu-build-action", "Build Project", icons.build, hovered, !project_loaded
                || building || simulating, false,))
        popup.push(popup_action("menu-exit-action", "Exit Graphene", icons.exit, hovered, false, false))
    } elif menu == "menu-edit" {
        popup.push(popup_action("menu-undo-action", "Undo", icons.undo, hovered, !can_undo, false))
        popup.push(popup_action("menu-redo-action", "Redo", icons.redo, hovered, !can_redo, false))
        popup.push(popup_action("menu-duplicate-action", "Duplicate Actor", icons.duplicate, hovered,
                selected_cube == 0_u32 || simulating, false,))
        popup.push(popup_action("menu-delete-action", "Delete Actor", icons.delete, hovered, selected_cube
                == 0_u32 || simulating, false,))
    } elif menu == "menu-window" {
        popup.push(popup_action("menu-outliner-action", "World Outliner", icons.panels, hovered, false,
                show_outliner,))
        popup.push(popup_action("menu-details-action", "Details", icons.panels, hovered, false, show_details))
        popup.push(popup_action("menu-content-action", "Content Browser", icons.panels, hovered, false,
                show_content,))
    } elif menu == "menu-tools" {
        popup.push(popup_action("menu-tools-build-action", "Build Project", icons.build, hovered, !project_loaded
                || building || simulating, false,))
    } else {
        popup.push(popup_action("menu-about-action", "About Graphene", icons.info, hovered, false, false))
    }
    ret popup
}

fn add_actor_popup(imported_meshes: Vec[ImportedMeshAsset], hovered: str, icons: EditorIcons) -> Widget
{
    let visible_meshes = if imported_meshes.len() > 7_usize {
        7_usize
    } else {
        imported_meshes.len()
    }
    let height = 102.0_f32 +(visible_meshes as f32) * 23.0_f32 + if visible_meshes > 0_usize {
        23.0_f32
    } else {
        0.0_f32
    }
    let mut popup = Widget::panel("add-actor-popup").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(24_u8, 24_u8, 27_u8)).with_border(1.0_f32, Color::rgb(67_u8,
                68_u8, 75_u8,))
        .with_radius(3.0_f32).with_padding(Insets::all(5.0_f32)).with_gap(2.0_f32).with_width(232.0_f32).with_height(height)
        .with_absolute(true).with_left(6.0_f32).with_top(154.0_f32).with_z_index(96_i32)
        .with_shadow(0.0_f32, 7.0_f32, 18.0_f32, 0.0_f32, Color::rgba(0_u8, 0_u8, 0_u8, 190_u8), false))
    popup.push(Widget::label("BASIC").with_flex(18.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(116_u8, 119_u8, 126_u8)).with_font_size(8.0_f32).with_font_weight(700_u32)
            .with_padding(Insets::symmetric(2.0_f32, 6.0_f32)).with_pointer_events(false)))
    popup.push(popup_action("add-actor-cube", "Cube", icons.mesh, hovered, false, false))
    popup.push(popup_action("add-actor-plane", "Plane", icons.mesh, hovered, false, false))
    popup.push(popup_action("add-actor-sphere", "Sphere", icons.mesh, hovered, false, false))
    if visible_meshes > 0_usize {
        popup.push(Widget::label("PROJECT MESHES").with_flex(18.0_f32, 0.0_f32).with_style(
                Style::default().with_foreground(Color::rgb(116_u8, 119_u8, 126_u8)).with_font_size(8.0_f32).with_font_weight(700_u32)
                .with_padding(Insets::symmetric(2.0_f32, 6.0_f32)).with_pointer_events(false)))
        let mut index = 0_usize
        while index < visible_meshes {
            match imported_meshes.get(index) {
                Option::Some(asset) => {
                    popup.push(popup_action("add-actor-imported-" + index.fmt(), asset.name(), icons.mesh,
                            hovered, false, false,))
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
    }
    ret popup
}

fn outliner_settings_popup(show_editor_actors: bool, show_hidden_actors: bool, hovered: str, icons: EditorIcons)
-> Widget {
    let mut popup = Widget::panel("outliner-settings-popup").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(24_u8, 24_u8, 27_u8)).with_border(1.0_f32, Color::rgb(67_u8,
                68_u8, 75_u8,))
