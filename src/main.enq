                5.0_f32,)).with_gap(4.0_f32)
        .with_pointer_events(false))
    row.push(Widget::icon("", icons.expanded).with_flex(13.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(125_u8, 128_u8, 135_u8)).with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
    row.push(Widget::icon("", icons.folder).with_flex(17.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(185_u8, 144_u8, 66_u8)).with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
    row.push(Widget::label(name).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(169_u8, 172_u8, 178_u8)).with_font_size(9.0_f32).with_font_weight(600_u32)
            .with_pointer_events(false)))
    ret row
}

fn hierarchy(selected: str, actor_ids: Vec[u64], actor_parents: Vec[Option[u64]], actor_names: Vec[str],
    actor_visibilities: Vec[bool],
    object_count: u32, search_editor: TextEditor, search_focused: bool, show_editor_actors: bool, show_hidden_actors:
    bool,
    hovered: str, icons: EditorIcons,) -> Widget {
    let query = search_editor.value()
    let camera_matches = show_editor_actors && outliner_actor_matches(query, "Camera", true, true)
    let light_matches = show_editor_actors && outliner_actor_matches(query, "Directional Light", true,
        true,)
    let mut visible_geometry = 0_u32
    let mut count_index = 0_usize
    while count_index < actor_ids.len() {
        let actor = count_index as u32 + 1_u32
        if outliner_actor_matches(query, actor_name_at(actor_names, actor), bool_at(actor_visibilities,
                actor, true,), show_hidden_actors) {
            visible_geometry = visible_geometry + 1_u32
        }
        count_index = count_index + 1_usize
    }
    let visible_count = visible_geometry + if camera_matches {
        1_u32
    } else {
        0_u32
    }
    + if light_matches {
        1_u32
    } else {
        0_u32
    }
    let mut panel = Widget::panel("hierarchy").with_direction(vertical()).with_flex(242.0_f32, 0.0_f32).with_style(panel_style())
    panel.push(dock_header("WORLD OUTLINER", Debug::fmt(visible_count) + " / " + Debug::fmt(object_count
                + 2_u32) + " ACTORS", 74.0_f32))
    let mut search = Widget::panel("outliner-tools").with_direction(horizontal()).with_flex(30.0_f32,
        0.0_f32,).with_style(
        Style::default().with_gap(4.0_f32))
    search.push(editable_search_field("scene-search", search_editor, search_focused, "Search actors",
            icons.search, 0.0_f32, 1.0_f32,))
    search.push(Widget::icon_button("outliner-add", "", icons.add).with_flex(30.0_f32, 0.0_f32)
        .with_style(compact_icon_style(hovered == "outliner-add")))
    search.push(Widget::icon_button("outliner-settings", "", icons.settings).with_flex(30.0_f32, 0.0_f32)
        .with_style(compact_icon_style(hovered == "outliner-settings")))
    panel.push(search)
    if camera_matches {
        panel.push(actor_row("entity-camera", "Camera", "CAM", icons.camera, selected == "Camera", true,
                hovered, 0_u32, icons,))
    }
    if light_matches {
        panel.push(actor_row("entity-light", "Directional Light", "LIGHT", icons.light, selected == "Directional Light",
                true, hovered, 0_u32, icons,))
    }
    if visible_geometry > 0_u32 {
        panel.push(collection_row("Geometry", icons))
    }
    let mut index = 0_usize
    while index < actor_ids.len() {
        let actor = index as u32 + 1_u32
        let name = actor_name_at(actor_names, actor)
        let visible = bool_at(actor_visibilities, actor, true)
        if outliner_actor_matches(query, name, visible, show_hidden_actors) {
            panel.push(actor_row("entity-cube-" + Debug::fmt(actor), name, "MESH", icons.mesh, selected
                    == name,
                    visible, hovered, actor_hierarchy_depth(index, actor_ids, actor_parents), icons,))
        }
        index = index + 1_usize
    }
    if visible_count == 0_u32 {
        panel.push(Widget::label("No actors match current filters").with_flex(32.0_f32, 0.0_f32).with_style(
                Style::default().with_foreground(Color::rgb(130_u8, 133_u8, 140_u8)).with_font_size(9.0_f32)
                .with_padding(Insets::symmetric(8.0_f32, 6.0_f32)).with_pointer_events(false)))
    }
    panel.push(Widget::spacer(1.0_f32))
    ret panel
}

fn viewport(simulation_mode: str, dragging: bool, object_count: u32, selected: str, active_tool: str,
    camera_mode: str,
    shading_mode: str, camera_speed: str, grid_visible: bool, rotation_snap: bool, open_viewport_menu:
    str, hovered: str,
    compact: bool, icons: EditorIcons,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut viewport = Widget::panel("viewport").with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_background(Color::rgb(13_u8, 14_u8, 16_u8))
        .with_border(if dragging {
                2.0_f32
            } else {
                1.0_f32
            }
            ,
            if dragging {
                Color::rgb(22_u8, 136_u8, 212_u8)
            } else {
                Color::rgb(43_u8, 44_u8, 49_u8)
            }
            ,)
        .with_padding(Insets::all(0.0_f32)).with_gap(0.0_f32))
    let mut viewport_bar = Widget::panel("viewport-bar").with_direction(horizontal()).with_flex(30.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(Color::rgb(20_u8, 20_u8, 23_u8)).with_border(1.0_f32, Color::rgb(43_u8,
                44_u8, 49_u8,))
        .with_padding(Insets::symmetric(3.0_f32, 6.0_f32)).with_gap(5.0_f32))
    if simulation_mode_is_play(simulation_mode) {
        viewport_bar.push(Widget::icon("", icons.play).with_flex(18.0_f32, 0.0_f32).with_style(
                Style::default().with_foreground(Color::rgb(91_u8, 196_u8, 121_u8)).with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
        viewport_bar.push(label("PLAY IN EDITOR").with_flex(112.0_f32, 0.0_f32))
        viewport_bar.push(Widget::spacer(1.0_f32))
        viewport_bar.push(label("Esc to stop").with_flex(78.0_f32, 0.0_f32))
    } else {
        viewport_bar.push(selector_control("viewport-camera", camera_mode_name(camera_mode), icons.view,
                icons.expanded, 108.0_f32,
                hovered == "viewport-camera",))
        viewport_bar.push(selector_control("viewport-lit", shading_mode_name(shading_mode), icons.lighting,
                icons.expanded, 76.0_f32,
                hovered == "viewport-lit",))
        let mut tools = segmented_group()
        tools.push(Widget::icon_button("tool-select", "", icons.select).with_flex(30.0_f32, 1.0_f32).with_style(
                segmented_icon_style(active_tool == "select", hovered == "tool-select")))
        tools.push(Widget::icon_button("tool-move", "", icons.move).with_flex(30.0_f32, 1.0_f32).with_style(
                segmented_icon_style(active_tool == "move", hovered == "tool-move")))
        tools.push(Widget::icon_button("tool-rotate", "", icons.rotate).with_flex(30.0_f32, 1.0_f32).with_style(
                segmented_icon_style(active_tool == "rotate", hovered == "tool-rotate")))
        tools.push(Widget::icon_button("tool-scale", "", icons.scale).with_flex(30.0_f32, 1.0_f32).with_style(
                segmented_icon_style(active_tool == "scale", hovered == "tool-scale")))
        viewport_bar.push(tools)
        if !compact {
            viewport_bar.push(Widget::panel("").with_flex(1.0_f32, 0.0_f32).with_style(
                    Style::default().with_background(Color::rgb(54_u8, 55_u8, 60_u8)).with_pointer_events(false)))
            viewport_bar.push(viewport_toggle_readout("grid-toggle", "10", icons.grid, 48.0_f32, grid_visible,
                    hovered == "grid-toggle",))
            viewport_bar.push(viewport_toggle_readout("snap-toggle", "10 deg", icons.snap, 66.0_f32,
                    rotation_snap,
                    hovered == "snap-toggle",))
            viewport_bar.push(selector_control("viewport-speed", camera_speed_name(camera_speed), icons.speed,
                    icons.expanded,
                    78.0_f32, hovered == "viewport-speed",))
        }
        viewport_bar.push(Widget::spacer(1.0_f32))
        viewport_bar.push(label(simulation_mode_label(simulation_mode)).with_flex(72.0_f32, 0.0_f32))
    }
    viewport.push(viewport_bar)
    if !simulation_mode_is_play(simulation_mode) && open_viewport_menu == "camera" {
        viewport.push(viewport_camera_strip(camera_mode, hovered, icons))
    }
    if !simulation_mode_is_play(simulation_mode) && open_viewport_menu == "shading" {
        viewport.push(viewport_shading_strip(shading_mode, hovered, icons))
    }
    if !simulation_mode_is_play(simulation_mode) && open_viewport_menu == "speed" {
        viewport.push(viewport_speed_strip(camera_speed, hovered, icons))
    }
    viewport.push(Widget::render_surface("viewport-surface").with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_background(Color::rgb(12_u8, 16_u8, 22_u8))
            .with_padding(Insets::all(0.0_f32)).with_gap(0.0_f32)))
    let mut viewport_status = Widget::panel("viewport-status").with_direction(horizontal()).with_flex(22.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(Color::rgb(17_u8, 17_u8, 20_u8)).with_border(1.0_f32, Color::rgb(41_u8,
                42_u8, 47_u8,))
        .with_padding(Insets::symmetric(3.0_f32, 7.0_f32)).with_gap(8.0_f32))
    if simulation_mode_is_play(simulation_mode) {
        viewport_status.push(viewport_status_item("Game Camera", icons.camera, 108.0_f32, Color::rgb(88_u8,
                    183_u8, 116_u8,)))
        viewport_status.push(label("Actors " + Debug::fmt(object_count)).with_flex(64.0_f32, 0.0_f32))
        viewport_status.push(Widget::spacer(1.0_f32))
        viewport_status.push(label("Editor navigation locked").with_flex(146.0_f32, 0.0_f32))
    } else {
        viewport_status.push(viewport_status_item(selected,
                if selected == "Camera" {
                    icons.camera
                } else {
                    if selected == "Directional Light" {
                        icons.light
                    } else {
                        icons.mesh
                    }
                }
                ,
                if compact {
                    104.0_f32
                } else {
                    132.0_f32
                }
                , Color::rgb(91_u8, 166_u8, 209_u8),))
        viewport_status.push(viewport_status_item(tool_name(active_tool),
                if active_tool == "move" {
                    icons.move
                } else {
                    if active_tool == "rotate" {
                        icons.rotate
                    } else {
                        if active_tool == "scale" {
                            icons.scale
                        } else {
                            icons.select
                        }
                    }
                }
                , if compact {
                    64.0_f32
                } else {
                    76.0_f32
                }
                , Color::rgb(182_u8, 144_u8, 73_u8),))
        if !compact {
            viewport_status.push(label("Actors " + Debug::fmt(object_count)).with_flex(64.0_f32, 0.0_f32))
        }
        viewport_status.push(Widget::spacer(1.0_f32))
        viewport_status.push(label(if compact {
                    "RMB Orbit   MMB Pan   Wheel Zoom"
                } else {
                    "RMB Orbit   MMB Pan   Wheel Zoom   F Focus"
                }
            )
            .with_flex(if compact {
                    198.0_f32
                } else {
                    248.0_f32
                }
                , 0.0_f32,))
    }
    viewport.push(viewport_status)
    ret viewport
}

fn viewport_reactive_target(target: str) -> bool {
    ret target == "viewport-camera" || target == "viewport-lit" || target == "viewport-speed" ||
    target == "camera-perspective" || target == "camera-top" || target == "camera-front" ||
    target == "camera-right" || target == "shading-lit" || target == "shading-unlit" ||
    target == "speed-025" || target == "speed-05" || target == "speed-1" ||
    target == "speed-2" || target == "speed-4" || target == "grid-toggle" ||
    target == "snap-toggle" || target == "tool-select" || target == "tool-move" ||
    target == "tool-rotate" || target == "tool-scale"
}

fn selection_reactive_target(target: str) -> bool {
    ret target == "entity-camera" || target == "entity-light" ||
    (target.contains("entity-cube-") && !target.contains("toggle-visible-")) ||
    target == "asset-cube" || target == "asset-material" || target == "asset-script" ||
    target.contains("asset-imported-mesh-")
}

fn scene_reactive_target(target: str) -> bool {
    ret target == "undo" || target == "redo" || target == "duplicate" ||
    target == "delete" || target == "menu-undo-action" ||
    target == "menu-redo-action" || target == "menu-duplicate-action" ||
    target == "menu-delete-action" || target == "add-actor-cube" ||
    target == "add-actor-plane" || target == "add-actor-sphere" ||
    target.contains("add-actor-imported-") || target.contains("toggle-visible-") ||
    target == "parent-none" || target.contains("parent-actor-")
}

fn details_reactive_target(target: str) -> bool {
    ret target == "entity-name" || target == "parent-selector" ||
    target == "parent-none" || target.contains("parent-actor-") ||
    target.contains("transform-") || target.contains("move-") ||
    target.contains("rotate-") || target.contains("scale-")
}

fn overlay_reactive_target(target: str) -> bool {
    ret target == "menu-file" || target == "menu-edit" || target == "menu-window" ||
    target == "menu-tools" || target == "menu-help" || target == "outliner-add" ||
    target == "outliner-settings" || target.contains("menu-") ||
    target.contains("unsaved-") || target.contains("approval-") || target.contains("project-") ||
    target.contains("file-picker") || target == "asset-import-confirm" ||
    target == "outliner-show-editor-actors" ||
    target == "outliner-show-hidden-actors" || target == "content-add"
}

fn pending_approval_id(approvals: ApprovalBroker) -> str {
    match approvals.pending() {
        Option::Some(request) => {
            ret request.id()
        }
        Option::None => {
        }
    }
    ret ""
}

fn overlay_visible(open_menu: str, add_actor_open: bool, outliner_settings_open: bool,
    project_dialog_mode: str, unsaved_action: str, hovered: str, approval_id: str,) -> bool {
    ret open_menu != "" || add_actor_open || outliner_settings_open ||
    project_dialog_mode != "" || unsaved_action != "" || tooltip_text(hovered) != "" ||
    approval_id != ""
}

fn workspace_structure_target(target: str) -> bool {
    ret target == "menu-outliner-action" || target == "menu-details-action" ||
    target == "menu-content-action"
}

fn viewport_bounds(layout: WidgetLayout) -> Rect {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret bounds
        }
        Option::None => {
            ret Rect::new(0.0_f32, 0.0_f32, 960.0_f32, 540.0_f32)
        }
    }
}

fn viewport_width(layout: WidgetLayout) -> u32 {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret if bounds.width() >= 64.0_f32 {
                bounds.width() as u32
            } else {
                64_u32
            }
        }
        Option::None => {
            ret 960_u32
        }
    }
}

fn viewport_height(layout: WidgetLayout) -> u32 {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret if bounds.height() >= 64.0_f32 {
                bounds.height() as u32
            } else {
                64_u32
            }
        }
        Option::None => {
            ret 540_u32
        }
    }
}

fn ui_cache_exclusions() -> Vec[str] {
    let mut targets = Vec[str]::new()
    targets.push("overlay-layer")
    targets.push("hover-tooltip")
    ret targets
}

fn viewport_pixel_x(layout: WidgetLayout, density: f32) -> u32 {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret(bounds.x() * density) as u32
        }
        Option::None => {
            ret 0_u32
        }
    }
}

fn viewport_pixel_y(layout: WidgetLayout, density: f32) -> u32 {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret(bounds.y() * density) as u32
        }
        Option::None => {
            ret 0_u32
        }
    }
}

fn viewport_point(layout: WidgetLayout, x: f32, y: f32) -> Option[(f32, f32)] {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            let local_x = x - bounds.x()
            let local_y = y - bounds.y()
            if local_x >= 0.0_f32 && local_y >= 0.0_f32 &&
            local_x < bounds.width() && local_y < bounds.height() {
                ret Option[(f32, f32)]::Some((local_x, local_y))
            }
        }
        Option::None => {
        }
    }
    ret Option[(f32, f32)]::None
}

fn gizmo_mode(tool: str) -> u32 {
    if tool == "move" {
        ret 1_u32
    }
    if tool == "rotate" {
        ret 2_u32
    }
    if tool == "scale" {
        ret 3_u32
    }
    ret 0_u32
}

fn position_at(positions: Vec[Vec3], cube_index: u32) -> Vec3 {
    if cube_index == 0_u32 {
        ret Vec3::zero()
    }
    match positions.get((cube_index - 1_u32) as usize) {
        Option::Some(position) => {
            ret position
        }
        Option::None => {
            ret Vec3::zero()
        }
    }
}

fn rotation_at(rotations: Vec[Vec3], cube_index: u32) -> Vec3 {
    if cube_index == 0_u32 {
        ret Vec3::zero()
    }
    match rotations.get((cube_index - 1_u32) as usize) {
        Option::Some(rotation) => {
            ret rotation
        }
        Option::None => {
            ret Vec3::zero()
        }
    }
}

fn copy_vec3_values(values: Vec[Vec3]) -> Vec[Vec3] {
    let mut result = Vec[Vec3]::new()
    for value in values {
        result.push(value)
    }
    ret result
}

fn scale_at(scales: Vec[Vec3], cube_index: u32) -> Vec3 {
    if cube_index == 0_u32 {
        ret Vec3::new(1.0_f32, 1.0_f32, 1.0_f32)
    }
    match scales.get((cube_index - 1_u32) as usize) {
        Option::Some(scale) => {
            ret scale
        }
        Option::None => {
            ret Vec3::new(1.0_f32, 1.0_f32, 1.0_f32)
        }
    }
}

fn mesh_name_at(mesh_names: Vec[str], cube_index: u32) -> str {
    if cube_index == 0_u32 {
        ret ""
    }
    match mesh_names.get((cube_index - 1_u32) as usize) {
        Option::Some(value) => {
            ret value
        }
        Option::None => {
        }
    }
    ret ""
}

fn bool_at(values: Vec[bool], index: u32, fallback: bool) -> bool {
    if index == 0_u32 {
        ret fallback
    }
    match values.get((index - 1_u32) as usize) {
        Option::Some(value) => {
            ret value
        }
        Option::None => {
        }
    }
    ret fallback
}

fn actor_name_at(actor_names: Vec[str], actor_index: u32) -> str {
    if actor_index == 0_u32 {
        ret ""
    }
    match actor_names.get((actor_index - 1_u32) as usize) {
        Option::Some(value) => {
            if value != "" {
                ret value
            }
        }
        Option::None => {
        }
    }
    ret "Actor " + Debug::fmt(actor_index)
}

fn actor_name_for_mesh(mesh_name: str, actor_index: u32) -> str {
    if mesh_name == "" {
        ret "Cube " + Debug::fmt(actor_index)
    }
    if mesh_name == "@plane" {
        ret "Plane " + Debug::fmt(actor_index)
    }
    if mesh_name == "@sphere" {
        ret "Sphere " + Debug::fmt(actor_index)
    }
    let mut base = mesh_name
    if base.byte_len() > 4_usize && base.slice(base.byte_len() - 4_usize, 4_usize) == ".obj" {
        base = base.slice(0_usize, base.byte_len() - 4_usize)
    }
    ret base + " " + Debug::fmt(actor_index)
}

fn actor_kind_for_mesh(mesh_name: str) -> str {
    if mesh_name == "" {
        ret "cube"
    }
    if mesh_name == "@plane" {
        ret "plane"
    }
    if mesh_name == "@sphere" {
        ret "sphere"
    }
    ret "mesh:" + mesh_name
}

fn mesh_display_name(mesh_name: str) -> str {
    if mesh_name == "" {
        ret "Cube"
    }
    if mesh_name == "@plane" {
        ret "Plane"
    }
    if mesh_name == "@sphere" {
        ret "Sphere"
    }
    ret mesh_name
}

fn resolve_actor_gpu_mesh(mesh_name: str, plane: MeshId, sphere: MeshId,
    imported: Vec[ImportedMeshAsset], uploaded: Vec[MeshId],) -> MeshId {
    if mesh_name == "@plane" {
        ret plane
    }
    if mesh_name == "@sphere" {
        ret sphere
    }
    let mut index = 0_usize
    while index < imported.len() {
        match imported.get(index) {
            Option::Some(asset) => {
                if asset.name() == mesh_name {
                    match uploaded.get(index) {
                        Option::Some(mesh) => {
                            ret mesh
                        }
                        Option::None => {
                        }
                    }
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret MeshId::new(0_u64)
}

fn create_viewport_renderer(window: Window, width: u32, height: u32) -> ViewportRenderer {
    let interop = window.vulkan_interop()
    if !interop.valid() {
        panic("Graphene Editor: Luma Vulkan interop is unavailable")
    }
    match ViewportRenderer::create_composed(interop.instance(), interop.physical_device(),
        interop.render_device(), interop.swapchain(),) {
        Option::Some(renderer) => {
            ret renderer
        }
        Option::None => {
            panic("Graphene Editor: unable to create composed Vulkan viewport")
            ret create_viewport_renderer(window, width, height)
        }
    }
}

fn transform_step_kind(target: str) -> str {
    if target == "move-x-minus" || target == "move-x-plus" || target == "move-y-minus" ||
    target == "move-y-plus" || target == "move-z-minus" || target == "move-z-plus" {
        ret "move"
    }
    if target == "rotate-x-minus" || target == "rotate-x-plus" || target == "rotate-y-minus" ||
    target == "rotate-y-plus" || target == "rotate-z-minus" || target == "rotate-z-plus" {
        ret "rotate"
    }
    if target == "scale-x-minus" || target == "scale-x-plus" || target == "scale-y-minus" ||
    target == "scale-y-plus" || target == "scale-z-minus" || target == "scale-z-plus" {
        ret "scale"
    }
    ret ""
}

fn stepped_vector(value: Vec3, target: str, amount: f32, minimum: f32) -> Vec3 {
    let signed = if target.contains("-minus") {
        0.0_f32 - amount
    } else {
        amount
    }
    let mut x = value.x() let mut y = value.y() let mut z = value.z()
    if target.contains("-x-") {
        x = x + signed
    } elif target.contains("-y-") {
        y = y + signed
    } elif target.contains("-z-") {
        z = z + signed
    }
    if minimum > 0.0_f32 {
        if x < minimum {
            x = minimum
        }
        if y < minimum {
            y = minimum
        }
        if z < minimum {
            z = minimum
        }
    }
    ret Vec3::new(x, y, z)
}

fn set_position(positions: Vec[Vec3], cube_index: u32, position: Vec3) -> Vec[Vec3] {
    let mut result = positions
    if cube_index > 0_u32 && cube_index <= result.len() as u32 {
        result.set((cube_index - 1_u32) as usize, position)
    }
    ret result
}

fn set_rotation(rotations: Vec[Vec3], cube_index: u32, rotation: Vec3) -> Vec[Vec3] {
    let mut result = rotations
    if cube_index > 0_u32 && cube_index <= result.len() as u32 {
        result.set((cube_index - 1_u32) as usize, rotation)
    }
    ret result
}

fn set_scale(scales: Vec[Vec3], cube_index: u32, scale: Vec3) -> Vec[Vec3] {
    let mut result = scales
    if cube_index > 0_u32 && cube_index <= result.len() as u32 {
        result.set((cube_index - 1_u32) as usize, scale)
    }
    ret result
}

fn rebuild_viewport_actors(renderer: mut ViewportRenderer, previous_count: u32, meshes: Vec[str],
    visibilities: Vec[bool], positions: Vec[Vec3], rotations: Vec[Vec3], scales: Vec[Vec3], plane: MeshId,
    sphere: MeshId,
    imported: Vec[ImportedMeshAsset], uploaded: Vec[MeshId], selected_actor: u32, ids: Vec[u64], parents:
    Vec[Option[u64]],) ->() {
    let mut remaining = previous_count
    while remaining > 0_u32 {
        renderer.remove_cube(1_u32) remaining = remaining - 1_u32
    }
    renderer.sync_cubes(positions.len() as u32)
    let mut index = 0_usize
    while index < positions.len() {
        let actor = index as u32 + 1_u32
        let mesh_name = mesh_name_at(meshes, actor)
        let mesh = resolve_actor_gpu_mesh(mesh_name, plane, sphere, imported, uploaded)
        if mesh.valid() {
            renderer.set_cube_mesh(actor, mesh)
        }
        renderer.set_cube_visible(actor, bool_at(visibilities, actor, true))
        index = index + 1_usize
    }
    renderer.sync_cube_transforms_hierarchical(positions, rotations, scales, actor_parent_indices(ids,
            parents,))
    renderer.select_cube(selected_actor)
    ret()
}

fn scene_asset(positions: Vec[Vec3], rotations: Vec[Vec3], scales: Vec[Vec3]) -> SceneAsset {
    ret scene_asset_with_meshes(positions, rotations, scales, Vec[str]::new(), Vec[str]::new(), Vec[bool]::new(),
        Vec[u64]::new(), Vec[Option[u64]]::new(),)
}

fn scene_asset_with_meshes(positions: Vec[Vec3], rotations: Vec[Vec3], scales: Vec[Vec3], actor_names:
    Vec[str],
    mesh_names: Vec[str], visibilities: Vec[bool], actor_ids: Vec[u64], parents: Vec[Option[u64]],) ->
SceneAsset {
    let mut asset = SceneAsset::new()
    let mut index = 0_usize
    while index < positions.len() {
        match positions.get(index) {
            Option::Some(position) => {
                let rotation = rotation_at(rotations, index as u32 + 1_u32)
                let scale = scale_at(scales, index as u32 + 1_u32)
                let mut mesh_name = ""
                match mesh_names.get(index) {
                    Option::Some(value) => {
                        mesh_name = value
                    }
                    Option::None => {
                    }
                }
                let kind = actor_kind_for_mesh(mesh_name)
                let fallback_name = actor_name_for_mesh(mesh_name, index as u32 + 1_u32)
                let name = match actor_names.get(index) {
                    Option::Some(value) => {
                        if value == "" {
                            fallback_name
                        } else {
                            value
                        }
                    }
                    Option::None => fallback_name
                }
                let actor_id = match actor_ids.get(index) {
                    Option::Some(value) => value Option::None => index as u64 + 1_u64
                }
                let parent = match parents.get(index) {
                    Option::Some(value) => value Option::None => Option[u64]::None
                }
                asset.add(SceneActor::new(name, kind,
                        Transform::identity().with_position(position).with_rotation(rotation).with_scale(scale),)
                    .with_identity(actor_id).with_parent(parent)
                    .with_visible(bool_at(visibilities, index as u32 + 1_u32, true)))
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret asset
}

fn save_editor_project(scene_path: str, script_path: str, positions: Vec[Vec3], rotations: Vec[Vec3],
    scales: Vec[Vec3], actor_names: Vec[str], mesh_names: Vec[str], visibilities: Vec[bool], actor_ids:
    Vec[u64],
    parents: Vec[Option[u64]], material_path: str, material: StandardMaterial, code: str,) -> bool {
    let scene_saved = write_file(scene_path, scene_asset_with_meshes(positions, rotations, scales, actor_names,
            mesh_names, visibilities,
            actor_ids, parents,).stringify() + "\n") == 0_i32
    if mkdir_all(parent_directory(material_path)) != 0_i32 {
        ret false
    }
    let material_saved = write_file(material_path, material_asset_stringify(material) + "\n") == 0_i32
    let script_saved = write_file(script_path, code) == 0_i32
    ret scene_saved && material_saved && script_saved
}

fn scene_actor_parents(scene: Scene, actor_ids: Vec[u64]) -> Vec[Option[u64]] {
    let mut parents = Vec[Option[u64]]::new()
    for id in actor_ids {
        match scene.get(id) {
            Option::Some(entity) => {
                parents.push(entity.parent())
            }
            Option::None => {
                parents.push(Option[u64]::None)
            }
        }
    }
    ret parents
}

fn actor_parent_indices(actor_ids: Vec[u64], parents: Vec[Option[u64]]) -> Vec[u32] {
    let mut indices = Vec[u32]::new()
    let mut index = 0_usize
    while index < actor_ids.len() {
        let parent = match parents.get(index) {
            Option::Some(value) => value Option::None => Option[u64]::None
        }
        match parent {
            Option::Some(parent_id) => {
                indices.push(actor_index_for_id(actor_ids, parent_id))
            }
            Option::None => {
                indices.push(0_u32)
            }
        }
        index = index + 1_usize
    }
    ret indices
}

fn actor_world_position(scene: Scene, actor_ids: Vec[u64], actor: u32, fallback: Vec3) -> Vec3 {
    if actor == 0_u32 {
        ret fallback
    }
    match actor_ids.get((actor - 1_u32) as usize) {
        Option::Some(id) => {
            match scene.world_position(id) {
                Option::Some(position) => {
                    ret position
                }
                Option::None => {
                }
            }
        }
        Option::None => {
        }
    }
    ret fallback
}

fn actor_local_position_for_world(scene: Scene, actor_ids: Vec[u64], actor: u32, world: Vec3, fallback:
    Vec3,) -> Vec3 {
    if actor == 0_u32 {
        ret fallback
    }
    match actor_ids.get((actor - 1_u32) as usize) {
        Option::Some(id) => {
            match scene.local_position_for_world(id, world) {
                Option::Some(position) => {
                    ret position
                }
                Option::None => {
                }
            }
        }
        Option::None => {
        }
    }
    ret fallback
}

fn parent_display_name(parent: Option[u64], actor_ids: Vec[u64], actor_names: Vec[str]) -> str {
    match parent {
        Option::Some(id) => {
            let index = actor_index_for_id(actor_ids, id)
            if index > 0_u32 {
                ret actor_name_at(actor_names, index)
            }
            ret "Missing Actor"
        }
        Option::None => {
            ret "None (World)"
        }
    }
}

fn parent_selector(selected_id: u64, selected_parent: Option[u64], actor_ids: Vec[u64], actor_names:
    Vec[str],
    open: bool, hovered: str, icons: EditorIcons,) -> Widget {
    let mut group = Widget::panel("parent-control").with_direction(vertical()).with_flex(if open {
            36.0_f32 +(actor_ids.len() as f32) * 24.0_f32
        } else {
            34.0_f32
        }
        , 0.0_f32,)
    .with_style(Style::default().with_gap(2.0_f32))
    let mut control = Widget::panel("parent-selector").with_direction(horizontal()).with_flex(32.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(if hovered == "parent-selector" {
                Color::rgb(43_u8, 44_u8, 49_u8)
            } else {
                Color::rgb(19_u8, 19_u8, 22_u8)
            }
        )
        .with_border(1.0_f32, if open {
                theme_accent()
            } else {
                Color::rgb(48_u8, 49_u8, 55_u8)
            }
            ,
        ).with_radius(2.0_f32)
        .with_padding(Insets::symmetric(4.0_f32, 7.0_f32)).with_gap(5.0_f32))
    control.push(Widget::label("Parent").with_flex(62.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(143_u8, 146_u8, 153_u8)).with_font_size(9.0_f32).with_pointer_events(false)))
    control.push(Widget::label(parent_display_name(selected_parent, actor_ids, actor_names)).with_flex(0.0_f32,
            1.0_f32,).with_style(
            Style::default().with_foreground(Color::rgb(216_u8, 218_u8, 222_u8)).with_font_size(10.0_f32).with_pointer_events(false)))
    control.push(Widget::icon("", icons.expanded).with_flex(14.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(139_u8, 142_u8, 149_u8)).with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
    group.push(control)
    if open {
        group.push(popup_action("parent-none", "None (World)", icons.level, hovered, false, selected_parent.is_none()))
        let mut index = 0_usize
        while index < actor_ids.len() {
            match actor_ids.get(index) {
                Option::Some(id) => {
                    if id != selected_id {
                        group.push(popup_action("parent-actor-" + Debug::fmt(index + 1_usize), actor_name_at(actor_names,
                                    index as u32 + 1_u32,),
                                icons.mesh, hovered, false, selected_parent == Option[u64]::Some(id),))
                    }
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
    }
    ret group
}

fn detail_row(name: str, value: str, accent: Color) -> Widget {
    let mut row = Widget::panel("detail-" + name).with_direction(horizontal()).with_flex(27.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(18_u8, 18_u8, 21_u8)).with_border(1.0_f32, Color::rgb(42_u8,
                43_u8, 48_u8,))
        .with_padding(Insets::symmetric(3.0_f32, 6.0_f32)).with_gap(5.0_f32))
    row.push(Widget::panel("").with_flex(2.0_f32, 0.0_f32).with_style(
            Style::default().with_background(accent).with_pointer_events(false)))
    row.push(Widget::label(name).with_flex(78.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(147_u8, 150_u8, 157_u8)).with_font_size(9.0_f32).with_pointer_events(false)))
    row.push(Widget::label(value).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(211_u8, 213_u8, 217_u8)).with_font_size(10.0_f32).with_pointer_events(false)))
    ret row
}

fn material_percent(value: f32) -> str {
    ret Debug::fmt((value * 100.0_f32 + 0.5_f32) as u32) + "%"
}

fn material_color_value(value: f32) -> u8 {
    if value <= 0.0_f32 {
        ret 0_u8
    }
    if value >= 1.0_f32 {
        ret 255_u8
    }
    ret(value * 255.0_f32) as u8
}

fn material_swatch(id: str, color: Vec3, selected: Vec3, hovered: str) -> Widget {
    let active = color.x() == selected.x() && color.y() == selected.y() && color.z() == selected.z()
    ret Widget::button(id, "").with_flex(42.0_f32, 1.0_f32).with_style(
        Style::default().with_background(Color::rgb(material_color_value(color.x()), material_color_value(color.y()),
                material_color_value(color.z()),))
        .with_border(if active {
                3.0_f32
            } else {
                if hovered == id {
                    2.0_f32
                } else {
                    1.0_f32
                }
            }
            ,
            if active {
                Color::rgb(223_u8, 226_u8, 231_u8)
            } else {
                Color::rgb(72_u8, 74_u8, 81_u8)
            }
            ,)
        .with_radius(3.0_f32).with_padding(Insets::all(2.0_f32)))
}

fn material_scalar_control(name: str, prefix: str, value: f32, hovered: str, icons: EditorIcons) -> Widget
{
    let mut row = Widget::panel("material-" + prefix + "-control").with_direction(horizontal()).with_flex(34.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(Color::rgb(18_u8, 18_u8, 21_u8)).with_border(1.0_f32, Color::rgb(43_u8,
                44_u8, 49_u8,))
        .with_radius(2.0_f32).with_padding(Insets::all(3.0_f32)).with_gap(3.0_f32))
    row.push(Widget::label(name).with_flex(82.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(154_u8, 157_u8, 164_u8)).with_font_size(9.0_f32).with_pointer_events(false)))
    row.push(Widget::icon_button("material-" + prefix + "-minus", "", icons.minus).with_flex(28.0_f32,
            0.0_f32,)
        .with_style(compact_icon_style(hovered == "material-" + prefix + "-minus")))
    row.push(Widget::label(material_percent(value)).with_flex(52.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(13_u8, 13_u8, 15_u8)).with_foreground(Color::rgb(222_u8,
                    224_u8, 228_u8,))
            .with_border(1.0_f32, Color::rgb(42_u8, 43_u8, 48_u8)).with_radius(2.0_f32).with_font_size(9.0_f32).with_pointer_events(false)))
    row.push(Widget::icon_button("material-" + prefix + "-plus", "", icons.add).with_flex(28.0_f32, 0.0_f32)
        .with_style(compact_icon_style(hovered == "material-" + prefix + "-plus")))
    ret row
}

fn material_inspector(material: StandardMaterial, hovered: str, icons: EditorIcons) -> Widget {
    let color = material.base_color()
    let mut panel = Widget::panel("details-panel").with_direction(vertical()).with_flex(292.0_f32, 0.0_f32).with_style(panel_style())
    panel.push(dock_header("DETAILS", "DEFAULT MATERIAL", 112.0_f32))
    let mut identity = Widget::panel("material-identity").with_direction(horizontal()).with_flex(38.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(Color::rgb(20_u8, 20_u8, 23_u8)).with_border(1.0_f32, Color::rgb(45_u8,
                46_u8, 51_u8,))
        .with_padding(Insets::all(4.0_f32)).with_gap(6.0_f32))
    identity.push(Widget::icon("", icons.material).with_flex(24.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(65_u8, 48_u8, 25_u8)).with_foreground(Color::rgb(224_u8,
                    176_u8, 91_u8,))
            .with_radius(2.0_f32).with_padding(Insets::all(4.0_f32)).with_pointer_events(false)))
    identity.push(Widget::label("Graphene Default").with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(222_u8, 224_u8, 228_u8)).with_font_size(10.0_f32).with_pointer_events(false)))
    identity.push(Widget::label("MATERIAL").with_flex(56.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(72_u8, 53_u8, 27_u8)).with_foreground(Color::rgb(224_u8,
                    183_u8, 108_u8,))
            .with_border(1.0_f32, Color::rgb(103_u8, 75_u8, 37_u8)).with_radius(2.0_f32).with_font_size(7.0_f32).with_pointer_events(false)))
    panel.push(identity)
    panel.push(section_title("BASE COLOR"))
    panel.push(Widget::panel("material-color-preview").with_flex(54.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(material_color_value(color.x()), material_color_value(color.y()),
                    material_color_value(color.z()),))
            .with_border(1.0_f32, Color::rgb(75_u8, 77_u8, 84_u8)).with_radius(3.0_f32)))
    let mut swatches = Widget::panel("material-color-presets").with_direction(horizontal()).with_flex(34.0_f32,
        0.0_f32,).with_style(
        Style::default().with_gap(5.0_f32))
    let mut preset_ids = Vec[str]::new()
    preset_ids.push("material-color-slate") preset_ids.push("material-color-ruby") preset_ids.push("material-color-jade")
    preset_ids.push("material-color-cobalt") preset_ids.push("material-color-gold")
    for id in preset_ids {
        swatches.push(material_swatch(id, material_preset_color(id), color, hovered))
    }
    panel.push(swatches)
    panel.push(section_title("SURFACE"))
    panel.push(material_scalar_control("Metallic", "metallic", material.metallic(), hovered, icons))
    panel.push(material_scalar_control("Roughness", "roughness", material.roughness(), hovered, icons))
    panel.push(popup_action("material-unlit", "Unlit", icons.lighting, hovered, false, material.unlit()))
    panel.push(Widget::button("material-reset", "Reset Material").with_flex(30.0_f32, 0.0_f32).with_style(
            control_style(false, hovered == "material-reset").with_font_size(9.0_f32)))
    panel.push(Widget::spacer(1.0_f32))
    ret panel
}

fn inspector(selected: str, name_editor: TextEditor, name_focused: bool, position: Vec3, rotation: Vec3,
    scale: Vec3,
    transform_field: str, transform_editor: TextEditor, transform_invalid: bool,
    cube_selected: bool, selected_id: u64, selected_parent: Option[u64], actor_ids: Vec[u64], actor_names:
    Vec[str],
    parent_menu_open: bool, selected_mesh_name: str, hovered: str, icons: EditorIcons,) -> Widget {
    let mut panel = Widget::panel("details-panel").with_direction(vertical()).with_flex(292.0_f32, 0.0_f32).with_style(panel_style())
    panel.push(dock_header("DETAILS", selected, 72.0_f32))
    let mut identity = Widget::panel("object-identity").with_direction(horizontal()).with_flex(38.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(Color::rgb(20_u8, 20_u8, 23_u8)).with_border(1.0_f32, Color::rgb(45_u8,
                46_u8, 51_u8,))
        .with_padding(Insets::all(4.0_f32)).with_gap(5.0_f32))
    identity.push(Widget::icon("", if cube_selected {
                icons.mesh
            } else {
                if selected == "Camera" {
                    icons.camera
                } else {
                    icons.light
                }
            }
            ,
        )
        .with_flex(24.0_f32, 0.0_f32).with_style(Style::default().with_background(Color::rgb(28_u8, 50_u8,
                    64_u8,))
            .with_foreground(Color::rgb(143_u8, 190_u8, 217_u8)).with_radius(2.0_f32).with_padding(Insets::all(4.0_f32)).with_pointer_events(false)))
    identity.push(Widget::input("entity-name", if name_focused {
                name_editor.value()
            } else {
                selected
            }
            ,
        ).with_flex(0.0_f32, 1.0_f32)
        .with_focus(name_focused).with_disabled(!cube_selected).with_style(
            Style::default().with_background(Color::rgb(15_u8, 15_u8, 17_u8)).with_foreground(Color::rgb(216_u8,
                    217_u8, 221_u8,))
            .with_border(1.0_f32, Color::rgb(48_u8, 49_u8, 54_u8)).with_radius(2.0_f32).with_padding(Insets::symmetric(4.0_f32,
                    7.0_f32,))))
    identity.push(Widget::label(if cube_selected {
                "ACTOR"
            } else {
                "SCENE"
            }
        ).with_flex(42.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(34_u8, 61_u8, 78_u8)).with_foreground(Color::rgb(167_u8,
                    207_u8, 229_u8,))
            .with_border(1.0_f32, Color::rgb(43_u8, 82_u8, 105_u8)).with_radius(2.0_f32).with_padding(Insets::symmetric(3.0_f32,
                    5.0_f32,))
            .with_font_size(8.0_f32).with_font_weight(700_u32).with_pointer_events(false)))
    panel.push(identity)
    if cube_selected {
        panel.push(section_title("HIERARCHY"))
        panel.push(parent_selector(selected_id, selected_parent, actor_ids, actor_names, parent_menu_open,
                hovered, icons,))
    }
    panel.push(section_title("TRANSFORM"))
    panel.push(transform_property("Location", "location", position, transform_field, transform_editor,
            transform_invalid, !cube_selected,))
    let mut location_tools = Widget::panel("location-tools").with_direction(horizontal()).with_flex(32.0_f32,
        0.0_f32,)
    .with_style(Style::default().with_gap(4.0_f32))
    location_tools.push(axis_stepper("X", "move-x-minus", "move-x-plus", icons, hovered, !cube_selected))
    location_tools.push(axis_stepper("Y", "move-y-minus", "move-y-plus", icons, hovered, !cube_selected))
    location_tools.push(axis_stepper("Z", "move-z-minus", "move-z-plus", icons, hovered, !cube_selected))
    panel.push(location_tools)
    panel.push(transform_property("Rotation", "rotation", rotation, transform_field, transform_editor,
            transform_invalid, !cube_selected,))
    let mut rotation_tools = Widget::panel("rotation-tools").with_direction(horizontal()).with_flex(32.0_f32,
        0.0_f32,)
    .with_style(Style::default().with_gap(4.0_f32))
    rotation_tools.push(axis_stepper("X", "rotate-x-minus", "rotate-x-plus", icons, hovered, !cube_selected))
    rotation_tools.push(axis_stepper("Y", "rotate-y-minus", "rotate-y-plus", icons, hovered, !cube_selected))
    rotation_tools.push(axis_stepper("Z", "rotate-z-minus", "rotate-z-plus", icons, hovered, !cube_selected))
    panel.push(rotation_tools)
    panel.push(transform_property("Scale", "scale", scale, transform_field, transform_editor, transform_invalid,
            !cube_selected,))
    let mut scale_tools = Widget::panel("scale-tools").with_direction(horizontal()).with_flex(32.0_f32,
        0.0_f32,)
    .with_style(Style::default().with_gap(4.0_f32))
    scale_tools.push(axis_stepper("X", "scale-x-minus", "scale-x-plus", icons, hovered, !cube_selected))
    scale_tools.push(axis_stepper("Y", "scale-y-minus", "scale-y-plus", icons, hovered, !cube_selected))
    scale_tools.push(axis_stepper("Z", "scale-z-minus", "scale-z-plus", icons, hovered, !cube_selected))
    panel.push(scale_tools)
    panel.push(Widget::separator())
    panel.push(section_title("STATIC MESH"))
    let has_mesh = cube_selected
    let mut mesh = Widget::panel("mesh-component").with_direction(vertical()).with_flex(72.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(19_u8, 19_u8, 22_u8)).with_border(1.0_f32, Color::rgb(45_u8,
                46_u8, 51_u8,))
        .with_radius(1.0_f32).with_padding(Insets::all(5.0_f32)).with_gap(3.0_f32))
    mesh.push(detail_row("Static Mesh", if has_mesh {
                mesh_display_name(selected_mesh_name)
            } else {
                "None"
            }
            , Color::rgb(83_u8, 143_u8, 178_u8),))
    mesh.push(detail_row("Material", if has_mesh {
                "Graphene Default"
            } else {
                "None"
            }
            , Color::rgb(180_u8, 132_u8, 63_u8),))
    panel.push(mesh)
    panel.push(Widget::spacer(1.0_f32))
    ret panel
}

fn asset_tile(id: str, name: str, kind: str, icon: SvgDocument, accent: Color, active: bool, hovered:
    str,) -> Widget {
    let background = if active {
        Color::rgb(32_u8, 52_u8, 65_u8)
    } else {
        interactive_background(hovered == id)
    }
    let border = if active {
        Color::rgb(49_u8, 112_u8, 151_u8)
    } else {
        interactive_border(hovered == id)
    }
    let mut tile = Widget::panel(id).with_direction(vertical()).with_flex(80.0_f32, 0.0_f32).with_style(
        Style::default().with_background(background).with_border(1.0_f32, border).with_radius(2.0_f32)
        .with_padding(Insets::all(4.0_f32)).with_gap(1.0_f32))
    tile.push(Widget::panel("").with_flex(2.0_f32, 0.0_f32).with_style(
            Style::default().with_background(if active {
                    theme_accent()
                } else {
                    background
                }
            ).with_radius(1.0_f32)
            .with_pointer_events(false)))
    tile.push(Widget::icon("", icon).with_flex(48.0_f32, 0.0_f32).with_style(
            Style::default().with_background(if active {
                    Color::rgb(22_u8, 32_u8, 39_u8)
                } else {
                    Color::rgb(20_u8, 20_u8, 23_u8)
                }
            ).with_foreground(accent)
            .with_radius(1.0_f32).with_padding(Insets::all(10.0_f32)).with_pointer_events(false)))
    tile.push(Widget::label(name).with_flex(18.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(218_u8, 220_u8, 224_u8)).with_font_size(9.0_f32)
            .with_font_weight(500_u32).with_pointer_events(false)))
    tile.push(Widget::label(kind).with_flex(15.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(132_u8, 135_u8, 143_u8)).with_font_size(8.0_f32)
            .with_pointer_events(false)))
    ret tile
}

fn content_browser(dragging: bool, selected_asset: str, imported_meshes: Vec[ImportedMeshAsset], search_editor:
    TextEditor,
    search_focused: bool, hovered: str, icons: EditorIcons,) -> Widget {
    let mut panel = Widget::panel("content-browser").with_direction(vertical()).with_flex(270.0_f32,
        0.0_f32,).with_style(panel_style())
    let mut tabs = Widget::panel("content-tabs").with_direction(horizontal()).with_flex(26.0_f32, 0.0_f32).with_style(
        Style::default().with_gap(2.0_f32))
    tabs.push(dock_tab("content-tab", "Content Browser", true))
    tabs.push(Widget::spacer(1.0_f32))
    tabs.push(dock_badge(Debug::fmt(3_usize + imported_meshes.len()) + " ASSETS", 64.0_f32))
    panel.push(tabs)
    let mut path = Widget::panel("content-path").with_direction(horizontal()).with_flex(28.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(19_u8, 19_u8, 22_u8)).with_border(1.0_f32, Color::rgb(43_u8,
                44_u8, 48_u8,))
        .with_padding(Insets::symmetric(3.0_f32, 5.0_f32)).with_gap(4.0_f32))
    path.push(Widget::icon_button("content-add", "Add", icons.add).with_flex(54.0_f32, 0.0_f32)
        .with_style(compact_icon_style(hovered == "content-add")))
    path.push(Widget::icon("content-folder", icons.folder).with_flex(17.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(197_u8, 157_u8, 72_u8)).with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
    path.push(Widget::label("Content").with_flex(48.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(202_u8, 204_u8, 209_u8)).with_font_size(10.0_f32).with_pointer_events(false)))
    path.push(Widget::icon("content-path-chevron", icons.chevron).with_flex(14.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(116_u8, 119_u8, 126_u8)).with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
    path.push(Widget::label("Game").with_flex(36.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(154_u8, 157_u8, 164_u8)).with_font_size(10.0_f32).with_pointer_events(false)))
    path.push(Widget::spacer(1.0_f32))
    panel.push(path)
    panel.push(editable_search_field("asset-search", search_editor, search_focused, "Search assets",
            icons.search, 30.0_f32, 0.0_f32,))
    let mut assets = Widget::panel("asset-grid").with_direction(horizontal()).with_flex(94.0_f32, 0.0_f32).with_style(
        Style::default().with_gap(5.0_f32).with_padding(Insets::symmetric(3.0_f32, 0.0_f32)))
    let query = search_editor.value()
    let mut visible_assets = 0_usize
    if content_asset_matches(query, "Cube", "Static Mesh") {
        assets.push(asset_tile("asset-cube", if dragging {
                    "Moving..."
                } else {
                    "Cube"
                }
                , "Static Mesh", icons.mesh,
                Color::rgb(145_u8, 179_u8, 201_u8), selected_asset == "asset-cube", hovered,))
        visible_assets = visible_assets + 1_usize
    }
    if content_asset_matches(query, "Default", "Material") {
        assets.push(asset_tile("asset-material", "Default", "Material", icons.material,
                Color::rgb(193_u8, 145_u8, 75_u8), selected_asset == "asset-material", hovered,))
        visible_assets = visible_assets + 1_usize
    }
    if content_asset_matches(query, "Player", "Encore Script") {
        assets.push(asset_tile("asset-script", "Player", "Encore Script", icons.script,
                Color::rgb(80_u8, 157_u8, 208_u8), selected_asset == "asset-script", hovered,))
        visible_assets = visible_assets + 1_usize
    }
    let mut mesh_index = 0_usize
    while mesh_index < imported_meshes.len() {
        match imported_meshes.get(mesh_index) {
            Option::Some(asset) => {
                let id = "asset-imported-mesh-" + mesh_index.fmt()
                if content_asset_matches(query, asset.name(), "Imported OBJ") {
                    assets.push(asset_tile(id, asset.name(), "Imported OBJ", icons.mesh,
                            Color::rgb(112_u8, 177_u8, 157_u8), selected_asset == id, hovered,))
                    visible_assets = visible_assets + 1_usize
                }
            }
            Option::None => {
            }
        }
        mesh_index = mesh_index + 1_usize
    }
    if visible_assets == 0_usize {
        assets.push(Widget::label("No assets match '" + query + "'").with_flex(0.0_f32, 1.0_f32).with_style(
                Style::default().with_foreground(Color::rgb(132_u8, 135_u8, 143_u8)).with_font_size(10.0_f32)
                .with_padding(Insets::symmetric(12.0_f32, 8.0_f32)).with_pointer_events(false)))
    }
    panel.push(assets)
    panel.push(Widget::spacer(1.0_f32))
    ret panel
}

fn code_line_numbers(text: str) -> str {
    let mut result = "1"
    let mut line = 1_usize
    let length = text.len()
    let mut index = 0_usize
    while index < length {
        match text.get_byte(index) {
            Option::Some(byte) => {
                if byte == 10_u8 && index + 1_usize < length {
                    line = line + 1_usize
                    result = result + "\n" + Debug::fmt(line)
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret result
}

fn code_cursor_location(text: str, cursor: usize) ->(usize, usize) {
    let mut line = 1_usize
    let mut column = 1_usize
    let mut byte_index = 0_usize
    let mut character_index = 0_usize
    let length = text.len()
    while character_index < cursor && byte_index < length {
        match text.get_byte(byte_index) {
            Option::Some(byte) => {
                // UTF-8 continuation bytes do not advance the editor's
                // character cursor. Newline is always the single byte LF.
                if byte < 128_u8 || byte >= 192_u8 {
                    if byte == 10_u8 {
                        line = line + 1_usize column = 1_usize
                    } else {
                        column = column + 1_usize
                    }
                    character_index = character_index + 1_usize
                }
            }
            Option::None => {
            }
        }
        byte_index = byte_index + 1_usize
    }
    ret(line, column)
}

fn code_panel(editor: TextEditor, focused: bool, icons: EditorIcons) -> Widget {
    let mut panel = Widget::panel("code-panel").with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(
        panel_style().with_overflow_hidden(true))
    let mut tabs = Widget::panel("code-tabs").with_direction(horizontal()).with_flex(28.0_f32, 0.0_f32).with_style(Style::default().with_gap(6.0_f32))
    tabs.push(active_icon_tab("code-tab", "player_controller.enq", icons.script, 176.0_f32))
    tabs.push(Widget::spacer(1.0_f32))
    tabs.push(dock_badge(if focused {
                "EDITING"
            } else {
                "ENCORE"
            }
            , 58.0_f32,))
    panel.push(tabs)
    let mut editor_surface = Widget::panel("code-surface").with_direction(horizontal()).with_flex(0.0_f32,
        1.0_f32,).with_style(
        Style::default().with_background(Color::rgb(13_u8, 13_u8, 15_u8)).with_border(1.0_f32,
            if focused {
                Color::rgb(31_u8, 116_u8, 170_u8)
            } else {
                Color::rgb(43_u8, 44_u8, 49_u8)
            }
            ,)
        .with_gap(0.0_f32).with_overflow_hidden(true))
    editor_surface.push(Widget::textarea("code-line-numbers", code_line_numbers(editor.value())).with_flex(34.0_f32,
            0.0_f32,).with_style(
            Style::default().with_background(Color::rgb(18_u8, 18_u8, 21_u8)).with_foreground(Color::rgb(92_u8,
                    96_u8, 104_u8,))
            .with_border(1.0_f32, Color::rgb(38_u8, 39_u8, 44_u8)).with_padding(Insets::symmetric(9.0_f32,
                    5.0_f32,))
            .with_font_family("Roboto Mono").with_font_size(11.0_f32).with_text_align(text_end())
            .with_overflow_hidden(true).with_pointer_events(false)))
    editor_surface.push(Widget::textarea("code-editor", editor.value()).with_focus(focused)
        .with_selection(editor.selection_start(), editor.selection_end()).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_background(Color::rgb(13_u8, 13_u8, 15_u8)).with_foreground(Color::rgb(214_u8,
                    215_u8, 220_u8,))
            .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32)
            .with_padding(Insets::all(9.0_f32)).with_font_family("Roboto Mono").with_font_size(11.0_f32)))
    panel.push(editor_surface)
    let location = code_cursor_location(editor.value(), editor.cursor())
    let mut editor_status = Widget::panel("code-status").with_direction(horizontal()).with_flex(20.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(Color::rgb(19_u8, 19_u8, 22_u8)).with_border(1.0_f32, Color::rgb(41_u8,
                42_u8, 47_u8,))
        .with_padding(Insets::symmetric(2.0_f32, 6.0_f32)).with_gap(10.0_f32))
    editor_status.push(Widget::label("Ln " + Debug::fmt(location.0) + ", Col " + Debug::fmt(location.1)).with_flex(92.0_f32,
            0.0_f32,).with_style(
            Style::default().with_foreground(Color::rgb(142_u8, 145_u8, 152_u8))
            .with_font_family("Roboto Mono").with_font_size(9.0_f32).with_pointer_events(false)))
    editor_status.push(Widget::spacer(1.0_f32))
    editor_status.push(Widget::label("Spaces: 4   UTF-8   LF").with_flex(120.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(121_u8, 124_u8, 131_u8))
            .with_font_family("Roboto Mono").with_font_size(9.0_f32).with_pointer_events(false)))
    panel.push(editor_status)
    ret panel
}

fn patch_reactive_editor(ui: mut ReactiveUi, id: str, editor: TextEditor, focused: bool) -> bool {
    match ui.layout().find_widget(id) {
        Option[Widget]::Some(widget) => {
            ret ui.patch_widget(id, widget.with_text(editor.value()).with_focus(focused)
                .with_selection(editor.selection_start(), editor.selection_end()),)
        }
        Option[Widget]::None => {
            ret false
        }
    }
}

fn patch_transform_display(ui: mut ReactiveUi, position: Vec3, rotation: Vec3,
    scale: Vec3,) -> bool {
    let displayed_rotation = rotation.scale(57.29578_f32)
    let mut patched = true
    patched = ui.patch_text("transform-location-x", transform_scalar(position.x())) && patched
    patched = ui.patch_text("transform-location-y", transform_scalar(position.y())) && patched
    patched = ui.patch_text("transform-location-z", transform_scalar(position.z())) && patched
    patched = ui.patch_text("transform-rotation-x", transform_scalar(displayed_rotation.x())) && patched
    patched = ui.patch_text("transform-rotation-y", transform_scalar(displayed_rotation.y())) && patched
    patched = ui.patch_text("transform-rotation-z", transform_scalar(displayed_rotation.z())) && patched
    patched = ui.patch_text("transform-scale-x", transform_scalar(scale.x())) && patched
    patched = ui.patch_text("transform-scale-y", transform_scalar(scale.y())) && patched
    patched = ui.patch_text("transform-scale-z", transform_scalar(scale.z())) && patched
    ret patched
}

fn hoverable_widget(widget: Widget) -> bool {
    let kind = widget.kind()
    ret kind == widget_button() || kind == widget_icon_button() ||
    kind == widget_icon_card() || kind == widget_input() ||
    kind == widget_textarea() || kind == widget_checkbox() ||
    kind == widget_radio() || kind == widget_switch() ||
    kind == widget_select() || kind == widget_slider() ||
    kind == widget_link() || kind == widget_color_picker() ||
    kind == widget_color_swatch() || kind == widget_color_channel() ||
    widget.id() == "parent-selector" || widget.id().contains("transform-") ||
    widget.id() == "viewport-surface"
}

fn tooltip_text(target: str) -> str {
    if target == "save" {
        ret "Save level (Ctrl+S)"
    }
    if target == "undo" {
        ret "Undo (Ctrl+Z)"
    }
    if target == "redo" {
        ret "Redo (Ctrl+Shift+Z)"
    }
    if target == "duplicate" {
        ret "Duplicate selected actor"
    }
    if target == "delete" {
        ret "Delete selected actor"
    }
    if target == "build-game" {
        ret "Build gameplay project"
    }
    if target == "play" {
        ret "Play in editor"
    }
    if target == "stop" {
        ret "Stop simulation"
    }
    if target == "simulate" {
        ret "Simulate world"
    }
    if target == "viewport-camera" {
        ret "Perspective camera"
    }
    if target == "viewport-lit" {
        ret "Lit view mode"
    }
    if target == "viewport-speed" {
        ret "Camera movement speed"
    }
    if target == "grid-toggle" {
        ret "Toggle editor grid"
    }
    if target == "snap-toggle" {
        ret "Toggle 10 degree rotation snapping"
    }
    if target == "tool-select" {
        ret "Select tool (Q)"
    }
    if target == "tool-move" {
        ret "Move tool (W)"
    }
    if target == "tool-rotate" {
        ret "Rotate tool (E)"
    }
    if target == "tool-scale" {
        ret "Scale tool (R)"
    }
    if target == "outliner-add" {
        ret "Add actor"
    }
    if target == "outliner-settings" {
        ret "Outliner settings"
    }
    if target == "content-add" {
        ret "Add or import content"
    }
    ret ""
}

fn tooltip(text: str, pointer_x: f32, pointer_y: f32, view_width: f32, view_height: f32) -> Widget {
    let left = if pointer_x + 192.0_f32 > view_width {
        pointer_x - 190.0_f32
    } else {
        pointer_x + 12.0_f32
    }
    let top = if pointer_y + 44.0_f32 > view_height {
        pointer_y - 34.0_f32
    } else {
        pointer_y + 18.0_f32
    }
    ret Widget::label(text).with_id("hover-tooltip").with_flex(180.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(24_u8, 24_u8, 27_u8)).with_foreground(Color::rgb(224_u8,
                225_u8, 229_u8,))
        .with_border(1.0_f32, Color::rgb(68_u8, 70_u8, 76_u8)).with_radius(2.0_f32)
        .with_padding(Insets::symmetric(5.0_f32, 8.0_f32)).with_font_size(10.0_f32)
        .with_width(180.0_f32).with_height(26.0_f32).with_absolute(true).with_left(left).with_top(top)
        .with_z_index(100_i32).with_pointer_events(false))
}

fn overlay_layer(open_menu: str, add_actor_open: bool, outliner_settings_open: bool,
    project_dialog_mode: str, unsaved_action: str, project_loaded: bool, project_dirty: bool,
    can_undo: bool, can_redo: bool, selected_cube: u32, simulating: bool, building: bool,
    show_outliner: bool, show_details: bool, show_content: bool,
    outliner_show_editor_actors: bool, outliner_show_hidden_actors: bool,
    imported_meshes: Vec[ImportedMeshAsset], hovered: str, pointer_x: f32, pointer_y: f32,
    project_path_editor: TextEditor, project_path_focused: bool, project_error: str,
    asset_picker: FilePicker, approvals: ApprovalBroker, view_width: f32, view_height: f32,
    icons: EditorIcons,) -> Widget {
    let mut layer = Widget::panel("overlay-layer").with_style(
        Style::default().with_absolute(true).with_left(0.0_f32).with_top(0.0_f32)
        .with_width(view_width).with_height(view_height).with_z_index(80_i32)
        .with_pointer_events(false))
    if open_menu != "" {
        layer.push(menu_popup(open_menu, hovered, project_loaded, project_dirty, can_undo, can_redo,
                selected_cube, simulating, building, show_outliner, show_details, show_content, icons,))
    }
    if add_actor_open && show_outliner && project_loaded && !simulating {
        layer.push(add_actor_popup(imported_meshes, hovered, icons))
    }
    if outliner_settings_open && show_outliner {
        layer.push(outliner_settings_popup(outliner_show_editor_actors, outliner_show_hidden_actors,
                hovered, icons,))
    }
    if project_dialog_mode == "import" {
        layer.push(asset_import_dialog(asset_picker, project_error, view_width, view_height, icons))
    } elif project_dialog_mode != "" {
        layer.push(project_dialog(project_dialog_mode, project_path_editor, project_path_focused,
                project_error, view_width, view_height,))
    }
    if unsaved_action != "" {
        layer.push(unsaved_changes_dialog(unsaved_action, view_width, view_height, icons))
    }
    match approvals.pending() {
        Option::Some(request) => {
            layer.push(approval_dialog(request, view_width, view_height))
        }
        Option::None => {
        }
    }
    let hint = tooltip_text(hovered)
    if hint != "" {
        layer.push(tooltip(hint, pointer_x, pointer_y, view_width, view_height))
    }
    ret layer
}

fn editor_menu_bar(open_menu: str, hovered: str, project_loaded: bool,
    project_root: str, icons: EditorIcons,) -> Widget {
    let mut menu = Widget::panel("menu-bar").with_direction(horizontal())
    .with_flex(25.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(15_u8, 15_u8, 17_u8))
        .with_border(1.0_f32, Color::rgb(38_u8, 39_u8, 43_u8))
        .with_padding(Insets::symmetric(3.0_f32, 8.0_f32)).with_gap(8.0_f32))
    menu.push(Widget::icon("graphene-mark", icons.brand).with_flex(18.0_f32, 0.0_f32)
        .with_style(Style::default().with_foreground(Color::rgb(42_u8, 147_u8, 210_u8))
            .with_padding(Insets::all(2.0_f32))))
    menu.push(Widget::label("GRAPHENE").with_flex(72.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(232_u8, 233_u8, 236_u8))
            .with_font_size(10.0_f32).with_font_weight(700_u32)))
    menu.push(menu_item("menu-file", "File",
            if open_menu == "menu-file" {
                "menu-file"
            } else {
                hovered
            }
            ,))
    menu.push(menu_item("menu-edit", "Edit",
            if open_menu == "menu-edit" {
                "menu-edit"
            } else {
                hovered
            }
            ,))
    menu.push(menu_item("menu-window", "Window",
            if open_menu == "menu-window" {
                "menu-window"
            } else {
                hovered
            }
            ,))
    menu.push(menu_item("menu-tools", "Tools",
            if open_menu == "menu-tools" {
                "menu-tools"
            } else {
                hovered
            }
            ,))
    menu.push(menu_item("menu-help", "Help",
            if open_menu == "menu-help" {
                "menu-help"
            } else {
                hovered
            }
            ,))
    menu.push(Widget::spacer(1.0_f32))
    menu.push(Widget::label(if project_loaded {
                project_root + " / scene.graphene.json"
            } else {
                "No Project"
            }
        ).with_flex(280.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(137_u8, 140_u8, 147_u8))
            .with_font_size(10.0_f32)))
    ret menu
}

fn editor_toolbar(simulation_mode: str, project_loaded: bool, project_dirty: bool,
    can_undo: bool, can_redo: bool, selected_cube: u32, building: bool,
    hovered: str, icons: EditorIcons,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut toolbar = Widget::panel("toolbar").with_direction(horizontal())
    .with_flex(42.0_f32, 0.0_f32).with_style(
        panel_style().with_background(Color::rgb(21_u8, 21_u8, 24_u8))
        .with_padding(Insets::symmetric(4.0_f32, 7.0_f32)).with_gap(5.0_f32))
    let mut history_tools = toolbar_action_group(104.0_f32)
    history_tools.push(Widget::icon_button("save", "", icons.save)
        .with_flex(33.0_f32, 1.0_f32)
        .with_disabled(!project_loaded || !project_dirty || simulating)
        .with_style(segmented_icon_style(false, hovered == "save")))
    history_tools.push(Widget::icon_button("undo", "", icons.undo)
        .with_flex(33.0_f32, 1.0_f32).with_disabled(!can_undo)
        .with_style(segmented_icon_style(false, hovered == "undo")))
    history_tools.push(Widget::icon_button("redo", "", icons.redo)
        .with_flex(33.0_f32, 1.0_f32).with_disabled(!can_redo)
        .with_style(segmented_icon_style(false, hovered == "redo")))
    toolbar.push(history_tools)
    toolbar.push(toolbar_divider())
    let mut actor_tools = toolbar_action_group(69.0_f32)
    actor_tools.push(Widget::icon_button("duplicate", "", icons.duplicate)
        .with_flex(33.0_f32, 1.0_f32)
        .with_disabled(selected_cube == 0_u32 || simulating)
        .with_style(segmented_icon_style(false, hovered == "duplicate")))
    actor_tools.push(Widget::icon_button("delete", "", icons.delete)
        .with_flex(33.0_f32, 1.0_f32)
        .with_disabled(selected_cube == 0_u32 || simulating)
        .with_style(segmented_icon_style(false, hovered == "delete")))
    toolbar.push(actor_tools)
    toolbar.push(toolbar_divider())
    toolbar.push(Widget::icon_button("build-game",
            if building {
                "Building..."
            } else {
                "Build"
            }
            , icons.build,)
        .with_flex(88.0_f32, 0.0_f32)
        .with_disabled(!project_loaded || building || simulating)
        .with_style(build_style(building, hovered == "build-game")))
    toolbar.push(Widget::spacer(1.0_f32))
    toolbar.push(Widget::icon_button(if simulating {
                "stop"
            } else {
                "play"
            }
            ,
            if simulating {
                "Stop"
            } else {
                "Play"
            }
            , icons.play,)
        .with_flex(76.0_f32, 0.0_f32).with_disabled(!project_loaded)
        .with_style(play_style(simulating,
                hovered == if simulating {
                    "stop"
                } else {
                    "play"
                }
                ,)))
    toolbar.push(Widget::icon_button("simulate", "Simulate", icons.play)
        .with_flex(88.0_f32, 0.0_f32).with_disabled(!project_loaded || simulating)
        .with_style(play_style(false, hovered == "simulate")))
    toolbar.push(Widget::spacer(1.0_f32))
    toolbar.push(Widget::label("Linux  |  Vulkan").with_flex(94.0_f32, 0.0_f32)
        .with_style(Style::default().with_background(Color::rgb(29_u8, 30_u8, 34_u8))
            .with_foreground(Color::rgb(164_u8, 167_u8, 174_u8))
            .with_border(1.0_f32, Color::rgb(46_u8, 47_u8, 52_u8))
            .with_radius(2.0_f32).with_padding(Insets::symmetric(4.0_f32, 7.0_f32))
            .with_font_size(10.0_f32)))
    ret toolbar
}

fn workspace_tabs(project_dirty: bool, icons: EditorIcons) -> Widget {
    let mut tabs = Widget::panel("workspace-tabs").with_direction(horizontal())
    .with_flex(28.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(16_u8, 16_u8, 19_u8))
        .with_border(1.0_f32, Color::rgb(39_u8, 40_u8, 45_u8))
        .with_padding(Insets::symmetric(2.0_f32, 6.0_f32)).with_gap(4.0_f32))
    tabs.push(active_icon_tab("level-tab",
            "scene.graphene.json" + if project_dirty {
                "  *"
            } else {
                ""
            }
            ,
            icons.level, 196.0_f32,))
    tabs.push(Widget::spacer(1.0_f32))
    tabs.push(Widget::label("LEVEL EDITOR").with_flex(78.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(105_u8, 108_u8, 115_u8))
            .with_font_size(8.0_f32).with_font_weight(700_u32).with_pointer_events(false)))
    ret tabs
}

fn status_bar(simulation_mode: str, building: bool, status_message: str,
    project_loaded: bool, project_dirty: bool, object_count: u32,
    icons: EditorIcons,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut status = Widget::panel("status").with_direction(horizontal())
    .with_flex(23.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(18_u8, 18_u8, 21_u8))
        .with_border(1.0_f32, Color::rgb(42_u8, 43_u8, 47_u8))
        .with_padding(Insets::symmetric(3.0_f32, 8.0_f32)))
    status.push(status_segment(if building {
                "BUILDING"
            } else {
                if simulating {
                    simulation_mode_label(simulation_mode)
                } else {
                    "READY"
                }
            }
            , if building {
                icons.build
            } else {
                if simulating {
                    icons.play
                } else {
                    icons.clean
                }
            }
            ,
            if building {
                Color::rgb(205_u8, 154_u8, 70_u8)
            } else {
                if simulating {
                    Color::rgb(81_u8, 181_u8, 113_u8)
                } else {
                    Color::rgb(81_u8, 157_u8, 203_u8)
                }
            }
            , 92.0_f32, building || simulating,))
    status.push(Widget::label(status_message).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(163_u8, 166_u8, 173_u8))
            .with_font_size(10.0_f32)))
    status.push(Widget::spacer(1.0_f32))
    status.push(status_segment(if !project_loaded {
                "No Project"
            } else {
                if project_dirty {
                    "Unsaved"
                } else {
                    "Saved"
                }
            }
            , if project_dirty {
                icons.save
            } else {
                icons.clean
            }
            ,
            if project_dirty {
                Color::rgb(209_u8, 157_u8, 72_u8)
            } else {
                Color::rgb(79_u8, 169_u8, 106_u8)
            }
            , 82.0_f32, false,))
    status.push(status_segment("Source Control", icons.branch,
            Color::rgb(132_u8, 164_u8, 185_u8), 108.0_f32, false,))
    status.push(status_segment("Vulkan", icons.processor,
            Color::rgb(99_u8, 166_u8, 207_u8), 72.0_f32, false,))
    status.push(status_segment("Shaders 2", icons.storage,
            Color::rgb(155_u8, 158_u8, 165_u8), 78.0_f32, false,))
    status.push(label("Actors " + Debug::fmt(object_count)).with_flex(68.0_f32, 0.0_f32))
    ret status
}

fn upper_workspace(simulation_mode: str, selected: str, selected_position: Vec3,
    selected_rotation: Vec3, selected_scale: Vec3, selected_cube: u32,
    selected_mesh_name: str, actor_ids: Vec[u64], actor_parents: Vec[Option[u64]],
    actor_names: Vec[str], actor_visibilities: Vec[bool], name_editor: TextEditor,
    name_focused: bool, parent_menu_open: bool, transform_field: str,
    transform_editor: TextEditor, transform_invalid: bool, outliner_search: TextEditor,
    outliner_search_focused: bool, selected_asset: str, default_material: StandardMaterial,
    object_count: u32, dragging: bool, active_tool: str, camera_mode: str,
    shading_mode: str, camera_speed: str, grid_visible: bool, rotation_snap: bool,
    open_viewport_menu: str, hovered: str, compact: bool,
    outliner_show_editor_actors: bool, outliner_show_hidden_actors: bool,
    show_outliner: bool, show_details: bool, icons: EditorIcons,) -> Widget {
    let mut upper = Widget::panel("upper").with_direction(horizontal())
    .with_flex(0.0_f32, 4.0_f32).with_style(Style::default().with_gap(1.0_f32))
    if show_outliner {
        upper.push(hierarchy(selected, actor_ids, actor_parents, actor_names,
                actor_visibilities, object_count, outliner_search, outliner_search_focused,
                outliner_show_editor_actors, outliner_show_hidden_actors, hovered, icons,))
    }
    upper.push(viewport(simulation_mode, dragging, object_count, selected, active_tool,
            camera_mode, shading_mode, camera_speed, grid_visible, rotation_snap,
            open_viewport_menu, hovered, compact, icons,))
    let selected_id = match actor_ids.get(if selected_cube > 0_u32 {
            (selected_cube - 1_u32) as usize
        } else {
            actor_ids.len()
        }
    ) {
        Option::Some(id) => id
        Option::None => 0_u64
    }
    let selected_parent = match actor_parents.get(if selected_cube > 0_u32 {
            (selected_cube - 1_u32) as usize
        } else {
            actor_parents.len()
        }
    ) {
        Option::Some(parent) => parent
        Option::None => Option[u64]::None
    }
    if show_details {
        if selected_asset == "asset-material" {
            upper.push(material_inspector(default_material, hovered, icons))
        } else {
            upper.push(inspector(selected, name_editor, name_focused, selected_position,
                    selected_rotation, selected_scale, transform_field, transform_editor,
                    transform_invalid, selected_cube > 0_u32, selected_id, selected_parent,
                    actor_ids, actor_names, parent_menu_open, selected_mesh_name, hovered, icons,))
        }
    }
    ret upper
}

fn lower_workspace(simulation_mode: str, building: bool, status_message: str,
    build_output: str, dragging: bool, selected_asset: str,
    imported_meshes: Vec[ImportedMeshAsset], asset_search: TextEditor,
    asset_search_focused: bool, code_editor: TextEditor, code_focused: bool,
    console_editor: TextEditor, console_focused: bool, console_output: str,
    hovered: str, show_content: bool, icons: EditorIcons,) -> Widget {
    let mut lower = Widget::panel("lower").with_direction(horizontal())
    .with_flex(0.0_f32, 1.55_f32).with_style(Style::default().with_gap(1.0_f32))
    if show_content {
        lower.push(content_browser(dragging, selected_asset, imported_meshes,
                asset_search, asset_search_focused, hovered, icons,))
    }
    lower.push(code_panel(code_editor, code_focused, icons))
    lower.push(output_panel(simulation_mode, building, status_message, build_output,
            console_editor, console_focused, console_output, icons,))
    ret lower
}

fn editor_view(simulation_mode: str, selected: str, selected_position: Vec3, selected_rotation: Vec3,
    selected_scale: Vec3,
    selected_cube: u32, selected_mesh_name: str, actor_ids: Vec[u64], actor_parents: Vec[Option[u64]],
    actor_names: Vec[str], actor_visibilities: Vec[bool],
    name_editor: TextEditor, name_focused: bool, parent_menu_open: bool,
    transform_field: str, transform_editor: TextEditor, transform_invalid: bool,
    outliner_search: TextEditor, outliner_search_focused: bool,
    asset_search: TextEditor, asset_search_focused: bool,
    dragging: bool, selected_asset: str, default_material: StandardMaterial, imported_meshes: Vec[ImportedMeshAsset],
    object_count: u32, code_editor: TextEditor,
    code_focused: bool, console_editor: TextEditor, console_focused: bool,
    console_output: str, status_message: str, project_loaded: bool,
    project_dirty: bool, active_tool: str, camera_mode: str, shading_mode: str, camera_speed: str,
    grid_visible: bool, rotation_snap: bool,
    can_undo: bool, can_redo: bool,
    building: bool, build_output: str, hovered: str,
    pointer_x: f32, pointer_y: f32, compact: bool, open_menu: str, add_actor_open: bool, outliner_settings_open:
    bool,
    outliner_show_editor_actors: bool, outliner_show_hidden_actors: bool, show_outliner: bool, show_details:
    bool,
    show_content: bool, open_viewport_menu: str, project_root: str, project_dialog_mode: str, unsaved_action:
    str,
    project_path_editor: TextEditor, project_path_focused: bool, project_error: str, asset_picker: FilePicker,
    approvals: ApprovalBroker, view_width: f32, view_height: f32, icons: EditorIcons,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut root = Widget::panel("root").with_direction(vertical()).with_style(
        Style::default().with_background(Color::rgb(13_u8, 13_u8, 15_u8)).with_foreground(Color::rgb(202_u8,
                204_u8, 209_u8,))
        .with_font_family("Roboto").with_font_size(11.0_f32).with_gap(1.0_f32))
    let mut part_started = perf_counter_ms()
    let menu_bar = editor_menu_bar(open_menu, hovered, project_loaded, project_root, icons)
    profile_view_part("menu", part_started)
    root.push(menu_bar)
    part_started = perf_counter_ms()
    let toolbar = editor_toolbar(simulation_mode, project_loaded, project_dirty,
        can_undo, can_redo, selected_cube, building, hovered, icons,)
    profile_view_part("toolbar", part_started)
    root.push(toolbar)

    part_started = perf_counter_ms()
    let tabs = workspace_tabs(project_dirty, icons)
    profile_view_part("tabs", part_started)
    root.push(tabs)

    part_started = perf_counter_ms()
    let upper = upper_workspace(simulation_mode, selected, selected_position,
            selected_rotation, selected_scale, selected_cube, selected_mesh_name,
            actor_ids, actor_parents, actor_names, actor_visibilities, name_editor,
            name_focused, parent_menu_open, transform_field, transform_editor,
            transform_invalid, outliner_search, outliner_search_focused, selected_asset,
            default_material, object_count, dragging, active_tool, camera_mode, shading_mode,
            camera_speed, grid_visible, rotation_snap, open_viewport_menu, hovered, compact,
            outliner_show_editor_actors, outliner_show_hidden_actors, show_outliner,
            show_details, icons,)
    profile_view_part("upper workspace", part_started)
    root.push(upper)
    part_started = perf_counter_ms()
    let lower = lower_workspace(simulation_mode, building, status_message, build_output,
            dragging, selected_asset, imported_meshes, asset_search, asset_search_focused,
            code_editor, code_focused, console_editor, console_focused, console_output,
            hovered, show_content, icons,)
    profile_view_part("lower workspace", part_started)
    root.push(lower)

    part_started = perf_counter_ms()
    let status = status_bar(simulation_mode, building, status_message,
            project_loaded, project_dirty, object_count, icons,)
    profile_view_part("status", part_started)
    root.push(status)
    part_started = perf_counter_ms()
    let overlays = overlay_layer(open_menu, add_actor_open, outliner_settings_open, project_dialog_mode,
            unsaved_action, project_loaded, project_dirty, can_undo, can_redo, selected_cube, simulating,
            building, show_outliner, show_details, show_content, outliner_show_editor_actors,
            outliner_show_hidden_actors, imported_meshes, hovered, pointer_x, pointer_y,
            project_path_editor, project_path_focused, project_error, asset_picker,
            approvals, view_width, view_height, icons,)
    profile_view_part("overlays", part_started)
    root.push(overlays)
    ret root
}

fn profile_view_part(name: str, started: u64) ->() {
    if env("GRAPHENE_PROFILE").is_some() {
        println("Graphene profile: view " + name + " " +
            Debug::fmt(perf_counter_ms() - started) + " ms")
    }
    ret()
}

fn main() -> u32 {
    let startup_started = perf_counter_ms()
    let profiling = env("GRAPHENE_PROFILE").is_some()
    let import_project = requested_import_project()
    if import_project != "" {
        if !project_valid(project_paths(import_project)) {
            println("Graphene: invalid project: " + import_project)
            ret 1_u32
        }
        let import_source = requested_import_source()
        match import_obj_asset(import_project, import_source) {
            Result::Ok(asset) => {
                println("Imported " + asset.name() + " to " + asset.project_path()) ret 0_u32
            }
            Result::Err(message) => {
                println("Graphene: " + message) ret 1_u32
            }
        }
    }
    let new_project = requested_new_project_path()
    if new_project != "" {
        if !create_project_with_template(new_project, requested_project_template()) {
            println("Graphene: unable to create project at " + new_project)
            ret 1_u32
        }
        remember_project(new_project)
    }
    let requested_project = requested_project_path()
    let mut startup_project = Option[str]::None
    if new_project != "" {
        startup_project = Option[str]::Some(new_project)
    } elif requested_project != "" && project_valid(project_paths(requested_project)) {
        remember_project(requested_project)
        startup_project = Option[str]::Some(requested_project)
    } else {
        startup_project = launch_project_browser()
    }
    let mut project_at_startup = ""
    match startup_project {
        Option::Some(path) => {
            project_at_startup = path
        }
        Option::None => {
        }
    }
    if project_at_startup == "" {
        ret 0_u32
    }
    let window = Window::create_with_renderer("Graphene Editor", 1440_u32, 900_u32,
        RendererKind::DirectVulkan,)
    .with_background(Color::rgb(13_u8, 13_u8, 15_u8))
    if !window.available() {
        println("Graphene Editor: unable to create " + backend_name() + " window: " + backend_error())
        ret 1_u32
    }
    let mut font_manager = FontManager::with_bundled("../Luma/assets/fonts")
    font_manager.register_all(window)
    font_manager = font_manager.activate(window, "Roboto", 12.0_f32, 400_u32)
    if font_manager.error() != "" {
        println("Graphene Editor: unable to activate Roboto: " + font_manager.error())
    }
    if profiling {
        println("Graphene profile: window and fonts " +
            Debug::fmt(perf_counter_ms() - startup_started) + " ms")
    }
    // Reveal one complete, inexpensive startup frame while the retained
    // editor tree and Vulkan viewport are prepared. Luma keeps the mapped
    // Wayland surface transparent until this first application present.
    if window.begin(Color::rgb(13_u8, 13_u8, 15_u8)) {
        let _accent = window.fill_rect(Rect::new(0.0_f32, 0.0_f32,
                window.width() as f32, 3.0_f32,), Color::rgb(36_u8, 165_u8, 245_u8),)
        let _brand = window.text(32.0_f32, 34.0_f32, "GRAPHENE",
            Color::rgb(232_u8, 237_u8, 243_u8),)
        let _loading = window.text(32.0_f32, 62.0_f32, "Loading editor...",
            Color::rgb(125_u8, 134_u8, 145_u8),)
        let _startup_presented = window.present()
    }
    if profiling {
        println("Graphene profile: startup frame " +
            Debug::fmt(perf_counter_ms() - startup_started) + " ms")
    }
    let icon_load_started = perf_counter_ms()
    let icon_manager = IconManager::with_lazy_bundled("../Luma/assets/icons")
    let icons = EditorIcons::load(icon_manager)
    if profiling {
        println("Graphene profile: icons " +
            Debug::fmt(perf_counter_ms() - icon_load_started) + " ms")
    }
    let mut simulation_mode = match env("GRAPHENE_SIMULATION_MODE") {
        Option::Some(mode) => {
            normalize_simulation_mode(mode)
        }
        Option::None => {
            if env("GRAPHENE_AUTOPLAY").is_some() {
                "play"
            } else {
                ""
            }
        }
    }
    let mut simulating = simulation_mode_active(simulation_mode)
    if simulating && !window.set_present_mode(PresentMode::Immediate) {
        println("Graphene Editor: unable to enable immediate presentation: " +
            backend_error())
    }
    let mut selected = "Cube 1"
    let mut selected_cube = 1_u32
    let mut dragging = false
    let mut selected_asset = match env("GRAPHENE_SELECTED_ASSET") {
        Option::Some(name) => {
            if name == "material" {
                "asset-material"
            } elif name == "script" {
                "asset-script"
            } else {
                "asset-cube"
            }
        }
        Option::None => {
            "asset-cube"
        }
    }
    let mut project_root = project_at_startup
    let mut paths = project_paths(project_root)
    let mut imported_meshes = discover_obj_assets(project_root)
    let mut scene_path = paths.scene
    let mut material_path = paths.material
    let mut default_material = if file_exists(material_path) {
        match material_asset_parse(read_file(material_path)) {
            Option::Some(material) => material Option::None => StandardMaterial::editor_default()
        }
    } else {
        StandardMaterial::editor_default()
    }
    let mut status_message = if project_valid(paths) {
        "Loading project " + project_root
    } else {
        "No project loaded"
    }
    let mut editor_scene = Scene::new()
    let mut cube_entities = Vec[u64]::new()
    let mut cube_positions = Vec[Vec3]::new()
    let mut cube_rotations = Vec[Vec3]::new()
    let mut cube_scales = Vec[Vec3]::new()
    let mut actor_names = Vec[str]::new()
    let mut actor_visibilities = Vec[bool]::new()
    let mut cube_mesh_names = Vec[str]::new()
    let mut render_rotations = Vec[Vec3]::new()
    let mut scene_loaded = false
    if file_exists(scene_path) {
        match SceneAsset::parse(read_file(scene_path)) {
            Option::Some(asset) => {
                let mut actor_index = 0_usize
                while actor_index < asset.len() {
                    match asset.actor(actor_index) {
                        Option::Some(actor) => {
                            match actor_mesh_name(actor.kind()) {
                                Option::Some(mesh_name) => {
                                    let transform = actor.transform()
                                    let actor_name = if actor.name() == "" {
                                        actor_name_for_mesh(mesh_name, cube_entities.len() as u32 + 1_u32)
                                    } else {
                                        actor.name()
                                    }
                                    let entity = actor.id()
                                    editor_scene.create_entity_with_id(entity, actor_name, transform)
                                    editor_scene.set_renderable(entity,
                                        Option[Renderable]::Some(Renderable::new(MeshId::new(1_u64),
                                                MaterialId::new(1_u64),)),)
                                    cube_entities.push(entity)
                                    cube_positions.push(transform.position())
                                    cube_rotations.push(transform.rotation())
                                    cube_scales.push(transform.scale())
                                    actor_names.push(actor_name)
                                    actor_visibilities.push(actor.visible())
                                    cube_mesh_names.push(mesh_name)
                                    editor_scene.set_visible(entity, actor.visible())
                                    render_rotations.push(transform.rotation())
                                }
                                Option::None => {
                                }
                            }
                        }
                        Option::None => {
                        }
                    }
                    actor_index = actor_index + 1_usize
                }
                let mut parent_index = 0_usize
                while parent_index < asset.len() {
                    match asset.actor(parent_index) {
                        Option::Some(actor) => {
                            editor_scene.set_parent(actor.id(), actor.parent())
                        }
                        Option::None => {
                        }
                    }
                    parent_index = parent_index + 1_usize
                }
                scene_loaded = true
                status_message = "Loaded " + scene_path
            }
            Option::None => {
                status_message = "Unable to parse " + scene_path
            }
        }
    }
    editor_scene.create_entity("Camera", Transform::identity().with_position(Vec3::new(0.0_f32, 2.0_f32,
                6.0_f32,)))
    editor_scene.create_entity("Directional Light", Transform::identity().with_rotation(Vec3::new( -
                0.7_f32, - 0.4_f32, 0.0_f32,)))
    let mut object_count = cube_entities.len() as u32
    let mut project_loaded = project_valid(paths) && scene_loaded
    selected_cube = if object_count > 0_u32 {
        1_u32
    } else {
        0_u32
    }
    selected = if selected_cube > 0_u32 {
        actor_name_at(actor_names, selected_cube)
    } else {
        "Camera"
    }
    let mut command_state = EditorState::with_assets(editor_scene, cube_entities, cube_mesh_names)
    command_state.configure_project(project_loaded)
    if simulating {
        let started = command_state.execute(GrapheneCommand::StartSimulation(
                SimulationCommand::new(simulation_mode)))
        if !started.success() {
            simulation_mode = ""
            simulating = false
            status_message = started.message()
        }
    }
    if selected_cube > 0_u32 {
        match cube_entities.get(0_usize) {
            Option::Some(actor) => {
                let _selected = command_state.execute(GrapheneCommand::Select(
                        ActorSelectionCommand::new(Option[u64]::Some(actor))))
            }
            Option::None => {
            }
        }
    }
    mkdir_all(home_dir() + "/.graphene")
    let requested_automation_endpoint = match env("GRAPHENE_AUTOMATION_ENDPOINT") {
        Option::Some(value) => {
            value
        }
        Option::None => {
            home_dir() + "/.graphene/automation.sock"
        }
    }
    let automation_token = match env("GRAPHENE_AUTOMATION_TOKEN") {
        Option::Some(value) => {
            value
        }
        Option::None => {
            automation_capability_token()
        }
    }
    let automation_endpoint = if automation_token == "" {
        ""
    } else {
        requested_automation_endpoint
    }
    let automation_scopes = if env("GRAPHENE_AUTOMATION_READ_ONLY").is_some() {
        AutomationScopes::read_only()
    } else {
        AutomationScopes::all()
    }
    let mut approval_broker = ApprovalBroker::new()
    let automation_listener = AutomationListener::listen(automation_endpoint)
    let automation_discovery_path = home_dir() + "/.graphene/automation.json"
    if !automation_listener.available() {
        println("Graphene Automation API: " + automation_listener.error())
        if file_exists(automation_discovery_path) {
            remove_file(automation_discovery_path)
        }
    } else {
        let mut discovery_fields = Vec[(str, Json)]::new()
        discovery_fields.push(field("endpoint", Json::String(automation_endpoint)))
        discovery_fields.push(field("token", Json::String(automation_token)))
        discovery_fields.push(field("protocol", Json::Number("1")))
        let mut scope_values = Vec[Json]::new()
        for scope in automation_scopes.names() {
            scope_values.push(Json::String(scope))
        }
        discovery_fields.push(field("scopes", Json::Array(scope_values)))
        if write_file(automation_discovery_path, stringify(Json::Object(discovery_fields)) + "\n") !=
        0_i32 ||
        !automation_secure_file(automation_discovery_path) {
            println("Graphene Automation API: unable to write secure discovery file")
        }
    }
    let mut actor_name_editor = TextEditor::new(selected)
    let mut actor_name_focused = false
    let mut actor_name_before_edit = selected
    let mut transform_field = ""
    let mut transform_editor = TextEditor::new("")
    let mut transform_invalid = false
    let mut outliner_search = TextEditor::new("")
    let mut outliner_search_focused = false
    let mut asset_search = TextEditor::new("")
    let mut asset_search_focused = false
    let mut simulation_started = perf_counter_ms()
    let mut code_focused = false
    let mut active_tool = "move"
    let mut camera_mode = match env("GRAPHENE_CAMERA_MODE") {
        Option::Some(mode) => {
            if mode == "top" || mode == "front" || mode == "right" {
                mode
            } else {
                "perspective"
            }
        }
        Option::None => {
            "perspective"
        }
    }
    let mut shading_mode = match env("GRAPHENE_SHADING_MODE") {
        Option::Some(mode) => {
            if mode == "unlit" {
                "unlit"
            } else {
                "lit"
            }
        }
        Option::None => {
            "lit"
        }
    }
    let mut camera_speed = match env("GRAPHENE_CAMERA_SPEED") {
        Option::Some(mode) => {
            if mode == "0.25" || mode == "0.5" || mode == "2" || mode == "4" {
                mode
            } else {
                "1"
            }
        }
        Option::None => {
            "1"
        }
    }
    let mut grid_visible = match env("GRAPHENE_GRID_VISIBLE") {
        Option::Some(value) => {
            value != "0" && value != "false"
        }
        Option::None => {
            true
        }
    }
    let mut rotation_snap = match env("GRAPHENE_ROTATION_SNAP") {
        Option::Some(value) => {
            value != "0" && value != "false"
        }
        Option::None => {
            true
        }
    }
    let mut transform_editing = false
    let mut edit_start_position = Vec3::zero()
    let mut edit_start_rotation = Vec3::zero()
    let mut edit_start_scale = Vec3::new(1.0_f32, 1.0_f32, 1.0_f32)
    let mut script_path = paths.script
    let mut game_manifest = paths.manifest
    let mut build_log_path = paths.build_log
    let mut build_completion_path = paths.build_completion
    let compiler = match env("ENCORE_COMPILER") {
        Option::Some(path) => {
            path
        }
        Option::None => {
            "encore"
        }
    }
    let mut code_editor = TextEditor::new(if project_loaded && file_exists(script_path) {
            read_file(script_path)
        } else {
            ""
        }
    )
    let mut console_editor = TextEditor::new("scene.rename {\"actor\":1,\"name\":\"Player\"}")
    let mut console_focused = false
    let mut text_selection_target = ""
    let mut console_output = console_help()
    let mut project_dirty = false
    let mut building = false
    let mut build_output = "Gameplay project has not been built"
    let mut build_handle = Option[JoinHandle[i32]]::None
    let mut autobuild_pending = env("GRAPHENE_AUTOBUILD").is_some()
    let mut hovered = match env("GRAPHENE_HOVER_TARGET") {
        Option::Some(target) => {
            target
        }
        Option::None => {
            ""
        }
    }
    let mut pointer_x = 0.0_f32
    let mut pointer_y = 0.0_f32
    let mut compact = window.width() < 1200_u32
    let mut open_menu = match env("GRAPHENE_OPEN_MENU") {
        Option::Some(name) => {
            if name == "file" || name == "edit" || name == "window" || name == "tools" || name == "help"
            {
                "menu-" + name
            } else {
                ""
            }
        }
        Option::None => {
            ""
        }
    }
    let mut add_actor_open = match env("GRAPHENE_OPEN_ADD_ACTOR") {
        Option::Some(value) => {
            value != "0" && value != "false"
        }
        Option::None => {
            false
        }
    }
    let mut outliner_settings_open = match env("GRAPHENE_OPEN_OUTLINER_SETTINGS") {
        Option::Some(value) => {
            value != "0" && value != "false"
        }
        Option::None => {
            false
        }
    }
    let mut outliner_show_editor_actors = match env("GRAPHENE_SHOW_EDITOR_ACTORS") {
        Option::Some(value) => {
            value != "0" && value != "false"
        }
        Option::None => {
            true
        }
    }
    let mut outliner_show_hidden_actors = match env("GRAPHENE_SHOW_HIDDEN_ACTORS") {
        Option::Some(value) => {
            value != "0" && value != "false"
        }
        Option::None => {
            true
        }
    }
    let mut show_outliner = true
    let mut show_details = true
    let mut show_content = true
    let mut open_viewport_menu = match env("GRAPHENE_OPEN_VIEWPORT_MENU") {
        Option::Some(menu) => {
            if menu == "camera" || menu == "shading" || menu == "speed" {
                menu
            } else {
                ""
            }
        }
        Option::None => {
            ""
        }
    }
    let mut project_dialog_mode = if project_loaded {
        ""
    } else {
        "open"
    }
    let mut unsaved_action = ""
    let mut action_after_save = ""
    let mut project_path_editor = TextEditor::new(project_root)
    let mut project_path_focused = project_dialog_mode != ""
    let mut project_error = ""
    let mut asset_picker = FilePicker::new(home_dir())
    let mut parent_menu_open = false
    compact = window.width() < 1200_u32
    let initial_view_started = perf_counter_ms()
    let initial_view = editor_view(simulation_mode, selected, position_at(cube_positions, selected_cube),
        rotation_at(render_rotations, selected_cube), scale_at(cube_scales, selected_cube), selected_cube,
        mesh_name_at(cube_mesh_names, selected_cube),
        cube_entities, scene_actor_parents(editor_scene, cube_entities), actor_names, actor_visibilities,
        actor_name_editor, actor_name_focused, parent_menu_open, transform_field, transform_editor, transform_invalid,
        outliner_search, outliner_search_focused,
        asset_search, asset_search_focused, dragging,
        selected_asset, default_material, imported_meshes, object_count, code_editor, code_focused,
        console_editor, console_focused, console_output, status_message, project_loaded,
        project_dirty, active_tool, camera_mode,
        shading_mode, camera_speed, grid_visible, rotation_snap,
        false, false, building, build_output, hovered,
        pointer_x, pointer_y, compact, open_menu, add_actor_open, outliner_settings_open,
        outliner_show_editor_actors, outliner_show_hidden_actors, show_outliner, show_details, show_content,
        open_viewport_menu, project_root, project_dialog_mode, unsaved_action, project_path_editor, project_path_focused,
        project_error, asset_picker,
        approval_broker, window.width() as f32, window.height() as f32, icons,)
    let initial_view_finished = perf_counter_ms()
    let mut layout = window.layout(initial_view)
    let mut reactive_ui = ReactiveUi::new(layout)
    let mut hovered_base = Option[Widget]::None
    if profiling {
        println("Graphene profile: initial UI view " + Debug::fmt(initial_view_finished - initial_view_started)
            +
            " ms, layout " + Debug::fmt(perf_counter_ms() - initial_view_finished) + " ms")
    }
    let initial_prepared = window.prepare_frame(layout, false)
    let mut render_width = 64_u32
    let mut render_height = 64_u32
    match initial_prepared.surface("viewport-surface") {
        Option::Some(slot) => {
            render_width = slot.pixel_width()
            render_height = slot.pixel_height()
        }
        Option::None => {
            panic("Graphene Editor: Luma did not prepare the viewport surface")
        }
    }
    let mut viewport_renderer = create_viewport_renderer(window,
        render_width, render_height,)
    viewport_renderer.set_default_material(default_material)
    let plane_gpu_mesh = viewport_renderer.upload_mesh(plane_mesh(2.0_f32))
    let sphere_gpu_mesh = viewport_renderer.upload_mesh(sphere_mesh(0.6_f32, 20_u32, 32_u32))
    let mut imported_gpu_meshes = Vec[MeshId]::new()
    for asset in imported_meshes {
        imported_gpu_meshes.push(viewport_renderer.upload_mesh(asset.mesh()))
    }
    let mut camera_yaw = if camera_mode == "front" {
        1.5707963_f32
    } else {
        if camera_mode == "perspective" {
            0.64_f32
        } else {
            0.0_f32
        }
    }
    let mut camera_pitch = if camera_mode == "top" {
        1.35_f32
    } else {
        if camera_mode == "perspective" {
            0.42_f32
        } else {
            0.0_f32
        }
    }
    let mut camera_distance = 5.7_f32
    let mut camera_target = Vec3::zero()
    let mut editor_camera_yaw = camera_yaw
    let mut editor_camera_pitch = camera_pitch
    let mut editor_camera_distance = camera_distance
    let mut editor_camera_target = camera_target
    if simulation_mode_is_play(simulation_mode) {
        camera_yaw = 0.0_f32
        camera_pitch = 0.32175055_f32
        camera_distance = 6.3245554_f32
        camera_target = Vec3::zero()
    }
    let mut viewport_focused = false
    let mut orbiting = false
    let mut panning = false
    let mut orbit_x = 0.0_f32
    let mut orbit_y = 0.0_f32
    let mut moving_cube = false
    let mut move_offset = Vec3::zero()
    let mut rotate_drag_y = 0.0_f32
    let mut profile_frames = 0_u64
    let mut profile_render_ms = 0_u64
    let mut profile_scene_ms = 0_u64
    let mut profile_compose_ms = 0_u64
    let mut profile_sample_started = perf_counter_ms()
    let initial_cache_started = perf_counter_ms()
    let initial_cache_frame = window.prepare_frame(layout, true)
        .with_overlays(ui_cache_exclusions(), Vec[WidgetLayout]::new(), false)
    let mut layout_cached = window.cache_prepared_frame(initial_cache_frame)
    if profiling {
        println("Graphene profile: initial UI cache " + Debug::fmt(perf_counter_ms() - initial_cache_started)
            + " ms")
    }
    if !layout_cached {
        println("Graphene Editor: unable to cache UI layout: " + backend_error())
    }
    let mut first_frame_drawn = false
    let mut overlay_cache_ready = false
    viewport_renderer.set_shading_mode(if shading_mode == "unlit" {
            1_u32
        } else {
            0_u32
        }
    )
    viewport_renderer.set_grid_visible(grid_visible && !simulation_mode_is_play(simulation_mode))
    viewport_renderer.set_gizmo_mode(if simulation_mode_is_play(simulation_mode) {
            0_u32
        } else {
            gizmo_mode(active_tool)
        }
    )
    viewport_renderer.sync_cubes(object_count)
    let mut initial_mesh_index = 0_usize
    while initial_mesh_index < cube_mesh_names.len() {
        match cube_mesh_names.get(initial_mesh_index) {
            Option::Some(mesh_name) => {
                let mesh = resolve_actor_gpu_mesh(mesh_name, plane_gpu_mesh, sphere_gpu_mesh, imported_meshes,
                    imported_gpu_meshes,)
                if mesh.valid() {
                    viewport_renderer.set_cube_mesh(initial_mesh_index as u32 + 1_u32, mesh)
                }
            }
            Option::None => {
            }
        }
        viewport_renderer.set_cube_visible(initial_mesh_index as u32 + 1_u32,
            bool_at(actor_visibilities, initial_mesh_index as u32 + 1_u32, true),)
        initial_mesh_index = initial_mesh_index + 1_usize
    }
    viewport_renderer.select_cube(if simulation_mode_is_play(simulation_mode) {
            0_u32
        } else {
            selected_cube
        }
    )
    viewport_renderer.sync_cube_transforms_hierarchical(cube_positions, render_rotations, cube_scales,
        actor_parent_indices(cube_entities, scene_actor_parents(editor_scene, cube_entities)),)
    let mut external_overlays = Vec[str]::new()
    let mut external_overlay_layouts = Vec[WidgetLayout]::new()
    if overlay_visible(open_menu, add_actor_open, outliner_settings_open,
        project_dialog_mode, unsaved_action, hovered,
        pending_approval_id(approval_broker),) {
        external_overlays.push("overlay-layer")
        match reactive_ui.find_layout("overlay-layer") {
            Option::Some(overlay) => {
                external_overlay_layouts.push(overlay)
            }
            Option::None => {
            }
        }
    }
    if external_overlay_layouts.len() > 0_usize {
        overlay_cache_ready = window.cache_overlay_layouts(external_overlay_layouts)
    }
    let initial_frame = window.prepare_frame(layout, layout_cached)
        .with_overlays(external_overlays, external_overlay_layouts,
            overlay_cache_ready && external_overlays.len() > 0_usize,)
    match initial_frame.surface("viewport-surface") {
        Option::Some(slot) => {
            let borrowed = window.begin_vulkan_frame(initial_frame)
            let recorded = borrowed.valid() &&
                viewport_renderer.record_camera_at(borrowed.frame(), borrowed.slot(),
                    slot.pixel_x(), slot.pixel_y(), slot.pixel_width(), slot.pixel_height(),
                    camera_yaw, camera_pitch, camera_distance, camera_target,)
            if borrowed.valid() {
                let presented = window.present_vulkan_frame(borrowed)
                first_frame_drawn = recorded && presented
            }
        }
        Option::None => {
        }
    }
    if !first_frame_drawn {
        println("Graphene Editor: unable to draw first frame using " + backend_name() + ": " + backend_error())
        window.destroy()
        ret 2_u32
    }
    if profiling {
        println("Graphene profile: complete editor " +
            Debug::fmt(perf_counter_ms() - startup_started) + " ms")
    }
    let mut redraw_pending = false
    while window.is_open() {
        let event = if simulating || redraw_pending {
            window.poll()
        } else {
            // SDL wakes this wait immediately for input. The short build
            // timeout is only for observing an asynchronous compiler worker.
            window.wait(if building {
                    16_u32
                } else {
                    if automation_listener.available() {
                        32_u32
                    } else {
                        250_u32
                    }
                }
            )
        }
        let event_started = perf_counter_ms()
        let previous_open_menu = open_menu
        let previous_project_root = project_root
        let previous_project_loaded = project_loaded
        let previous_project_dirty = project_dirty
        let previous_building = building
        let previous_simulation_mode = simulation_mode
        let previous_selected_cube = selected_cube
        let previous_selected = selected
        let previous_selected_asset = selected_asset
        let previous_dragging = dragging
        let previous_status_message = status_message
        let previous_object_count = object_count
        let previous_command_can_undo = command_state.can_undo()
        let previous_command_can_redo = command_state.can_redo()
        let previous_approval_id = pending_approval_id(approval_broker)
        let resize_changed = event.kind() == event_resize() &&
        (layout.bounds().width() != window.width() as f32 ||
            layout.bounds().height() != window.height() as f32)
        let mut dirty = event.kind() == event_resize() || redraw_pending
        let save_pending_before_request = command_state.save_pending()
        let building_before_request = command_state.building()
        let automation_request = automation_listener.poll()
        if automation_request != "" {
            dirty = true
            let revision_before_request = command_state.revision()
            let simulation_before_request = command_state.simulation_mode()
            let mut automation = AutomationServer::with_security(
                command_state, automation_token, automation_scopes, approval_broker,)
            let response = automation.handle(automation_request)
            let automation_parts = automation.into_parts()
            command_state = automation_parts.0
            approval_broker = automation_parts.1
            let _responded = automation_listener.respond(response)
            if command_state.revision() != revision_before_request {
                let previous_actor_count = object_count
                editor_scene = command_state.scene()
                let projection = editor_actors_from_scene(editor_scene, cube_entities, cube_mesh_names)
                cube_entities = projection.ids()
                actor_names = projection.names()
                cube_mesh_names = command_state.asset_names(cube_entities)
                actor_visibilities = projection.visibilities()
                cube_positions = projection.positions()
                cube_rotations = projection.rotations()
                cube_scales = projection.scales()
                render_rotations = cube_rotations
                object_count = cube_entities.len() as u32
                selected_cube = match command_state.selection() {
                    Option::Some(actor) => {
                        actor_index_for_id(cube_entities, actor)
                    }
                    Option::None => {
                        0_u32
                    }
                }
                selected = if selected_cube > 0_u32 {
                    actor_name_at(actor_names, selected_cube)
                } else {
                    "Camera"
                }
                rebuild_viewport_actors(viewport_renderer, previous_actor_count, cube_mesh_names,
                    actor_visibilities, cube_positions, render_rotations, cube_scales,
                    plane_gpu_mesh, sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,
                    selected_cube, cube_entities, scene_actor_parents(editor_scene, cube_entities),)
                project_dirty = command_state.dirty()
                dirty = true
            }
            if command_state.simulation_mode() != simulation_before_request {
                simulation_mode = command_state.simulation_mode()
                simulating = simulation_mode_active(simulation_mode)
                dragging = false
                moving_cube = false
                orbiting = false
                panning = false
                open_viewport_menu = ""
                if simulating {
                    simulation_started = perf_counter_ms()
                    if simulation_mode_is_play(simulation_mode) {
                        editor_camera_yaw = camera_yaw
                        editor_camera_pitch = camera_pitch
                        editor_camera_distance = camera_distance
                        editor_camera_target = camera_target
                        camera_yaw = 0.0_f32
                        camera_pitch = 0.32175055_f32
                        camera_distance = 6.3245554_f32
                        camera_target = Vec3::zero()
                    }
                    status_message = if simulation_mode_is_play(simulation_mode) {
                        "Play in editor started"
                    } else {
                        "Editor simulation started"
                    }
                } else {
                    if simulation_mode_is_play(simulation_before_request) {
                        camera_yaw = editor_camera_yaw
                        camera_pitch = editor_camera_pitch
                        camera_distance = editor_camera_distance
                        camera_target = editor_camera_target
                    }
                    render_rotations = copy_vec3_values(cube_rotations)
                    viewport_focused = false
                    status_message = "Simulation stopped"
                }
                dirty = true
            }
        }
        let automation_requested_save = !save_pending_before_request &&
        command_state.save_pending()
        let automation_requested_build = !building_before_request &&
        command_state.building()
        let previous_code_focused = code_focused
        let previous_console_focused = console_focused
        let previous_console_output = console_output
        let previous_outliner_search_focused = outliner_search_focused
        let previous_asset_search_focused = asset_search_focused
        let previous_unsaved_action = unsaved_action
        let previous_add_actor_open = add_actor_open
        let previous_outliner_settings_open = outliner_settings_open
        let previous_project_dialog_mode = project_dialog_mode
        let previous_parent_menu_open = parent_menu_open
        let previous_open_viewport_menu = open_viewport_menu
        let retrying_redraw = redraw_pending
        let was_transform_editing = transform_editing
        if event.kind() == event_close() {
            let guarded = guard_editor_action("exit", project_dirty)
            if action_needs_confirmation(guarded) {
                unsaved_action = guarded_action(guarded)
                viewport_focused = false code_focused = false actor_name_focused = false outliner_search_focused
                = false
                moving_cube = false orbiting = false panning = false transform_editing = false
                redraw_pending = true
            } else {
                break
            }
        }
        let mut layout_dirty = resize_changed
        let mut hover_only = false
        // An expose event with unchanged logical dimensions only needs the
        // retained frame to be presented again; reflowing the whole editor
        // costs almost a second in debug builds and changes no geometry.
        let mut reactive_only = event.kind() == event_resize() && !resize_changed
        let mut viewport_only = retrying_redraw
        let mut request_undo = false
        let mut request_redo = false
        let mut request_duplicate = false
        let mut request_delete = false
        let mut request_save = automation_requested_save
        let mut request_build = autobuild_pending || automation_requested_build
        let mut request_exit = false
        let mut request_stop = false
        let mut event_target = ""
        let actor_name_was_focused = actor_name_focused
        let transform_was_active = transform_field != ""
        autobuild_pending = false
        redraw_pending = false
        if event.kind() == event_pointer_move() {
            if event.x() != pointer_x || event.y() != pointer_y {
                pointer_x = event.x()
                pointer_y = event.y()
                let hover_hit = reactive_ui.hit(event.x(), event.y())
                let next_hovered = match reactive_ui.find_widget(hover_hit) {
                    Option::Some(widget) => {
                        if hoverable_widget(widget) {
                            hover_hit
                        } else {
                            ""
                        }
                    }
                    Option::None => {
                        ""
                    }
                }
                if next_hovered != hovered {
                    match hovered_base {
                        Option[Widget]::Some(original) => {
                            let _restored = reactive_ui.restore_widget(hovered, original)
                        }
                        Option[Widget]::None => {
                        }
                    }
                    hovered = next_hovered
                    hovered_base = if hovered == "" {
                        Option[Widget]::None
                    } else {
                        reactive_ui.find_widget(hovered)
                    }
                    match hovered_base {
                        Option[Widget]::Some(widget) => {
                            let width = if widget.style().border_width() > 0.0_f32 {
                                widget.style().border_width()
                            } else {
                                1.0_f32
                            }
                            let _highlighted = reactive_ui.patch_style(hovered,
                                widget.style().with_border(width, theme_accent()),)
                        }
                        Option[Widget]::None => {
                        }
                    }
                    layout = reactive_ui.layout()
                    dirty = reactive_ui.is_dirty()
                    reactive_only = dirty
                    let next_overlay = overlay_layer(open_menu, add_actor_open, outliner_settings_open,
                        project_dialog_mode, unsaved_action, project_loaded, project_dirty,
                        command_state.can_undo(), command_state.can_redo(), selected_cube,
                        simulating, building, show_outliner, show_details, show_content,
                        outliner_show_editor_actors, outliner_show_hidden_actors, imported_meshes,
                        hovered, pointer_x, pointer_y, project_path_editor, project_path_focused,
                        project_error, asset_picker, approval_broker, window.width() as f32,
                        window.height() as f32, icons,)
                    if reactive_ui.replace_subtree("overlay-layer", next_overlay) {
                        layout = reactive_ui.layout()
                    }
                }
            }
        }
        if building && file_exists(build_completion_path) {
            let mut build_succeeded = false
            match build_handle {
                Option::Some(handle) => {
                    let code = handle.join()
                    build_succeeded = code == 0_i32
                    build_output = if code == 0_i32 {
                        "Gameplay build succeeded"
                    } else {
                        "Gameplay build failed; see " + build_log_path
                    }
                    status_message = build_output
                }
                Option::None => {
                    build_output = "Gameplay build worker was lost"
                }
            }
            let _completed = command_state.execute(GrapheneCommand::CompleteBuild(
                    OperationCompletionCommand::new(build_succeeded, build_output)))
            build_handle = Option[JoinHandle[i32]]::None
            building = command_state.building()
            remove_file(build_completion_path)
            dirty = true
        }
        if event.kind() == event_pointer_down() {
            let target = reactive_ui.hit(event.x(), event.y())
            event_target = target
            text_selection_target = if target == "code-editor" ||
                target == "command-console" {
                target
            } else {
                ""
            }
            if target == "approval-approve" || target == "approval-deny" {
                match approval_broker.pending() {
                    Option::Some(request) => {
                        let resolved = if target == "approval-approve" {
                            approval_broker.approve(request.id())
                        } else {
                            approval_broker.deny(request.id())
                        }
                        if resolved {
                            status_message = if target == "approval-approve" {
                                "Allowed once: " + request.method()
                            } else {
                                "Denied: " + request.method()
                            }
                            dirty = true
                        }
                    }
                    Option::None => {
                    }
                }
            }
            if actor_name_focused && target != "entity-name" && command_state.interactive_active() {
                let committed = command_state.commit_interactive()
                if committed.success() {
                    editor_scene = command_state.scene()
                    project_dirty = command_state.dirty()
                } else {
                    status_message = committed.message()
                }
            }
            let viewport_location = viewport_point(layout, event.x(), event.y())
            viewport_focused = viewport_location.is_some() && project_dialog_mode == "" && unsaved_action
            == ""
            let clicked_transform = transform_input_target(target)
            if clicked_transform != "" && selected_cube > 0_u32 && !simulating && project_dialog_mode
            == "" && unsaved_action == "" {
                transform_field = clicked_transform
                transform_editor = TextEditor::new(transform_input_text(clicked_transform,
                        position_at(cube_positions, selected_cube), rotation_at(cube_rotations, selected_cube),
                        scale_at(cube_scales, selected_cube),)).select_all()
                transform_invalid = false
                actor_name_focused = false
                outliner_search_focused = false
                code_focused = false
                dirty = true
            } elif clicked_transform == "" && transform_field != "" {
                transform_field = ""
                transform_invalid = false
                dirty = true
            }
            if target == "unsaved-cancel" && unsaved_action != "" {
                unsaved_action = "" action_after_save = "" dirty = true
            } elif target == "unsaved-discard" && unsaved_action != "" {
                let action = unsaved_action
                unsaved_action = "" action_after_save = ""
                if action == "exit" {
                    request_exit = true
                } else {
                    project_dialog_mode = action
                    project_path_editor = TextEditor::new(if action == "new" {
                            cwd() + "/GrapheneProject"
                        } else {
                            project_root
                        }
                    )
                    project_path_focused = true project_error = ""
                }
                dirty = true
            } elif target == "unsaved-save" && unsaved_action != "" {
                action_after_save = unsaved_action unsaved_action = "" request_save = true dirty = true
            } elif target == "asset-import-confirm" && project_dialog_mode == "import" {
                let import_requested = command_state.execute(GrapheneCommand::RequestImportAsset(
                        AssetImportCommand::new(asset_picker.selected())))
                if import_requested.success() {
                    match import_obj_asset(project_root, command_state.import_source()) {
                        Result::Ok(imported_asset) => {
                            imported_meshes = discover_obj_assets(project_root)
                            imported_gpu_meshes.clear()
                            let mut imported_index = 0_usize
                            for asset in imported_meshes {
                                imported_gpu_meshes.push(viewport_renderer.upload_mesh(asset.mesh()))
                                if asset.name() == imported_asset.name() {
                                    selected_asset = "asset-imported-mesh-" + imported_index.fmt()
                                }
                                imported_index = imported_index + 1_usize
                            }
                            status_message = "Imported " + imported_asset.name()
                            project_dialog_mode = ""
                            project_error = ""
                            dragging = false
                            let _completed = command_state.execute(GrapheneCommand::CompleteImport(
                                    OperationCompletionCommand::new(true, imported_asset.name())))
                        }
                        Result::Err(message) => {
                            project_error = message
                            let _completed = command_state.execute(GrapheneCommand::CompleteImport(
                                    OperationCompletionCommand::new(false, message)))
                        }
                    }
                } else {
                    project_error = import_requested.message()
                }
                dirty = true
            } elif project_dialog_mode == "import" && target == "file-picker-create-folder" {
                asset_picker = asset_picker.create_folder()
                project_error = ""
                dirty = true
            } elif project_dialog_mode == "import" && target.contains("file-picker") {
                asset_picker = asset_picker.click(target)
                project_error = ""
                dirty = true
            } elif target == "project-path" {
                project_path_focused = true code_focused = false dirty = true
            } elif target == "project-cancel" {
                project_dialog_mode = "" project_path_focused = false project_error = "" dirty = true
            } elif target == "project-confirm" {
                let requested_root = trim_trailing_separator(project_path_editor.value())
                let requested_paths = project_paths(requested_root)
                let project_requested = command_state.execute(GrapheneCommand::RequestProject(
                        if project_dialog_mode == "new" {
                            ProjectRequestCommand::create(requested_root, "default")
                        } else {
                            ProjectRequestCommand::open(requested_root)
                        }
                    ))
                if project_requested.success() {
                    let ready = if command_state.project_operation() == "create" {
                        create_project(command_state.project_path())
                    } else {
                        project_valid(requested_paths)
                    }
                    if ready {
                        match load_project(requested_paths) {
                            Option::Some(contents) => {
                                while object_count > 0_u32 {
                                    viewport_renderer.remove_cube(1_u32) object_count = object_count
                                    - 1_u32
                                }
                                project_root = requested_root
                                paths = requested_paths
                                imported_meshes = discover_obj_assets(project_root)
                                scene_path = paths.scene
                                material_path = paths.material
                                script_path = paths.script
                                game_manifest = paths.manifest
                                build_log_path = paths.build_log
                                build_completion_path = paths.build_completion
                                cube_positions = contents.positions
                                cube_rotations = contents.rotations
                                cube_scales = contents.scales
                                actor_names = contents.actor_names
                                actor_visibilities = contents.visibilities
                                default_material = contents.material
                                viewport_renderer.set_default_material(default_material)
                                cube_mesh_names = contents.mesh_names
                                render_rotations = cube_rotations
                                imported_gpu_meshes.clear()
                                for asset in imported_meshes {
                                    imported_gpu_meshes.push(viewport_renderer.upload_mesh(asset.mesh()))
                                }
                                editor_scene = Scene::new()
                                cube_entities = Vec[u64]::new()
                                let mut loaded_index = 0_usize
                                while loaded_index < cube_positions.len() {
                                    let transform = Transform::identity().with_position(position_at(cube_positions,
                                            loaded_index as u32 + 1_u32,))
                                    .with_rotation(rotation_at(cube_rotations, loaded_index as u32 +
                                            1_u32,))
                                    .with_scale(scale_at(cube_scales, loaded_index as u32 + 1_u32))
                                    let entity = match contents.actor_ids.get(loaded_index) {
                                        Option::Some(id) => id Option::None => loaded_index as u64 +
                                        1_u64
                                    }
                                    editor_scene.create_entity_with_id(entity, actor_name_at(actor_names,
                                            loaded_index as u32 + 1_u32,), transform)
                                    editor_scene.set_renderable(entity, Option[Renderable]::Some(Renderable::new(MeshId::new(1_u64),
                                                MaterialId::new(1_u64),)))
                                    cube_entities.push(entity)
                                    editor_scene.set_visible(entity, bool_at(actor_visibilities, loaded_index
                                            as u32 + 1_u32, true,))
                                    loaded_index = loaded_index + 1_usize
                                }
                                let mut loaded_parent_index = 0_usize
                                while loaded_parent_index < cube_entities.len() {
                                    match cube_entities.get(loaded_parent_index) {
                                        Option::Some(entity) => {
                                            match contents.parents.get(loaded_parent_index) {
                                                Option::Some(parent) => {
                                                    editor_scene.set_parent(entity, parent)
                                                }
                                                Option::None => {
                                                }
                                            }
                                        }
                                        Option::None => {
                                        }
                                    }
                                    loaded_parent_index = loaded_parent_index + 1_usize
                                }
                                editor_scene.create_entity("Camera", Transform::identity().with_position(Vec3::new(0.0_f32,
                                            2.0_f32, 6.0_f32,)))
                                editor_scene.create_entity("Directional Light", Transform::identity().with_rotation(Vec3::new(
                                            - 0.7_f32, - 0.4_f32, 0.0_f32,)))
                                let project_completed = command_state.execute(
                                    GrapheneCommand::CompleteProjectLoad(ProjectLoadedCommand::success(
                                            editor_scene, cube_entities, cube_mesh_names,)))
                                if !project_completed.success() {
                                    project_error = project_completed.message()
                                }
                                editor_scene = command_state.scene()
                                object_count = cube_entities.len() as u32
                                selected_cube = if object_count > 0_u32 {
                                    1_u32
                                } else {
                                    0_u32
                                }
                                selected = if selected_cube > 0_u32 {
                                    actor_name_at(actor_names, selected_cube)
                                } else {
                                    "Camera"
                                }
                                code_editor = TextEditor::new(contents.code)
                                project_loaded = true
                                project_dirty = false
                                project_dialog_mode = ""
                                project_path_focused = false
                                parent_menu_open = false
                                project_error = ""
                                status_message = "Loaded project " + project_root
                                viewport_renderer.sync_cubes(object_count)
                                let mut loaded_mesh_index = 0_usize
                                while loaded_mesh_index < cube_mesh_names.len() {
                                    match cube_mesh_names.get(loaded_mesh_index) {
                                        Option::Some(mesh_name) => {
                                            let mesh = resolve_actor_gpu_mesh(mesh_name, plane_gpu_mesh,
                                                sphere_gpu_mesh,
                                                imported_meshes, imported_gpu_meshes,)
                                            if mesh.valid() {
                                                viewport_renderer.set_cube_mesh(loaded_mesh_index as
                                                    u32 + 1_u32, mesh,)
                                            }
                                        }
                                        Option::None => {
                                        }
                                    }
                                    viewport_renderer.set_cube_visible(loaded_mesh_index as u32 + 1_u32,
                                        bool_at(actor_visibilities, loaded_mesh_index as u32 + 1_u32,
                                            true,),)
                                    loaded_mesh_index = loaded_mesh_index + 1_usize
                                }
                                viewport_renderer.select_cube(selected_cube)
                                viewport_renderer.sync_cube_transforms_hierarchical(cube_positions, render_rotations,
                                    cube_scales,
                                    actor_parent_indices(cube_entities, scene_actor_parents(editor_scene,
                                            cube_entities,)),)
                            }
                            Option::None => {
                                project_error = "The project scene is invalid."
                                let _completed = command_state.execute(
                                    GrapheneCommand::CompleteProjectLoad(ProjectLoadedCommand::failure(
                                            project_error,)))
                            }
                        }
                    } else {
                        project_error = if command_state.project_operation() == "create" {
                            "Unable to create project. The directory may already contain a project."
                        } else {
                            "No valid Graphene project was found at this path."
                        }
                        let _completed = command_state.execute(
                            GrapheneCommand::CompleteProjectLoad(ProjectLoadedCommand::failure(
                                    project_error,)))
                    }
                } else {
                    project_error = project_requested.message()
                }
                dirty = true
            }
            if target != "menu-file" && target != "menu-edit" && target != "menu-window" &&
            target != "menu-tools" && target != "menu-help" {
                open_menu = ""
            }
            if target != "outliner-add" && target != "add-actor-cube" && target != "add-actor-plane"
            &&
            target != "add-actor-sphere" && !target.contains("add-actor-imported-") {
                add_actor_open = false
            }
            if target != "outliner-settings" && target != "outliner-show-editor-actors" &&
            target != "outliner-show-hidden-actors" {
                outliner_settings_open = false
            }
            if target != "parent-selector" && target != "parent-none" && !target.contains("parent-actor-")
            {
                parent_menu_open = false
            }
            if target != "viewport-camera" && target != "camera-perspective" && target != "camera-top"
            &&
            target != "camera-front" && target != "camera-right" && target != "viewport-lit" &&
            target != "shading-lit" && target != "shading-unlit" && target != "viewport-speed" &&
            target != "speed-025" && target != "speed-05" && target != "speed-1" && target != "speed-2"
            &&
            target != "speed-4" {
                open_viewport_menu = ""
            }
            if target == "menu-file" || target == "menu-edit" || target == "menu-window" ||
            target == "menu-tools" || target == "menu-help" {
                add_actor_open = false
                outliner_settings_open = false
                open_menu = if open_menu == target {
                    ""
                } else {
                    target
                }
                dirty = true
            } elif target == "menu-new-project-action" || target == "menu-open-project-action" {
                let action = if target == "menu-new-project-action" {
                    "new"
                } else {
                    "open"
                }
                let guarded = guard_editor_action(action, project_dirty)
                if action_needs_confirmation(guarded) {
                    unsaved_action = guarded_action(guarded)
                } else {
                    project_dialog_mode = action
                    project_path_editor = TextEditor::new(if action == "new" {
                            cwd() + "/GrapheneProject"
                        } else {
                            project_root
                        }
                    )
                    project_path_focused = true project_error = ""
                }
                code_focused = false viewport_focused = false actor_name_focused = false outliner_search_focused
                = false
                dirty = true
            } elif target == "menu-save-action" && project_loaded {
                request_save = true dirty = true
            } elif (target == "menu-build-action" || target == "menu-tools-build-action") && project_loaded
            {
                request_build = true dirty = true
            } elif target == "menu-exit-action" {
                let guarded = guard_editor_action("exit", project_dirty)
                if action_needs_confirmation(guarded) {
                    unsaved_action = guarded_action(guarded)
                    code_focused = false viewport_focused = false actor_name_focused = false outliner_search_focused
                    = false
                    dirty = true
                } else {
                    request_exit = true
