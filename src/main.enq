                        editor_camera_pitch = camera_pitch
                        editor_camera_distance = camera_distance
                        editor_camera_target = camera_target
                        camera_yaw = 0.0_f32
                        camera_pitch = 0.32175055_f32
                        camera_distance = 6.3245554_f32
                        camera_target = Vec3::zero()
                        status_message = "Play in editor started"
                    } else {
