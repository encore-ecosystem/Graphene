}

fn with_graphene_styles(window: Window) -> Window {
    match StyleSheet::from_file("graphene.css") {
        Result::Ok(sheet) => {
            let base = sheet.style(Widget::panel("window-theme").with_classes("graphene-editor"),
                false, false, false,)
            ret window.with_stylesheet(sheet).with_background(base.background())
        }
        Result::Err(message) => {
            println("Graphene: unable to load graphene.css: " + message)
        }
    }
    ret window
}

fn state_classes(base: str, active: bool) -> str {
    ret if active {
        base + " active"
    } else {
        base
    }
}

struct ProjectPaths {
    root: str
    marker: str
    scene: str
    material: str
    script: str
    manifest: str
    build_log: str
    build_completion: str
}

struct ProjectContents {
    actor_ids: Vec[u64]
    parents: Vec[Option[u64]]
    positions: Vec[Vec3]
    rotations: Vec[Vec3]
    scales: Vec[Vec3]
    actor_names: Vec[str]
    mesh_names: Vec[str]
    visibilities: Vec[bool]
    material: StandardMaterial
    code: str
}

fn actor_mesh_name(kind: str) -> Option[str] {
    if SceneComponent::for_kind(kind).kind() != "" {
        ret Option[str]::Some("@" + kind)
    }
    if kind == "blueprint" {
        ret Option[str]::Some("")
    }
    if kind == "cube" {
        ret Option[str]::Some("")
    }
    if kind == "plane" {
        ret Option[str]::Some("@plane")
    }
    if kind == "sphere" {
        ret Option[str]::Some("@sphere")
    }
    if kind.byte_len() > 5_usize && kind.slice(0_usize, 5_usize) == "mesh:" {
        ret Option[str]::Some(kind.slice(5_usize, kind.byte_len() - 5_usize))
    }
    ret Option[str]::None
}

fn trim_trailing_separator(path: str) -> str {
    let mut length = path.char_len()
    while length > 1_usize &&(path.slice(length - 1_usize, 1_usize) == "/" || path.slice(length - 1_usize,
            1_usize,) == "\\") {
        length = length - 1_usize
    }
    ret path.slice(0_usize, length)
}

fn parent_directory(path: str) -> str {
    let mut index = path.char_len()
    while index > 0_usize {
        let token = path.slice(index - 1_usize, 1_usize)
        if token == "/" || token == "\\" {
            ret path.slice(0_usize, index - 1_usize)
        }
        index = index - 1_usize
    }
    ret ""
}

fn project_paths(root: str) -> ProjectPaths {
    let base = trim_trailing_separator(root)
    ret ProjectPaths {
        base, base + "/graphene.project", base + "/scene.graphene.json", base + "/Content/Materials/Default.graphene-material.json",
        base + "/game/src/main.enq", base + "/game/encore.toml", base + "/game/.graphene-build.log",
        base + "/game/.graphene-build-complete"
    }
}

fn project_valid(paths: ProjectPaths) -> bool {
    ret file_exists(paths.marker) && file_exists(paths.scene) && file_exists(paths.manifest) && file_exists(paths.script)
}

fn create_project_with_template(root: str, template: str) -> bool {
    let paths = project_paths(root)
    if file_exists(paths.marker) || file_exists(paths.scene) || file_exists(paths.manifest) || file_exists(paths.script)
    {
        ret false
    }
    if mkdir_all(paths.root + "/game/src") != 0_i32 {
        ret false
    }
    if mkdir_all(paths.root + "/Content/Meshes") != 0_i32 {
        ret false
    }
    if mkdir_all(paths.root + "/Content/Materials") != 0_i32 {
        ret false
    }
    let mut positions = Vec[Vec3]::new()
    let mut rotations = Vec[Vec3]::new()
    let mut scales = Vec[Vec3]::new()
    if template == "starter" {
        positions.push(Vec3::zero())
        rotations.push(Vec3::zero())
        scales.push(Vec3::new(1.0_f32, 1.0_f32, 1.0_f32))
    }
    if write_file(paths.scene, scene_asset(positions, rotations, scales).stringify() + "\n") != 0_i32
    {
        ret false
    }
    if write_file(paths.material, material_asset_stringify(StandardMaterial::editor_default()) + "\n")
    != 0_i32 {
        ret false
    }
    if write_file(paths.manifest, "[project]\nname = \"graphene_game\"\nversion = \"0.1.0\"\ndependencies = []\n")
    != 0_i32 {
        ret false
    }
    if write_file(paths.script, "fn main() -> u32 {\n    ret 0_u32\n}\n") != 0_i32 {
        ret false
    }
    ret write_file(paths.marker, "[project]\nformat = 1\nscene = \"scene.graphene.json\"\ngame = \"game/encore.toml\"\n")
    == 0_i32
}

fn create_project(root: str) -> bool {
    ret create_project_with_template(root, "empty")
}

fn load_project(paths: ProjectPaths) -> Option[ProjectContents] {
    if !project_valid(paths) {
        ret Option[ProjectContents]::None
    }
    match SceneAsset::parse(read_file(paths.scene)) {
        Option::Some(asset) => {
            let mut positions = Vec[Vec3]::new()
            let mut actor_ids = Vec[u64]::new()
            let mut parents = Vec[Option[u64]]::new()
            let mut rotations = Vec[Vec3]::new()
            let mut scales = Vec[Vec3]::new()
            let mut actor_names = Vec[str]::new()
            let mut mesh_names = Vec[str]::new()
            let mut visibilities = Vec[bool]::new()
            let mut index = 0_usize
            while index < asset.len() {
                match asset.actor(index) {
                    Option::Some(actor) => {
                        match actor_mesh_name(actor.kind()) {
                            Option::Some(mesh_name) => {
                                actor_ids.push(actor.id())
                                parents.push(actor.parent())
                                positions.push(actor.transform().position())
                                rotations.push(actor.transform().rotation())
                                scales.push(actor.transform().scale())
                                actor_names.push(actor.name())
                                mesh_names.push(mesh_name)
                                visibilities.push(actor.visible())
                            }
                            Option::None => {
                            }
                        }
                    }
                    Option::None => {
                    }
                }
                index = index + 1_usize
            }
            let material = if file_exists(paths.material) || file_exists(paths.material + ".gmaterial") {
                match load_material_asset_file(paths.material) {
                    Option::Some(value) => value Option::None => StandardMaterial::editor_default()
                }
            } else {
                StandardMaterial::editor_default()
            }
            ret Option[ProjectContents]::Some(ProjectContents {
                    actor_ids, parents, positions, rotations, scales, actor_names, mesh_names, visibilities,
                    material, read_file(paths.script)
                }
                ,)
        }
        Option::None => {
            ret Option[ProjectContents]::None
        }
    }
}

fn vec3_differs(lhs: Vec3, rhs: Vec3) -> bool {
    ret lhs.x() != rhs.x() || lhs.y() != rhs.y() || lhs.z() != rhs.z()
}

fn selection_contains(values: Vec[u32], expected: u32) -> bool {
    for value in values {
        if value == expected {
            ret true
        }
    }
    ret false
}

fn selection_single(value: u32) -> Vec[u32] {
    let mut result = Vec[u32]::new()
    if value > 0_u32 {
        result.push(value)
    }
    ret result
}

fn selection_last(values: Vec[u32]) -> u32 {
    let mut result = 0_u32
    for value in values {
        result = value
    }
    ret result
}

fn selection_toggle(values: Vec[u32], value: u32) -> Vec[u32] {
    let mut result = Vec[u32]::new()
    let mut removed = false
    for current in values {
        if current == value {
            removed = true
        } else {
            result.push(current)
        }
    }
    if !removed && value > 0_u32 {
        result.push(value)
    }
    ret result
}

fn actor_ids_for_selection(indices: Vec[u32], actors: Vec[u64]) -> Vec[u64] {
    let mut result = Vec[u64]::new()
    for index in indices {
        if index > 0_u32 {
            match actors.get((index - 1_u32) as usize) {
                Option::Some(actor) => {
                    result.push(actor)
                }
                Option::None => {
                }
            }
        }
    }
    ret result
}

fn average_position(values: Vec[Vec3]) -> Vec3 {
    if values.len() == 0_usize {
        ret Vec3::zero()
    }
    let mut total = Vec3::zero()
    for value in values {
        total = total.add(value)
    }
    ret total.scale(1.0_f32 /(values.len() as f32))
}

fn compile_game(compiler: str, manifest: str, profile: str, run_after_build: bool,
    log_path: str, completion_path: str,) -> i32 {
    let mut args = Vec[str]::new()
    args.push(if run_after_build {
            "run"
        } else {
            "build"
        }
    )
    args.push("--profile")
    args.push(profile)
    args.push("--manifest-path")
    args.push(manifest)
    if run_after_build {
        args.push("--")
        args.push("--profile")
        args.push(profile)
    }
    let code = run_args_capture(compiler, args, log_path)
    write_file(completion_path, Debug::fmt(code))
    ret code
}

