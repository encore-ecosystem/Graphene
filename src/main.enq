                open_viewport_menu = "" status_message = shading_mode_name(shading_mode) + " shading"
                dirty = true
            } elif target == "skybox-clear" || target == "skybox-sunset" || target == "skybox-night" {
                skybox_mode = if target == "skybox-sunset" {
                    "sunset"
                } elif target == "skybox-night" {
                    "night"
                } else {
                    "clear"
                }
                viewport_renderer.set_skybox(if skybox_mode == "sunset" {
                        1_u32
                    } elif skybox_mode == "night" {
                        2_u32
                    } else {
                        0_u32
                    }
