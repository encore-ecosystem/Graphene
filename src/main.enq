                    }
                } else {
                    status_message = "Unable to resolve actor asset"
                }
                dirty = true
            } elif target.contains("toggle-visible-entity-cube-") && !simulating {
                let mut visibility_index = 0_u32
                while visibility_index < object_count {
                    if target == "toggle-visible-entity-cube-" + Debug::fmt(visibility_index + 1_u32)
                    {
                        let actor_index = visibility_index + 1_u32
                        let before_visible = bool_at(actor_visibilities, actor_index, true)
                        let visible = !before_visible
                        actor_visibilities.set(visibility_index as usize, visible)
                        viewport_renderer.set_cube_visible(actor_index, visible)
                        match cube_entities.get(visibility_index as usize) {
                            Option::Some(entity) => {
                                let changed = command_state.execute(GrapheneCommand::SetVisibility(
                                        ActorVisibilityCommand::new(entity, visible)))
                                if changed.success() {
                                    editor_scene = command_state.scene()
                                } else {
                                    actor_visibilities.set(visibility_index as usize, before_visible)
                                    viewport_renderer.set_cube_visible(actor_index, before_visible)
                                    status_message = changed.message()
                                }
                            }
                            Option::None => {
                            }
                        }
                        status_message = actor_name_at(actor_names, actor_index) + if visible {
                            " shown"
                        } else {
                            " hidden"
                        }
                        project_dirty = command_state.dirty()
                        dirty = true
                    }
                    visibility_index = visibility_index + 1_u32
                }
            } elif target == "parent-selector" && selected_cube > 0_u32 && !simulating {
                parent_menu_open = !parent_menu_open
                actor_name_focused = false
                transform_field = ""
                dirty = true
            } elif (target == "parent-none" || target.contains("parent-actor-")) && selected_cube > 0_u32
            && !simulating {
                let selected_index =(selected_cube - 1_u32) as usize
                match cube_entities.get(selected_index) {
                    Option::Some(actor_id) => {
                        let mut next_parent = Option[u64]::None
                        if target != "parent-none" {
                            let mut parent_index = 0_usize
                            while parent_index < cube_entities.len() {
                                if target == "parent-actor-" + Debug::fmt(parent_index + 1_usize) {
                                    match cube_entities.get(parent_index) {
                                        Option::Some(parent_id) => {
                                            next_parent = Option[u64]::Some(parent_id)
                                        }
                                        Option::None => {
                                        }
                                    }
                                }
                                parent_index = parent_index + 1_usize
                            }
                        }
                        match editor_scene.get(actor_id) {
                            Option::Some(before_entity) => {
                                let before_parent = before_entity.parent()
                                let before_transform = before_entity.transform()
                                if before_parent != next_parent {
                                    let changed = command_state.execute(GrapheneCommand::SetParent(
                                            ActorParentCommand::new(actor_id, next_parent)))
                                    if changed.success() {
                                        editor_scene = command_state.scene()
                                        match editor_scene.get(actor_id) {
                                            Option::Some(after_entity) => {
                                                let after_transform = after_entity.transform()
                                                cube_positions.set(selected_index, after_transform.position())
                                                cube_rotations.set(selected_index, after_transform.rotation())
                                                render_rotations.set(selected_index, after_transform.rotation())
                                                cube_scales.set(selected_index, after_transform.scale())
                                                project_dirty = command_state.dirty()
                                                status_message = selected + " parent: " + parent_display_name(next_parent,
                                                    cube_entities, actor_names,)
                                            }
                                            Option::None => {
                                            }
                                        }
                                    } else {
                                        status_message = changed.message()
                                    }
                                }
                            }
                            Option::None => {
                            }
                        }
                    }
                    Option::None => {
                    }
                }
                parent_menu_open = false
                dirty = true
            } elif target == "entity-name" && selected_cube > 0_u32 {
                actor_name_before_edit = selected
                actor_name_editor = TextEditor::new(selected).select_all()
                actor_name_focused = true
                code_focused = false
                dirty = true
            } elif target == "entity-camera" {
                selected = "Camera" selected_cube = 0_u32 selected_asset = "" parent_menu_open = false
                dirty = true
            } elif target == "entity-light" {
                selected = "Directional Light" selected_cube = 0_u32 selected_asset = "" parent_menu_open
                = false dirty = true
            } elif target == "content-add" && project_loaded && !simulating {
                project_dialog_mode = "import"
