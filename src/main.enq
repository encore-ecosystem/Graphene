                    "0.25"
                } else {
                    if target == "speed-05" {
                        "0.5"
                    } else {
                        if target == "speed-2" {
                            "2"
                        } else {
                            if target == "speed-4" {
                                "4"
                            } else {
                                "1"
                            }
                        }
                    }
                }
                open_viewport_menu = "" status_message = "Camera speed " + camera_speed_name(camera_speed)
                dirty = true
            } elif target == "grid-toggle" {
                grid_visible = !grid_visible
                viewport_renderer.set_grid_visible(grid_visible)
                status_message = if grid_visible {
