        error
    } else {
        if picker.error() != "" {
            picker.error()
        } else {
            if picker.selected() == "" {
                "Select an .obj file"
            } else {
                picker.selected()
            }
        }
    }
    actions.push(Widget::label(message).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(if error != "" || picker.error() != "" {
                    Color::rgb(220_u8, 102_u8, 94_u8)
                } else {
                    Color::rgb(145_u8, 148_u8, 155_u8)
                }
            ).with_font_size(9.0_f32)))
    actions.push(Widget::button("project-cancel", "Cancel").with_flex(88.0_f32, 0.0_f32).with_style(
            Style::default().with_background(theme_control()).with_foreground(Color::rgb(210_u8, 212_u8,
                    217_u8,))
            .with_border(1.0_f32, theme_border_hover()).with_radius(3.0_f32)))
    actions.push(Widget::button("asset-import-confirm", "Import").with_flex(96.0_f32, 0.0_f32).with_disabled(picker.selected()
            == "").with_style(
            Style::default().with_background(theme_accent()).with_foreground(Color::rgb(255_u8, 255_u8,
                    255_u8,))
            .with_border(1.0_f32, Color::rgb(55_u8, 166_u8, 226_u8)).with_radius(3.0_f32).with_font_weight(600_u32)))
    dialog.push(actions)
    shade.push(dialog)
    ret shade
}

fn split_lines(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    while index < value.char_len() {
        if value.slice(index, 1_usize) == "\n" {
            if index > start {
                result.push(value.slice(start, index - start))
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    if start < value.char_len() {
        result.push(value.slice(start, value.char_len() - start))
    }
    ret result
}

fn project_name(path: str) -> str {
    let trimmed = trim_trailing_separator(path)
    let mut index = trimmed.char_len()
    while index > 0_usize {
        let token = trimmed.slice(index - 1_usize, 1_usize)
        if token == "/" || token == "\\" {
            ret trimmed.slice(index, trimmed.char_len() - index)
        }
        index = index - 1_usize
    }
    ret trimmed
}

fn recent_projects_path() -> str {
    ret home_dir() + "/.graphene/recent-projects"
}

fn recent_projects() -> Vec[str] {
    let mut result = Vec[str]::new()
    if !file_exists(recent_projects_path()) {
        ret result
    }
    for path in split_lines(read_file(recent_projects_path())) {
        if project_valid(project_paths(path)) {
            result.push(path)
        }
    }
    ret result
}

fn remember_project(path: str) ->() {
    mkdir_all(home_dir() + "/.graphene")
    let mut output = path + "\n"
    let mut count = 1_usize
    for recent in recent_projects() {
        if recent != path && count < 8_usize {
            output = output + recent + "\n" count = count + 1_usize
        }
    }
    write_file(recent_projects_path(), output)
    ret()
}

fn requested_project_path() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "open" {
                match argv(2_usize) {
                    Option::Some(path) => {
                        ret trim_trailing_separator(path)
                    }
                    Option::None => {
                    }
                }
            }
            if command == "new" {
                ret ""
            }
        }
        Option::None => {
        }
    }
    let mut index = 1_usize
    while index < argc() {
        match argv(index) {
            Option::Some(value) => {
                if value == "--project" && index + 1_usize < argc() {
                    match argv(index + 1_usize) {
                        Option::Some(path) => {
                            ret trim_trailing_separator(path)
                        }
                        Option::None => {
                        }
                    }
                } elif value.char_len() > 0_usize && value.slice(0_usize, 1_usize) != "-" {
                    ret trim_trailing_separator(value)
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    match env("GRAPHENE_PROJECT") {
        Option::Some(path) => {
            ret trim_trailing_separator(path)
        }
        Option::None => {
        }
    }
    ret ""
}

fn requested_new_project_path() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "new" {
                match argv(2_usize) {
                    Option::Some(path) => {
                        ret trim_trailing_separator(path)
                    }
                    Option::None => {
                    }
                }
            }
        }
        Option::None => {
        }
    }
    ret ""
}

fn requested_project_template() -> str {
    let mut index = 3_usize
    while index < argc() {
        match argv(index) {
            Option::Some(value) => {
                if value == "--template" && index + 1_usize < argc() {
                    match argv(index + 1_usize) {
                        Option::Some(template) => {
                            if template == "starter" {
                                ret "starter"
                            }
                        }
                        Option::None => {
                        }
                    }
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret "empty"
}

fn requested_import_project() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "import" {
                match argv(2_usize) {
                    Option::Some(path) => {
                        ret trim_trailing_separator(path)
                    }
                    Option::None => {
                    }
                }
            }
        }
        Option::None => {
        }
    }
    ret ""
}

fn requested_import_source() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "import" {
                match argv(3_usize) {
                    Option::Some(path) => {
                        ret path
                    }
                    Option::None => {
                    }
                }
            }
        }
        Option::None => {
        }
    }
    ret ""
}

fn project_actor_count(path: str) -> usize {
    let scene_path = project_paths(path).scene
    if !file_exists(scene_path) {
        ret 0_usize
    }
    match SceneAsset::parse(read_file(scene_path)) {
        Option::Some(asset) => {
            ret asset.len()
        }
        Option::None => {
        }
    }
    ret 0_usize
}

fn project_card(id: str, path: str, hovered: str, icons: EditorIcons) -> Widget {
    let active = hovered == id
    let mut card = Widget::panel(id).with_direction(vertical()).with_flex(176.0_f32, 0.0_f32).with_style(
        Style::default().with_background(if active {
                Color::rgb(34_u8, 37_u8, 43_u8)
            } else {
                Color::rgb(27_u8, 28_u8, 32_u8)
            }
        )
        .with_border(1.0_f32, if active {
                theme_accent()
            } else {
                Color::rgb(53_u8, 55_u8, 61_u8)
            }
            ,
        )
        .with_radius(5.0_f32).with_padding(Insets::all(7.0_f32)).with_gap(5.0_f32).with_height(176.0_f32))
    let mut preview = Widget::panel(id).with_direction(vertical()).with_flex(96.0_f32, 0.0_f32).with_style(
        Style::default().with_background(Color::rgb(17_u8, 22_u8, 27_u8)).with_radius(3.0_f32).with_padding(Insets::all(25.0_f32)))
    preview.push(Widget::icon(id, icons.level).with_flex(46.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(45_u8, 146_u8, 205_u8)).with_pointer_events(false)))
    card.push(preview)
    card.push(Widget::label(project_name(path)).with_flex(22.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(231_u8, 232_u8, 235_u8)).with_font_size(11.0_f32).with_font_weight(600_u32).with_pointer_events(false)))
    card.push(Widget::label(Debug::fmt(project_actor_count(path)) + " scene objects").with_flex(16.0_f32,
            0.0_f32,).with_style(
            Style::default().with_foreground(Color::rgb(157_u8, 160_u8, 168_u8)).with_font_size(8.0_f32).with_pointer_events(false)))
    card.push(Widget::label(path).with_flex(20.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(126_u8, 129_u8, 137_u8)).with_font_size(8.0_f32).with_pointer_events(false)))
    ret card
}

fn project_template_card(id: str, title: str, description: str, icon: SvgDocument, selected: bool, hovered:
    str,) -> Widget {
    let active = selected || hovered == id
    let mut card = Widget::panel(id).with_direction(horizontal()).with_flex(244.0_f32, 0.0_f32).with_style(
        Style::default().with_background(if active {
                Color::rgb(31_u8, 38_u8, 44_u8)
            } else {
                Color::rgb(23_u8, 24_u8, 28_u8)
            }
        )
        .with_border(1.0_f32, if selected {
                theme_accent()
            } else {
                if hovered == id {
                    theme_border_hover()
                } else {
                    theme_border()
                }
            }
            ,
        )
        .with_radius(4.0_f32).with_padding(Insets::all(9.0_f32)).with_gap(9.0_f32).with_height(64.0_f32))
    card.push(Widget::icon(id, icon).with_flex(36.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(if selected {
                    theme_accent()
                } else {
                    Color::rgb(174_u8, 177_u8, 184_u8)
                }
            ).with_pointer_events(false)))
    let mut copy = Widget::panel("").with_direction(vertical()).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_gap(2.0_f32).with_pointer_events(false))
    copy.push(Widget::label(title).with_flex(20.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(231_u8, 233_u8, 236_u8)).with_font_size(11.0_f32).with_font_weight(600_u32).with_pointer_events(false)))
    copy.push(Widget::label(description).with_flex(28.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(139_u8, 142_u8, 150_u8)).with_font_size(8.0_f32).with_pointer_events(false)))
    card.push(copy)
    ret card
}

fn project_browser_view(mode: str, picker: FilePicker, name: TextEditor, template: str, hovered: str,
    error: str, icons: EditorIcons,
    width: f32, height: f32,) -> Widget {
    let mut root = Widget::panel("project-browser").with_direction(vertical()).with_style(
