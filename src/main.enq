fn log_line(prefix: str, text: str, color: Color) -> Widget {
    let mut row = Widget::panel("log-" + prefix + "-" + text).with_direction(horizontal()).with_flex(22.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(Color::rgb(17_u8, 17_u8, 20_u8)).with_padding(Insets::symmetric(2.0_f32,
                5.0_f32,)).with_gap(6.0_f32))
    row.push(Widget::panel("").with_flex(2.0_f32, 0.0_f32).with_style(
            Style::default().with_background(color).with_pointer_events(false)))
    row.push(Widget::label(prefix).with_flex(48.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(color).with_font_family("Roboto Mono")
            .with_font_size(9.0_f32).with_font_weight(600_u32)))
    row.push(Widget::label(text).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(182_u8, 184_u8, 190_u8))
            .with_font_family("Roboto Mono").with_font_size(9.0_f32)))
    ret row
}

fn output_panel(simulation_mode: str, building: bool, status_message: str, build_output: str,
    console_editor: TextEditor, console_focused: bool, console_output: str,
    icons: EditorIcons,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut output = Widget::panel("output").with_direction(vertical()).with_flex(300.0_f32, 0.0_f32).with_style(panel_style())
    let mut output_tabs = Widget::panel("output-tabs").with_direction(horizontal()).with_flex(28.0_f32,
        0.0_f32,).with_style(
        Style::default().with_gap(5.0_f32))
    output_tabs.push(active_icon_tab("output-tab", "Command Console", icons.terminal, 142.0_f32))
    output_tabs.push(Widget::spacer(1.0_f32))
    output_tabs.push(dock_badge("5 MESSAGES", 76.0_f32))
    output.push(output_tabs)
    output.push(log_line("SYSTEM", "Graphene Editor initialized", Color::rgb(118_u8, 157_u8, 184_u8)))
    output.push(log_line("RENDER", "Vulkan viewport ready", Color::rgb(72_u8, 153_u8, 204_u8)))
    output.push(log_line("EDITOR", status_message, Color::rgb(146_u8, 149_u8, 157_u8)))
    output.push(log_line("BUILD", build_output, if building {
                Color::rgb(201_u8, 151_u8, 68_u8)
            } else {
                if build_output == "Gameplay build succeeded" {
                    Color::rgb(78_u8, 170_u8, 106_u8)
                } else {
                    Color::rgb(151_u8, 153_u8, 160_u8)
                }
            }
            ,))
    output.push(log_line("WORLD", simulation_world_message(simulation_mode),
            if simulating {
                Color::rgb(78_u8, 170_u8, 106_u8)
            } else {
                Color::rgb(132_u8, 135_u8, 143_u8)
            }
            ,))
    output.push(Widget::label(console_output).with_flex(38.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(14_u8, 14_u8, 17_u8))
            .with_foreground(Color::rgb(142_u8, 176_u8, 151_u8))
            .with_border(1.0_f32, Color::rgb(42_u8, 43_u8, 48_u8))
            .with_padding(Insets::symmetric(5.0_f32, 7.0_f32))
            .with_font_family("Roboto Mono").with_font_size(9.0_f32)))
    output.push(Widget::input("command-console", console_editor.value())
        .with_focus(console_focused)
        .with_selection(console_editor.selection_start(), console_editor.selection_end())
        .with_flex(30.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(12_u8, 12_u8, 15_u8))
            .with_foreground(Color::rgb(208_u8, 210_u8, 215_u8))
            .with_border(1.0_f32, if console_focused {
                    Color::rgb(31_u8, 116_u8, 170_u8)
                } else {
                    Color::rgb(45_u8, 46_u8, 51_u8)
                }
                ,)
            .with_padding(Insets::symmetric(5.0_f32, 7.0_f32))
            .with_font_family("Roboto Mono").with_font_size(10.0_f32)))
    ret output
}

fn axis_color(axis: str) -> Color {
    ret if axis == "X" {
        Color::rgb(210_u8, 73_u8, 78_u8)
    } else {
        if axis == "Y" {
            Color::rgb(80_u8, 172_u8, 93_u8)
        } else {
            Color::rgb(66_u8, 135_u8, 214_u8)
        }
    }
}

fn axis_step_button(id: str, icon: SvgDocument, axis: str, hovered: str, disabled: bool) -> Widget {
    let hot = if axis == "X" {
        Color::rgb(112_u8, 43_u8, 49_u8)
    } else {
        if axis == "Y" {
            Color::rgb(42_u8, 94_u8, 53_u8)
        } else {
            Color::rgb(39_u8, 76_u8, 120_u8)
        }
    }
    ret Widget::icon_button(id, "", icon).with_flex(24.0_f32, 1.0_f32).with_disabled(disabled).with_style(
        Style::default().with_background(if hovered == id {
                hot
            } else {
                Color::rgb(28_u8, 29_u8, 33_u8)
            }
        )
        .with_foreground(if hovered == id {
                Color::rgb(245_u8, 246_u8, 248_u8)
            } else {
                Color::rgb(174_u8, 176_u8, 183_u8)
            }
        )
        .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(1.0_f32).with_padding(Insets::all(5.0_f32)))
}

fn axis_stepper(axis: str, minus_id: str, plus_id: str, icons: EditorIcons, hovered: str, disabled: bool)
-> Widget {
    let mut group = Widget::panel("").with_direction(horizontal()).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_background(Color::rgb(20_u8, 20_u8, 23_u8)).with_border(1.0_f32, Color::rgb(48_u8,
                49_u8, 55_u8,))
        .with_radius(2.0_f32).with_padding(Insets::all(1.0_f32)).with_gap(1.0_f32).with_overflow_hidden(true))
    group.push(Widget::label(axis).with_flex(20.0_f32, 0.0_f32).with_style(
            Style::default().with_background(Color::rgb(24_u8, 25_u8, 29_u8)).with_foreground(axis_color(axis))
            .with_font_size(9.0_f32).with_font_weight(700_u32).with_pointer_events(false)))
    group.push(axis_step_button(minus_id, icons.minus, axis, hovered, disabled))
    group.push(axis_step_button(plus_id, icons.add, axis, hovered, disabled))
    ret group
}

fn actor_row(id: str, name: str, kind: str, icon: SvgDocument, selected: bool, visible: bool, hovered:
    str, depth: u32,
    icons: EditorIcons,) -> Widget {
    let background = if selected {
        Color::rgb(31_u8, 70_u8, 97_u8)
    } else {
        if hovered == id {
            Color::rgb(42_u8, 43_u8, 48_u8)
        } else {
            Color::rgb(24_u8, 24_u8, 27_u8)
        }
    }
    let mut row = Widget::panel(id).with_direction(horizontal()).with_flex(28.0_f32, 0.0_f32).with_style(
        Style::default().with_background(background).with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8))
        .with_radius(1.0_f32).with_padding(Insets::symmetric(3.0_f32, 4.0_f32)).with_gap(4.0_f32).with_overflow_hidden(true))
    row.push(Widget::panel("").with_flex(2.0_f32, 0.0_f32).with_style(
            Style::default().with_background(if selected {
                    Color::rgb(38_u8, 143_u8, 207_u8)
                } else {
                    background
                }
            )
            .with_pointer_events(false)))
    if depth > 0_u32 {
        row.push(Widget::panel("").with_flex(10.0_f32 * depth as f32, 0.0_f32).with_style(
                Style::default().with_pointer_events(false)))
    }
    row.push(Widget::icon("", icon).with_flex(18.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(if selected {
                    Color::rgb(197_u8, 222_u8, 237_u8)
                } else {
                    Color::rgb(151_u8, 178_u8, 195_u8)
                }
            )
            .with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
    row.push(Widget::label(name).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(if selected {
                    Color::rgb(235_u8, 238_u8, 241_u8)
                } else {
                    Color::rgb(202_u8, 204_u8, 209_u8)
                }
            )
            .with_font_size(10.0_f32).with_overflow_hidden(true).with_pointer_events(false)))
    row.push(Widget::label(kind).with_flex(32.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(111_u8, 114_u8, 121_u8)).with_font_size(7.0_f32)
            .with_overflow_hidden(true).with_pointer_events(false)))
    if depth > 0_u32 {
        row.push(Widget::icon_button("toggle-visible-" + id, "", icons.visible).with_flex(18.0_f32, 0.0_f32).with_style(
                Style::default().with_background(if hovered == "toggle-visible-" + id {
                        Color::rgb(50_u8, 52_u8, 58_u8)
                    } else {
                        background
                    }
                )
                .with_foreground(if visible {
                        Color::rgb(148_u8, 170_u8, 184_u8)
                    } else {
                        Color::rgb(69_u8, 71_u8, 77_u8)
                    }
                )
                .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(2.0_f32).with_padding(Insets::all(2.0_f32))))
    } else {
        row.push(Widget::icon("", icons.visible).with_flex(18.0_f32, 0.0_f32).with_style(
                Style::default().with_foreground(Color::rgb(112_u8, 114_u8, 121_u8)).with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
    }
    ret row
}

fn actor_index_for_id(ids: Vec[u64], id: u64) -> u32 {
    let mut index = 0_usize
    while index < ids.len() {
        match ids.get(index) {
            Option::Some(value) => {
                if value == id {
                    ret index as u32 + 1_u32
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret 0_u32
}

fn actor_hierarchy_depth(actor: usize, ids: Vec[u64], parents: Vec[Option[u64]]) -> u32 {
    let mut depth = 1_u32
    let mut steps = 0_usize
    let mut parent = match parents.get(actor) {
        Option::Some(value) => value
        Option::None => Option[u64]::None
    }
    while parent.is_some() && steps < ids.len() {
        match parent {
            Option::Some(parent_id) => {
                let parent_index = actor_index_for_id(ids, parent_id)
                if parent_index == 0_u32 {
                    break
                }
                depth = depth + 1_u32
                parent = match parents.get((parent_index - 1_u32) as usize) {
                    Option::Some(value) => value
                    Option::None => Option[u64]::None
                }
            }
            Option::None => {
                break
            }
        }
        steps = steps + 1_usize
    }
    ret depth
}

fn collection_row(name: str, icons: EditorIcons) -> Widget {
    let mut row = Widget::panel("collection-" + name).with_direction(horizontal()).with_flex(25.0_f32,
