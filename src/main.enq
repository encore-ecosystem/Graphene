                request_redo = true dirty = true
            } elif target == "menu-duplicate-action" {
                request_duplicate = true dirty = true
            } elif target == "menu-delete-action" {
                request_delete = true dirty = true
            } elif target == "menu-outliner-action" {
                show_outliner = !show_outliner
                if !show_outliner {
                    outliner_settings_open = false add_actor_open = false
