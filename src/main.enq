            target == "speed-2" || target == "speed-4" {
                camera_speed = if target == "speed-025" {
                    "0.25"
                } else {
                    if target == "speed-05" {
                        "0.5"
                    } else {
                        if target == "speed-2" {
                            "2"
                        } else {
                            if target == "speed-4" {
                                "4"
                            } else {
                                "1"
                            }
                        }
                    }
                }
                open_viewport_menu = "" status_message = "Camera speed " + camera_speed_name(camera_speed)
                dirty = true
            } elif target == "grid-toggle" {
