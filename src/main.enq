fn menu_popup(menu: str, hovered: str, project_loaded: bool, project_dirty: bool, can_undo: bool, can_redo:
    bool, selected_cube: u32,
    simulating: bool, building: bool, show_outliner: bool, show_details: bool, show_content: bool, icons:
    EditorIcons,) -> Widget {
    let left = if menu == "menu-file" {
        112.0_f32
    } else {
        if menu == "menu-edit" {
            154.0_f32
        } else {
            if menu == "menu-window" {
                196.0_f32
            } else {
                if menu == "menu-tools" {
                    250.0_f32
                } else {
                    292.0_f32
                }
            }
        }
    }
    let height = if menu == "menu-edit" {
        128.0_f32
    } else {
        if menu == "menu-file" {
            122.0_f32
        } else {
            if menu == "menu-window" {
                76.0_f32
            } else {
                29.0_f32
            }
        }
    }
    let mut popup = Nav::new("menu-popup").with_classes("menu-popup")
    .with_added_classes("g-menu-popup" + if menu == "menu-edit" {
            " state-menu-menu-edit"
        } else {
            ""
        }
        + if menu == "menu-file" {
            " state-menu-menu-file"
        } else {
            ""
        }
        + if menu == "menu-window" {
            " state-menu-menu-window"
        } else {
            ""
        }
        + if menu == "menu-tools" {
            " state-menu-menu-tools"
        } else {
            ""
        }
    )
    if menu == "menu-file" {
        popup.push(popup_action("menu-new-project-action", "New Project", icons.add, hovered, building
                || simulating, false,))
        popup.push(popup_action("menu-open-project-action", "Open Project", icons.folder, hovered, building
                || simulating, false,))
        popup.push(popup_action("menu-save-action", "Save Level", icons.save, hovered, !project_loaded
                || !project_dirty || simulating, false,))
        popup.push(popup_action("menu-build-action", "Build Project", icons.build, hovered, !project_loaded
                || building || simulating, false,))
        popup.push(popup_action("menu-exit-action", "Exit Graphene", icons.exit, hovered, false, false))
    } elif menu == "menu-edit" {
        popup.push(popup_action("menu-undo-action", "Undo", icons.undo, hovered, !can_undo, false))
        popup.push(popup_action("menu-redo-action", "Redo", icons.redo, hovered, !can_redo, false))
        popup.push(popup_action("menu-duplicate-action", "Duplicate Actor", icons.duplicate, hovered,
                selected_cube == 0_u32 || simulating, false,))
        popup.push(popup_action("menu-delete-action", "Delete Actor", icons.delete, hovered, selected_cube
                == 0_u32 || simulating, false,))
        popup.push(Widget::separator())
        popup.push(popup_action("ui-project-settings", "Project Settings", icons.settings, hovered, !project_loaded, false))
    } elif menu == "menu-window" {
        popup.push(popup_action("menu-outliner-action", "World Outliner", icons.panels, hovered, false,
                show_outliner,))
        popup.push(popup_action("menu-details-action", "Details", icons.panels, hovered, false, show_details))
        popup.push(popup_action("menu-content-action", "Content Browser", icons.panels, hovered, false,
                show_content,))
        popup.push(popup_action("menu-performance-action", "Performance", icons.panels, hovered, false, false))
        popup.push(popup_action("menu-environment-action", "Environment", icons.light, hovered, false, false))
        popup.push(popup_action("menu-audio-action", "Audio", icons.settings, hovered, false, false))
        popup.push(popup_action("menu-particles-action", "VFX / Particles", icons.settings, hovered, false, false))
        popup.push(popup_action("menu-reset-layout", "Reset Layout", icons.refresh, hovered, false, false))
    } elif menu == "menu-tools" {
        popup.push(popup_action("menu-tools-build-action", "Build Project", icons.build, hovered, !project_loaded
                || building || simulating, false,))
    }
    ret popup
}

fn add_actor_popup(imported_meshes: Vec[ImportedMeshAsset], hovered: str, icons: EditorIcons, disabled: bool) -> Widget
{
    let visible_meshes = if imported_meshes.len() > 7_usize {
        7_usize
    } else {
        imported_meshes.len()
    }
    let height = 401.0_f32 +(visible_meshes as f32) * 23.0_f32 + if visible_meshes > 0_usize {
        23.0_f32
    } else {
        0.0_f32
    }
    let mut popup = Widget::panel("add-actor-popup").with_added_classes("g-add-actor-popup").with_computed_style(Style::default().with_height(height))
    popup.push(Widget::label("BASIC").with_added_classes("g-add-actor-popup-2"))
    popup.push(popup_action("add-actor-cube", "Cube", icons.mesh, hovered, disabled, false))
    popup.push(popup_action("add-actor-plane", "Plane", icons.mesh, hovered, disabled, false))
    popup.push(popup_action("add-actor-sphere", "Sphere", icons.mesh, hovered, disabled, false))
    popup.push(Widget::label("LIGHTS & CAMERA").with_added_classes("g-add-actor-popup-4"))
    popup.push(popup_action("add-actor-directional-light", "Directional Light", icons.light, hovered, disabled, false))
    popup.push(popup_action("add-actor-point-light", "Point Light", icons.light, hovered, disabled, false))
    popup.push(popup_action("add-actor-spot-light", "Spot Light", icons.light, hovered, disabled, false))
    popup.push(popup_action("add-actor-camera", "Camera", icons.camera, hovered, disabled, false))
    popup.push(Widget::label("ENVIRONMENT").with_added_classes("g-add-actor-popup-4"))
    for kind in environment_kinds() {
        popup.push(popup_action("add-actor-" + kind, kind, icons.light, hovered, disabled, false))
    }
    if visible_meshes > 0_usize {
        popup.push(Widget::label("PROJECT MESHES").with_added_classes("g-add-actor-popup-4"))
        let mut index = 0_usize
        while index < visible_meshes {
            match imported_meshes.get(index) {
                Option::Some(asset) => {
                    popup.push(popup_action("add-actor-imported-" + index.fmt(), asset.name(), icons.mesh,
                            hovered, disabled, false,))
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
    }
    ret popup
}

fn outliner_settings_popup(show_editor_actors: bool, show_hidden_actors: bool, hovered: str, icons: EditorIcons)
-> Widget {
    let mut popup = Widget::panel("outliner-settings-popup").with_added_classes("g-outliner-settings-popup")
    popup.push(Widget::label("OUTLINER FILTERS").with_added_classes("g-outliner-settings-popup-2"))
    popup.push(popup_action("outliner-show-editor-actors", "Lights & Cameras", icons.camera, hovered, false,
            show_editor_actors,))
    popup.push(popup_action("outliner-show-hidden-actors", "Hidden Actors", icons.hidden, hovered, false,
            show_hidden_actors,))
    ret popup
}

fn project_dialog(mode: str, path_editor: TextEditor, focused: bool, error: str, view_width: f32, view_height:
    f32,) -> Widget {
    let mut shade = Widget::panel("project-dialog-shade").with_added_classes("g-project-dialog").with_computed_style(Style::default().with_width(view_width).with_height(view_height))
    let width = 520.0_f32
    let height = 224.0_f32
    let mut dialog = Widget::panel("project-dialog").with_added_classes("g-project-dialog-body").with_computed_style(Style::default().with_width(width).with_height(height).with_left((view_width - width) * 0.5_f32).with_top((view_height - height) * 0.5_f32))
    dialog.push(Widget::label(if mode == "new" {
                "Create Graphene Project"
            } else {
                "Open Graphene Project"
            }
        ).with_added_classes("g-project-dialog-title"))
    dialog.push(Widget::label(if mode == "new" {
                "Choose the new project directory."
            } else {
                "Choose a directory containing graphene.project."
            }
        ).with_added_classes("g-project-dialog-description"))
    dialog.push(Widget::input("project-path", path_editor.value()).with_added_classes("g-project-path-input" + if focused {
                " state-focused"
            } else {
                ""
            }
        ))
    dialog.push(Widget::label(error).with_added_classes("g-project-dialog-error"))
    dialog.push(Widget::spacer(1.0_f32))
    let mut actions = Widget::panel("project-dialog-actions")
    .with_added_classes("g-project-dialog-actions")
    actions.push(Widget::spacer(1.0_f32))
    actions.push(Widget::button("project-cancel", "Cancel").with_added_classes("g-project-dialog-cancel"))
    actions.push(Widget::button("project-confirm", if mode == "new" {
                "Create"
            } else {
                "Open"
            }
            ,
        )
        .with_added_classes("g-project-dialog-confirm"))
    dialog.push(actions)
    shade.push(dialog)
    ret shade
}

fn unsaved_changes_dialog(action: str, view_width: f32, view_height: f32, icons: EditorIcons) -> Widget
{
    let mut shade = Widget::panel("unsaved-shade").with_added_classes("g-unsaved-changes-dialog").with_computed_style(Style::default().with_width(view_width).with_height(view_height))
    let width = 520.0_f32
