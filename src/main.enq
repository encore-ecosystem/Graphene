                76_u8, 83_u8,))
        .with_radius(4.0_f32).with_padding(Insets::all(12.0_f32)).with_gap(8.0_f32)
        .with_width(width).with_height(height).with_absolute(true).with_left((view_width - width) * 0.5_f32)
        .with_top((view_height - height) * 0.5_f32).with_z_index(141_i32)
        .with_shadow(0.0_f32, 12.0_f32, 32.0_f32, 0.0_f32, Color::rgba(0_u8, 0_u8, 0_u8, 210_u8), false))
    dialog.push(Widget::label("Import Static Mesh").with_flex(28.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(235_u8, 236_u8, 239_u8)).with_font_size(16.0_f32).with_font_weight(600_u32)))
    dialog.push(Widget::label("Select a Wavefront OBJ file. The validated source will be copied to Content/Meshes.")
        .with_flex(20.0_f32, 0.0_f32).with_style(Style::default().with_foreground(Color::rgb(157_u8,
                    160_u8, 167_u8,)).with_font_size(10.0_f32)))
