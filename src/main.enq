fn property_value(id: str, text: str, axis: str, active: bool, editor: TextEditor, invalid: bool, disabled:
    bool,) -> Widget {
    let axis_color = if axis == "X" {
        Color::rgb(178_u8, 58_u8, 63_u8)
    } else {
        if axis == "Y" {
            Color::rgb(67_u8, 148_u8, 82_u8)
        } else {
            Color::rgb(54_u8, 112_u8, 180_u8)
        }
    }
    let border = if invalid && active {
        Color::rgb(192_u8, 67_u8, 67_u8)
    } else {
        if active {
            theme_accent()
        } else {
            Color::rgb(48_u8, 49_u8, 54_u8)
        }
    }
    let mut field = Widget::panel(id + "-field").with_direction(horizontal()).with_flex(0.0_f32, 1.0_f32).with_style(
        Style::default().with_background(Color::rgb(14_u8, 14_u8, 16_u8)).with_border(1.0_f32, border)
        .with_radius(2.0_f32).with_padding(Insets::symmetric(2.0_f32, 4.0_f32)).with_gap(4.0_f32))
    field.push(Widget::label(axis).with_flex(15.0_f32, 0.0_f32).with_style(
            Style::default().with_background(axis_color).with_foreground(Color::rgb(248_u8, 248_u8, 249_u8))
            .with_radius(2.0_f32).with_font_size(9.0_f32).with_font_weight(700_u32)))
    field.push(Widget::input(id, if active {
                editor.value()
            } else {
                text
            }
            ,
        ).with_flex(0.0_f32, 1.0_f32).with_focus(active)
        .with_disabled(disabled).with_style(Style::default().with_background(Color::rgb(14_u8, 14_u8,
                    16_u8,))
            .with_foreground(if invalid && active {
                    Color::rgb(239_u8, 139_u8, 132_u8)
                } else {
                    Color::rgb(211_u8, 212_u8, 216_u8)
                }
            )
            .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32).with_padding(Insets::all(0.0_f32))
            .with_font_family("Roboto Mono").with_font_size(9.0_f32)))
    ret field
}

fn transform_scalar(value: f32) -> str {
    let negative = value < 0.0_f32
    let magnitude = if negative {
        - value
    } else {
        value
    }
    let scaled =(magnitude * 1000.0_f32 + 0.5_f32) as u32
    let whole = scaled / 1000_u32
    let fraction = scaled % 1000_u32
    let padding = if fraction < 10_u32 {
        "00"
    } else {
        if fraction < 100_u32 {
            "0"
        } else {
            ""
        }
    }
    let sign = if negative {
        "-"
    } else {
        ""
    }
    ret sign + Debug::fmt(whole) + "." + padding + Debug::fmt(fraction)
}

fn snap_scalar(value: f32, step: f32) -> f32 {
    if step <= 0.0_f32 {
        ret value
    }
    let scaled = value / step
    let rounded = if scaled < 0.0_f32 {
        (scaled - 0.5_f32) as i32
    } else {
        (scaled + 0.5_f32) as i32
    }
    ret(rounded as f32) * step
}

fn transform_property(name: str, prefix: str, value: Vec3, active_field: str, editor: TextEditor, invalid:
    bool, disabled: bool,) -> Widget {
    let display = if name == "Rotation" {
        value.scale(57.29578_f32)
    } else {
        value
    }
    let mut row = Widget::panel("transform-" + name).with_direction(horizontal()).with_flex(30.0_f32,
        0.0_f32,).with_style(
        Style::default().with_gap(4.0_f32).with_padding(Insets::symmetric(2.0_f32, 0.0_f32)))
    row.push(Widget::label(name).with_flex(58.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(181_u8, 183_u8, 188_u8)).with_font_size(10.0_f32)))
    let x_id = "transform-" + prefix + "-x"
    let y_id = "transform-" + prefix + "-y"
    let z_id = "transform-" + prefix + "-z"
    row.push(property_value(x_id, transform_scalar(display.x()), "X", active_field == x_id, editor, invalid,
            disabled,))
    row.push(property_value(y_id, transform_scalar(display.y()), "Y", active_field == y_id, editor, invalid,
            disabled,))
    row.push(property_value(z_id, transform_scalar(display.z()), "Z", active_field == z_id, editor, invalid,
            disabled,))
    ret row
}

fn transform_input_target(target: str) -> str {
    if target == "transform-location-x" || target == "transform-location-x-field" {
        ret "transform-location-x"
    }
    if target == "transform-location-y" || target == "transform-location-y-field" {
        ret "transform-location-y"
    }
    if target == "transform-location-z" || target == "transform-location-z-field" {
        ret "transform-location-z"
    }
    if target == "transform-rotation-x" || target == "transform-rotation-x-field" {
        ret "transform-rotation-x"
    }
    if target == "transform-rotation-y" || target == "transform-rotation-y-field" {
        ret "transform-rotation-y"
    }
    if target == "transform-rotation-z" || target == "transform-rotation-z-field" {
        ret "transform-rotation-z"
    }
    if target == "transform-scale-x" || target == "transform-scale-x-field" {
        ret "transform-scale-x"
    }
    if target == "transform-scale-y" || target == "transform-scale-y-field" {
        ret "transform-scale-y"
    }
    if target == "transform-scale-z" || target == "transform-scale-z-field" {
        ret "transform-scale-z"
    }
    ret ""
}

fn transform_input_text(field: str, position: Vec3, rotation: Vec3, scale: Vec3) -> str {
    let value = if field.contains("location") {
        position
    } else {
        if field.contains("rotation") {
            rotation.scale(57.29578_f32)
        } else {
            scale
        }
    }
    if field.slice(field.byte_len() - 1_usize, 1_usize) == "x" {
        ret transform_scalar(value.x())
    }
    if field.slice(field.byte_len() - 1_usize, 1_usize) == "y" {
        ret transform_scalar(value.y())
    }
    ret transform_scalar(value.z())
}

fn interactive_background(hovered: bool) -> Color {
    ret if hovered {
        theme_control_hover()
    } else {
        theme_control()
    }
}

fn interactive_border(hovered: bool) -> Color {
    ret if hovered {
        theme_border_hover()
    } else {
        theme_border()
    }
}

fn control_style(active: bool, hovered: bool) -> Style {
    let background = if active {
        Color::rgb(0_u8, 112_u8, 184_u8)
    } else {
        interactive_background(hovered)
    }
    let border = if active {
        Color::rgb(22_u8, 136_u8, 212_u8)
    } else {
        interactive_border(hovered)
    }
    ret Style::default().with_background(background).with_foreground(Color::rgb(232_u8, 233_u8, 236_u8))
    .with_border(1.0_f32, border).with_radius(2.0_f32)
    .with_padding(Insets::symmetric(5.0_f32, 9.0_f32)).with_font_size(11.0_f32)
}

fn compact_icon_style(hovered: bool) -> Style {
    ret Style::default().with_background(interactive_background(hovered))
    .with_foreground(Color::rgb(191_u8, 194_u8, 200_u8)).with_border(1.0_f32, interactive_border(hovered))
    .with_radius(2.0_f32).with_padding(Insets::all(5.0_f32))
}

fn segmented_icon_style(active: bool, hovered: bool) -> Style {
    let background = if active {
        Color::rgb(0_u8, 112_u8, 184_u8)
    } else {
        interactive_background(hovered)
    }
    ret Style::default().with_background(background).with_foreground(Color::rgb(222_u8, 224_u8, 228_u8))
    .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32).with_padding(Insets::all(5.0_f32))
}

fn segmented_group() -> Widget {
    ret Widget::panel("").with_direction(horizontal()).with_flex(124.0_f32, 0.0_f32).with_style(
        Style::default().with_background(theme_control()).with_border(1.0_f32, theme_border()).with_radius(2.0_f32)
        .with_padding(Insets::all(1.0_f32)).with_gap(1.0_f32).with_overflow_hidden(true))
}

fn toolbar_action_group(width: f32) -> Widget {
    ret Widget::panel("").with_direction(horizontal()).with_flex(width, 0.0_f32).with_style(
        Style::default().with_background(theme_control()).with_border(1.0_f32, theme_border()).with_radius(2.0_f32)
        .with_padding(Insets::all(1.0_f32)).with_gap(1.0_f32).with_overflow_hidden(true))
}

fn selector_control(id: str, text: str, icon: SvgDocument, chevron: SvgDocument, width: f32, hovered:
    bool,) -> Widget {
    let mut control = Widget::panel(id).with_direction(horizontal()).with_flex(width, 0.0_f32).with_style(
        Style::default().with_background(interactive_background(hovered)).with_border(1.0_f32, interactive_border(hovered))
        .with_radius(2.0_f32).with_padding(Insets::symmetric(4.0_f32, 6.0_f32)).with_gap(4.0_f32))
    control.push(Widget::icon("", icon).with_flex(15.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(190_u8, 193_u8, 199_u8)).with_padding(Insets::all(2.0_f32))
            .with_pointer_events(false)))
    control.push(Widget::label(text).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(224_u8, 226_u8, 230_u8)).with_font_size(10.0_f32)
            .with_pointer_events(false)))
    control.push(Widget::icon("", chevron).with_flex(12.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(124_u8, 127_u8, 134_u8)).with_padding(Insets::all(2.0_f32))
            .with_pointer_events(false)))
    ret control
}

fn camera_mode_name(mode: str) -> str {
    if mode == "top" {
        ret "Top"
    }
    if mode == "front" {
        ret "Front"
    }
    if mode == "right" {
        ret "Right"
    }
    ret "Perspective"
}

fn shading_mode_name(mode: str) -> str {
    ret if mode == "unlit" {
        "Unlit"
    } else {
        "Lit"
    }
}

fn camera_speed_name(mode: str) -> str {
    if mode == "0.25" {
        ret "0.25x"
    }
    if mode == "0.5" {
        ret "0.5x"
    }
    if mode == "2" {
        ret "2.0x"
    }
    if mode == "4" {
        ret "4.0x"
    }
    ret "1.0x"
}

fn camera_speed_value(mode: str) -> f32 {
    if mode == "0.25" {
        ret 0.25_f32
    }
    if mode == "0.5" {
        ret 0.5_f32
    }
    if mode == "2" {
        ret 2.0_f32
    }
    if mode == "4" {
        ret 4.0_f32
    }
    ret 1.0_f32
}

fn camera_option(id: str, text: str, mode: str, active_mode: str, hovered: str, icons: EditorIcons) ->
Widget {
    ret Widget::icon_button(id, text, icons.view).with_flex(if mode == "perspective" {
            108.0_f32
        } else {
            72.0_f32
        }
        , 0.0_f32,)
    .with_style(control_style(mode == active_mode, hovered == id))
}

fn viewport_camera_strip(mode: str, hovered: str, icons: EditorIcons) -> Widget {
    let mut strip = Widget::panel("viewport-camera-menu").with_direction(horizontal()).with_flex(34.0_f32,
        0.0_f32,).with_style(
        Style::default().with_background(Color::rgb(17_u8, 18_u8, 21_u8)).with_border(1.0_f32, theme_border())
        .with_padding(Insets::symmetric(3.0_f32, 6.0_f32)).with_gap(4.0_f32))
    strip.push(Widget::label("CAMERA").with_flex(54.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(112_u8, 115_u8, 122_u8)).with_font_size(8.0_f32)
            .with_font_weight(700_u32).with_pointer_events(false)))
    strip.push(camera_option("camera-perspective", "Perspective", "perspective", mode, hovered, icons))
    strip.push(camera_option("camera-top", "Top", "top", mode, hovered, icons))
    strip.push(camera_option("camera-front", "Front", "front", mode, hovered, icons))
    strip.push(camera_option("camera-right", "Right", "right", mode, hovered, icons))
    strip.push(Widget::spacer(1.0_f32))
    ret strip
}

