                        console_editor = console_editor.with_cursor(cursor)
                    }
                    Option::None => {
                    }
                }
            }
            code_focused = target == "code-editor" || target == "asset-script"
            console_focused = target == "command-console"
            if console_focused {
                code_focused = false
                actor_name_focused = false
                outliner_search_focused = false
                asset_search_focused = false
            }
            let next_asset_search_focused = target == "asset-search"
