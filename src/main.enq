    dialog.push(Widget::label(if action == "blueprint" {
                "Save changes to this Blueprint?"
            } else {
                "Save changes to this level?"
            }
        ).with_added_classes("g-unsaved-changes-dialog-3"))
    let destination = if action == "exit" {
        "before exiting Graphene"
    } else {
        if action == "blueprint" {
