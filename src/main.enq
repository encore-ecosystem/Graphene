                            20.0_f32,
                            event.x() - bounds.x() - 10.0_f32, event.y() - bounds.y() - 10.0_f32,)
                        code_editor = code_editor.with_cursor(cursor)
                    }
                    Option::None => {
                    }
                }
            }
            if target == "command-console" {
                match layout.find_bounds("command-console") {
                    Option::Some(bounds) => {
