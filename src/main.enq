                            }
                            if moving_cube {
                                transform_editing = true
                                edit_start_position = position_at(cube_positions, selected_cube)
                                edit_start_rotation = rotation_at(cube_rotations, selected_cube)
                                edit_start_scale = scale_at(cube_scales, selected_cube)
                            }
                            dirty = true
                        }
                    }
                    Option::None => {
                    }
                }
            } elif !simulating && selected_cube > 0_u32 && transform_step_kind(target) != "" {
                let kind = transform_step_kind(target)
                let before_position = position_at(cube_positions, selected_cube)
                let before_rotation = rotation_at(cube_rotations, selected_cube)
                let before_scale = scale_at(cube_scales, selected_cube)
                if kind == "move" {
                    cube_positions = set_position(cube_positions, selected_cube,
                        stepped_vector(before_position, target, 0.25_f32, 0.0_f32),)
                } elif kind == "rotate" {
                    cube_rotations = set_rotation(cube_rotations, selected_cube,
