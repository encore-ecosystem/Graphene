            } elif (target == "parent-none" || target.contains("parent-actor-")) && selected_cube > 0_u32
            && !simulating {
                let selected_index =(selected_cube - 1_u32) as usize
                match cube_entities.get(selected_index) {
                    Option::Some(actor_id) => {
                        let mut next_parent = Option[u64]::None
                        if target != "parent-none" {
                            let mut parent_index = 0_usize
                            while parent_index < cube_entities.len() {
                                if target == "parent-actor-" + Debug::fmt(parent_index + 1_usize) {
                                    match cube_entities.get(parent_index) {
                                        Option::Some(parent_id) => {
                                            next_parent = Option[u64]::Some(parent_id)
                                        }
                                        Option::None => {
                                        }
                                    }
                                }
                                parent_index = parent_index + 1_usize
                            }
                        }
                        match editor_scene.get(actor_id) {
                            Option::Some(before_entity) => {
                                let before_parent = before_entity.parent()
                                let before_transform = before_entity.transform()
                                if before_parent != next_parent {
                                    let changed = command_state.execute(GrapheneCommand::SetParent(
                                            ActorParentCommand::new(actor_id, next_parent)))
                                    if changed.success() {
                                        editor_scene = command_state.scene()
