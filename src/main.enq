        if recent.len() == 0_usize {
            cards.push(Widget::label("No recent projects").with_style(Style::default().with_foreground(Color::rgb(112_u8,
                            115_u8, 123_u8,))))
        }
        root.push(cards)
    } else {
        root.push(Widget::label(if mode == "new" {
                    "CREATE PROJECT"
                } else {
                    "OPEN PROJECT"
                }
            ).with_flex(25.0_f32, 0.0_f32).with_style(
                Style::default().with_foreground(Color::rgb(225_u8, 227_u8, 231_u8)).with_font_size(12.0_f32).with_font_weight(700_u32)))
        if mode == "new" {
            let mut templates = Widget::panel("project-templates").with_direction(horizontal()).with_flex(70.0_f32,
                0.0_f32,).with_style(
                Style::default().with_gap(8.0_f32).with_align(align_start()))
