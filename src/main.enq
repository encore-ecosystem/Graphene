            }
            asset_search_focused = next_asset_search_focused
            if asset_search_focused {
                code_focused = false
                actor_name_focused = false
                outliner_search_focused = false
            }
            if target != "entity-name" {
                actor_name_focused = false actor_name_before_edit = selected actor_name_editor = TextEditor::new(selected)
            }
            if target != "scene-search" {
                outliner_search_focused = false
            }
        }
        if previous_open_menu != open_menu ||
        previous_add_actor_open != add_actor_open ||
        previous_outliner_settings_open != outliner_settings_open ||
        previous_parent_menu_open != parent_menu_open ||
        previous_open_viewport_menu != open_viewport_menu {
            dirty = true
        }
        if request_exit {
            break
        }
        if event.kind() == event_pointer_move() &&
        text_selection_target == "code-editor" {
            match layout.find_bounds("code-editor") {
                Option::Some(bounds) => {
                    let cursor = window.wrapped_text_index(code_editor.value(),
                        bounds.width() - 20.0_f32,
                        event.x() - bounds.x() - 10.0_f32,
                        event.y() - bounds.y() - 10.0_f32,)
                    code_editor = code_editor.with_selection(
                        code_editor.selection_anchor(), cursor,)
                    dirty = true
                }
                Option::None => {
                }
            }
        } elif event.kind() == event_pointer_move() &&
        text_selection_target == "command-console" {
            match layout.find_bounds("command-console") {
                Option::Some(bounds) => {
                    let cursor = window.text_index(console_editor.value(),
                        event.x() - bounds.x() - 7.0_f32,)
                    console_editor = console_editor.with_selection(
                        console_editor.selection_anchor(), cursor,)
                    dirty = true
                }
                Option::None => {
                }
            }
        }
        if event.kind() == event_pointer_move() && orbiting {
            camera_yaw = camera_yaw +(event.x() - orbit_x) * 0.006_f32
            camera_pitch = camera_pitch +(event.y() - orbit_y) * 0.006_f32
            if camera_pitch > 1.35_f32 {
                camera_pitch = 1.35_f32
            }
            if camera_pitch < - 1.35_f32 {
                camera_pitch = - 1.35_f32
            }
            orbit_x = event.x()
            orbit_y = event.y()
            dirty = true
            viewport_only = true
        }
        if event.kind() == event_pointer_move() && panning {
            let forward = Vec3::zero().sub(Vec3::from_spherical(camera_yaw, camera_pitch)).normalized()
            let right = forward.cross(Vec3::new(0.0_f32, 1.0_f32, 0.0_f32)).normalized()
            let up = right.cross(forward).normalized()
            let speed = camera_distance * 0.0015_f32 * camera_speed_value(camera_speed)
            camera_target = camera_target.add(right.scale((orbit_x - event.x()) * speed))
            .add(up.scale((event.y() - orbit_y) * speed))
            orbit_x = event.x()
            orbit_y = event.y()
            dirty = true
            viewport_only = true
        }
        if event.kind() == event_pointer_move() && moving_cube && selected_cube > 0_u32 {
            if active_tool == "move" {
                match viewport_point(layout, event.x(), event.y()) {
                    Option::Some(point) => {
                        match viewport_renderer.ground_point_at(point.0 * window.pixel_density(), point.1
                            * window.pixel_density(), camera_yaw, camera_pitch,
                            camera_distance, camera_target,) {
                            Option::Some(ground) => {
                                let before = position_at(cube_positions, selected_cube)
                                let local = actor_local_position_for_world(editor_scene, cube_entities,
                                    selected_cube,
                                    ground.add(move_offset), before,)
                                cube_positions = set_position(cube_positions, selected_cube, local)
                            }
                            Option::None => {
                            }
                        }
                    }
                    Option::None => {
                    }
                }
            } elif active_tool == "rotate" {
                let current = rotation_at(cube_rotations, selected_cube)
                rotate_drag_y = rotate_drag_y +(event.x() - orbit_x) * 0.01_f32
                let displayed_y = if rotation_snap {
                    snap_scalar(rotate_drag_y, 0.1745329_f32)
                } else {
                    rotate_drag_y
                }
                let next = Vec3::new(current.x(), displayed_y, current.z())
                cube_rotations = set_rotation(cube_rotations, selected_cube, next)
                render_rotations = set_rotation(render_rotations, selected_cube, next)
                orbit_x = event.x()
            } elif active_tool == "scale" {
                let current = scale_at(cube_scales, selected_cube)
                let mut value = current.x() +(event.x() - orbit_x) * 0.01_f32
                if value < 0.1_f32 {
                    value = 0.1_f32
                }
                cube_scales = set_scale(cube_scales, selected_cube, Vec3::new(value, value, value))
                orbit_x = event.x()
            }
            match cube_entities.get((selected_cube - 1_u32) as usize) {
                Option::Some(entity) => {
                    let command = GrapheneCommand::SetTransform(
                        ActorTransformCommand::new(entity, Transform::identity()
                            .with_position(position_at(cube_positions, selected_cube))
                            .with_rotation(rotation_at(cube_rotations, selected_cube))
                            .with_scale(scale_at(cube_scales, selected_cube)),))
                    let changed = if command_state.interactive_active() {
                        command_state.preview_interactive(command)
                    } else {
                        command_state.begin_interactive(command)
                    }
                    if changed.success() {
                        editor_scene = command_state.scene()
                    } else {
                        status_message = changed.message()
                    }
                }
                Option::None => {
                }
            }
            dirty = true
            viewport_only = true
        }
        if event.kind() == event_pointer_up() && event.key() == 3_u32 {
            orbiting = false
        }
        if event.kind() == event_pointer_up() && event.key() == 2_u32 {
            panning = false
        }
        if event.kind() == event_pointer_up() && event.key() == 1_u32 {
            text_selection_target = ""
            if transform_editing && selected_cube > 0_u32 {
                if command_state.interactive_active() {
                    let committed = command_state.commit_interactive()
                    if committed.success() {
                        editor_scene = command_state.scene()
                        project_dirty = command_state.dirty()
                    } else {
                        status_message = committed.message()
                    }
                }
                dirty = true
            }
            transform_editing = false
            moving_cube = false
        }
        if event.kind() == event_key_down() && event.key() == 102_u32 && viewport_focused && selected_cube
        > 0_u32 &&
        !simulation_mode_is_play(simulation_mode) {
            camera_target = actor_world_position(editor_scene, cube_entities, selected_cube,
                position_at(cube_positions, selected_cube),)
            dirty = true
            viewport_only = true
        }
        if event.kind() == event_key_down() && viewport_focused && !code_focused && !simulation_mode_is_play(simulation_mode)
        {
            if event.key() == 113_u32 {
                active_tool = "select" dirty = true
            } elif event.key() == 119_u32 {
                active_tool = "move" dirty = true
            } elif event.key() == 101_u32 {
                active_tool = "rotate" dirty = true
            } elif event.key() == 114_u32 {
                active_tool = "scale" dirty = true
            }
        }
        if event.kind() == event_key_down() && event.key() == 27_u32 && unsaved_action != "" {
            unsaved_action = "" action_after_save = "" dirty = true
        } elif event.kind() == event_key_down() && event.key() == 27_u32 && add_actor_open {
            add_actor_open = false
            dirty = true
        } elif event.kind() == event_key_down() && event.key() == 27_u32 && outliner_settings_open {
            outliner_settings_open = false
            dirty = true
        } elif event.kind() == event_key_down() && event.key() == 27_u32 && simulating {
            request_stop = true
        }
        if request_stop && simulating {
            let stopped_play = simulation_mode_is_play(simulation_mode)
            let stopped = command_state.execute(GrapheneCommand::StopSimulation)
            if !stopped.success() {
                status_message = stopped.message()
            }
            simulating = command_state.simulation_mode() != ""
            simulation_mode = command_state.simulation_mode()
            render_rotations = copy_vec3_values(cube_rotations)
            if stopped_play {
                camera_yaw = editor_camera_yaw
                camera_pitch = editor_camera_pitch
                camera_distance = editor_camera_distance
                camera_target = editor_camera_target
            }
            orbiting = false
            panning = false
            moving_cube = false
            viewport_focused = false
            status_message = "Simulation stopped"
            dirty = true
        }
        if event.kind() == event_key_down() && event.control() && !code_focused && !console_focused &&
        !outliner_search_focused &&
        !asset_search_focused && !actor_name_focused && transform_field == "" && unsaved_action == ""
        {
            if event.key() == 122_u32 && event.shift() {
                request_redo = true
            } elif event.key() == 122_u32 {
                request_undo = true
            } elif event.key() == 121_u32 {
                request_redo = true
            } elif event.key() == 100_u32 && selected_cube > 0_u32 && !simulating {
                request_duplicate = true
            }
        }
        if event.kind() == event_key_down() && event.control() && event.key() == 115_u32 && project_loaded
        && !simulating && unsaved_action == "" {
            request_save = true
        }
        if event.kind() == event_key_down() && event.key() == 127_u32 && viewport_focused &&
        selected_cube > 0_u32 && !simulating {
            request_delete = true
        }
        if event.kind() == event_scroll() {
            if project_dialog_mode == "import" {
                asset_picker = asset_picker.scroll_by(0.0_f32 - event.wheel_y() * 24.0_f32)
                dirty = true
            } elif viewport_point(layout, event.x(), event.y()).is_some() && !simulation_mode_is_play(simulation_mode)
            {
                camera_distance = camera_distance - event.wheel_y() * 0.45_f32 * camera_speed_value(camera_speed)
                if camera_distance < 2.0_f32 {
                    camera_distance = 2.0_f32
                }
                if camera_distance > 14.0_f32 {
                    camera_distance = 14.0_f32
                }
                dirty = true
                viewport_only = true
            }
        }
        if !simulating && event.kind() == event_pointer_up() && dragging {
            match viewport_point(layout, event.x(), event.y()) {
                Option::Some(point) => {
                    let previous_count = object_count
                    let mut position = Vec3::zero()
                    match viewport_renderer.ground_point_at(point.0 * window.pixel_density(), point.1
                        * window.pixel_density(), camera_yaw, camera_pitch, camera_distance, camera_target,)
                    {
                        Option::Some(ground) => {
                            position = ground
                        }
                        Option::None => {
                        }
                    }
                    let mut placed_mesh_name = ""
                    let mut placed_mesh = MeshId::new(0_u64)
                    let mut placed_asset_index = 0_usize
                    while placed_asset_index < imported_meshes.len() {
                        if selected_asset == "asset-imported-mesh-" + placed_asset_index.fmt() {
                            match imported_meshes.get(placed_asset_index) {
                                Option::Some(asset) => {
                                    placed_mesh_name = asset.name()
                                }
                                Option::None => {
                                }
                            }
                            match imported_gpu_meshes.get(placed_asset_index) {
                                Option::Some(mesh) => {
                                    placed_mesh = mesh
                                }
                                Option::None => {
                                }
                            }
                        }
                        placed_asset_index = placed_asset_index + 1_usize
                    }
                    let actor_name = actor_name_for_mesh(placed_mesh_name, object_count + 1_u32)
                    let added = command_state.execute(GrapheneCommand::AddActor(
                            AddActorCommand::with_asset(actor_name,
                                Transform::identity().with_position(position), placed_mesh_name,)))
                    if added.success() {
                        editor_scene = command_state.scene()
                        let projection = editor_actors_from_scene(editor_scene, cube_entities,
                            cube_mesh_names,)
                        cube_entities = projection.ids()
                        actor_names = projection.names()
                        cube_mesh_names = command_state.asset_names(cube_entities)
                        actor_visibilities = projection.visibilities()
                        cube_positions = projection.positions()
                        cube_rotations = projection.rotations()
                        cube_scales = projection.scales()
                        render_rotations = cube_rotations
                        object_count = cube_entities.len() as u32
                        selected_cube = object_count
                        selected = actor_name
                        match added.events().get(0_usize) {
                            Option::Some(command_event) => {
                                let _selection = command_state.execute(GrapheneCommand::Select(
                                        ActorSelectionCommand::new(command_event.actor())))
                            }
                            Option::None => {
                            }
                        }
                        rebuild_viewport_actors(viewport_renderer, previous_count, cube_mesh_names,
                            actor_visibilities, cube_positions, render_rotations, cube_scales,
                            plane_gpu_mesh, sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,
                            selected_cube, cube_entities,
                            scene_actor_parents(editor_scene, cube_entities),)
                        if placed_mesh.valid() {
                            viewport_renderer.set_cube_mesh(selected_cube, placed_mesh)
                        }
                        project_dirty = command_state.dirty()
                    } else {
                        status_message = added.message()
                    }
                }
                Option::None => {
                }
            }
            dragging = false
            dirty = true
        }
        if request_save {
            let mut request_accepted = command_state.save_pending()
            let mut request_error = ""
            if !request_accepted {
                let requested = command_state.execute(GrapheneCommand::RequestSave)
                request_accepted = requested.success()
                request_error = requested.message()
            }
            if request_accepted {
                let saved = save_editor_project(scene_path, script_path, cube_positions, cube_rotations,
                    cube_scales, actor_names, cube_mesh_names, actor_visibilities,
                    cube_entities, scene_actor_parents(editor_scene, cube_entities), material_path,
                    default_material, code_editor.value(),)
                let completion_message = if saved {
                    "Saved scene and " + script_path
                } else {
                    "Unable to save editor project"
                }
                let _completed = command_state.execute(GrapheneCommand::CompleteSave(
                        OperationCompletionCommand::new(saved, completion_message)))
                status_message = completion_message
                project_dirty = command_state.dirty()
                if saved {
                    if action_after_save != "" {
                        let action = action_after_save
                        action_after_save = ""
                        if action == "exit" {
                            request_exit = true
                        } else {
                            project_dialog_mode = action
                            project_path_editor = TextEditor::new(if action == "new" {
                                    cwd() + "/GrapheneProject"
                                } else {
                                    project_root
                                }
                            )
                            project_path_focused = true project_error = ""
                        }
                    }
                } else {
                    if action_after_save != "" {
                        unsaved_action = action_after_save action_after_save = ""
                    }
                }
            } else {
                status_message = request_error
            }
            dirty = true
        }
        if request_exit {
            break
        }
        if request_build {
            let mut request_accepted = command_state.building()
            let mut request_error = ""
            if !request_accepted {
                let requested = command_state.execute(GrapheneCommand::RequestBuild)
                request_accepted = requested.success()
                request_error = requested.message()
            }
            if request_accepted {
                if save_editor_project(scene_path, script_path, cube_positions, cube_rotations, cube_scales,
                    actor_names, cube_mesh_names, actor_visibilities,
                    cube_entities, scene_actor_parents(editor_scene, cube_entities), material_path, default_material,
                    code_editor.value(),) {
                    let _prepared = command_state.execute(GrapheneCommand::BuildPrepared)
                    project_dirty = command_state.dirty()
                    remove_file(build_completion_path)
                    remove_file(build_log_path)
                    build_handle = Option[JoinHandle[i32]]::Some(
                        spawn compile_game(compiler, game_manifest, build_log_path, build_completion_path))
                    building = command_state.building()
                    build_output = "Compiling gameplay project..."
                    status_message = build_output
                } else {
                    build_output = "Unable to save gameplay project"
                    status_message = build_output
                    let _completed = command_state.execute(GrapheneCommand::CompleteBuild(
                            OperationCompletionCommand::new(false, build_output)))
                    building = command_state.building()
                }
            } else {
                build_output = request_error
                status_message = build_output
            }
            dirty = true
        }
        if request_duplicate && selected_cube > 0_u32 {
            let previous_count = object_count
            let source_actor_name = actor_name_at(actor_names, selected_cube)
            let source_mesh_name = match cube_mesh_names.get((selected_cube - 1_u32) as usize) {
                Option::Some(value) => value Option::None => ""
            }
            let source_position = position_at(cube_positions, selected_cube)
            let position = source_position.add(Vec3::new(0.75_f32, 0.0_f32, 0.0_f32))
            let rotation = rotation_at(cube_rotations, selected_cube)
            let scale = scale_at(cube_scales, selected_cube)
            let duplicate_name = source_actor_name + " Copy " + Debug::fmt(object_count + 1_u32)
            let source_id = match cube_entities.get((selected_cube - 1_u32) as usize) {
                Option::Some(actor) => actor
                Option::None => 0_u64
            }
            let duplicated = command_state.execute(GrapheneCommand::DuplicateActor(
                    DuplicateActorCommand::new(source_id, duplicate_name,
                        Transform::identity().with_position(position)
                        .with_rotation(rotation).with_scale(scale),)))
            if duplicated.success() {
                editor_scene = command_state.scene()
                let projection = editor_actors_from_scene(editor_scene, cube_entities,
                    cube_mesh_names,)
                cube_entities = projection.ids()
                actor_names = projection.names()
                cube_mesh_names = command_state.asset_names(cube_entities)
                actor_visibilities = projection.visibilities()
                cube_positions = projection.positions()
                cube_rotations = projection.rotations()
                cube_scales = projection.scales()
                render_rotations = cube_rotations
                object_count = cube_entities.len() as u32
                selected_cube = object_count
                selected = duplicate_name
                match duplicated.events().get(0_usize) {
                    Option::Some(command_event) => {
                        let _selection = command_state.execute(GrapheneCommand::Select(
                                ActorSelectionCommand::new(command_event.actor())))
                    }
                    Option::None => {
                    }
                }
                rebuild_viewport_actors(viewport_renderer, previous_count, cube_mesh_names,
                    actor_visibilities, cube_positions, render_rotations, cube_scales,
                    plane_gpu_mesh, sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,
                    selected_cube, cube_entities,
                    scene_actor_parents(editor_scene, cube_entities),)
                let duplicate_mesh = resolve_actor_gpu_mesh(source_mesh_name, plane_gpu_mesh,
                    sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,)
                if duplicate_mesh.valid() {
                    viewport_renderer.set_cube_mesh(selected_cube, duplicate_mesh)
                }
                status_message = "Duplicated " + selected
                project_dirty = command_state.dirty()
            } else {
                status_message = duplicated.message()
            }
            dirty = true
        }
        if request_delete && selected_cube > 0_u32 && selected_cube <= object_count {
            let removed = selected_cube
            let removed_index =(removed - 1_u32) as usize
            let removed_name = actor_name_at(actor_names, removed)
            match cube_entities.get(removed_index) {
                Option::Some(entity) => {
                    let previous_count = object_count
                    let changed = command_state.execute(GrapheneCommand::DeleteActor(
                            ActorCommand::new(entity)))
                    if changed.success() {
                        editor_scene = command_state.scene()
                        let projection = editor_actors_from_scene(editor_scene, cube_entities,
                            cube_mesh_names,)
                        cube_entities = projection.ids()
                        actor_names = projection.names()
                        cube_mesh_names = command_state.asset_names(cube_entities)
                        actor_visibilities = projection.visibilities()
                        cube_positions = projection.positions()
                        cube_rotations = projection.rotations()
                        cube_scales = projection.scales()
                        render_rotations = cube_rotations
                        object_count = cube_entities.len() as u32
                        selected_cube = if object_count == 0_u32 {
                            0_u32
                        } else {
                            if removed > object_count {
                                object_count
                            } else {
                                removed
                            }
                        }
                        selected = if selected_cube > 0_u32 {
                            actor_name_at(actor_names, selected_cube)
                        } else {
                            "Camera"
                        }
                        if selected_cube > 0_u32 {
                            match cube_entities.get((selected_cube - 1_u32) as usize) {
                                Option::Some(actor) => {
                                    let _selection = command_state.execute(GrapheneCommand::Select(
                                            ActorSelectionCommand::new(Option[u64]::Some(actor))))
                                }
                                Option::None => {
                                }
                            }
                        }
                        rebuild_viewport_actors(viewport_renderer, previous_count,
                            cube_mesh_names, actor_visibilities, cube_positions,
                            render_rotations, cube_scales, plane_gpu_mesh, sphere_gpu_mesh,
                            imported_meshes, imported_gpu_meshes, selected_cube, cube_entities,
                            scene_actor_parents(editor_scene, cube_entities),)
                        parent_menu_open = false
                        transform_editing = false
                        moving_cube = false
                        status_message = "Deleted " + removed_name
                        project_dirty = command_state.dirty()
                    } else {
                        status_message = changed.message()
                    }
                }
                Option::None => {
                }
            }
            dirty = true
        }
        let command_history_requested =(request_undo && command_state.can_undo()) ||
        (request_redo && command_state.can_redo())
        if command_history_requested {
            let previous_count = object_count
            let command_history_redo = request_redo
            let changed = command_state.execute(if command_history_redo {
                    GrapheneCommand::Redo
                } else {
                    GrapheneCommand::Undo
                }
            )
            request_undo = false
            request_redo = false
            if changed.success() {
                editor_scene = command_state.scene()
                let projection = editor_actors_from_scene(editor_scene, cube_entities, cube_mesh_names)
                cube_entities = projection.ids()
                actor_names = projection.names()
                cube_mesh_names = command_state.asset_names(cube_entities)
                actor_visibilities = projection.visibilities()
                cube_positions = projection.positions()
                cube_rotations = projection.rotations()
                render_rotations = cube_rotations
                cube_scales = projection.scales()
                object_count = cube_entities.len() as u32
                selected_cube = match command_state.selection() {
                    Option::Some(actor) => {
                        actor_index_for_id(cube_entities, actor)
                    }
                    Option::None => {
                        0_u32
                    }
                }
                selected = if selected_cube > 0_u32 {
                    actor_name_at(actor_names, selected_cube)
                } else {
                    "Camera"
                }
                rebuild_viewport_actors(viewport_renderer, previous_count, cube_mesh_names,
                    actor_visibilities, cube_positions, render_rotations, cube_scales,
                    plane_gpu_mesh, sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,
                    selected_cube, cube_entities, scene_actor_parents(editor_scene, cube_entities),)
                actor_name_editor = TextEditor::new(selected)
                project_dirty = command_state.dirty()
                status_message = if command_history_redo {
                    "Redo command"
                } else {
                    "Undo command"
                }
                dirty = true
            } else {
                status_message = changed.message()
            }
        }
        if project_dialog_mode == "import" && event.kind() == event_text_input() && event.text() != ""
        {
            asset_picker = asset_picker.input(event.text())
            project_error = ""
            dirty = true
        }
        if project_dialog_mode == "import" && event.kind() == event_key_down() {
            if event.key() == key_backspace() {
                asset_picker = asset_picker.backspace() dirty = true
            } elif event.key() == key_enter() {
                asset_picker = if asset_picker.creating_folder() {
                    asset_picker.create_folder()
                } else {
                    asset_picker.confirm_path()
                }
                dirty = true
            }
        }
        if project_dialog_mode != "" && project_dialog_mode != "import" && project_path_focused && event.kind()
        == event_text_input() && event.text() != "" {
            project_path_editor = project_path_editor.insert(event.text())
            project_error = ""
            dirty = true
        }
        if project_dialog_mode != "" && project_dialog_mode != "import" && project_path_focused && event.kind()
        == event_key_down() {
            let extend = event.shift()
            if event.control() && event.key() == 97_u32 {
                project_path_editor = project_path_editor.select_all() dirty = true
            } elif event.control() && event.key() == 99_u32 {
                if project_path_editor.has_selection() {
                    window.set_clipboard(project_path_editor.selected_text())
                }
            } elif event.control() && event.key() == 120_u32 {
                if project_path_editor.has_selection() {
                    window.set_clipboard(project_path_editor.selected_text())
                    project_path_editor = project_path_editor.cut()
                    dirty = true
                }
            } elif event.control() && event.key() == 118_u32 {
                project_path_editor = project_path_editor.paste(window.clipboard_text()) dirty = true
            } elif event.key() == key_backspace() {
                project_path_editor = project_path_editor.backspace() dirty = true
            } elif event.key() == key_delete() {
                project_path_editor = project_path_editor.delete() dirty = true
            } elif event.key() == key_left() {
                project_path_editor = project_path_editor.move_left(extend) dirty = true
            } elif event.key() == key_right() {
                project_path_editor = project_path_editor.move_right(extend) dirty = true
            } elif event.key() == key_home() {
                project_path_editor = project_path_editor.move_home(extend) dirty = true
            } elif event.key() == key_end() {
                project_path_editor = project_path_editor.move_end(extend) dirty = true
            }
        }
