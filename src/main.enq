fn project_browser_view(mode: str, picker: FilePicker, name: TextEditor, template: str, hovered: str,
    error: str, icons: EditorIcons,
    width: f32, height: f32,) -> Widget {
    let mut root = Main::new("project-browser").with_classes("project-browser")
    let mut brand = Header::new("project-browser-brand").with_classes("project-browser-brand")
    brand.push(Widget::icon("", icons.brand).with_added_classes("g-project-browser-view"))
    brand.push(Widget::heading("GRAPHENE").with_added_classes("g-project-browser-view-2"))
    brand.push(Widget::spacer(1.0_f32))
    if mode != "home" {
        brand.push(Widget::button("browser-back", "Back to Projects").with_added_classes("g-project-browser-view-3"))
    }
    root.push(brand)
    if mode == "home" {
        let mut hero = Widget::panel("browser-hero").with_added_classes("g-project-browser-view-4")
        hero.push(Widget::icon("", icons.brand).with_added_classes("g-project-browser-view-5"))
        hero.push(Widget::label("Build worlds with Graphene").with_added_classes("g-project-browser-view-6"))
        let mut actions = Widget::panel("browser-actions").with_added_classes("g-project-browser-view-7")
        actions.push(Widget::icon_button("browser-new", "New Project", icons.add).with_added_classes("g-project-browser-view-8"))
        actions.push(Widget::icon_button("browser-open", "Open Project", icons.folder).with_added_classes("g-project-browser-view-9"))
        hero.push(actions)
        root.push(hero)
        root.push(Widget::label("RECENT PROJECTS").with_added_classes("g-project-browser-view-10"))
        let mut cards = Widget::panel("recent-projects").with_added_classes("g-project-browser-view-11")
        let recent = recent_projects()
        let mut index = 0_usize
        while index < recent.len() {
            match recent.get(index) {
                Option::Some(path) => {
                    cards.push(project_card("recent-project-" + index.fmt(), path, hovered, icons))
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
        if recent.len() == 0_usize {
            cards.push(Widget::label("No recent projects").with_added_classes("g-project-browser-view-12"))
        }
        root.push(cards)
    } else {
        root.push(Widget::label(if mode == "new" {
                    "CREATE PROJECT"
                } else {
                    "OPEN PROJECT"
                }
            ).with_added_classes("g-project-browser-view-13"))
        if mode == "new" {
            let mut templates = Widget::panel("project-templates").with_added_classes("g-project-browser-view-14")
            templates.push(project_template_card("template-empty", "Empty", "Blank scene with camera and light",
                    icons.file, template == "empty", hovered,))
            templates.push(project_template_card("template-starter", "Starter Scene", "A ready-to-edit cube scene",
                    icons.mesh, template == "starter", hovered,))
            root.push(templates)
            root.push(Widget::input("browser-project-name", name.value()).with_focus(true).with_added_classes("g-project-browser-view-15"))
        }
        root.push(picker.view(file_picker_icons(icons)))
        let mut footer = Footer::new("browser-footer").with_classes("browser-footer")
        footer.push(Widget::label(error).with_added_classes("g-project-browser-view-16"))
        footer.push(Widget::button("browser-confirm", if mode == "new" {
                    "Create Project"
                } else {
                    "Open Project"
                }
                ,
            ).with_added_classes("g-project-browser-view-17"))
        root.push(footer)
    }
    ret root
}

fn browse_for_project(window: Window, icons: EditorIcons) -> Option[str] {
    let mut mode = match env("GRAPHENE_BROWSER_MODE") {
        Option::Some(value) => {
            if value == "new" || value == "open" {
                value
            } else {
                "home"
            }
        }
        Option::None => {
            "home"
        }
    }
    let mut picker = FilePicker::new(home_dir())
    let mut name = TextEditor::new("GrapheneProject")
    let mut template = "empty"
    let mut focus = "name"
    let mut hovered = ""
    let mut error = ""
    let mut browser_ui = window.reactive(project_browser_view(mode, picker, name,
            template, hovered, error, icons, window.width() as f32,
            window.height() as f32,))
    let mut layout = browser_ui.layout()
    while window.is_open() {
        let event = window.wait(250_u32)
        if event.kind() == event_close() {
            ret Option[str]::None
        }
        let mut dirty = event.kind() == event_resize()
        if event.kind() == event_pointer_move() {
            let next_hovered = browser_ui.hit(event.x(), event.y())
            if next_hovered != hovered {
                hovered = next_hovered dirty = true
            }
        }
        if event.kind() == event_pointer_down() {
            let target = browser_ui.hit(event.x(), event.y())
            if target == "browser-new" {
                mode = "new" picker = FilePicker::new(home_dir()) template = "empty" focus = "name" error
                = ""
            } elif target == "browser-open" {
                mode = "open" picker = FilePicker::new(home_dir()) focus = "picker" error = ""
            } elif target == "browser-back" {
                mode = "home" error = ""
            } elif target == "template-empty" {
                template = "empty"
            } elif target == "template-starter" {
                template = "starter"
            } elif target == "browser-project-name" {
                focus = "name"
            } elif target == "file-picker-create-folder" {
                picker = picker.create_folder() focus = "picker"
            } elif target == "browser-confirm" {
                let path = if mode == "new" {
                    picker.directory() + "/" + name.value()
                } else {
                    picker.directory()
                }
                let ready = if mode == "new" {
                    create_project_with_template(path, template)
                } else {
                    project_valid(project_paths(path))
                }
                if ready {
                    remember_project(path) ret Option[str]::Some(path)
                }
                error = if mode == "new" {
                    "Unable to create project at this location"
                } else {
                    "This folder is not a Graphene project"
                }
            } else {
                let mut recent_index = 0_usize
                let recent = recent_projects()
                while recent_index < recent.len() {
                    if target == "recent-project-" + recent_index.fmt() {
                        match recent.get(recent_index) {
                            Option::Some(path) => {
                                remember_project(path) ret Option[str]::Some(path)
                            }
                            Option::None => {
                            }
                        }
                    }
                    recent_index = recent_index + 1_usize
                }
                picker = picker.click(target)
                focus = "picker"
            }
            dirty = true
        }
        if event.kind() == event_text_input() && event.text() != "" {
            if mode == "new" && focus == "name" {
                name = name.insert(event.text())
            } else {
                picker = picker.input(event.text())
            }
            dirty = true
        }
        if event.kind() == event_key_down() && event.key() == key_backspace() {
            if mode == "new" && focus == "name" {
                name = name.backspace()
            } else {
                picker = picker.backspace()
            }
            dirty = true
        }
        if event.kind() == event_key_down() && event.key() == key_enter() {
            if picker.creating_folder() && focus == "picker" {
                picker = picker.create_folder()
            } elif focus == "picker" {
                picker = picker.confirm_path()
            }
            dirty = true
        }
        if event.kind() == event_scroll() && mode != "home" {
            picker = picker.scroll_by(0.0_f32 - event.wheel_y() * 24.0_f32) dirty = true
        }
        if dirty {
            if event.kind() == event_resize() {
                browser_ui = window.relayout_reactive(browser_ui)
            } else {
                browser_ui = window.update_reactive(browser_ui,
                    project_browser_view(mode, picker, name, template, hovered,
                        error, icons, window.width() as f32,
                        window.height() as f32,),)
            }
            layout = browser_ui.layout()
        }
    }
    ret Option[str]::None
}

fn launch_project_browser() -> Option[str] {
    let window = with_graphene_styles(
        Window::create("Graphene Project Browser", 1180_u32, 760_u32)
        ,)
    if !window.available() {
        println("Graphene: unable to create project browser: " + backend_error())
        ret Option[str]::None
    }
    let mut font_manager = FontManager::with_bundled("../Luma/assets/fonts")
    font_manager.register_all(window)
    let typography = window.stylesheet().style(Widget::panel("window-theme").with_classes("graphene-editor"), false, false, false)
    font_manager = font_manager.activate(window, typography.font_family(), typography.font_size(), typography.font_weight())
    if font_manager.error() != "" {
        println("Graphene: unable to activate Roboto: " + font_manager.error())
    }
    let icons = EditorIcons::load(IconManager::with_bundled("../Luma/assets/icons"))
    let project = browse_for_project(window, icons)
    window.destroy()
    ret project
}

