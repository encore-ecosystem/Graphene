                }
                let after_position = position_at(cube_positions, selected_cube)
                let after_rotation = rotation_at(cube_rotations, selected_cube)
                let after_scale = scale_at(cube_scales, selected_cube)
                status_message = "Adjusted " + kind + " for " + selected
                match cube_entities.get((selected_cube - 1_u32) as usize) {
