fn tooltip(text: str, pointer_x: f32, pointer_y: f32, view_width: f32, view_height: f32) -> Widget {
    let left = if pointer_x + 192.0_f32 > view_width {
        pointer_x - 190.0_f32
    } else {
        pointer_x + 12.0_f32
    }
    let top = if pointer_y + 44.0_f32 > view_height {
        pointer_y - 34.0_f32
    } else {
        pointer_y + 18.0_f32
    }
    ret Widget::label(text).with_id("hover-tooltip").with_added_classes("g-tooltip").with_computed_style(Style::default().with_left(left).with_top(top))
}

// Transient hints are paint-only: changing a hover must not reconcile the
// overlay host, rebuild its hit-test index or invalidate the authored CSS tree.
fn tooltip_display(text: str, pointer_x: f32, pointer_y: f32, view_width: f32, view_height: f32, style: Style) -> DisplayList {
    let mut list = DisplayList::new()
    if text == "" {
        ret list
    }
    let left = if pointer_x + 192 > view_width {
        pointer_x - 190
    } else {
        pointer_x + 12
    }
    let top = if pointer_y + 44 > view_height {
        pointer_y - 34
    } else {
        pointer_y + 18
    }
    let bounds = Rect::new(if left < 0 {
            0
        } else {
            left
        }
        , if top < 0 {
            0
        } else {
            top
        }
        , 180, 26,)
    list.fill_rect(bounds, style.background()) list.stroke_rect(bounds, style.border_color())
    list.clip(Rect::new(bounds.x() + 1, bounds.y() + 1, bounds.width() - 2, bounds.height() - 2))
    list.styled_text(bounds.x() + 8, bounds.y() + 5, text, style)
    ret list
}

fn overlay_layer(open_menu: str, open_viewport_menu: str, shading_mode: str,
    add_actor_open: bool, outliner_settings_open: bool,
    project_dialog_mode: str, unsaved_action: str, project_loaded: bool, project_dirty: bool,
    can_undo: bool, can_redo: bool, selected_cube: u32, simulating: bool, building: bool,
    show_outliner: bool, show_details: bool, show_content: bool,
    outliner_show_editor_actors: bool, outliner_show_hidden_actors: bool,
    imported_meshes: Vec[ImportedMeshAsset], hovered: str,
    pointer_x: f32, pointer_y: f32,
    project_path_editor: TextEditor, project_path_focused: bool, project_error: str,
    asset_picker: FilePicker, approvals: ApprovalBroker, view_width: f32, view_height: f32,
    icons: EditorIcons,) -> Widget {
    let mut layer = Widget::panel("overlay-layer").with_added_classes("g-overlay-layer").with_computed_style(Style::default().with_width(view_width).with_height(view_height))
    if open_menu != "" {
        layer.push(interactive_overlay(menu_popup(open_menu, hovered, project_loaded, project_dirty,
                    can_undo, can_redo, selected_cube, simulating, building, show_outliner,
                    show_details, show_content, icons,)))
    }
    if open_viewport_menu == "shading" {
        layer.push(interactive_overlay(viewport_shading_popup(shading_mode, hovered, icons)))
    }
    if add_actor_open && show_outliner && project_loaded && !simulating {
        layer.push(interactive_overlay(add_actor_popup(imported_meshes, hovered, icons, simulating)))
    }
    if outliner_settings_open && show_outliner {
        layer.push(interactive_overlay(outliner_settings_popup(outliner_show_editor_actors,
                    outliner_show_hidden_actors, hovered, icons,)))
    }
    if asset_picker_mode(project_dialog_mode) {
        layer.push(interactive_overlay(asset_import_dialog(asset_picker, project_error,
                    view_width, view_height, icons, project_dialog_mode,)))
    } elif project_dialog_mode != "" {
        layer.push(interactive_overlay(project_dialog(project_dialog_mode, project_path_editor,
                    project_path_focused, project_error, view_width, view_height,)))
    }
    if unsaved_action != "" {
        layer.push(interactive_overlay(unsaved_changes_dialog(unsaved_action, view_width,
                    view_height, icons,)))
    }
    match approvals.pending() {
        Option::Some(request) => {
            layer.push(interactive_overlay(approval_dialog(request, view_width, view_height)))
        }
        Option::None => {
        }
    }
    // Transform guides use a paint-only DisplayList, not retained widgets.
    ret layer
}

// The overlay host deliberately ignores pointer input so uncovered viewport
// pixels remain interactive. Popup and dialog roots opt back in; pointer
// events are inherited by their controls, matching the CSS overlay pattern
// `pointer-events: none` on the host and `auto` on interactive children.
fn interactive_overlay(widget: Widget) -> Widget {
    ret widget.with_classes(widget.classes() + " interactive-overlay")
}

fn anti_aliasing_choices(ui: EditorUiState, hovered: str, icons: EditorIcons) -> Widget {
    let mut rows = Widget::panel("anti-aliasing-choices").with_direction(vertical()).with_classes("g-aa-choices")
    for method in anti_aliasing_methods() {
        let available = effective_reconstruction(method, ui.aa_sample_counts, ui.reconstruction_capabilities).key() == method.key()
        let reason = if available {
            method.name()
        } else {
            method.name() + " · SDK / GPU unavailable"
        }
        rows.push(popup_action("anti-aliasing-" + method.key(), reason, icons.lighting, hovered, !available, ui.render_settings.anti_aliasing().key() == method.key())
            .with_attribute("aria-label", reason).with_attribute("aria-checked", if ui.render_settings.anti_aliasing().key() == method.key() {
                    "true"
                } else {
                    "false"
                }
                ,
            ).with_attribute("role", "menuitemradio"))
    }
    ret rows
}

fn reconstruction_choice(id: str, text: str, disabled: bool, active: bool) -> Widget {
    ret Widget::button(id, text).with_tag("button").with_classes(state_classes("popup-action", active) + " g-reconstruction-chip").with_disabled(disabled).with_attribute("aria-label", text).with_attribute("title", text).with_attribute("role", "menuitemradio").with_attribute("aria-checked", if active {
            "true"
        } else {
            "false"
        }
        ,
    )
}

fn reconstruction_controls(ui: EditorUiState, hovered: str, icons: EditorIcons) -> Widget {
    let settings = ui.render_settings let method = settings.anti_aliasing()
    let mut root = Widget::panel("reconstruction-controls").with_direction(vertical()).with_classes("g-reconstruction-controls")
    if method.key() == "fsr" || method.key() == "dlss" {
        root.push(Widget::label("Upscaling Quality").with_classes("g-popup-caption"))
        let mut row = Widget::panel("reconstruction-quality-options").with_direction(horizontal()).with_classes("g-reconstruction-options")
        let mut count = 0_u32
        for quality in upscaling_qualities() {
            if quality.value() == 0 && method.key() != "fsr" {
                continue
            }
            if count == 3 {
                root.push(row) row = Widget::panel("reconstruction-quality-options-more").with_direction(horizontal()).with_classes("g-reconstruction-options")
            }
            count += 1
            row.push(reconstruction_choice("reconstruction-quality-" + quality.key(), quality.name(), false, settings.quality().key() == quality.key()).with_added_classes("g-reconstruction-chip").with_attribute("role", "menuitemradio").with_attribute("aria-checked", if settings.quality().key() == quality.key() {
                        "true"
                    } else {
                        "false"
                    }
                    ,
                ))
        }
        root.push(row)
    }
    root.push(Widget::label("Frame Generation · Play / Game").with_classes("g-popup-caption"))
    let mut row = Widget::panel("reconstruction-fg-options").with_direction(horizontal()).with_classes("g-reconstruction-options")
    for fg in vec![FrameGenerationMethod::Off, FrameGenerationMethod::Fsr, FrameGenerationMethod::Dlss] {
        let available = fg.key() == "off" ||(method.temporal() &&(ui.reconstruction_capabilities & if fg.key() == "fsr" {
                    8_u32
                } else {
                    16_u32
                }
            ) != 0)
        row.push(reconstruction_choice("reconstruction-fg-" + fg.key(), fg.name(), !available, settings.frame_generation().key() == fg.key()).with_added_classes("g-reconstruction-chip").with_attribute("role", "menuitemradio").with_attribute("aria-checked", if settings.frame_generation().key() == fg.key() {
                    "true"
                } else {
                    "false"
                }
                ,
            ).with_attribute("aria-label", if available {
                    fg.name()
                } else {
                    fg.name() + " unavailable: requires temporal AA and SDK / GPU support"
                }
                ,
            ))
    }
    root.push(row)
    if settings.frame_generation().key() != "off" {
        let mut row = Widget::panel("reconstruction-multiplier-options").with_direction(horizontal()).with_classes("g-reconstruction-options")
        for multiplier in 2..5 {
            let available = multiplier == 2 ||(settings.frame_generation().key() == "dlss" &&(ui.reconstruction_capabilities & if multiplier == 3 {
                        32_u32
                    } else {
                        64_u32
                    }
                ) != 0)
            row.push(reconstruction_choice("reconstruction-multiplier-" + Debug::fmt(multiplier), Debug::fmt(multiplier) + "×", !available, settings.multiplier() == multiplier).with_added_classes("g-reconstruction-chip").with_attribute("role", "menuitemradio").with_attribute("aria-checked", if settings.multiplier() == multiplier {
                        "true"
                    } else {
                        "false"
                    }
                    ,
                ))
        }
        root.push(row)
    }
    if method.key() == "fsr" {
        root.push(Widget::label("Sharpness").with_classes("g-popup-caption"))
        let mut row = Widget::panel("reconstruction-sharpness-options").with_direction(horizontal()).with_classes("g-reconstruction-options")
        for step in 0..5 {
            let value =(step as f32) * 0.25_f32
            row.push(reconstruction_choice("reconstruction-sharpness-" + Debug::fmt(step), Debug::fmt(step * 25) + "%", false, settings.sharpness() == value).with_added_classes("g-reconstruction-chip"))
        }
        root.push(row)
    }
    if ui.reconstruction_status != "" {
        root.push(Widget::label(ui.reconstruction_status).with_classes("g-aa-help"))
    }
    ret root
}

fn local_popup(ui: EditorUiState, layout: WidgetLayout, width: f32, height: f32,
    material: StandardMaterial, profile: str, snap: GizmoSnap,
    sky: str, speed: str, grid: bool, hovered: str, icons: EditorIcons,) -> Widget {
    let mut popup = Widget::panel("ui-local-popup").with_classes("g-local-popup").with_direction(vertical()).with_attribute("role", "menu")
    let owner = ui.popup()
    if owner == "ui-lod-groups" {
        let w = if width > 964 {
            940.0_f32
        } else {
            width - 24
        }
        let h = if height > 684 {
            660.0_f32
        } else {
            height - 24
        }
        ret ui.lod_groups.widget_width(w).with_computed_style(Style::default().with_left((width - w) * 0.5_f32).with_top((height - h) * 0.5_f32).with_width(w).with_height(h))
    }
    let mut desired = Size::new(224, 178)
    if owner == "ui-project-settings" || owner == "ui-anti-aliasing" {
        desired = if owner == "ui-project-settings" {
            Size::new(464, 644)
        } else {
            Size::new(400, 590)
        }
        popup.push(Widget::label(if owner == "ui-project-settings" {
                    "Project Settings"
                } else {
                    "Anti-Aliasing"
                }
            ).with_classes("g-popup-caption"))
        if owner == "ui-project-settings" {
            popup = popup.with_added_classes("g-project-render-settings").with_attribute("role", "dialog").with_attribute("aria-label", "Project Settings · Rendering")
            popup.push(Widget::label("Rendering / Anti-Aliasing").with_classes("g-popup-caption"))
        }
        popup = popup.with_attribute("data-luma-scrollable", "true")
        popup.push(anti_aliasing_choices(ui, hovered, icons))
        popup.push(reconstruction_controls(ui, hovered, icons))
        if owner == "ui-project-settings" {
            popup.push(popup_action("ui-lod-groups", "AutoLOD Groups", icons.mesh, hovered, false, false))
            popup.push(popup_action("menu-audio-action", "Audio / Mixer", icons.settings, hovered, false, false))
        }
        let active = effective_reconstruction(ui.render_settings.anti_aliasing(), ui.aa_sample_counts, ui.reconstruction_capabilities)
        popup.push(Widget::label(if active.key() != ui.render_settings.anti_aliasing().key() {
                    "GPU fallback: " + active.name()
                } else {
                    "Saved in project · Applied immediately"
                }
            ).with_classes("g-aa-help"))
    } elif owner == "ui-autolod-group" {
        desired = Size::new(244, if ui.lod_groups.catalog.groups.len() < 9 {
                (ui.lod_groups.catalog.groups.len() as f32) * 30.0_f32 + 12.0_f32
            } else {
                264.0_f32
            }
            ,
        )
        popup = popup.with_attribute("data-luma-scrollable", "true")
        for group in ui.lod_groups.catalog.groups {
            popup.push(popup_action("autolod-assign-" + group.id, group.name, icons.mesh, hovered, false, ui.mesh.settings.group_id == group.id).with_attribute("role", "menuitemradio"))
        }
    } elif owner == "ui-material-palette" {
        desired = Size::new(224, 62)
        popup.push(Widget::label("Base Color").with_classes("g-popup-caption"))
        let mut swatches = Widget::panel("").with_classes("g-local-palette").with_direction(horizontal())
        for id in vec!["material-color-slate", "material-color-ruby", "material-color-jade", "material-color-cobalt", "material-color-gold"] {
            swatches.push(material_swatch(id, material_preset_color(id), material.base_color(), hovered).with_attribute("aria-label", id))
        }
        popup.push(swatches)
    } elif owner.contains("ui-transform-") {
        desired = Size::new(244, 116)
        let prefix = if owner == "ui-transform-location" {
            "move"
        } elif owner == "ui-transform-rotation" {
            "rotate"
        } else {
            "scale"
        }
        popup.push(Widget::label("Step " + prefix).with_classes("g-popup-caption"))
        for axis in vec!["x", "y", "z"] {
            popup.push(axis_stepper(if axis == "x" {
                        "X"
                    } elif axis == "y" {
                        "Y"
                    } else {
                        "Z"
                    }
                    , prefix + "-" + axis + "-minus", prefix + "-" + axis + "-plus", icons, hovered, false,))
        }
    } elif owner == "ui-build" {
        popup.push(Widget::label("Build Profile").with_classes("g-popup-caption"))
        for name in vec!["debug", "release", "extreme"] {
            popup.push(popup_action("build-profile-" + name, name, icons.build, hovered, false, profile == name))
        }
        popup.push(Widget::separator())
        popup.push(popup_action("build-run", "Build & Run", icons.play, hovered, false, false))
    } elif owner == "ui-play" {
        desired = Size::new(224, 64)
        popup.push(popup_action("play", "Play", icons.play, hovered, false, false))
        popup.push(popup_action("simulate", "Simulate", icons.play, hovered, false, false))
    } elif owner.contains("ui-snap-step-") {
        let snap_tool = owner.slice(13, owner.byte_len() - 13)
        desired = Size::new(172, if snap_tool == "scale" {
                128.0_f32
            } else {
                156.0_f32
            }
            ,
        )
        popup = popup.with_classes("g-local-popup g-snap-popup")
        popup.push(Widget::label(snap_tool_name(snap_tool) + " step").with_classes("g-popup-caption"))
        popup.push(snap_step_grid(snap_tool, snap))
    } elif owner == "ui-viewport-settings" {
        desired = Size::new(260, 246)
        popup.push(Widget::label("Viewport").with_classes("g-popup-caption"))
        popup.push(popup_action("grid-toggle", "Grid", icons.grid, hovered, false, grid))
        popup.push(viewport_skybox_strip(sky, hovered, icons))
        popup.push(viewport_speed_strip(speed, hovered, icons))
        popup.push(popup_action("ui-anti-aliasing", "Anti-Aliasing: " + ui.render_settings.anti_aliasing().name(), icons.lighting, hovered, false, false))
    }
    if desired.width() > width - 16 {
        desired = Size::new(width - 16, desired.height())
    }
    if desired.height() > height - 16 {
        desired = Size::new(desired.width(), height - 16)
    }
    let bounds = if owner == "ui-project-settings" {
        Rect::new((width - desired.width()) * 0.5,(height - desired.height()) * 0.5, desired.width(), desired.height())
    } else {
        anchored_popup_bounds(layout.find_bounds(ui.popup_anchor()).unwrap_or(Rect::new(8, 8, 0, 0)), desired, Rect::new(8, 8, width - 16, height - 16))
    }
    ret popup.with_computed_style(Style::default().with_left(bounds.x()).with_top(bounds.y()).with_width(bounds.width()).with_height(bounds.height()))
}

fn local_popup_actions(widget: Widget) -> Vec[str] {
    let mut actions = Vec[str]::new()
    if !widget.disabled() &&(widget.kind() == widget_button() || widget.kind() == widget_icon_button() || widget.kind() == luma::widget_input() || widget.id() == "lod-curve") && widget.id() != "" {
        actions.push(widget.id())
    }
    for child in widget.children() {
        for id in local_popup_actions(child) {
            actions.push(id)
        }
    }
    ret actions
}

fn editor_menu_bar(open_menu: str, hovered: str, project_loaded: bool,
    project_root: str, icons: EditorIcons,) -> Widget {
    let mut menu = Header::new("menu-bar").with_classes("editor-menu-bar")
    menu.push(Widget::icon("graphene-mark", icons.brand)
        .with_added_classes("g-editor-menu-bar"))
    menu.push(Widget::label("GRAPHENE").with_added_classes("g-editor-menu-bar-2"))
    menu.push(menu_item("menu-file", "File",
            if open_menu == "menu-file" {
                "menu-file"
            } else {
                hovered
            }
            ,))
    menu.push(menu_item("menu-edit", "Edit",
            if open_menu == "menu-edit" {
                "menu-edit"
            } else {
                hovered
            }
            ,))
    menu.push(menu_item("menu-window", "Window",
            if open_menu == "menu-window" {
                "menu-window"
            } else {
                hovered
            }
            ,))
    menu.push(menu_item("menu-tools", "Tools",
            if open_menu == "menu-tools" {
                "menu-tools"
            } else {
                hovered
            }
            ,))
    menu.push(Widget::spacer(1.0_f32))
    menu.push(Widget::label(if project_loaded {
                project_root + " / scene.graphene.json"
            } else {
                "No Project"
            }
        ).with_added_classes("g-editor-menu-bar-3"))
    ret menu
}

fn editor_toolbar(simulation_mode: str, project_loaded: bool, project_dirty: bool,
    can_undo: bool, can_redo: bool, selected_cube: u32, building: bool,
    build_profile: str, build_profile_open: bool, hovered: str, icons: EditorIcons, ui: EditorUiState,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut toolbar = Nav::new("toolbar").with_classes("editor-toolbar")
    let mut history_tools = toolbar_action_group(104.0_f32)
    history_tools.push(Widget::icon_button("save", "", icons.save)
        .with_tag("button").with_classes("toolbar-icon")
        .with_disabled(!project_loaded || !project_dirty || simulating))
    history_tools.push(Widget::icon_button("undo", "", icons.undo)
        .with_tag("button").with_classes("toolbar-icon").with_disabled(!can_undo)
    )
    history_tools.push(Widget::icon_button("redo", "", icons.redo)
        .with_tag("button").with_classes("toolbar-icon").with_disabled(!can_redo)
    )
    toolbar.push(history_tools)
    toolbar.push(toolbar_divider())
    let mut actor_tools = toolbar_action_group(69.0_f32)
    actor_tools.push(Widget::icon_button("duplicate", "", icons.duplicate)
        .with_tag("button").with_classes("toolbar-icon")
        .with_disabled(selected_cube == 0_u32 || simulating))
    actor_tools.push(Widget::icon_button("delete", "", icons.delete)
        .with_tag("button").with_classes("toolbar-icon danger")
        .with_disabled(selected_cube == 0_u32 || simulating))
    toolbar.push(actor_tools)
    toolbar.push(toolbar_divider())
    toolbar.push(Widget::icon_button("build-game",
            if building {
                "Building..."
            } else {
                "Build"
            }
            , icons.build,)
        .with_tag("button").with_classes(state_classes("toolbar-button build-button", building))
        .with_disabled(!project_loaded || building || simulating))
    toolbar.push(Widget::icon_button("ui-build", "", icons.expanded).with_classes("toolbar-icon").with_attribute("aria-label", "Build profile and run options").with_disabled(!project_loaded || building || simulating))
    toolbar.push(Widget::spacer(1.0_f32))
    toolbar.push(Widget::icon_button(if simulating {
                "stop"
            } else {
                "play"
            }
            ,
            if simulating {
                "Stop"
            } else {
                "Play"
            }
            , icons.play,)
        .with_tag("button").with_classes(state_classes("toolbar-button play-button", simulating)).with_disabled(!project_loaded)
    )
    toolbar.push(Widget::icon_button("ui-play", "", icons.expanded).with_classes("toolbar-icon").with_attribute("aria-label", "Play options").with_disabled(!project_loaded || simulating))
    ret toolbar
}

fn workspace_tabs(project_dirty: bool, icons: EditorIcons) -> Widget {
    let mut tabs = Nav::new("workspace-tabs").with_classes("workspace-tabs")
    tabs.push(pane_heading("level-tab",
            "scene.graphene.json" + if project_dirty {
                "  *"
            } else {
                ""
            }
            ,
            icons.level, 196.0_f32,))
    ret tabs
}

fn status_bar(simulation_mode: str, building: bool, status_message: str,
    project_loaded: bool, project_dirty: bool, object_count: u32,
    icons: EditorIcons,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut status = Footer::new("status").with_classes("editor-status")
    status.push(status_segment(if building {
                "BUILDING"
            } else {
                if simulating {
                    simulation_mode_label(simulation_mode)
                } else {
                    "READY"
                }
            }
            , if building {
                icons.build
            } else {
                if simulating {
                    icons.play
                } else {
                    icons.clean
                }
            }
            ,
            if building {
                "tone-warning"
            } else {
                if simulating {
                    "tone-success"
                } else {
                    "tone-info"
                }
            }
            , 92.0_f32, building || simulating,))
    status.push(Widget::label(status_message).with_added_classes("g-status-bar"))
    status.push(Widget::spacer(1.0_f32))
    status.push(status_segment(if !project_loaded {
                "No Project"
            } else {
                if project_dirty {
                    "Unsaved"
                } else {
                    "Saved"
                }
            }
            , if project_dirty {
                icons.save
            } else {
                icons.clean
            }
            ,
            if project_dirty {
                "tone-warning"
            } else {
                "tone-success"
            }
            , 82.0_f32, false,))
    status.push(label("Actors " + Debug::fmt(object_count)).with_added_classes("size-68-grow-0"))
    ret status
}

fn dock_splitter(id: str, horizontal_axis: bool) -> Widget {
    ret Widget::button(id, "").with_classes(if horizontal_axis {
            "dock-splitter dock-splitter-row"
        } else {
            "dock-splitter dock-splitter-column"
        }
    )
}

fn upper_workspace(simulation_mode: str, selected: str, selected_position: Vec3,
    selected_rotation: Vec3, selected_scale: Vec3, selected_cube: u32,
    selected_mesh_name: str, actor_ids: Vec[u64], actor_parents: Vec[Option[u64]],
    actor_names: Vec[str], actor_visibilities: Vec[bool], name_editor: TextEditor,
    name_focused: bool, parent_menu_open: bool, transform_field: str,
    transform_editor: TextEditor, transform_invalid: bool, outliner_search: TextEditor,
    outliner_search_focused: bool, selected_asset: str, selected_autolod_enabled: bool,
    default_material: StandardMaterial,
    object_count: u32, autolod_stats: str,
    dragging: bool, active_tool: str, camera_mode: str,
    shading_mode: str, skybox_mode: str, camera_speed: str, grid_visible: bool, snap_settings: GizmoSnap,
    open_viewport_menu: str, hovered: str, compact: bool,
    outliner_show_editor_actors: bool, outliner_show_hidden_actors: bool,
    show_outliner: bool, show_details: bool, icons: EditorIcons, ui: EditorUiState,) -> Widget {
    let mut upper = Main::new("upper").with_classes("upper-workspace")
    if show_outliner {
        let mut outliner_dock = Widget::panel("outliner-dock").with_classes("outliner-dock")
        outliner_dock.push(hierarchy(selected, actor_ids, actor_parents, actor_names,
                actor_visibilities, object_count, outliner_search, outliner_search_focused,
                outliner_show_editor_actors, outliner_show_hidden_actors, hovered, icons, ui,))
        upper.push(outliner_dock)
        upper.push(dock_splitter("dock-splitter-outliner", false))
    }
    upper.push(viewport(simulation_mode, dragging, object_count, autolod_stats,
            selected, active_tool,
            camera_mode, shading_mode, skybox_mode, camera_speed, grid_visible, snap_settings,
            open_viewport_menu, hovered, compact, icons, ui,))
    let selected_id = match actor_ids.get(if selected_cube > 0_u32 {
            (selected_cube - 1_u32) as usize
        } else {
            actor_ids.len()
        }
    ) {
        Option::Some(id) => id
        Option::None => 0_u64
    }
    let selected_parent = match actor_parents.get(if selected_cube > 0_u32 {
            (selected_cube - 1_u32) as usize
        } else {
            actor_parents.len()
        }
    ) {
        Option::Some(parent) => parent
        Option::None => Option[u64]::None
    }
    if show_details {
        upper.push(dock_splitter("dock-splitter-details", false))
        let mut details_dock = Widget::panel("details-dock").with_classes("details-dock")
        if selected_asset == "asset-material" {
            details_dock.push(material_inspector(default_material, hovered, icons, ui,))
        } elif selected_asset.contains("asset-imported-mesh-") {
            details_dock.push(autolod_asset_inspector(
                    selected_autolod_enabled, autolod_stats, hovered, icons, ui,))
        } elif selected_asset == "cb-selected" {
            details_dock.push(content_asset_info(ui.browser, icons.content, true))
        } else {
            details_dock.push(inspector(selected, name_editor, name_focused, selected_position,
                    selected_rotation, selected_scale, transform_field, transform_editor,
                    transform_invalid, selected_cube > 0_u32, selected_id, selected_parent,
                    actor_ids, actor_names, parent_menu_open, selected_mesh_name, hovered, icons, ui,))
        }
        upper.push(details_dock)
    }
    ret upper
}

fn lower_workspace(show_content: bool, icons: EditorIcons, ui: EditorUiState) -> Widget {
    let mut lower = Section::new("lower").with_classes("lower-workspace")
    if show_content {
        lower.push(Widget::panel("content-dock").with_classes("content-dock").with_child(content_browser(icons, ui)))
    }
    ret lower
}

fn editor_view(simulation_mode: str, selected: str, selected_position: Vec3, selected_rotation: Vec3,
    selected_scale: Vec3,
    selected_cube: u32, selected_mesh_name: str, actor_ids: Vec[u64], actor_parents: Vec[Option[u64]],
    actor_names: Vec[str], actor_visibilities: Vec[bool],
    name_editor: TextEditor, name_focused: bool, parent_menu_open: bool,
    transform_field: str, transform_editor: TextEditor, transform_invalid: bool,
    outliner_search: TextEditor, outliner_search_focused: bool,
    asset_search: TextEditor, asset_search_focused: bool,
    dragging: bool, selected_asset: str, selected_autolod_enabled: bool,
    default_material: StandardMaterial, imported_meshes: Vec[ImportedMeshAsset],
    object_count: u32, autolod_stats: str, code_editor: TextEditor,
    code_focused: bool, console_editor: TextEditor, console_focused: bool,
    console_output: str, status_message: str, project_loaded: bool,
    project_dirty: bool, active_tool: str, camera_mode: str, shading_mode: str, skybox_mode: str, camera_speed: str,
    grid_visible: bool, snap_settings: GizmoSnap,
    can_undo: bool, can_redo: bool,
    building: bool, build_output: str, build_profile: str, build_profile_open: bool, hovered: str,
    pointer_x: f32, pointer_y: f32, compact: bool, open_menu: str, add_actor_open: bool, outliner_settings_open:
    bool,
    outliner_show_editor_actors: bool, outliner_show_hidden_actors: bool, show_outliner: bool, show_details:
    bool,
    show_content: bool, open_viewport_menu: str, project_root: str, project_dialog_mode: str, unsaved_action:
    str,
    project_path_editor: TextEditor, project_path_focused: bool, project_error: str, asset_picker: FilePicker,
    approvals: ApprovalBroker, view_width: f32, view_height: f32, icons: EditorIcons, ui: EditorUiState,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut root = Body::new("root").with_classes("graphene-editor")
    let mut part_started = perf_counter_ms()
    let menu_bar = editor_menu_bar(open_menu, hovered, project_loaded, project_root, icons)
    profile_view_part("menu", part_started)
    root.push(menu_bar)
    part_started = perf_counter_ms()
    let toolbar = editor_toolbar(simulation_mode, project_loaded, project_dirty,
        can_undo, can_redo, selected_cube, building, build_profile, build_profile_open, hovered, icons, ui,)
    profile_view_part("toolbar", part_started)
    root.push(toolbar)

    part_started = perf_counter_ms()
    let tabs = workspace_tabs(project_dirty, icons)
    profile_view_part("tabs", part_started)
    root.push(tabs)

    part_started = perf_counter_ms()
    let upper = upper_workspace(simulation_mode, selected, selected_position,
        selected_rotation, selected_scale, selected_cube, selected_mesh_name,
        actor_ids, actor_parents, actor_names, actor_visibilities, name_editor,
        name_focused, parent_menu_open, transform_field, transform_editor,
        transform_invalid, outliner_search, outliner_search_focused, selected_asset,
        selected_autolod_enabled, default_material, object_count, autolod_stats,
        dragging, active_tool, camera_mode, shading_mode, skybox_mode,
        camera_speed, grid_visible, snap_settings, open_viewport_menu, hovered, compact,
        outliner_show_editor_actors, outliner_show_hidden_actors, show_outliner,
        show_details, icons, ui,)
    profile_view_part("upper workspace", part_started)
    root.push(upper)
    root.push(dock_splitter("dock-splitter-bottom", true))
    part_started = perf_counter_ms()
    let lower = lower_workspace(show_content, icons, ui)
    profile_view_part("lower workspace", part_started)
    root.push(lower)

    part_started = perf_counter_ms()
    let status = status_bar(simulation_mode, building, status_message,
        project_loaded, project_dirty, object_count, icons,)
    profile_view_part("status", part_started)
    root.push(status)
    part_started = perf_counter_ms()
    let overlays = overlay_layer(open_menu, open_viewport_menu, shading_mode,
        add_actor_open, outliner_settings_open, project_dialog_mode,
        unsaved_action, project_loaded, project_dirty, can_undo, can_redo, selected_cube, simulating,
        building, show_outliner, show_details, show_content, outliner_show_editor_actors,
        outliner_show_hidden_actors, imported_meshes, if ui.popup() == "" && ui.browser.popup == "" {
            hovered
        } else {
            ""
        }
        , pointer_x, pointer_y,
        project_path_editor, project_path_focused, project_error, asset_picker,
        approvals, view_width, view_height, icons,)
    profile_view_part("overlays", part_started)
    root.push(overlays)
    ret Html::new().with_child(root)
}

fn profile_view_part(name: str, started: u64) ->() {
    if env("GRAPHENE_PROFILE").is_some() {
        println("Graphene profile: view " + name + " " +
            Debug::fmt(perf_counter_ms() - started) + " ms")
    }
    ret()
}

struct ProjectSources {
    scene: str
    material: str
    script: str
}

// This worker owns only immutable strings; native window/GPU state stays on
// the UI thread. Reading a project never blocks the loading event pump.
fn read_project_sources(root: str) -> ProjectSources {
    let paths = project_paths(root)
    ret ProjectSources {
        if file_exists(paths.scene) {
            read_file(paths.scene)
        } else {
            ""
        }
        ,
        if file_exists(paths.material) {
            read_file(paths.material)
        } else {
            ""
        }
        ,
        if file_exists(paths.script) {
            read_file(paths.script)
        } else {
            ""
        }
    }
}

fn loading_view(project: str, brand: SvgDocument, stage: str, completed: u32) -> Widget {
    let mut root = Widget::panel("startup").with_classes("loading-screen")
    root.push(Widget::spacer(1.0_f32))
    let mut card = Widget::panel("loading-card").with_classes("loading-card")
    card.push(Widget::icon("loading-logo", brand).with_classes("loading-logo"))
    card.push(Widget::heading("GRAPHENE").with_classes("loading-brand"))
    card.push(Widget::label("Preparing your workspace").with_classes("loading-caption"))
    card.push(Widget::label(project).with_classes("loading-project"))
    card.push(Widget::progress((completed as f32) / 5.0_f32).with_id("loading-progress").with_classes("loading-progress"))
    card.push(Widget::label(stage).with_classes("loading-message"))
    root.push(card)
    root.push(Widget::spacer(1.0_f32))
    ret root
}

fn present_loading(window: Window, project: str, brand: SvgDocument,
    stage: str, completed: u32,) -> bool {
    let geometry = window.prepare_geometry()
    if !geometry.valid() {
        ret false
    }
    let mut event = window.poll()
    while event.kind() != event_none() {
        if event.kind() == event_close() {
            ret false
        }
        event = window.poll()
    }
    let _loading = window.draw(loading_view(project, brand, stage, completed))
    ret window.is_open()
}

// The retained index handles missing IDs as well as present nodes in path depth.
fn retained_bounds(ui: mut ReactiveUi, id: str) -> Option[Rect] {
    ret match ui.find_layout(id) {
        Some(node) => Option[Rect]::Some(node.bounds())
        None => Option[Rect]::None
    }
}

fn retained_render_frame(window: Window, ui: mut ReactiveUi, layout: WidgetLayout, cached: bool) -> PreparedFrame {
    let mut slots = Vec[SurfaceSlot]::new()
    for id in vec!["viewport-surface", "camera-preview-surface", "material-preview-surface", "vfx-preview-surface"] {
        match window.surface_slot(ui, id) {
            Some(slot) => {
                slots.push(slot)
            }
            None => {
            }
        }
    }
    if cached {
        ret window.prepare_cached_surface_frame(layout.bounds(), slots)
    }
    ret window.prepare_frame_with_surfaces(layout, cached, slots)
}

fn render_worker_count() -> u32 {
    let parallelism = available_parallelism()
    let count = if parallelism > 2_usize {
        parallelism - 2_usize
    } else {
        1_usize
    }
    let automatic = if count > 4_usize {
        4_u32
    } else {
        count as u32
    }
    match env("GRAPHENE_RENDER_THREADS") {
        Option::Some(value) => {
            ret if value == "0" {
                0_u32
            } elif value == "1" {
                1_u32
            } elif value == "2" {
                2_u32
            } elif value == "3" {
                3_u32
            } elif value == "4" {
                4_u32
            } else {
                automatic
            }
        }
        Option::None => {
            ret automatic
        }
    }
}

fn material_preview_environment(renderer: ViewportRenderer<H>, position: Vec3) -> Vec[f32] {
    let all = renderer.environment_frame(position).values() let mut values = Vec[f32]::new()
    for i in 0..32 {
        values.push(all.get(i).unwrap_or(0))
    }
    ret values
}
fn main() -> u32 {
    let _parallel_rendering = native_parallel_configure(render_worker_count())
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "import-character" {
                let project = argv(2_usize).unwrap_or("") let source = argv(3_usize).unwrap_or("")
                if project == "" || source == "" || !project_valid(project_paths(project)) {
                    println("Usage: graphene import-character <project directory> <source.glb|source.gltf> [name]") ret 1_u32
                }
                let name = argv(4_usize).unwrap_or(Path::new(source).stem().unwrap_or(""))
                match import_character(project, source, name) {
                    Ok(asset) => {
                        println("Imported " + asset.name + " to Content/Characters/" + name + ".gcharacter") ret 0_u32
                    }
                    Err(error) => {
                        println("Graphene: " + error) ret 1_u32
                    }
                }
            }
            if command == "cook" {
                let root = argv(2_usize).unwrap_or("")
                if root == "" || !project_valid(project_paths(root)) {
                    println("Usage: graphene cook <project directory>") ret 1
                }
                let started = perf_counter_ms()
                let assets = discover_obj_assets(root)
                let material = load_material_asset_file(project_paths(root).material)
                println("Prepared " + assets.len().fmt() + " native meshes in " +(perf_counter_ms() - started).fmt() + " ms")
                ret if material.is_some() {
                    0_u32
                } else {
                    1_u32
                }
            }
        }
        Option::None => {
        }
    }
    let startup_started = perf_counter_ms()
    let profiling = env("GRAPHENE_PROFILE").is_some()
    let import_project = requested_import_project()
    if import_project != "" {
        if !project_valid(project_paths(import_project)) {
            println("Graphene: invalid project: " + import_project)
            ret 1_u32
        }
        let import_source = requested_import_source()
        let asset_name = argv(4_usize).unwrap_or("")
        if sound_source_supported(import_source) {
            let result = import_sound(import_project, import_source)
            if result.error == "" {
                println("Imported " + result.path) ret 0_u32
            }
            println("Graphene: " + result.error) ret 1_u32
        }
        let imported = if asset_name == "" {
            import_mesh_asset(import_project, import_source)
        } else {
            import_mesh_asset_as(import_project, import_source, asset_name)
        }
        match imported {
            Result::Ok(asset) => {
                println("Imported " + asset.name() + " to " + asset.project_path()) ret 0_u32
            }
            Result::Err(message) => {
                println("Graphene: " + message) ret 1_u32
            }
        }
    }
    let new_project = requested_new_project_path()
    if new_project != "" {
        if !create_project_with_template(new_project, requested_project_template()) {
            println("Graphene: unable to create project at " + new_project)
            ret 1_u32
        }
        remember_project(new_project)
    }
    let requested_project = requested_project_path()
    let mut startup_project = Option[str]::None
    if new_project != "" {
        startup_project = Option[str]::Some(new_project)
    } elif requested_project != "" && project_valid(project_paths(requested_project)) {
        remember_project(requested_project)
        startup_project = Option[str]::Some(requested_project)
    } else {
        startup_project = launch_project_browser()
    }
    let mut project_at_startup = ""
    match startup_project {
        Option::Some(path) => {
            project_at_startup = path
        }
        Option::None => {
        }
    }
    if project_at_startup == "" {
        ret 0_u32
    }
    let mut window = with_graphene_styles(
        Window::create_with_renderer_features("Graphene Editor", 1440_u32, 900_u32,
            RendererKind::DirectVulkan, VulkanFeatureRequest::advanced_rendering(),)
        ,)
    if !window.available() {
        println("Graphene Editor: unable to create " + backend_name() + " window: " + backend_error())
        ret 1_u32
    }
    let mut font_manager = FontManager::with_bundled("../Luma/assets/fonts")
    font_manager.register_all(window)
    let typography = window.stylesheet().style(Widget::panel("window-theme").with_classes("graphene-editor"), false, false, false)
    font_manager = font_manager.activate(window, typography.font_family(), typography.font_size(), typography.font_weight())
    if font_manager.error() != "" {
        println("Graphene Editor: unable to activate Roboto: " + font_manager.error())
    }
    if profiling {
        println("Graphene profile: window and fonts " +
            Debug::fmt(perf_counter_ms() - startup_started) + " ms")
    }
    // Reveal one complete, inexpensive startup frame while the retained
    // editor tree and Vulkan viewport are prepared. Luma completes the initial
    // compositor configuration before recording the opaque loading frame.
    let icon_manager = IconManager::with_lazy_bundled("../Luma/assets/icons")
    let loading_brand = icon_manager.document("hexagon")
    if !present_loading(window, project_at_startup, loading_brand, "Loading interface resources", 0) {
        window.destroy()
        ret 0
    }
    let project_worker = spawn read_project_sources(project_at_startup)
    if profiling {
        println("Graphene profile: startup frame " +
            Debug::fmt(perf_counter_ms() - startup_started) + " ms")
    }
    let icon_load_started = perf_counter_ms()
    let icons = EditorIcons::load(icon_manager)
    if profiling {
        println("Graphene profile: icons " +
            Debug::fmt(perf_counter_ms() - icon_load_started) + " ms")
    }
    let mut simulation_mode = match env("GRAPHENE_SIMULATION_MODE") {
        Option::Some(mode) => {
            normalize_simulation_mode(mode)
        }
        Option::None => {
            if env("GRAPHENE_AUTOPLAY").is_some() {
                "play"
            } else {
                ""
            }
        }
    }
    let mut simulating = simulation_mode_active(simulation_mode)
    if simulating && !window.set_present_mode(PresentMode::Immediate) {
        println("Graphene Editor: unable to enable immediate presentation: " +
            backend_error())
    }
    let mut selected = "Cube 1"
    let mut selected_cube = 1_u32
    let mut selected_cubes = Vec[u32]::new()
    let mut dragging = false
    let mut selected_asset = match env("GRAPHENE_SELECTED_ASSET") {
        Option::Some(name) => {
            if name == "material" {
                "asset-material"
            } elif name == "script" {
                "asset-script"
            } else {
                "asset-cube"
            }
        }
        Option::None => {
            "asset-cube"
        }
    }
    let mut project_root = project_at_startup
    let mut paths = project_paths(project_root)
    while !project_worker.is_finished() {
        let event = window.wait(16)
        if event.kind() == event_close() {
            window.destroy()
            ret 0
        }
        if event.kind() == event_resize() {
            let _loading = present_loading(window, project_root, loading_brand, "Reading project files", 1)
        }
    }
    let project_sources = project_worker.join()
    if !present_loading(window, project_root, loading_brand, "Loading scene and assets", 2) {
        window.destroy()
        ret 0
    }
    let asset_worker = spawn discover_obj_assets(project_root)
    while !asset_worker.is_finished() {
        let event = window.wait(16)
        if event.kind() == event_close() {
            window.destroy()
            ret 0
        }
        if event.kind() == event_resize() {
            let _loading = present_loading(window, project_root, loading_brand, "Loading scene and assets", 2)
        }
    }
    let mut imported_meshes = asset_worker.join()
    let mut selected_autolod_enabled = true
    let mut scene_path = paths.scene
    let mut material_path = paths.material
    let mut default_material = if file_exists(material_path) || file_exists(material_path + ".gmaterial") {
        match load_material_asset_file(material_path) {
            Option::Some(material) => material Option::None => StandardMaterial::editor_default()
        }
    } else {
        StandardMaterial::editor_default()
    }
    let mut texture_loader = TextureLoader::new()
    let mut texture_upload = Option[TextureUpload]::None
    let mut texture_upload_path = ""
    let mut texture_upload_project = ""
    let mut texture_upload_importing = false
    let mut bound_texture_path = ""
    let mut texture_restore_path = default_material.base_color_texture()
    let mut normal_restore_path = default_material.normal_texture()
    let mut bound_normal_path = ""
    let mut texture_loading_normal = false
    let mut texture_upload_normal = false
    let mut status_message = if project_valid(paths) {
        "Loading project " + project_root
    } else {
        "No project loaded"
    }
    let mut editor_scene = Scene::new()
    let mut cube_entities = Vec[u64]::new()
    let mut cube_positions = Vec[Vec3]::new()
    let mut cube_rotations = Vec[Vec3]::new()
    let mut cube_scales = Vec[Vec3]::new()
    let mut actor_names = Vec[str]::new()
    let mut actor_visibilities = Vec[bool]::new()
    let mut cube_mesh_names = Vec[str]::new()
    let mut render_rotations = Vec[Vec3]::new()
    let mut scene_loaded = false
    if file_exists(scene_path) {
        match SceneAsset::parse(project_sources.scene) {
            Option::Some(asset) => {
                let mut actor_index = 0_usize
                while actor_index < asset.len() {
                    match asset.actor(actor_index) {
                        Option::Some(actor) => {
                            match actor_mesh_name(actor.kind()) {
                                Option::Some(mesh_name) => {
                                    let transform = actor.transform()
                                    let actor_name = if actor.name() == "" {
                                        actor_name_for_mesh(mesh_name, cube_entities.len() as u32 + 1_u32)
                                    } else {
                                        actor.name()
                                    }
                                    let entity = actor.id()
                                    editor_scene.create_entity_with_id(entity, actor_name, transform)
                                    editor_scene.set_blueprint(entity, actor.blueprint())
                                    editor_scene.set_component(entity, actor.component())
                                    editor_scene.set_renderable(entity,
                                        Option[Renderable]::Some(Renderable::new(MeshId::new(1_u64),
                                                MaterialId::new(1_u64),)),)
                                    cube_entities.push(entity)
                                    cube_positions.push(transform.position())
                                    cube_rotations.push(transform.rotation())
                                    cube_scales.push(transform.scale())
                                    actor_names.push(actor_name)
                                    actor_visibilities.push(actor.visible())
                                    cube_mesh_names.push(mesh_name)
                                    editor_scene.set_visible(entity, actor.visible())
                                    render_rotations.push(transform.rotation())
                                }
                                Option::None => {
                                }
                            }
                        }
                        Option::None => {
                        }
                    }
                    actor_index = actor_index + 1_usize
                }
                let mut parent_index = 0_usize
                while parent_index < asset.len() {
                    match asset.actor(parent_index) {
                        Option::Some(actor) => {
                            editor_scene.set_parent(actor.id(), actor.parent())
                        }
                        Option::None => {
                        }
                    }
                    parent_index = parent_index + 1_usize
                }
                if asset.source_version() < 4_u32 {
                    ensure_scene_environment(editor_scene)
                }
                scene_loaded = true
                status_message = "Loaded " + scene_path
            }
            Option::None => {
                status_message = "Unable to parse " + scene_path
            }
        }
    }
    let initial_actors = editor_actors_from_scene(editor_scene, cube_entities, cube_mesh_names)
    cube_entities = initial_actors.ids() actor_names = initial_actors.names() cube_mesh_names = initial_actors.mesh_names()
    actor_visibilities = initial_actors.visibilities() cube_positions = initial_actors.positions()
    cube_rotations = initial_actors.rotations() cube_scales = initial_actors.scales() render_rotations = cube_rotations
    let mut object_count = cube_entities.len() as u32
    let mut project_loaded = project_valid(paths) && scene_loaded
    selected_cube = if object_count > 0_u32 {
        1_u32
    } else {
        0_u32
    }
    selected = if selected_cube > 0_u32 {
        actor_name_at(actor_names, selected_cube)
    } else {
        "Nothing selected"
    }
    selected_cubes = selection_single(selected_cube)
    let mut command_state = EditorState::with_assets(editor_scene, cube_entities, cube_mesh_names)
    command_state.configure_project(project_loaded)
    if simulating {
        let started = command_state.execute(GrapheneCommand::StartSimulation(
                SimulationCommand::new(simulation_mode)))
        if !started.success() {
            simulation_mode = ""
            simulating = false
            status_message = started.message()
        }
    }
    if selected_cube > 0_u32 {
        match cube_entities.get(0_usize) {
            Option::Some(actor) => {
                let _selected = command_state.execute(GrapheneCommand::Select(
                        ActorSelectionCommand::new(Option[u64]::Some(actor))))
            }
            Option::None => {
            }
        }
    }
    mkdir_all(home_dir() + "/.graphene")
    let requested_automation_endpoint = match env("GRAPHENE_AUTOMATION_ENDPOINT") {
        Option::Some(value) => {
            value
        }
        Option::None => {
            home_dir() + "/.graphene/automation.sock"
        }
    }
    let automation_token = match env("GRAPHENE_AUTOMATION_TOKEN") {
        Option::Some(value) => {
            value
        }
        Option::None => {
            automation_capability_token()
        }
    }
    let automation_endpoint = if automation_token == "" {
        ""
    } else {
        requested_automation_endpoint
    }
    let automation_scopes = if env("GRAPHENE_AUTOMATION_READ_ONLY").is_some() {
        AutomationScopes::read_only()
    } else {
        AutomationScopes::all()
    }
    let mut approval_broker = ApprovalBroker::new()
    let automation_listener = AutomationListener::listen(automation_endpoint)
    let automation_discovery_path = home_dir() + "/.graphene/automation.json"
    if !automation_listener.available() {
        println("Graphene Automation API: " + automation_listener.error())
        if file_exists(automation_discovery_path) {
            remove_file(automation_discovery_path)
        }
    } else {
        let mut discovery_fields = Vec[(str, Json)]::new()
        discovery_fields.push(field("endpoint", Json::String(automation_endpoint)))
        discovery_fields.push(field("token", Json::String(automation_token)))
        discovery_fields.push(field("protocol", Json::Number("1")))
        let mut scope_values = Vec[Json]::new()
        for scope in automation_scopes.names() {
            scope_values.push(Json::String(scope))
        }
        discovery_fields.push(field("scopes", Json::Array(scope_values)))
        if write_file(automation_discovery_path, stringify(Json::Object(discovery_fields)) + "\n") !=
        0_i32 ||
        !automation_secure_file(automation_discovery_path) {
            println("Graphene Automation API: unable to write secure discovery file")
        }
    }
    let mut actor_name_editor = TextEditor::new(selected)
    let mut actor_name_focused = false
    let mut actor_name_before_edit = selected
    let mut transform_field = ""
    let mut transform_editor = TextEditor::new("")
    let mut transform_invalid = false
    let mut outliner_search = TextEditor::new("")
    let mut outliner_search_focused = false
    let mut asset_search = TextEditor::new("")
    let mut asset_search_focused = false
    let mut simulation_started = perf_counter_ms()
    let mut code_focused = false
    let mut active_tool = "move"
    let mut camera_mode = match env("GRAPHENE_CAMERA_MODE") {
        Option::Some(mode) => {
            if mode == "top" || mode == "front" || mode == "right" {
                mode
            } else {
                "perspective"
            }
        }
        Option::None => {
            "perspective"
        }
    }
    let mut shading_mode = match env("GRAPHENE_SHADING_MODE") {
        Option::Some(mode) => {
            if mode == "lit" || shading_mode_value(mode) > 0_u32 {
                mode
            } else {
                "lit"
            }
        }
        Option::None => {
            "lit"
        }
    }
    // Play uses the game-facing Lit renderer, but the editor diagnostic mode
    // is restored verbatim when Play ends.
    let mut editor_shading_mode = shading_mode_value(shading_mode)
    let mut editor_shading_mode_saved = false
    let mut skybox_mode = match env("GRAPHENE_SKYBOX") {
        Option::Some(mode) => {
            if mode == "sunset" || mode == "night" {
                mode
            } else {
                "clear"
            }
        }
        Option::None => {
            "clear"
        }
    }
    let mut camera_speed = match env("GRAPHENE_CAMERA_SPEED") {
        Option::Some(mode) => {
            if mode == "0.25" || mode == "0.5" || mode == "2" || mode == "4" {
                mode
            } else {
                "1"
            }
        }
        Option::None => {
            "1"
        }
    }
    let mut grid_visible = match env("GRAPHENE_GRID_VISIBLE") {
        Option::Some(value) => {
            value != "0" && value != "false"
        }
        Option::None => {
            true
        }
    }
    let mut snap_settings = GizmoSnap::new()
    let mut transform_editing = false
    let mut edit_start_position = Vec3::zero()
    let mut edit_start_rotation = Vec3::zero()
    let mut edit_start_scale = Vec3::new(1.0_f32, 1.0_f32, 1.0_f32)
    let mut script_path = paths.script
    let mut game_manifest = paths.manifest
    let mut build_log_path = paths.build_log
    let mut build_completion_path = paths.build_completion
    let compiler = match env("ENCORE_COMPILER") {
        Option::Some(path) => {
            path
        }
        Option::None => {
            "encore"
        }
    }
    let mut code_editor = TextEditor::new(if project_loaded && file_exists(script_path) {
            project_sources.script
        } else {
            ""
        }
    )
    let mut console_editor = TextEditor::new("scene.rename {\"actor\":1,\"name\":\"Player\"}")
    let mut console_focused = false
    let mut text_selection_target = ""
    let mut console_output = console_help()
    let mut project_dirty = false
    let mut building = false
    let mut build_output = "Gameplay project has not been built"
    let mut build_profile = "debug"
    let mut build_profile_open = false
    let mut run_after_build = false
    let mut build_handle = Option[JoinHandle[i32]]::None
    let mut autobuild_pending = env("GRAPHENE_AUTOBUILD").is_some()
    let mut hovered = match env("GRAPHENE_HOVER_TARGET") {
        Option::Some(target) => {
