            } elif !simulation_mode_is_play(simulation_mode) && event.key() == 2_u32 && viewport_location.is_some()
            {
                panning = true orbit_x = event.x() orbit_y = event.y()
            } elif !simulating && event.key() == 1_u32 && viewport_location.is_some() {
                match viewport_location {
                    Option::Some(point) => {
                        let picked = viewport_renderer.pick_cube_at(point.0 * window.pixel_density(),
                            point.1 * window.pixel_density(), camera_yaw, camera_pitch,
                            camera_distance, camera_target,)
                        if picked > 0_u32 {
                            selected_cube = picked
                            selected = actor_name_at(actor_names, picked)
                            selected_asset = ""
                            if active_tool == "move" {
                                match viewport_renderer.ground_point_at(point.0 * window.pixel_density(),
                                    point.1 * window.pixel_density(), camera_yaw, camera_pitch,
                                    camera_distance, camera_target,) {
                                    Option::Some(ground) => {
                                        move_offset = actor_world_position(editor_scene, cube_entities,
