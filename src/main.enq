fn output_panel(simulation_mode: str, building: bool, status_message: str, build_output: str,
    console_editor: TextEditor, console_focused: bool, console_output: str,
    icons: EditorIcons,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut output = Widget::panel("output").with_added_classes(panel_classes() + " g-output-panel")
    let mut output_tabs = Widget::panel("output-tabs").with_added_classes("g-console-tabs")
    output_tabs.push(pane_heading("output-tab", "Command Console", icons.terminal, 156.0_f32))
    output.push(output_tabs)
    output.push(log_line("EDITOR", status_message, "tone-muted"))
    output.push(log_line("BUILD", build_output, if building {
                "tone-warning"
            } else {
                if build_output == "Gameplay build succeeded" {
                    "tone-success"
                } else {
                    "tone-muted"
                }
            }
            ,))
    output.push(log_line("WORLD", simulation_world_message(simulation_mode),
            if simulating {
                "tone-success"
            } else {
                "tone-muted"
            }
            ,))
    output.push(Widget::label(console_output).with_added_classes("g-console-output"))
    output.push(Widget::input("command-console", console_editor.value())
        .with_focus(console_focused)
        .with_selection(console_editor.selection_start(), console_editor.selection_end()).with_added_classes("g-console-input" + if console_focused {
                " state-console-focused"
            } else {
                ""
            }
        ))
    ret output
}

fn axis_step_button(id: str, icon: SvgDocument, axis: str, hovered: str, disabled: bool) -> Widget {
    ret Widget::icon_button(id, "", icon).with_disabled(disabled).with_added_classes("g-axis-step-button" + if axis == "X" {
            " state-axis-X"
        } else {
            ""
        }
        + if axis == "Y" {
            " state-axis-Y"
        } else {
            ""
        }
    )
}

fn axis_stepper(axis: str, minus_id: str, plus_id: str, icons: EditorIcons, hovered: str, disabled: bool)
-> Widget {
    let mut group = Widget::panel(minus_id + "-axis").with_added_classes("g-axis-stepper")
    group.push(Widget::label(axis).with_added_classes("g-axis-stepper-label" + if axis == "X" {
                " state-axis-X"
            } else {
                ""
            }
            + if axis == "Y" {
                " state-axis-Y"
            } else {
                ""
            }
        ))
    group.push(axis_step_button(minus_id, icons.minus, axis, hovered, disabled))
    group.push(axis_step_button(plus_id, icons.add, axis, hovered, disabled))
    ret group
}

fn actor_row(id: str, name: str, kind: str, icon: SvgDocument, selected: bool, visible: bool, hovered:
    str, depth: u32,
    icons: EditorIcons,) -> Widget {
    let mut row = Widget::panel(id).with_added_classes("g-actor-row" + if selected {
            " state-selected"
        } else {
            ""
        }
    )
    row.push(Widget::panel("").with_added_classes("g-actor-selection-mark" + if selected {
                " state-selected"
            } else {
                ""
            }
        ))
    if depth > 0_u32 {
        row.push(Widget::panel("").with_flex(10.0_f32 * depth as f32, 0.0_f32).with_added_classes("g-actor-indent"))
    }
    row.push(Widget::icon("", icon).with_added_classes("g-actor-icon" + if selected {
                " state-selected"
            } else {
                ""
            }
        ))
    row.push(Widget::label(name).with_added_classes("g-actor-name" + if selected {
                " state-selected"
            } else {
                ""
            }
        ))
    row.push(Widget::label(kind).with_added_classes("g-actor-kind"))
    if depth > 0_u32 {
        row.push(Widget::icon_button("toggle-visible-" + id, "", icons.visible).with_added_classes("g-actor-visibility" + if selected {
                    " state-selected"
                } else {
                    ""
                }
                + if visible {
                    " state-visible"
                } else {
                    ""
                }
            ))
    } else {
        row.push(Widget::icon("", icons.visible).with_added_classes("g-actor-editor-badge"))
    }
    ret row
}

fn actor_index_for_id(ids: Vec[u64], id: u64) -> u32 {
    let mut index = 0_usize
    while index < ids.len() {
        match ids.get(index) {
            Option::Some(value) => {
                if value == id {
                    ret index as u32 + 1_u32
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret 0_u32
}

fn actor_hierarchy_depth(actor: usize, ids: Vec[u64], parents: Vec[Option[u64]]) -> u32 {
    let mut depth = 1_u32
    let mut steps = 0_usize
    let mut parent = match parents.get(actor) {
        Option::Some(value) => value
        Option::None => Option[u64]::None
    }
    while parent.is_some() && steps < ids.len() {
        match parent {
            Option::Some(parent_id) => {
                let parent_index = actor_index_for_id(ids, parent_id)
                if parent_index == 0_u32 {
                    break
                }
                depth = depth + 1_u32
                parent = match parents.get((parent_index - 1_u32) as usize) {
                    Option::Some(value) => value
                    Option::None => Option[u64]::None
                }
            }
            Option::None => {
                break
            }
        }
        steps = steps + 1_usize
    }
    ret depth
}

fn collection_row(name: str, icons: EditorIcons) -> Widget {
    let mut row = Widget::panel("collection-" + name).with_added_classes("g-collection-row")
    row.push(Widget::icon("", icons.expanded).with_added_classes("g-collection-row-2"))
    row.push(Widget::icon("", icons.folder).with_added_classes("g-collection-row-3"))
    row.push(Widget::label(name).with_added_classes("g-collection-row-4"))
    ret row
}

fn hierarchy(selected: str, actor_ids: Vec[u64], actor_parents: Vec[Option[u64]], actor_names: Vec[str],
    actor_visibilities: Vec[bool],
    object_count: u32, search_editor: TextEditor, search_focused: bool, show_editor_actors: bool, show_hidden_actors:
    bool,
    hovered: str, icons: EditorIcons, ui: EditorUiState,) -> Widget {
    let query = search_editor.value()
    let mut visible_geometry = 0_u32
    let mut count_index = 0_usize
    while count_index < actor_ids.len() {
        let actor = count_index as u32 + 1_u32
        if (show_editor_actors ||(ui.actors.kind(actor_ids.get(count_index).unwrap_or(0_u64)) == "" || ui.actors.kind(actor_ids.get(count_index).unwrap_or(0_u64)) == "audio-source" || ui.actors.kind(actor_ids.get(count_index).unwrap_or(0_u64)) == "skeletal-mesh")) && outliner_actor_matches(query, actor_name_at(actor_names, actor), bool_at(actor_visibilities,
                actor, true,), show_hidden_actors) {
            visible_geometry = visible_geometry + 1_u32
        }
        count_index = count_index + 1_usize
    }
    let visible_count = visible_geometry
    let mut panel = Widget::panel("hierarchy").with_attribute("data-luma-scrollable", "true").with_added_classes(panel_classes() + " g-hierarchy")
    let mut search = Widget::panel("outliner-tools").with_added_classes("g-hierarchy-2")
    search.push(editable_search_field("scene-search", search_editor, search_focused, "Search actors",
            icons.search, 0.0_f32, 1.0_f32,))
    search.push(Widget::icon_button("outliner-add", "", icons.add).with_disabled(ui.actors.disabled)
        .with_added_classes(compact_icon_classes(hovered == "outliner-add") + " g-hierarchy-3"))
    search.push(Widget::icon_button("outliner-settings", "", icons.settings)
        .with_added_classes(compact_icon_classes(hovered == "outliner-settings") + " g-hierarchy-4"))
    panel.push(search)
    if visible_geometry > 0_u32 {
        panel.push(collection_row("Scene Actors", icons))
    }
    let mut index = 0_usize
    while index < actor_ids.len() {
        let actor = index as u32 + 1_u32
        let name = actor_name_at(actor_names, actor)
        let visible = bool_at(actor_visibilities, actor, true)
        if (show_editor_actors ||(ui.actors.kind(actor_ids.get(index).unwrap_or(0_u64)) == "" || ui.actors.kind(actor_ids.get(index).unwrap_or(0_u64)) == "audio-source" || ui.actors.kind(actor_ids.get(index).unwrap_or(0_u64)) == "skeletal-mesh")) && outliner_actor_matches(query, name, visible, show_hidden_actors) {
            let kind = ui.actors.kind(actor_ids.get(index).unwrap_or(0_u64))
            panel.push(actor_row("entity-cube-" + Debug::fmt(actor), name, if kind == "skeletal-mesh" {
                        "SKIN"
                    } elif kind == "particle-system" {
                        "VFX"
                    } elif kind == "audio-source" {
                        "AUDIO"
                    } elif kind == "camera" {
                        "CAM"
                    } elif kind == "sky-atmosphere" || kind == "sky-light" || kind == "cloud-layer" || kind == "height-fog" || kind == "weather-controller" || kind == "weather-volume" {
                        "ENV"
                    } elif kind != "" {
                        "LIGHT"
                    } else {
                        "MESH"
                    }
                    , if kind == "skeletal-mesh" {
                        icons.mesh
                    } elif kind == "audio-source" {
                        icons.content.sound
                    } elif kind == "camera" {
                        icons.camera
                    } elif kind != "" {
                        icons.light
                    } else {
                        icons.mesh
                    }
                    , selected
                    == name,
                    visible, hovered, actor_hierarchy_depth(index, actor_ids, actor_parents), icons,))
        }
        index = index + 1_usize
    }
    if visible_count == 0_u32 {
        panel.push(Widget::label("No actors match current filters").with_added_classes("g-hierarchy-5"))
    }
    panel.push(Widget::spacer(1.0_f32))
    ret panel
}

fn viewport(simulation_mode: str, dragging: bool, object_count: u32,
    autolod_stats: str, selected: str, active_tool: str,
    camera_mode: str,
    shading_mode: str, skybox_mode: str, camera_speed: str, grid_visible: bool, snap_settings: GizmoSnap, open_viewport_menu:
    str, hovered: str,
    compact: bool, icons: EditorIcons, ui: EditorUiState,) -> Widget {
    let simulating = simulation_mode_active(simulation_mode)
    let mut viewport = Section::new("viewport").with_classes(state_classes("viewport", dragging))
    let mut viewport_bar = Nav::new("viewport-bar").with_classes("viewport-bar")
    if simulation_mode_is_play(simulation_mode) {
        viewport_bar.push(Widget::icon("", icons.play).with_added_classes("g-viewport"))
        viewport_bar.push(label("PLAY IN EDITOR").with_added_classes("size-112-grow-0"))
        viewport_bar.push(Widget::spacer(1.0_f32))
        viewport_bar.push(label("Esc to stop").with_added_classes("size-78-grow-0"))
    } else {
        viewport_bar.push(selector_control("viewport-camera", camera_mode_name(camera_mode), icons.view,
                icons.expanded, 108.0_f32,
                hovered == "viewport-camera",))
        viewport_bar.push(selector_control("viewport-lit", shading_mode_name(shading_mode), icons.lighting,
                icons.expanded, 112.0_f32,
                hovered == "viewport-lit" || open_viewport_menu == "shading",))
        let mut tools = segmented_group()
        tools.push(Widget::icon_button("tool-select", "", icons.select).with_tag("button")
            .with_classes(state_classes("viewport-tool", active_tool == "select")))
        tools.push(Widget::icon_button("tool-move", "", icons.move).with_tag("button")
            .with_classes(state_classes("viewport-tool", active_tool == "move")))
        tools.push(Widget::icon_button("tool-rotate", "", icons.rotate).with_tag("button")
            .with_classes(state_classes("viewport-tool", active_tool == "rotate")))
        tools.push(Widget::icon_button("tool-scale", "", icons.scale).with_tag("button")
            .with_classes(state_classes("viewport-tool", active_tool == "scale")))
        viewport_bar.push(tools)
        for tool in vec!["move", "rotate", "scale"] {
            viewport_bar.push(snap_toolbar_control(tool, snap_settings, ui, icons))
        }
        viewport_bar.push(Widget::icon_button("ui-viewport-settings", "", icons.settings).with_classes("toolbar-icon").with_attribute("aria-label", "Viewport settings"))
        viewport_bar.push(Widget::spacer(1.0_f32))

    }
    viewport.push(viewport_bar)
    if !simulation_mode_is_play(simulation_mode) && open_viewport_menu == "camera" {
        viewport.push(viewport_camera_strip(camera_mode, hovered, icons))
    }
    if !simulation_mode_is_play(simulation_mode) && open_viewport_menu == "speed" {
        viewport.push(viewport_speed_strip(camera_speed, hovered, icons))
    }
    if !simulation_mode_is_play(simulation_mode) && open_viewport_menu == "skybox" {
        viewport.push(viewport_skybox_strip(skybox_mode, hovered, icons))
    }
    viewport.push(Widget::render_surface("viewport-surface")
        .with_classes("viewport-surface")
        .with_secondary_pointer_lock().with_added_classes("g-viewport-3"))
    let mut viewport_status = Footer::new("viewport-status").with_classes("viewport-status")
    if simulation_mode_is_play(simulation_mode) {
        viewport_status.push(viewport_status_item("Game Camera", icons.camera, 108.0_f32, "tone-success"))
        viewport_status.push(label("Actors " + Debug::fmt(object_count)).with_added_classes("size-64-grow-0"))
        viewport_status.push(Widget::spacer(1.0_f32))
        viewport_status.push(label("Editor navigation locked").with_added_classes("size-146-grow-0"))
    } else {
        if shading_mode != "lit" && shading_mode != "unlit" {
            viewport_status.push(viewport_status_item(
                    if shading_mode == "triangles" {
                        "AutoLOD Triangles + Edges"
                    } else {
                        "AutoLOD " + shading_mode_name(shading_mode)
                    }
                    ,
                    icons.lighting, 154.0_f32,
                    "tone-success",))
            viewport_status.push(label(autolod_stats)
                .with_id("viewport-autolod-statistics").with_added_classes("size-430-grow-0"))
        }
        if shading_mode == "lit" || shading_mode == "unlit" {
            viewport_status.push(viewport_status_item(selected,
                    if selected == "Camera" {
                        icons.camera
                    } else {
                        if selected == "Directional Light" {
                            icons.light
                        } elif selected == "Nothing selected" {
                            icons.select
                        } else {
                            icons.mesh
                        }
                    }
                    ,
                    if compact {
                        104.0_f32
                    } else {
                        132.0_f32
                    }
                    , "tone-info",))
            viewport_status.push(viewport_status_item(tool_name(active_tool),
                    if active_tool == "move" {
                        icons.move
                    } else {
                        if active_tool == "rotate" {
                            icons.rotate
                        } else {
                            if active_tool == "scale" {
                                icons.scale
                            } else {
                                icons.select
                            }
                        }
                    }
                    , if compact {
                        64.0_f32
                    } else {
                        76.0_f32
                    }
                    , "tone-warning",))
            if !compact {
                viewport_status.push(label("Actors " + Debug::fmt(object_count))
                    .with_added_classes("size-64-grow-0"))
            }
        }
        if shading_mode == "lit" || shading_mode == "unlit" {
            viewport_status.push(Widget::spacer(1.0_f32))
            viewport_status.push(label(if compact {
                        "RMB Orbit/Fly   WASD/QE   Wheel Zoom"
                    } else {
                        "RMB Orbit/Fly   WASD/QE   MMB Pan   Wheel Zoom   F Focus"
                    }
                )
                .with_flex(if compact {
                        198.0_f32
                    } else {
                        248.0_f32
                    }
                    , 0.0_f32,))
        }
    }
    viewport.push(viewport_status)
    if !simulating && ui.actors.component_kind() == "camera" && ui.actors.preview && !ui.actors.pilot {
        let aspect = match ui.actors.component {
            Camera(settings) => settings.aspect _ => 1.7777778_f32
        }
        let height = if aspect < 1.5_f32 {
            160.0_f32
        } else {
            240.0_f32 / aspect
        }
        let width = height * aspect
        let mut preview = Widget::panel("camera-preview").with_classes("g-camera-preview").with_css_variable("--camera-preview-width", Debug::fmt(width + 4.0_f32) + "px").with_css_variable("--camera-preview-height", Debug::fmt(height + 27.0_f32) + "px").with_css_variable("--camera-preview-image-width", Debug::fmt(width) + "px").with_css_variable("--camera-preview-image-height", Debug::fmt(height) + "px")
        preview.push(Widget::label(selected).with_classes("g-camera-preview-title"))
        preview.push(Widget::render_surface("camera-preview-surface").with_classes("g-camera-preview-surface").with_geometry_basis(height))
        viewport.push(preview)
    }
    if ui.actors.pilot {
        viewport.push(Widget::label("PILOT CAMERA  ·  Esc to exit").with_id("camera-pilot-banner").with_classes("g-camera-pilot-banner"))
    }
    ret viewport
}

fn viewport_reactive_target(target: str) -> bool {
    ret target == "viewport-camera" || target == "viewport-lit" || target == "viewport-sky" || target == "viewport-speed" ||
    target == "camera-perspective" || target == "camera-top" || target == "camera-front" ||
    target == "camera-right" || is_shading_target(target) ||
    target == "speed-025" || target == "speed-05" || target == "speed-1" ||
    target == "speed-2" || target == "speed-4" || target == "grid-toggle" ||
    target.contains("snap-toggle-") || target.contains("ui-snap-step-") || target.contains("snap-value-") ||
    target == "skybox-clear" || target == "skybox-sunset" || target == "skybox-night" ||
    target == "tool-select" || target == "tool-move" ||
    target == "tool-rotate" || target == "tool-scale"
}

fn selection_reactive_target(target: str) -> bool {
    ret target == "entity-camera" || target == "entity-light" ||
    (target.contains("entity-cube-") && !target.contains("toggle-visible-")) ||
    target == "asset-cube" || target == "asset-material" || target == "asset-script" ||
    target.contains("asset-imported-mesh-") || target.contains("autolod-")
}

fn scene_reactive_target(target: str) -> bool {
    ret target == "undo" || target == "redo" || target == "duplicate" ||
    target == "delete" || target == "menu-undo-action" ||
    target == "menu-redo-action" || target == "menu-duplicate-action" ||
    target == "menu-delete-action" || target == "add-actor-cube" ||
    target == "add-actor-plane" || target == "add-actor-sphere" || target == "add-actor-camera" || target == "add-actor-directional-light" || target == "add-actor-point-light" || target == "add-actor-spot-light" || target == "add-actor-sky-atmosphere" || target == "add-actor-sky-light" || target == "add-actor-cloud-layer" || target == "add-actor-height-fog" || target == "add-actor-weather-controller" || target == "add-actor-weather-volume" ||
    target.contains("add-actor-imported-") || target.contains("toggle-visible-") ||
    target == "parent-none" || target.contains("parent-actor-")
}

fn details_reactive_target(target: str) -> bool {
    ret target == "entity-name" || target == "parent-selector" ||
    target == "parent-none" || target.contains("parent-actor-") ||
    target.contains("transform-") || target.contains("move-") ||
    target.contains("rotate-") || target.contains("scale-")
}

fn overlay_reactive_target(target: str) -> bool {
    ret target == "menu-file" || target == "menu-edit" || target == "menu-window" ||
    target == "menu-tools" || target == "outliner-add" ||
    target == "outliner-settings" || target.contains("menu-") ||
    target.contains("unsaved-") || target.contains("approval-") || target.contains("project-") ||
    target.contains("file-picker") || target == "asset-import-confirm" || target == "asset-import-character" ||
    target == "outliner-show-editor-actors" ||
    target == "outliner-show-hidden-actors" || target == "content-add" ||
    target == "viewport-lit" || is_shading_target(target)
}

fn pending_approval_id(approvals: ApprovalBroker) -> str {
    match approvals.pending() {
        Option::Some(request) => {
            ret request.id()
        }
        Option::None => {
        }
    }
    ret ""
}

fn overlay_visible(open_menu: str, add_actor_open: bool, outliner_settings_open: bool,
    project_dialog_mode: str, unsaved_action: str, hovered: str, approval_id: str,) -> bool {
    ret open_menu != "" || add_actor_open || outliner_settings_open ||
    project_dialog_mode != "" || unsaved_action != "" ||
    approval_id != ""
}

fn workspace_structure_target(target: str) -> bool {
    ret target == "menu-outliner-action" || target == "menu-details-action" ||
    target == "menu-content-action" || target == "menu-reset-layout"
}

fn viewport_bounds(layout: WidgetLayout) -> Rect {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret bounds
        }
        Option::None => {
            ret Rect::new(0.0_f32, 0.0_f32, 960.0_f32, 540.0_f32)
        }
    }
}

fn viewport_width(layout: WidgetLayout) -> u32 {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret if bounds.width() >= 64.0_f32 {
                bounds.width() as u32
            } else {
                64_u32
            }
        }
        Option::None => {
            ret 960_u32
        }
    }
}

fn viewport_height(layout: WidgetLayout) -> u32 {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret if bounds.height() >= 64.0_f32 {
                bounds.height() as u32
            } else {
                64_u32
            }
        }
        Option::None => {
            ret 540_u32
        }
    }
}

fn ui_cache_exclusions() -> Vec[str] {
    let mut targets = Vec[str]::new()
    targets.push("overlay-layer")
    targets.push("hover-tooltip")
    targets.push("viewport-shading-menu")
    ret targets
}

fn viewport_pixel_x(layout: WidgetLayout, density: f32) -> u32 {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret(bounds.x() * density) as u32
        }
        Option::None => {
            ret 0_u32
        }
    }
}

fn viewport_pixel_y(layout: WidgetLayout, density: f32) -> u32 {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            ret(bounds.y() * density) as u32
        }
        Option::None => {
            ret 0_u32
        }
    }
}

fn viewport_point(layout: WidgetLayout, x: f32, y: f32) -> Option[(f32, f32)] {
    match layout.find_bounds("viewport-surface") {
        Option::Some(bounds) => {
            let local_x = x - bounds.x()
            let local_y = y - bounds.y()
            if local_x >= 0.0_f32 && local_y >= 0.0_f32 &&
            local_x < bounds.width() && local_y < bounds.height() {
                ret Option[(f32, f32)]::Some((local_x, local_y))
            }
        }
        Option::None => {
        }
    }
    ret Option[(f32, f32)]::None
}

fn viewport_point_extent(pixel_x: u32, pixel_y: u32, pixel_width: u32,
    pixel_height: u32, density: f32, x: f32, y: f32,) ->
Option[(f32, f32)] {
    let scale = if density <= 0.0_f32 {
        1.0_f32
    } else {
        density
    }
    let local_x = x -(pixel_x as f32) / scale
    let local_y = y -(pixel_y as f32) / scale
    let width =(pixel_width as f32) / scale
    let height =(pixel_height as f32) / scale
    ret if local_x >= 0.0_f32 && local_y >= 0.0_f32 &&
    local_x < width && local_y < height {
        Option[(f32, f32)]::Some((local_x, local_y))
    } else {
        Option[(f32, f32)]::None
    }
}

// The retained hit-test can resolve the render-surface behind the compact
// toolbar while the icon glyph is under the pointer.  Resolve the four tool
// buttons from their actual layout rectangles as a small, deterministic
// fallback so their hover state never depends on child hit-test details.
fn toolbar_hover_target(layout: WidgetLayout, x: f32, y: f32) -> str {
    // The toolbar is confined to the top editor chrome. Avoid recursively
    // traversing the large owned layout tree for high-rate viewport motion.
    if y > 96.0_f32 {
        ret ""
    }
    let mut targets = Vec[str]::new()
    targets.push("tool-select")
    targets.push("tool-move")
    targets.push("tool-rotate")
    targets.push("tool-scale")
    for target in targets {
        match layout.find_bounds(target) {
            Option::Some(bounds) => {
                if x >= bounds.x() && y >= bounds.y() && x < bounds.right() && y < bounds.bottom() {
                    ret target
                }
            }
            Option::None => {
            }
        }
    }
    ret ""
}

fn gizmo_mode(tool: str) -> u32 {
    if tool == "move" {
        ret 1_u32
    }
    if tool == "rotate" {
        ret 2_u32
    }
    if tool == "scale" {
        ret 3_u32
    }
    ret 0_u32
}

fn position_at(positions: Vec[Vec3], cube_index: u32) -> Vec3 {
    if cube_index == 0_u32 {
        ret Vec3::zero()
    }
    match positions.get((cube_index - 1_u32) as usize) {
        Option::Some(position) => {
            ret position
        }
        Option::None => {
            ret Vec3::zero()
        }
    }
}

fn rotation_at(rotations: Vec[Vec3], cube_index: u32) -> Vec3 {
    if cube_index == 0_u32 {
        ret Vec3::zero()
    }
    match rotations.get((cube_index - 1_u32) as usize) {
        Option::Some(rotation) => {
            ret rotation
        }
        Option::None => {
            ret Vec3::zero()
        }
    }
}

fn copy_vec3_values(values: Vec[Vec3]) -> Vec[Vec3] {
    let mut result = Vec[Vec3]::new()
    for value in values {
        result.push(value)
    }
    ret result
}

fn scale_at(scales: Vec[Vec3], cube_index: u32) -> Vec3 {
    if cube_index == 0_u32 {
        ret Vec3::new(1.0_f32, 1.0_f32, 1.0_f32)
    }
    match scales.get((cube_index - 1_u32) as usize) {
        Option::Some(scale) => {
            ret scale
        }
        Option::None => {
            ret Vec3::new(1.0_f32, 1.0_f32, 1.0_f32)
        }
    }
}

fn mesh_name_at(mesh_names: Vec[str], cube_index: u32) -> str {
    if cube_index == 0_u32 {
        ret ""
    }
    match mesh_names.get((cube_index - 1_u32) as usize) {
        Option::Some(value) => {
            ret value
        }
        Option::None => {
        }
    }
    ret ""
}

fn bool_at(values: Vec[bool], index: u32, fallback: bool) -> bool {
    if index == 0_u32 {
        ret fallback
    }
    match values.get((index - 1_u32) as usize) {
        Option::Some(value) => {
            ret value
        }
        Option::None => {
        }
    }
    ret fallback
}

fn actor_name_at(actor_names: Vec[str], actor_index: u32) -> str {
    if actor_index == 0_u32 {
        ret ""
    }
    match actor_names.get((actor_index - 1_u32) as usize) {
        Option::Some(value) => {
            if value != "" {
                ret value
            }
        }
        Option::None => {
        }
    }
    ret "Actor " + Debug::fmt(actor_index)
}

fn actor_name_for_mesh(mesh_name: str, actor_index: u32) -> str {
    if mesh_name == "@camera" {
        ret "Camera " + Debug::fmt(actor_index)
    }
    if mesh_name == "@directional-light" {
        ret "Directional Light " + Debug::fmt(actor_index)
    }
    if mesh_name == "@point-light" {
        ret "Point Light " + Debug::fmt(actor_index)
    }
    if mesh_name == "@spot-light" {
        ret "Spot Light " + Debug::fmt(actor_index)
    }
    if mesh_name == "@skeletal-mesh" {
        ret "Character " + Debug::fmt(actor_index)
    }
    if mesh_name == "@particle-system" {
        ret "Particle System " + Debug::fmt(actor_index)
    }
    if mesh_name == "@audio-source" {
        ret "Audio Source " + Debug::fmt(actor_index)
    }
    if mesh_name == "" {
        ret "Cube " + Debug::fmt(actor_index)
    }
    if mesh_name == "@plane" {
        ret "Plane " + Debug::fmt(actor_index)
    }
    if mesh_name == "@sphere" {
        ret "Sphere " + Debug::fmt(actor_index)
    }
    let mut base = mesh_name
    for suffix in vec![".gmesh", ".obj", ".fbx", ".glb", ".gltf"] {
        if ends(base, suffix) {
            base = base.slice_bytes(0, base.byte_len() - suffix.byte_len()) break
        }
    }
    ret base + " " + Debug::fmt(actor_index)
}

fn actor_kind_for_mesh(mesh_name: str) -> str {
    for kind in vec!["skeletal-mesh", "audio-source", "camera", "directional-light", "point-light", "spot-light", "sky-atmosphere", "sky-light", "cloud-layer", "height-fog", "weather-controller", "weather-volume"] {
        if mesh_name == "@" + kind {
            ret kind
        }
    }
    if mesh_name == "" {
        ret "cube"
    }
    if mesh_name == "@plane" {
        ret "plane"
    }
    if mesh_name == "@sphere" {
        ret "sphere"
    }
    ret "mesh:" + mesh_name
}

fn mesh_display_name(mesh_name: str) -> str {
    if mesh_name == "" {
        ret "Cube"
    }
    if mesh_name == "@plane" {
        ret "Plane"
    }
    if mesh_name == "@sphere" {
        ret "Sphere"
    }
    ret mesh_name
}

fn resolve_actor_gpu_mesh(mesh_name: str, plane: MeshId, sphere: MeshId,
    imported: Vec[ImportedMeshAsset], uploaded: Vec[MeshId],) -> MeshId {
    if mesh_name == "@plane" {
        ret plane
    }
    if mesh_name == "@sphere" {
        ret sphere
    }
    let mut index = 0_usize
    while index < imported.len() {
        match imported.get(index) {
            Option::Some(asset) => {
                if asset.name() == mesh_name {
                    match uploaded.get(index) {
                        Option::Some(mesh) => {
                            ret mesh
                        }
                        Option::None => {
                        }
                    }
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret MeshId::new(0_u64)
}

fn blueprint_render_error(classes: Vec[BlueprintClass], plane: MeshId, sphere: MeshId,
    imported: Vec[ImportedMeshAsset], uploaded: Vec[MeshId],) -> str {
    for class in classes {
        for component in class.asset.components {
            if component.kind == "static-mesh" {
                if component.mesh != "cube" && !resolve_actor_gpu_mesh(component.mesh, plane, sphere, imported, uploaded).valid() {
                    ret class.asset.name + "/" + component.name + ": mesh asset not found: " + component.mesh
                }
                if component.material != "" && component.material != "default" {
                    ret class.asset.name + "/" + component.name + ": material is not loaded: " + component.material
                }
            }
        }
    }
    ret ""
}

fn compose_camera_preview(window: Window, renderer: mut ViewportRenderer&, frame: mut PreparedFrame, scene: Scene, id: u64) -> bool {
    match frame.surface("camera-preview-surface") {
        Some(slot) => {
            match scene_camera(scene, id) {
                Some(view) => {
                    if (slot.pixel_width() > renderer.camera_preview_width() || slot.pixel_height() > renderer.camera_preview_height()) && renderer.camera_preview_image() != 0 {
                        if !window.release_external_vulkan_image(renderer.camera_preview_image() as u64) {
                            ret false
                        }
                    }
                    if !renderer.render_camera_preview(view, slot.pixel_width(), slot.pixel_height()) {
                        ret false
                    }
                    ret frame.submit_external("camera-preview-surface", slot.generation(), ExternalVulkanImage::new(renderer.camera_preview_image() as u64, renderer.camera_preview_width(), renderer.camera_preview_height(), renderer.camera_preview_layout()).with_region(0, 0, slot.pixel_width(), slot.pixel_height()))
                }
                None => {
                    ret false
                }
            }
        }
        None => {
            ret true
        }
    }
}

fn create_viewport_renderer(window: Window, width: u32, height: u32) -> ViewportRenderer<H> {
    let interop = window.vulkan_interop()
    if !interop.valid() {
        panic("Graphene Editor: Luma Vulkan interop is unavailable")
    }
    match ViewportRenderer::create_retained(interop.instance(), interop.physical_device(),
        interop.render_device(), interop.swapchain(), width, height,) {
        Option::Some(renderer) => {
            ret renderer
        }
        Option::None => {
            panic("Graphene Editor: unable to create retained Vulkan viewport")
            ret create_viewport_renderer(window, width, height)
        }
    }
}

fn transform_step_kind(target: str) -> str {
    if target == "move-x-minus" || target == "move-x-plus" || target == "move-y-minus" ||
    target == "move-y-plus" || target == "move-z-minus" || target == "move-z-plus" {
        ret "move"
    }
    if target == "rotate-x-minus" || target == "rotate-x-plus" || target == "rotate-y-minus" ||
    target == "rotate-y-plus" || target == "rotate-z-minus" || target == "rotate-z-plus" {
        ret "rotate"
    }
    if target == "scale-x-minus" || target == "scale-x-plus" || target == "scale-y-minus" ||
    target == "scale-y-plus" || target == "scale-z-minus" || target == "scale-z-plus" {
        ret "scale"
    }
    ret ""
}

fn stepped_vector(value: Vec3, target: str, amount: f32, minimum: f32) -> Vec3 {
    let signed = if target.contains("-minus") {
        0.0_f32 - amount
    } else {
        amount
    }
    let mut x = value.x() let mut y = value.y() let mut z = value.z()
    if target.contains("-x-") {
        x = x + signed
    } elif target.contains("-y-") {
        y = y + signed
    } elif target.contains("-z-") {
        z = z + signed
    }
    if minimum > 0.0_f32 {
        if x < minimum {
            x = minimum
        }
        if y < minimum {
            y = minimum
        }
        if z < minimum {
            z = minimum
        }
    }
    ret Vec3::new(x, y, z)
}

fn set_position(positions: mut Vec[Vec3], cube_index: u32, position: Vec3) -> Vec[Vec3] {
    let mut result = positions
    if cube_index > 0_u32 && cube_index <= result.len() as u32 {
        result.set((cube_index - 1_u32) as usize, position)
    }
    ret result
}

fn set_rotation(rotations: mut Vec[Vec3], cube_index: u32, rotation: Vec3) -> Vec[Vec3] {
    let mut result = rotations
    if cube_index > 0_u32 && cube_index <= result.len() as u32 {
        result.set((cube_index - 1_u32) as usize, rotation)
    }
    ret result
}

fn set_scale(scales: mut Vec[Vec3], cube_index: u32, scale: Vec3) -> Vec[Vec3] {
    let mut result = scales
    if cube_index > 0_u32 && cube_index <= result.len() as u32 {
        result.set((cube_index - 1_u32) as usize, scale)
    }
    ret result
}

fn rebuild_viewport_actors(renderer: mut ViewportRenderer&, previous_count: u32, meshes: Vec[str],
    visibilities: Vec[bool], positions: Vec[Vec3], rotations: Vec[Vec3], scales: Vec[Vec3], plane: MeshId,
    sphere: MeshId,
    imported: Vec[ImportedMeshAsset], uploaded: Vec[MeshId], selected_actor: u32, ids: Vec[u64], parents:
    Vec[Option[u64]],) ->() {
    let mut remaining = previous_count
    while remaining > 0_u32 {
        renderer.remove_cube(1_u32) remaining = remaining - 1_u32
    }
    renderer.sync_cubes(positions.len() as u32)
    let mut index = 0_usize
    while index < positions.len() {
        let actor = index as u32 + 1_u32
        let mesh_name = mesh_name_at(meshes, actor)
        let mesh = resolve_actor_gpu_mesh(mesh_name, plane, sphere, imported, uploaded)
        if mesh.valid() {
            renderer.set_cube_mesh(actor, mesh)
        }
        renderer.set_cube_visible(actor, bool_at(visibilities, actor, true))
        index = index + 1_usize
    }
    renderer.sync_cube_transforms_hierarchical(positions, rotations, scales, actor_parent_indices(ids,
            parents,))
    renderer.select_cube(selected_actor)
    ret()
}

fn ensure_scene_environment(scene: mut Scene) ->() {
    let mut has_sun = false let mut has_camera = false
    for entity in scene.entities() {
        if entity.component().kind() == "directional-light" {
            has_sun = true
        }
        if entity.component().kind() == "camera" {
            has_camera = true
        }
    }
    if !has_camera {
        let id = scene.create_entity("Camera", Transform::identity().with_position(Vec3::new(0.0_f32, 2.0_f32, 6.0_f32)).with_rotation(Vec3::new( - 0.2_f32, 0.0_f32, 0.0_f32)))
        scene.set_component(id, SceneComponent::Camera(CameraComponent::new()))
    }
    if !has_sun {
        let id = scene.create_entity("Directional Light", Transform::identity().with_position(Vec3::new(0.0_f32, 3.0_f32, 0.0_f32)).with_rotation(Vec3::new( - 0.08_f32, - 2.5_f32, 0.0_f32)))
        scene.set_component(id, SceneComponent::Light(LightComponent::new("directional-light")))
    }
}

fn scene_asset(positions: Vec[Vec3], rotations: Vec[Vec3], scales: Vec[Vec3]) -> SceneAsset {
    let mut asset = scene_asset_with_meshes(positions, rotations, scales, Vec[str]::new(), Vec[str]::new(), Vec[bool]::new(), Vec[u64]::new(), Vec[Option[u64]]::new())
    asset.add(SceneActor::new("Camera", "camera", Transform::identity().with_position(Vec3::new(0.0_f32, 2.0_f32, 6.0_f32)).with_rotation(Vec3::new( - 0.2_f32, 0.0_f32, 0.0_f32))))
    asset.add(SceneActor::new("Directional Light", "directional-light", Transform::identity().with_position(Vec3::new(0.0_f32, 3.0_f32, 0.0_f32)).with_rotation(Vec3::new( - 0.08_f32, - 2.5_f32, 0.0_f32))))
    ret asset
}

fn scene_asset_with_meshes(positions: Vec[Vec3], rotations: Vec[Vec3], scales: Vec[Vec3], actor_names:
    Vec[str],
    mesh_names: Vec[str], visibilities: Vec[bool], actor_ids: Vec[u64], parents: Vec[Option[u64]],) ->
SceneAsset {
    let mut asset = SceneAsset::new()
    let mut index = 0_usize
    while index < positions.len() {
        match positions.get(index) {
            Option::Some(position) => {
                let rotation = rotation_at(rotations, index as u32 + 1_u32)
                let scale = scale_at(scales, index as u32 + 1_u32)
                let mut mesh_name = ""
                match mesh_names.get(index) {
                    Option::Some(value) => {
                        mesh_name = value
                    }
                    Option::None => {
                    }
                }
                let kind = actor_kind_for_mesh(mesh_name)
                let fallback_name = actor_name_for_mesh(mesh_name, index as u32 + 1_u32)
                let name = match actor_names.get(index) {
                    Option::Some(value) => {
                        if value == "" {
                            fallback_name
                        } else {
                            value
                        }
                    }
                    Option::None => fallback_name
                }
                let actor_id = match actor_ids.get(index) {
                    Option::Some(value) => value Option::None => index as u64 + 1_u64
                }
                let parent = match parents.get(index) {
                    Option::Some(value) => value Option::None => Option[u64]::None
                }
                asset.add(SceneActor::new(name, kind,
                        Transform::identity().with_position(position).with_rotation(rotation).with_scale(scale),)
                    .with_identity(actor_id).with_parent(parent)
                    .with_visible(bool_at(visibilities, index as u32 + 1_u32, true)))
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret asset
}

fn save_editor_project(scene_path: str, script_path: str, positions: Vec[Vec3], rotations: Vec[Vec3],
    scales: Vec[Vec3], actor_names: Vec[str], mesh_names: Vec[str], visibilities: Vec[bool], actor_ids:
    Vec[u64],
    parents: Vec[Option[u64]], material_path: str, material: StandardMaterial, code: str, scene: Scene,) -> bool {
    let reconstructed = scene_asset_with_meshes(positions, rotations, scales, actor_names,
        mesh_names, visibilities,
        actor_ids, parents,)
    let mut saved_asset = SceneAsset::new()
    let mut actor_index = 0_usize
    while actor_index < reconstructed.len() {
        match reconstructed.actor(actor_index) {
            Some(actor) => {
                let mut stored = actor.with_identity(actor.id())
                match scene.get(actor.id()) {
                    Some(entity) => {
                        stored = stored.with_component(entity.component()) match entity.blueprint() {
                            Some(instance) => {
                                stored = stored.with_blueprint(instance)
                            }
                            None => {
                            }
                        }
                    }
                    None => {
                    }
                }
                saved_asset.add(stored)
            }
            None => {
            }
        }
        actor_index += 1
    }
    let scene_saved = write_file(scene_path, saved_asset.stringify() + "\n") == 0_i32
    if mkdir_all(parent_directory(material_path)) != 0_i32 {
        ret false
    }
    let material_saved = save_material_asset_file(material_path, material)
    let script_saved = write_file(script_path, code) == 0_i32
    ret scene_saved && material_saved && script_saved
}

fn scene_actor_parents(scene: Scene, actor_ids: Vec[u64]) -> Vec[Option[u64]] {
    let mut parents = Vec[Option[u64]]::new()
    for id in actor_ids {
        match scene.get(id) {
            Option::Some(entity) => {
                parents.push(entity.parent())
            }
            Option::None => {
                parents.push(Option[u64]::None)
            }
        }
    }
    ret parents
}

fn actor_parent_indices(actor_ids: Vec[u64], parents: Vec[Option[u64]]) -> Vec[u32] {
    let mut indices = Vec[u32]::new()
    let mut index = 0_usize
    while index < actor_ids.len() {
        let parent = match parents.get(index) {
            Option::Some(value) => value Option::None => Option[u64]::None
        }
        match parent {
            Option::Some(parent_id) => {
                indices.push(actor_index_for_id(actor_ids, parent_id))
            }
            Option::None => {
                indices.push(0_u32)
            }
        }
        index = index + 1_usize
    }
    ret indices
}

fn actor_world_position(scene: Scene, actor_ids: Vec[u64], actor: u32, fallback: Vec3) -> Vec3 {
    if actor == 0_u32 {
        ret fallback
    }
    match actor_ids.get((actor - 1_u32) as usize) {
        Option::Some(id) => {
            match scene.world_position(id) {
                Option::Some(position) => {
                    ret position
                }
                Option::None => {
                }
            }
        }
        Option::None => {
        }
    }
    ret fallback
}

fn actor_local_position_for_world(scene: Scene, actor_ids: Vec[u64], actor: u32, world: Vec3, fallback:
    Vec3,) -> Vec3 {
    if actor == 0_u32 {
        ret fallback
    }
    match actor_ids.get((actor - 1_u32) as usize) {
        Option::Some(id) => {
            match scene.local_position_for_world(id, world) {
                Option::Some(position) => {
                    ret position
                }
                Option::None => {
                }
            }
        }
        Option::None => {
        }
    }
    ret fallback
}

fn parent_display_name(parent: Option[u64], actor_ids: Vec[u64], actor_names: Vec[str]) -> str {
    match parent {
        Option::Some(id) => {
            let index = actor_index_for_id(actor_ids, id)
            if index > 0_u32 {
                ret actor_name_at(actor_names, index)
            }
            ret "Missing Actor"
        }
        Option::None => {
            ret "None (World)"
        }
    }
}

fn parent_selector(selected_id: u64, selected_parent: Option[u64], actor_ids: Vec[u64], actor_names:
    Vec[str],
    open: bool, hovered: str, icons: EditorIcons,) -> Widget {
    let mut group = Widget::panel("parent-control").with_flex(if open {
            36.0_f32 +(actor_ids.len() as f32) * 24.0_f32
        } else {
            34.0_f32
        }
        , 0.0_f32,)
    .with_added_classes("g-parent-selector")
    let mut control = Widget::panel("parent-selector").with_added_classes("g-parent-selector-2" + if open {
            " state-open"
        } else {
            ""
        }
    )
    control.push(Widget::label("Parent").with_added_classes("g-parent-selector-3"))
    control.push(Widget::label(parent_display_name(selected_parent, actor_ids, actor_names)).with_added_classes("g-parent-selector-4"))
    control.push(Widget::icon("", icons.expanded).with_added_classes("g-parent-selector-5"))
    group.push(control)
    if open {
        group.push(popup_action("parent-none", "None (World)", icons.level, hovered, false, selected_parent.is_none()))
        let mut index = 0_usize
        while index < actor_ids.len() {
            match actor_ids.get(index) {
                Option::Some(id) => {
                    if id != selected_id {
                        group.push(popup_action("parent-actor-" + Debug::fmt(index + 1_usize), actor_name_at(actor_names,
                                    index as u32 + 1_u32,),
                                icons.mesh, hovered, false, selected_parent == Option[u64]::Some(id),))
                    }
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
    }
    ret group
}

fn detail_row(name: str, value: str, accent: str) -> Widget {
    let mut row = Widget::panel("detail-" + name).with_added_classes("g-detail-row")
    row.push(Widget::panel("").with_added_classes("g-detail-row-2" + " " + accent))
    row.push(Widget::label(name).with_added_classes("g-detail-row-3"))
    row.push(Widget::label(value).with_added_classes("g-detail-row-4"))
    ret row
}

fn material_percent(value: f32) -> str {
    ret Debug::fmt((value * 100.0_f32 + 0.5_f32) as u32) + "%"
}

fn material_color_value(value: f32) -> u8 {
    if value <= 0.0_f32 {
        ret 0_u8
    }
    if value >= 1.0_f32 {
        ret 255_u8
    }
    ret(value * 255.0_f32) as u8
}

fn material_css_color(color: Vec3) -> str {
    ret f "rgb({material_color_value(color.x())}, {material_color_value(color.y())}, {material_color_value(color.z())})"
}

fn material_swatch(id: str, color: Vec3, selected: Vec3, hovered: str) -> Widget {
    let active = color.x() == selected.x() && color.y() == selected.y() && color.z() == selected.z()
    ret Widget::button(id, "").with_added_classes("g-material-swatch" + if active {
            " state-active"
        } else {
            ""
        }
    ).with_css_variable("--material-color", material_css_color(color))
}

fn material_scalar_control(name: str, prefix: str, value: f32, hovered: str, icons: EditorIcons) -> Widget
{
    let mut row = Widget::panel("material-" + prefix + "-control").with_added_classes("g-material-scalar-control")
    row.push(Widget::label(name).with_added_classes("g-material-scalar-control-2"))
    row.push(Widget::icon_button("material-" + prefix + "-minus", "", icons.minus)
        .with_added_classes(compact_icon_classes(hovered == "material-" + prefix + "-minus") + " g-material-scalar-control-3"))
    row.push(Widget::label(material_percent(value)).with_added_classes("g-material-scalar-control-4"))
    row.push(Widget::icon_button("material-" + prefix + "-plus", "", icons.add)
        .with_added_classes(compact_icon_classes(hovered == "material-" + prefix + "-plus") + " g-material-scalar-control-5"))
    ret row
}

fn material_inspector(material: StandardMaterial, hovered: str, icons: EditorIcons, ui: EditorUiState) -> Widget {
    let color = material.base_color()
    let mut panel = Widget::panel("details-panel").with_attribute("data-luma-scrollable", "true").with_added_classes(panel_classes() + " g-material-inspector")
    let mut identity = Widget::panel("material-identity").with_added_classes("g-material-inspector-2")
    identity.push(Widget::icon("", icons.material).with_added_classes("g-material-inspector-3"))
    identity.push(Widget::label("Graphene Default").with_added_classes("g-material-inspector-4"))
    panel.push(identity)
    let mut surface = Widget::panel("material-surface-content").with_direction(vertical()).with_classes("g-property-content")
    surface.push(property_row("material-color-row", "Base Color", Widget::icon_button("ui-material-palette", "", icons.expanded).with_classes("g-material-color-button").with_css_variable("--material-color", material_css_color(color)).with_attribute("aria-label", "Base color palette")))
    surface.push(material_texture_row("Base Texture", "material-texture", material.base_color_texture(), icons))
    surface.push(material_scalar_control("Metallic", "metallic", material.metallic(), hovered, icons))
    surface.push(material_scalar_control("Roughness", "roughness", material.roughness(), hovered, icons))
    panel.push(property_section("ui-section-surface", "Surface", ui.expanded("ui-section-surface"), surface))
    let mut normal = Widget::panel("material-normal-content").with_direction(vertical()).with_classes("g-property-content")
    normal.push(material_texture_row("Normal Map", "material-normal", material.normal_texture(), icons))
    normal.push(material_scalar_control("Strength", "normal", material.normal_scale(), hovered, icons))
    normal.push(popup_action("material-normal-flip-y", "Flip Green (DirectX)", icons.lighting, hovered, false, material.normal_flip_y()))
    panel.push(property_section("ui-section-normal", "Normal", ui.expanded("ui-section-normal"), normal))
    let mut advanced = Widget::panel("material-advanced-content").with_direction(vertical()).with_classes("g-property-content")
    advanced.push(popup_action("material-unlit", "Unlit", icons.lighting, hovered, false, material.unlit()))
    advanced.push(popup_action("material-double-sided", "Double Sided", icons.panels, hovered, false, material.double_sided()))
    advanced.push(Widget::button("material-reset", "Reset Material").with_classes("control"))
    panel.push(property_section("ui-section-advanced", "Advanced", ui.expanded("ui-section-advanced"), advanced))
    panel.push(Widget::spacer(1)) ret panel
}

fn material_texture_row(title: str, prefix: str, path: str, icons: EditorIcons) -> Widget {
    let mut controls = Widget::panel("").with_classes("g-texture-controls").with_direction(horizontal())
    controls.push(Widget::icon_button(prefix + "-load", if path == "" {
                "None"
            } else {
                Path::new(path).file_name().unwrap_or(path)
            }
            , icons.folder,).with_classes("g-texture-choose").with_attribute("aria-label", "Choose " + title))
    controls.push(Widget::icon_button(prefix + "-clear", "", icons.clean).with_classes("g-property-menu").with_disabled(path == "").with_attribute("aria-label", "Clear " + title))
    ret property_row(prefix + "-row", title, controls)
}

fn autolod_asset_inspector(enabled: bool, statistics: str,
    hovered: str, icons: EditorIcons, ui: EditorUiState,) -> Widget {
    let mut panel = Widget::panel("details-panel").with_attribute("data-luma-scrollable", "true").with_added_classes(panel_classes() + " g-autolod-asset-inspector")
    let mut identity = Widget::panel("autolod-identity").with_added_classes("g-autolod-asset-inspector-2")
    identity.push(Widget::icon("", icons.mesh)
        .with_added_classes("g-autolod-asset-inspector-3"))
    identity.push(Widget::label("Static Mesh")
        .with_added_classes("g-autolod-asset-inspector-4"))
    identity.push(Widget::label("ASSET")
        .with_added_classes("g-autolod-asset-inspector-5"))
    panel.push(identity)
    panel.push(property_section("ui-section-autolod", "AutoLOD", ui.expanded("ui-section-autolod"), ui.mesh.widget(ui.lod_groups.catalog)))
