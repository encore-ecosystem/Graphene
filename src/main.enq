impl for EditorIcons {
    pub fn load(manager: IconManager) -> EditorIcons {
        let camera = manager.document("camera")
        ret EditorIcons {
            manager.document("hexagon"), manager.document("save"), manager.document("undo"), manager.document("redo"),
            manager.document("copy"), manager.document("trash-2"), manager.document("hammer"), manager.document("play"),
            manager.document("mouse-pointer-2"),
            manager.document("move-3d"), manager.document("rotate-3d"), manager.document("scale-3d"),
            camera, manager.document("sun"), camera,
            manager.document("lightbulb"), manager.document("box"), manager.document("palette"),
            manager.document("file-code"), manager.document("plus"), manager.document("minus"), manager.document("settings-2"),
            manager.document("search"),
            manager.document("folder"), manager.document("chevron-right"), manager.document("chevron-down"),
            manager.document("eye"),
            manager.document("square-terminal"), manager.document("grid-3x3"), manager.document("magnet"),
            manager.document("gauge"),
            manager.document("map"), manager.document("circle-check"),
            manager.document("log-out"), manager.document("panels-top-left"),
            manager.document("file"), manager.document("house"), manager.document("arrow-up"), manager.document("refresh-cw"),
            manager.document("eye-off"), ContentIcons::load(manager)
        }
    }
}

