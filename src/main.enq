        .with_added_classes("g-unsaved-changes-dialog-4"))
    dialog.push(Widget::label("Save them " + destination + ".").with_added_classes("g-unsaved-changes-dialog-5"))
    dialog.push(Widget::spacer(1.0_f32))
    let mut actions = Widget::panel("unsaved-actions").with_added_classes("g-unsaved-changes-dialog-6")
    actions.push(Widget::spacer(1.0_f32))
    actions.push(Widget::button("unsaved-cancel", "Cancel").with_added_classes("g-unsaved-changes-dialog-7"))
    actions.push(Widget::button("unsaved-discard", "Don't Save").with_added_classes("g-unsaved-changes-dialog-8"))
    actions.push(Widget::icon_button("unsaved-save", "Save", icons.save).with_added_classes("g-unsaved-changes-dialog-9"))
    dialog.push(actions)
    shade.push(Widget::spacer((view_height - height) * 0.5_f32))
    let mut row = Widget::panel("unsaved-dialog-row").with_flex(height,
        0.0_f32,).with_added_classes("g-unsaved-changes-dialog-10")
    row.push(Widget::spacer(1.0_f32))
    row.push(dialog)
    row.push(Widget::spacer(1.0_f32))
    shade.push(row)
    shade.push(Widget::spacer(1.0_f32))
    ret shade
}

