    let mut blueprint_reported_diagnostics = 0_usize
    let mut dock_interaction = DockInteraction::new()
    let mut environment_tick_ns = performance_counter_ns()
    let mut last_play_frame = Option[PreparedFrame]::None
    let mut saved_layout_revision = dock_workspace.revision()
    while window.is_open() {
        if viewport_renderer.is_playing() != simulation_mode_is_play(simulation_mode) {
            window.clear_external_vulkan_images() last_play_frame = Option[PreparedFrame]::None
        }
        viewport_renderer.set_playing(simulation_mode_is_play(simulation_mode))
        let reconstruction_changed = ui.reconstruction_capabilities != viewport_renderer.reconstruction_capabilities() || ui.reconstruction_status != viewport_renderer.reconstruction_status()
        if reconstruction_changed {
            ui.reconstruction_capabilities = viewport_renderer.reconstruction_capabilities() ui.reconstruction_status = viewport_renderer.reconstruction_status() redraw_pending = true
        }
        performance_panel.reconstruction(viewport_renderer.reconstruction_frame_counts(), viewport_renderer.internal_render_width(), viewport_renderer.internal_render_height(), render_width, render_height, viewport_renderer.anti_aliasing_attachment_bytes())
        // Intermediate images reuse the exact prepared UI transaction. This path
        // never ticks gameplay, animation, audio, VFX, bindings, or layout.
        if viewport_renderer.presentation_pending() {
            let now = performance_counter_ns()
            if viewport_renderer.presentation_expired(now) || !simulation_mode_is_play(simulation_mode) {
                viewport_renderer.cancel_presentations() viewport_redraw_pending = true
            } else {
                match last_play_frame {
                    Some(prepared) => {
                        if viewport_renderer.presentation_due(now) && window.render_frame_ready() {
                            let image = ExternalVulkanImage::new(viewport_renderer.external_image() as u64, viewport_renderer.allocation_width(), viewport_renderer.allocation_height(), viewport_renderer.external_layout()).with_region(0, 0, render_width, render_height)
                            if window.present_external_update(prepared, "viewport-surface", viewport_generation, image) {
                                viewport_renderer.presentation_submitted(performance_counter_ns()) viewport_renderer.commit_composition()
                            } elif window.frame_status() != 2_u32 {
                                viewport_renderer.cancel_presentations() viewport_redraw_pending = true
                            }
                        }
                    }
                    None => {
                        viewport_renderer.cancel_presentations() viewport_redraw_pending = true
                    }
                }
                if viewport_renderer.presentation_pending() {
                    vulkan::native_presentation_yield() continue
                }
            }
        }
        if audio_panel.project != project_root {
            audio_panel.configure(project_root) particle_editor.configure(project_root)
        }
        performance_panel.sync(viewport_renderer.profiling_device(), dock_workspace.location(PanelId::new("performance")).is_some(), viewport_visible && window.frame_status() != 3)
        let profiler_active = performance_panel.running()
        viewport_renderer.set_environment_project(project_root)
        let environment_active = viewport_renderer.environment_animating(simulation_mode_is_play(simulation_mode))
        let environment_now = performance_counter_ns()
