                }
                if scene_model_changed || render_settings_changed || previous_simulation_mode != simulation_mode || ui_chrome_dirty {
                    viewport_renderer.sync_scene_settings(editor_scene, cube_entities, simulation_mode_is_play(simulation_mode) || pilot_id > 0_u64)
                }
            }
            if blueprint_playing {
                let runtime_scene = blueprint_simulation.scene()
                let mut bindings = Vec[SceneGpuBinding]::new()
                let mut actor_index = 0_usize
                for actor in editor_scene.entities() {
                    if actor.blueprint().is_none() && actor.renderable().is_some() && actor.component().kind() == "" {
                        let mesh_name = mesh_name_at(cube_mesh_names, actor_index as u32 + 1)
                        let resolved = resolve_actor_gpu_mesh(mesh_name, plane_gpu_mesh, sphere_gpu_mesh, imported_meshes, imported_gpu_meshes)
                        bindings.push(SceneGpuBinding {
                                actor.id(), if resolved.valid() {
                                    resolved
                                } else {
                                    viewport_renderer.default_cube_mesh()
                                }
                            }
                            ,
                        )
                    }
                    actor_index += 1
                }
                for component in blueprint_simulation.component_bindings() {
                    if component.mesh != "" {
                        let resolved = resolve_actor_gpu_mesh(if component.mesh == "cube" {
                                ""
                            } else {
                                component.mesh
                            }
                            , plane_gpu_mesh, sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,)
                        bindings.push(SceneGpuBinding {
                                component.entity, if component.mesh == "cube" {
                                    viewport_renderer.default_cube_mesh()
                                } else {
                                    resolved
                                }
                            }
                            ,
                        )
                    }
                }
                viewport_renderer.sync_scene_instances(runtime_scene, bindings)
            }
            profile_phase(3_u32)
            let mut ui_updated = true
            if layout_dirty {
                layout_cached = window.cache_prepared_frame(
                    window.prepare_frame_with_surface_extent(
                        layout, true, "viewport-surface", viewport_pixel_x,
                        viewport_pixel_y, render_width, render_height,
                        viewport_density, viewport_generation,)
                    .with_overlays(ui_cache_exclusions(),
                        Vec[WidgetLayout]::new(), false,))
                ui_updated = layout_cached
            } elif reactive_only && layout_cached {
                let mut transient_targets = Vec[str]::new()
                transient_targets.push("overlay-layer")
                transient_targets.push("hover-tooltip")
                ui_updated = window.commit_cached_reactive_targets(reactive_ui,
                    transient_targets,)
                if !ui_updated {
                    // A backend or resource failure must not suppress the
                    // current viewport frame. Rebuild the stable cache once;
                    // Direct Vulkan normally succeeds through Luma's bounded
                    // segmented damage path and never enters this fallback.
                    layout_cached = window.cache_prepared_frame(
                        window.prepare_frame_with_surface_extent(
                            layout, true, "viewport-surface", viewport_pixel_x,
                            viewport_pixel_y, render_width, render_height,
                            viewport_density, viewport_generation,).with_overlays(
                            ui_cache_exclusions(), Vec[WidgetLayout]::new(), false,),)
                    ui_updated = layout_cached
                }
            }
            if dirty && overlay_refresh {
                external_overlays.clear()
                external_overlay_layouts.clear()
                if overlay_visible(open_menu, add_actor_open, outliner_settings_open,
                    project_dialog_mode, unsaved_action, hovered,
                    pending_approval_id(approval_broker),) ||
                open_viewport_menu == "shading" || ui.popup() != "" || ui.browser.popup != "" || ui.actors.popup_open() || blueprint_editor.popup_open() || material_editor.popup_open() {
                    external_overlays.push("overlay-layer")
                    match reactive_ui.find_layout("overlay-layer") {
                        Option::Some(overlay) => {
                            external_overlay_layouts.push(overlay)
                        }
                        Option::None => {
                        }
                    }
                }
                if external_overlay_layouts.len() > 0_usize {
                    overlay_cache_ready = window.cache_overlay_layouts(external_overlay_layouts)
                } else {
                    overlay_cache_ready = false
                }
            }
            let hint_display = tooltip_display(if popup_visible {
                    ""
                } elif dragging {
                    "Place " + content_leaf(ui.browser.primary) + " · Release in viewport"
                } else {
                    tooltip_text(hovered)
                }
                , pointer_x, pointer_y, window.width() as f32, window.height() as f32, tooltip_style,)
            let hint_clip = Rect::new(0, 0, window.width() as f32, window.height() as f32)
            let prepared_scene = retained_render_frame(window, reactive_ui, layout, layout_cached)
            match prepared_scene.surface("viewport-surface") {
                Some(slot) => {
                    viewport_pixel_x = slot.pixel_x() viewport_pixel_y = slot.pixel_y()
                    render_width = slot.pixel_width() render_height = slot.pixel_height()
                    viewport_density = slot.density() viewport_generation = slot.generation()
                }
                None => {
                }
            }
            profile_phase(4_u32)
            let mut rendered = false
            let mut scene_recorded = viewport_renderer.external_image() != 0
            if ui_updated && viewport_visible && render_width > 0_u32 && render_height > 0_u32 && window.render_frame_ready() {
                if render_viewport {
                    let mut target_ready = true
                    if viewport_renderer.width() != render_width || viewport_renderer.height() != render_height {
                        let capacity_ready = !viewport_renderer.needs_target_capacity(render_width, render_height) ||
                        viewport_renderer.external_image() == 0 ||
                        window.release_external_vulkan_image(viewport_renderer.external_image() as u64)
                        target_ready = capacity_ready && viewport_renderer.resize_shared(render_width, render_height)
                    }
                    // A shared image becomes sampleable only after its first
                    // successful render. Never require it to exist beforehand.
                    let view_actor = if simulation_mode_is_play(simulation_mode) {
                        first_scene_camera(editor_scene)
                    } else {
                        pilot_id
                    }
                    let view_aspect = match editor_scene.get(view_actor) {
                        Some(actor) => {
                            match actor.component() {
                                Camera(settings) => settings.aspect _ => 0.0_f32
                            }
                        }
                        None => 0.0_f32
                    }
                    viewport_renderer.set_camera_override(scene_camera(editor_scene, view_actor), view_aspect)
                    if viewport_renderer.retire_generated_images(render_width,render_height) {
                        window.clear_external_vulkan_images() last_play_frame = Option[PreparedFrame]::None
                    }
                    scene_recorded = target_ready && viewport_renderer.render_camera_pose(camera.position, camera.yaw, camera.pitch, camera.fov)
                    if scene_recorded {
                        viewport_redraw_pending = false
                    }
                }
                profile_phase(5_u32)
                if scene_recorded {
                    let mut composed = prepared_scene
                    composed = composed.with_overlays(external_overlays, external_overlay_layouts,
                        overlay_cache_ready && external_overlays.len() > 0_usize,)
                    match retained_bounds(reactive_ui, "blueprint-canvas") {
                        Some(bounds) => {
                            composed = composed.with_canvas_at(blueprint_editor.canvas(), blueprint_editor.view(), bounds)
                        }
                        None => {
                        }
                    }
                    match reactive_ui.find_layout("viewport") {
                        Some(view_layout) => {
                            composed = composed.with_display_overlay(camera_overlay_style.display(view_layout, selected), view_layout.bounds())
                        }
                        None => {
                        }
                    }
                    if moving_cube {
                        let clip = Rect::new(viewport_pixel_x as f32 / viewport_density, viewport_pixel_y as f32 / viewport_density,
                            render_width as f32 / viewport_density, render_height as f32 / viewport_density,)
                        composed = composed.with_display_overlay(gizmo_guides(gizmo_gesture,
                                viewport_renderer.gizmo_radius(), clip, gesture_world_value, guide_style,), clip)
                    }
                    match dock_interaction.preview() {
                        Some(drop) => {
                            let mut preview = DisplayList::new()
                            preview.fill_rect(drop.bounds(), dock_preview_style.background())
                            preview.stroke_rect(drop.bounds(), dock_preview_style.border_color())
                            composed = composed.with_display_overlay(preview, Rect::new(0, 0, window.width() as f32, window.height() as f32))
                        }
                        None => {
                        }
                    }
                    match reactive_ui.find_layout("performance-panel") {
                        Some(panel_layout) => {
                            performance_panel.layout(panel_layout)
                        }
                        None => {
                        }
                    }
                    composed = performance_panel.compose(composed, layout, window.stylesheet())
                    composed = audio_panel.compose(composed, layout, window.stylesheet())
                    composed = particle_editor.compose(composed, layout, window.stylesheet())
                    match retained_bounds(reactive_ui, "material-canvas") {
                        Some(bounds) => {
                            composed = composed.with_canvas_at(material_editor.canvas(window.stylesheet()), material_editor.view(), bounds)
                        }
                        None => {
                        }
                    }
                    if ui.popup() == "ui-lod-groups" {
                        ui.lod_groups.set_layout(layout) composed = ui.lod_groups.compose(composed, window.stylesheet())
                    }
                    composed = composed.with_display_overlay(hint_display, hint_clip)
                    let _material_composed = material_editor.compose(composed, material_preview_environment(viewport_renderer, camera.position), environment_active)
                    let image = ExternalVulkanImage::new(viewport_renderer.external_image() as u64,
                        viewport_renderer.allocation_width(), viewport_renderer.allocation_height(), viewport_renderer.external_layout(),)
                    .with_region(0, 0, render_width, render_height)
                    let camera_ready = compose_camera_preview(window, viewport_renderer, composed, editor_scene, cube_entities.get(if selected_cube > 0 {
                                (selected_cube - 1) as usize
                            } else {
                                cube_entities.len()
                            }
                        ).unwrap_or(0_u64))
                    if !camera_ready {
                        viewport_redraw_pending = true
                    }
                    let submitted = camera_ready && composed.submit_external("viewport-surface", viewport_generation, image)
                    rendered = submitted && window.present_prepared(composed)
                    if rendered && simulation_mode_is_play(simulation_mode) {
                        last_play_frame = Option[PreparedFrame]::Some(composed)
                    }
                    if profiling && !rendered && window.frame_status() != 2_u32 {
                        let reason = if !camera_ready {
                            "Camera preview producer is not ready"
                        } elif !submitted {
                            "Viewport submission extent/generation mismatch"
                        } else {
                            backend_error()
                        }
                        if reason != last_frame_error {
                            println("Graphene frame deferred: " + reason) last_frame_error = reason
                        }
                    } elif rendered {
                        last_frame_error = ""
                    }
                }
            } elif ui_updated && !viewport_visible && window.render_frame_ready() {
                let mut composed = prepared_scene
                .with_overlays(external_overlays, external_overlay_layouts,
                    overlay_cache_ready && external_overlays.len() > 0,)
                match retained_bounds(reactive_ui, "blueprint-canvas") {
                    Some(bounds) => {
                        composed = composed.with_canvas_at(blueprint_editor.canvas(), blueprint_editor.view(), bounds)
                    }
                    None => {
                    }
                }
                match dock_interaction.preview() {
                    Some(drop) => {
                        let mut preview = DisplayList::new()
                        preview.fill_rect(drop.bounds(), dock_preview_style.background())
                        preview.stroke_rect(drop.bounds(), dock_preview_style.border_color())
                        composed = composed.with_display_overlay(preview, Rect::new(0, 0, window.width() as f32, window.height() as f32))
                    }
                    None => {
                    }
                }
                composed = performance_panel.compose(composed, layout, window.stylesheet())
                composed = audio_panel.compose(composed, layout, window.stylesheet())
                composed = particle_editor.compose(composed, layout, window.stylesheet())
                match retained_bounds(reactive_ui, "material-canvas") {
                    Some(bounds) => {
                        composed = composed.with_canvas_at(material_editor.canvas(window.stylesheet()), material_editor.view(), bounds)
                    }
                    None => {
                    }
                }
                if ui.popup() == "ui-lod-groups" {
                    ui.lod_groups.set_layout(layout) composed = ui.lod_groups.compose(composed, window.stylesheet())
                }
                composed = composed.with_display_overlay(hint_display, hint_clip)
                let material_composed = material_editor.compose(composed, material_preview_environment(viewport_renderer, camera.position), environment_active)
                rendered = material_composed && window.present_prepared(composed)
            }
            profile_ui(window.ui_timings())
            profile_finish(rendered)
            let scene_finished = perf_counter_ms()
            if rendered && viewport_visible {
                viewport_renderer.presentation_submitted(performance_counter_ns())
                viewport_renderer.commit_composition()
            }
            // The base, canvases and transient overlays have all reached the
            // same presented frame. Failed submissions keep their damage;
            // successful ones must not leave stale preparation flags behind.
            if rendered {
                reactive_ui.commit_rendered()
            }
            redraw_pending = !rendered
            let render_finished = perf_counter_ms()
            if profiling {
                if rendered {
                    profile_frames = profile_frames + 1_u64
                }
                profile_render_ms = profile_render_ms +(render_finished - render_started)
                profile_scene_ms = profile_scene_ms +(scene_finished - render_started)
                profile_compose_ms = profile_compose_ms +(render_finished - scene_finished)
                let profile_elapsed = render_finished - profile_sample_started
                if profile_elapsed >= 1000_u64 {
                    println("Graphene profile: " +
                        Debug::fmt((profile_frames * 1000_u64) / profile_elapsed) +
                        " fps, sampled work " + Debug::fmt(profile_render_ms) +
                        " ms/s (scene " + Debug::fmt(profile_scene_ms) +
                        ", compose " + Debug::fmt(profile_compose_ms) + ")")
                    profile_frames = 0_u64
                    profile_render_ms = 0_u64
                    profile_scene_ms = 0_u64
                    profile_compose_ms = 0_u64
                    profile_sample_started = render_finished
                }
            }
        }
        profile_finish(false)
        if profiling && event.kind() != event_none() {
            let latency = perf_counter_ms() - event_started
            if event.kind() != event_pointer_move() || latency >= 5_u64 {
                println("Graphene profile: event " + Debug::fmt(event.kind()) + " handled in " +
                    Debug::fmt(latency) + " ms")
            }
        }
    }
    match build_handle {
        Option::Some(handle) => {
            let _build_code = handle.join()
        }
        Option::None => {
        }
    }
    blueprint_simulation.stop()
    match blueprint_build_worker {
        Some(worker) => {
            let _code = worker.join()
        }
        None => {
        }
    }
    profile_finish(false)
    performance_panel.sync(viewport_renderer.profiling_device(), false, false)
    audio_panel.runtime.close()
    automation_listener.destroy()
    if file_exists(automation_discovery_path) {
        remove_file(automation_discovery_path)
    }
    // Stop sampling producer images before releasing shared-device resources.
    window.clear_external_vulkan_images()
    ui.browser.destroy()
    match content_mesh_worker {
        Some(worker) => {
            let _content_joined = worker.join()
        }
        None => {
        }
    }
    particle_editor.destroy()
    material_editor.destroy()
    match texture_upload {
        Option::Some(upload) => {
            if upload.wait() {
                upload.finish().destroy()
            }
        }
        Option::None => {
        }
    }
    viewport_renderer.destroy()
    window.destroy()
    ret 0_u32
}
