fn search_field(id: str, placeholder: str, icon: SvgDocument, basis: f32, grow: f32) -> Widget {
    let mut field = Widget::panel(id + "-surface").with_direction(horizontal()).with_flex(basis, grow).with_style(
        Style::default().with_background(Color::rgb(15_u8, 15_u8, 17_u8))
        .with_border(1.0_f32, Color::rgb(48_u8, 49_u8, 54_u8)).with_radius(2.0_f32)
        .with_padding(Insets::symmetric(2.0_f32, 6.0_f32)).with_gap(4.0_f32))
    field.push(Widget::icon("", icon).with_flex(14.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(Color::rgb(112_u8, 115_u8, 122_u8))
            .with_padding(Insets::all(1.0_f32)).with_pointer_events(false)))
    field.push(Widget::input(id, placeholder).with_flex(0.0_f32, 1.0_f32).with_style(
            Style::default().with_background(Color::rgb(15_u8, 15_u8, 17_u8)).with_foreground(Color::rgb(205_u8,
                    207_u8, 212_u8,))
            .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32)
            .with_padding(Insets::symmetric(2.0_f32, 0.0_f32)).with_font_size(10.0_f32)))
    ret field
}

fn editable_search_field(id: str, editor: TextEditor, focused: bool, placeholder: str, icon: SvgDocument,
    basis: f32, grow: f32,) -> Widget {
    let mut field = Widget::panel(id + "-surface").with_direction(horizontal()).with_flex(basis, grow).with_style(
        Style::default().with_background(Color::rgb(15_u8, 15_u8, 17_u8))
        .with_border(1.0_f32, if focused {
                Color::rgb(39_u8, 132_u8, 190_u8)
            } else {
                Color::rgb(48_u8, 49_u8, 54_u8)
            }
            ,
        )
        .with_radius(2.0_f32).with_padding(Insets::symmetric(2.0_f32, 6.0_f32)).with_gap(4.0_f32))
    field.push(Widget::icon("", icon).with_flex(14.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(if focused {
                    Color::rgb(92_u8, 174_u8, 220_u8)
                } else {
                    Color::rgb(112_u8, 115_u8, 122_u8)
                }
            )
            .with_padding(Insets::all(1.0_f32)).with_pointer_events(false)))
    let value = if !focused && editor.value() == "" {
        placeholder
    } else {
        editor.value()
    }
    field.push(Widget::input(id, value).with_flex(0.0_f32, 1.0_f32).with_focus(focused).with_style(
            Style::default().with_background(Color::rgb(15_u8, 15_u8, 17_u8))
            .with_foreground(if !focused && editor.value() == "" {
                    Color::rgb(112_u8, 115_u8, 122_u8)
                } else {
                    Color::rgb(205_u8, 207_u8, 212_u8)
                }
            )
            .with_border(0.0_f32, Color::rgb(0_u8, 0_u8, 0_u8)).with_radius(0.0_f32)
            .with_padding(Insets::symmetric(2.0_f32, 0.0_f32)).with_font_size(10.0_f32)))
    ret field
}

