            let next_viewport = viewport(simulation_mode, dragging, object_count, selected, active_tool,
                camera_mode,
                shading_mode, camera_speed, grid_visible, rotation_snap, open_viewport_menu, hovered,
                compact, icons,)
            if reactive_ui.replace_subtree("viewport", next_viewport) {
                layout = reactive_ui.layout()
                reactive_only = true
            }
        }
        if dirty && project_dialog_mode == "" && unsaved_action == "" &&
        (selection_reactive_target(event_target) || scene_reactive_target(event_target) ||
            request_undo || request_redo || request_duplicate || request_delete ||
            previous_selected_cube != selected_cube || previous_selected != selected ||
            previous_selected_asset != selected_asset ||
            previous_object_count != object_count) {
            let mut components_updated = true
            let asset_selection_changed =
            (selection_reactive_target(event_target) && event_target.contains("asset-")) ||
            previous_selected_asset != selected_asset
            let scene_changed = scene_reactive_target(event_target) || request_undo ||
            request_redo || request_duplicate || request_delete ||
            previous_object_count != object_count
            if asset_selection_changed {
                components_updated = reactive_ui.replace_subtree("content-browser",
                    content_browser(dragging, selected_asset, imported_meshes, asset_search,
                        asset_search_focused, hovered, icons,),) && components_updated
            }
            if !asset_selection_changed || scene_changed {
                components_updated = reactive_ui.replace_subtree("hierarchy",
                    hierarchy(selected, cube_entities, scene_actor_parents(editor_scene, cube_entities),
                        actor_names, actor_visibilities, object_count, outliner_search,
                        outliner_search_focused, outliner_show_editor_actors,
                        outliner_show_hidden_actors, hovered, icons,),) && components_updated
            }
            if show_details {
                let details = if selected_asset == "asset-material" {
                    material_inspector(default_material, hovered, icons)
                } else {
                    let selected_id = match cube_entities.get(if selected_cube > 0_u32 {
                            (selected_cube - 1_u32) as usize
                        } else {
                            cube_entities.len()
                        }
                    ) {
                        Option::Some(id) => id
                        Option::None => 0_u64
                    }
                    let parents = scene_actor_parents(editor_scene, cube_entities)
                    let selected_parent = match parents.get(if selected_cube > 0_u32 {
                            (selected_cube - 1_u32) as usize
                        } else {
                            parents.len()
                        }
                    ) {
                        Option::Some(parent) => parent
                        Option::None => Option[u64]::None
                    }
                    inspector(selected, actor_name_editor, actor_name_focused,
                        position_at(cube_positions, selected_cube), rotation_at(render_rotations, selected_cube),
                        scale_at(cube_scales, selected_cube), transform_field, transform_editor,
                        transform_invalid, selected_cube > 0_u32, selected_id, selected_parent,
                        cube_entities, actor_names, parent_menu_open,
                        mesh_name_at(cube_mesh_names, selected_cube), hovered, icons,)
                }
                components_updated = reactive_ui.replace_subtree("details-panel", details) && components_updated
            }
            if !event_target.contains("asset-") {
                components_updated = reactive_ui.replace_subtree("viewport",
                    viewport(simulation_mode, dragging, object_count, selected, active_tool, camera_mode,
                        shading_mode, camera_speed, grid_visible, rotation_snap, open_viewport_menu,
                        hovered, compact, icons,),) && components_updated
            }
            if components_updated {
                layout = reactive_ui.layout()
                reactive_only = true
            }
        }
        if dirty && workspace_structure_target(event_target) {
            let mut workspace_updated = true
            if event_target == "menu-outliner-action" || event_target == "menu-details-action" {
                workspace_updated = reactive_ui.replace_subtree("upper",
                    upper_workspace(simulation_mode, selected,
                        position_at(cube_positions, selected_cube),
                        rotation_at(render_rotations, selected_cube),
                        scale_at(cube_scales, selected_cube), selected_cube,
                        mesh_name_at(cube_mesh_names, selected_cube), cube_entities,
                        scene_actor_parents(editor_scene, cube_entities), actor_names,
                        actor_visibilities, actor_name_editor, actor_name_focused,
                        parent_menu_open, transform_field, transform_editor,
                        transform_invalid, outliner_search, outliner_search_focused,
                        selected_asset, default_material, object_count, dragging,
                        active_tool, camera_mode, shading_mode, camera_speed, grid_visible,
                        rotation_snap, open_viewport_menu, hovered, compact,
                        outliner_show_editor_actors, outliner_show_hidden_actors,
                        show_outliner, show_details, icons,),) && workspace_updated
            }
            if event_target == "menu-content-action" {
                workspace_updated = reactive_ui.replace_subtree("lower",
                    lower_workspace(simulation_mode, building, status_message, build_output,
                        dragging, selected_asset, imported_meshes, asset_search,
                        asset_search_focused, code_editor, code_focused, console_editor,
                        console_focused, console_output, hovered,
                        show_content, icons,),) && workspace_updated
            }
            if workspace_updated {
                layout = reactive_ui.layout()
                reactive_only = true
            }
        }
        if dirty && previous_project_root != project_root {
            let upper_updated = reactive_ui.replace_subtree("upper",
                upper_workspace(simulation_mode, selected,
                    position_at(cube_positions, selected_cube),
                    rotation_at(render_rotations, selected_cube),
                    scale_at(cube_scales, selected_cube), selected_cube,
                    mesh_name_at(cube_mesh_names, selected_cube), cube_entities,
                    scene_actor_parents(editor_scene, cube_entities), actor_names,
                    actor_visibilities, actor_name_editor, actor_name_focused,
                    parent_menu_open, transform_field, transform_editor,
                    transform_invalid, outliner_search, outliner_search_focused,
                    selected_asset, default_material, object_count, dragging,
                    active_tool, camera_mode, shading_mode, camera_speed, grid_visible,
                    rotation_snap, open_viewport_menu, hovered, compact,
                    outliner_show_editor_actors, outliner_show_hidden_actors,
                    show_outliner, show_details, icons,),)
            let lower_updated = reactive_ui.replace_subtree("lower",
                lower_workspace(simulation_mode, building, status_message, build_output,
                    dragging, selected_asset, imported_meshes, asset_search,
                    asset_search_focused, code_editor, code_focused, console_editor,
                    console_focused, console_output, hovered,
                    show_content, icons,),)
            if upper_updated && lower_updated {
                layout = reactive_ui.layout()
                reactive_only = true
            }
        }
        let overlay_editing =(editing_event &&
            (project_dialog_mode != "" || unsaved_action != "")) ||
        (event.kind() == event_scroll() && project_dialog_mode == "import") ||
        previous_unsaved_action != unsaved_action ||
        previous_open_menu != open_menu ||
        previous_add_actor_open != add_actor_open ||
        previous_outliner_settings_open != outliner_settings_open ||
        previous_project_dialog_mode != project_dialog_mode ||
        previous_approval_id != pending_approval_id(approval_broker)
        if dirty &&(overlay_reactive_target(event_target) || overlay_editing) {
            let next_overlay = overlay_layer(open_menu, add_actor_open, outliner_settings_open,
                project_dialog_mode, unsaved_action, project_loaded, project_dirty,
                command_state.can_undo(), command_state.can_redo(), selected_cube,
                simulating, building, show_outliner, show_details, show_content,
                outliner_show_editor_actors, outliner_show_hidden_actors, imported_meshes,
                hovered, pointer_x, pointer_y, project_path_editor, project_path_focused,
                project_error, asset_picker, approval_broker, window.width() as f32,
                window.height() as f32, icons,)
            if reactive_ui.replace_subtree("overlay-layer", next_overlay) {
                layout = reactive_ui.layout()
                reactive_only = true
            }
        }
        if simulating {
            let seconds =((perf_counter_ms() - simulation_started) as f32) * 0.001_f32
            let mut simulation_index = 0_usize
            while simulation_index < cube_entities.len() {
                match cube_entities.get(simulation_index) {
                    Option::Some(_) => {
                        let rotation = Vec3::new(0.0_f32, seconds, 0.0_f32)
                        let base = rotation_at(cube_rotations, simulation_index as u32 + 1_u32)
                        render_rotations.set(simulation_index,
                            Vec3::new(base.x(), base.y() + rotation.y(), base.z()),)
                    }
                    Option::None => {
                    }
                }
                simulation_index = simulation_index + 1_usize
            }
        }
        if previous_simulation_mode != simulation_mode {
            let presentation = if simulation_mode_active(simulation_mode) {
                PresentMode::Immediate
            } else {
                PresentMode::VSync
            }
            if !window.set_present_mode(presentation) {
                println("Graphene Editor: unable to change presentation mode: " +
                    backend_error())
            }
        }
        let activity_changed = previous_building != building ||
        previous_simulation_mode != simulation_mode
        if dirty && activity_changed && previous_project_root == project_root {
            let output_updated = reactive_ui.replace_subtree("output",
                output_panel(simulation_mode, building, status_message, build_output,
                    console_editor, console_focused, console_output, icons,),)
            let viewport_updated = reactive_ui.replace_subtree("viewport",
                viewport(simulation_mode, dragging, object_count, selected, active_tool,
                    camera_mode, shading_mode, camera_speed, grid_visible, rotation_snap,
                    open_viewport_menu, hovered, compact, icons,),)
            if output_updated && viewport_updated {
                layout = reactive_ui.layout()
                reactive_only = true
            }
        }
        if dirty && event.kind() != event_resize() {
            let menu_changed = previous_open_menu != open_menu ||
            previous_project_root != project_root ||
            previous_project_loaded != project_loaded
            let toolbar_changed = previous_project_loaded != project_loaded ||
            previous_project_dirty != project_dirty || previous_building != building ||
            previous_simulation_mode != simulation_mode ||
            previous_selected_cube != selected_cube ||
            previous_command_can_undo != command_state.can_undo() ||
            previous_command_can_redo != command_state.can_redo()
            let status_changed = previous_status_message != status_message ||
            previous_project_loaded != project_loaded ||
            previous_project_dirty != project_dirty || previous_building != building ||
            previous_simulation_mode != simulation_mode ||
            previous_object_count != object_count
            let mut chrome_updated = false
            if menu_changed {
                chrome_updated = reactive_ui.replace_subtree("menu-bar",
                    editor_menu_bar(open_menu, hovered, project_loaded, project_root, icons),) ||
                chrome_updated
            }
            if toolbar_changed {
                chrome_updated = reactive_ui.replace_subtree("toolbar",
                    editor_toolbar(simulation_mode, project_loaded, project_dirty,
                        command_state.can_undo(), command_state.can_redo(),
                        selected_cube, building, hovered, icons,),) || chrome_updated
            }
            if status_changed {
                chrome_updated = reactive_ui.replace_subtree("status",
                    status_bar(simulation_mode, building, status_message,
                        project_loaded, project_dirty, object_count, icons,),) || chrome_updated
            }
            if previous_project_dirty != project_dirty {
                chrome_updated = reactive_ui.replace_subtree("workspace-tabs",
                    workspace_tabs(project_dirty, icons),) || chrome_updated
            }
            if chrome_updated {
                layout = reactive_ui.layout()
            }
            let chrome_only = event_target == "menu-about-action" ||
            event_target == "save" || event_target == "menu-save-action" ||
            event_target == "build-game" || event_target == "menu-build-action" ||
            event_target == "menu-tools-build-action" || request_save || request_build
            if chrome_updated && chrome_only && previous_project_root == project_root {
                reactive_only = true
            }
        }
        if dirty && !viewport_only && !reactive_only {
            if profiling && event.kind() != event_resize() {
                println("Graphene profile: reactive miss for event " +
                    Debug::fmt(event.kind()) + " target '" + event_target + "'")
            }
        }
        if layout_dirty {
            let layout_started = perf_counter_ms()
            if event.kind() == event_resize() {
                let next_compact = window.width() < 1200_u32
                if next_compact != compact {
                    compact = next_compact
                    let _viewport_replaced = reactive_ui.replace_subtree("viewport",
                        viewport(simulation_mode, dragging, object_count, selected, active_tool,
                            camera_mode, shading_mode, camera_speed, grid_visible, rotation_snap,
                            open_viewport_menu, hovered, compact, icons,),)
                }
                let _overlay_replaced = reactive_ui.replace_subtree("overlay-layer",
                    overlay_layer(open_menu, add_actor_open, outliner_settings_open,
                        project_dialog_mode, unsaved_action, project_loaded, project_dirty,
                        command_state.can_undo(), command_state.can_redo(),
                        selected_cube, simulating, building, show_outliner, show_details,
                        show_content, outliner_show_editor_actors,
                        outliner_show_hidden_actors, imported_meshes, hovered, pointer_x,
                        pointer_y, project_path_editor, project_path_focused, project_error,
                        asset_picker, approval_broker, window.width() as f32,
                        window.height() as f32, icons,),)
                layout = window.relayout(reactive_ui.layout())
                let layout_finished = perf_counter_ms()
                let resize_frame = window.prepare_frame(layout, true)
                let mut next_width = render_width
                let mut next_height = render_height
                match resize_frame.surface("viewport-surface") {
                    Option::Some(slot) => {
                        next_width = slot.pixel_width()
                        next_height = slot.pixel_height()
                    }
                    Option::None => {
                        // A compositor can report a transient constrained
                        // extent while tiling, minimizing, or crossing a
                        // responsive breakpoint. Keep the retained layout;
                        // the next resize restores the direct viewport.
                    }
                }
                if next_width != render_width || next_height != render_height {
                    render_width = next_width
                    render_height = next_height
                }
                reactive_ui.replace_layout(layout)
                hovered_base = Option[Widget]::None
                if profiling {
                    println("Graphene profile: retained resize layout " +
                        Debug::fmt(layout_finished - layout_started) + " ms")
                }
            }
        }
        if dirty || simulating {
            let render_started = perf_counter_ms()
            let render_viewport = simulating || viewport_only || layout_dirty || !reactive_only
            if render_viewport {
                viewport_renderer.set_grid_visible(grid_visible && !simulation_mode_is_play(simulation_mode))
                viewport_renderer.set_gizmo_mode(if simulation_mode_is_play(simulation_mode) {
                        0_u32
                    } else {
                        gizmo_mode(active_tool)
                    }
                )
                viewport_renderer.sync_cubes(object_count)
                viewport_renderer.select_cube(if simulation_mode_is_play(simulation_mode) {
                        0_u32
                    } else {
                        selected_cube
                    }
                )
                viewport_renderer.sync_cube_transforms_hierarchical(cube_positions, render_rotations,
                    cube_scales,
                    actor_parent_indices(cube_entities, scene_actor_parents(editor_scene, cube_entities)),)
            }
            let mut ui_updated = true
            let reactive_targets = reactive_ui.paint_targets()
            if layout_dirty {
                layout_cached = window.cache_prepared_frame(window.prepare_frame(layout, true)
                    .with_overlays(ui_cache_exclusions(),
                        Vec[WidgetLayout]::new(), false,))
                ui_updated = layout_cached
            } elif reactive_only && layout_cached {
                let mut transient_targets = Vec[str]::new()
                transient_targets.push("overlay-layer")
                transient_targets.push("hover-tooltip")
                ui_updated = window.commit_cached_layout_targets(layout, reactive_targets,
                    transient_targets,)
            }
            if dirty {
                external_overlays.clear()
                external_overlay_layouts.clear()
                if overlay_visible(open_menu, add_actor_open, outliner_settings_open,
                    project_dialog_mode, unsaved_action, hovered,
                    pending_approval_id(approval_broker),) {
                    external_overlays.push("overlay-layer")
                    match reactive_ui.find_layout("overlay-layer") {
                        Option::Some(overlay) => {
                            external_overlay_layouts.push(overlay)
                        }
                        Option::None => {
                        }
                    }
                }
                if external_overlay_layouts.len() > 0_usize {
                    overlay_cache_ready = window.cache_overlay_layouts(external_overlay_layouts)
                } else {
                    overlay_cache_ready = false
                }
            }
            let prepared = window.prepare_frame(layout, layout_cached)
                .with_overlays(external_overlays, external_overlay_layouts,
                    overlay_cache_ready && external_overlays.len() > 0_usize,)
            let mut rendered = false
            match prepared.surface("viewport-surface") {
                Option::Some(slot) => {
                    if ui_updated {
                        let borrowed = window.begin_vulkan_frame(prepared)
                        let scene_recorded = borrowed.valid() &&
                            viewport_renderer.record_camera_at(
                                borrowed.frame(), borrowed.slot(),
                                slot.pixel_x(), slot.pixel_y(),
                                slot.pixel_width(), slot.pixel_height(),
                                camera_yaw, camera_pitch, camera_distance,
                                camera_target,)
                        if borrowed.valid() {
                            let presented = window.present_vulkan_frame(borrowed)
                            rendered = scene_recorded && presented
                        }
                    }
                }
                Option::None => {
                    // Present the retained chrome once instead of spinning or
                    // aborting while the viewport has no drawable extent.
                    // Graphene resumes direct recording as soon as a later
                    // layout exposes the render surface again.
                    if ui_updated {
                        rendered = window.present_prepared(prepared)
                    }
                }
            }
            let scene_finished = perf_counter_ms()
            if rendered && reactive_only && layout_cached {
                let mut retained_targets = Vec[str]::new()
                retained_targets.push("overlay-layer")
                retained_targets.push("hover-tooltip")
                reactive_ui.retain_paint(retained_targets)
            }
            redraw_pending = !rendered
            let render_finished = perf_counter_ms()
            if profiling {
                profile_frames = profile_frames + 1_u64
                profile_render_ms = profile_render_ms +(render_finished - render_started)
                profile_scene_ms = profile_scene_ms +(scene_finished - render_started)
                profile_compose_ms = profile_compose_ms +(render_finished - scene_finished)
                let profile_elapsed = render_finished - profile_sample_started
                if profile_elapsed >= 1000_u64 {
                    println("Graphene profile: " +
                        Debug::fmt((profile_frames * 1000_u64) / profile_elapsed) +
                        " fps, sampled work " + Debug::fmt(profile_render_ms) +
                        " ms/s (scene " + Debug::fmt(profile_scene_ms) +
                        ", compose " + Debug::fmt(profile_compose_ms) + ")")
                    profile_frames = 0_u64
                    profile_render_ms = 0_u64
                    profile_scene_ms = 0_u64
                    profile_compose_ms = 0_u64
                    profile_sample_started = render_finished
                }
            }
        }
        if profiling && event.kind() != event_none() {
            let latency = perf_counter_ms() - event_started
            if event.kind() != event_pointer_move() || latency >= 5_u64 {
                println("Graphene profile: event " + Debug::fmt(event.kind()) + " handled in " +
                    Debug::fmt(latency) + " ms")
            }
        }
    }
    match build_handle {
        Option::Some(handle) => {
            let _build_code = handle.join()
        }
        Option::None => {
        }
    }
    viewport_renderer.destroy()
    automation_listener.destroy()
    if file_exists(automation_discovery_path) {
        remove_file(automation_discovery_path)
    }
    window.destroy()
    ret 0_u32
}
