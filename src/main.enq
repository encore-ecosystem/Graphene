                        248_u8, 250_u8,))
                .with_border(1.0_f32, Color::rgb(52_u8, 151_u8, 208_u8)).with_radius(4.0_f32)))
        actions.push(Widget::icon_button("browser-open", "Open Project", icons.folder).with_flex(132.0_f32,
                0.0_f32,).with_style(
