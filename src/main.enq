                let mut mesh_name = ""
                let mut valid_add = false
                match add_actor_mesh_name(target, imported_meshes) {
                    Option::Some(name) => {
                        mesh_name = name valid_add = true
                    }
                    Option::None => {
                    }
                }
                let gpu_mesh = resolve_actor_gpu_mesh(mesh_name, plane_gpu_mesh, sphere_gpu_mesh,
                    imported_meshes, imported_gpu_meshes,)
                if valid_add {
                    let previous_count = object_count
                    let actor_name = actor_name_for_mesh(mesh_name, object_count + 1_u32)
                    let added = command_state.execute(GrapheneCommand::AddActor(
