fn asset_picker_mode(mode: str) -> bool {
    ret mode == "import" || mode == "texture" || mode == "normal"
}

fn asset_import_dialog(picker: FilePicker, error: str, view_width: f32, view_height: f32, icons: EditorIcons, mode: str)
-> Widget {
    let texture = mode != "import"
    let mut shade = Widget::panel("asset-import-shade").with_added_classes("g-asset-import-dialog").with_computed_style(Style::default().with_width(view_width).with_height(view_height))
    let width = if view_width < 820.0_f32 {
        view_width - 32.0_f32
    } else {
        780.0_f32
    }
    let height = if view_height < 680.0_f32 {
        view_height - 32.0_f32
    } else {
        620.0_f32
    }
    let mut dialog = Widget::panel("asset-import-dialog").with_added_classes("g-asset-import-dialog-2" + if view_width < 820.0_f32 {
            " state-view-width-820-0-f32"
        } else {
            ""
        }
        + if view_height < 680.0_f32 {
            " state-view-height-680-0-f32"
        } else {
            ""
        }
    ).with_computed_style(Style::default().with_width(width).with_height(height).with_left((view_width - width) * 0.5_f32).with_top((view_height - height) * 0.5_f32))
    dialog.push(Widget::label(if mode == "normal" {
                "Normal Map / Linear"
            } elif texture {
                "Base Color Texture"
            } else {
                "Import Asset"
            }
        ).with_added_classes("g-asset-import-dialog-3"))
    dialog.push(Widget::label(if texture {
                "Choose an 8-bit RGB/RGBA PNG. A project-owned copy will be stored in Content/Textures."
            } else {
                "Import a model, PNG texture, or WAV / FLAC / MP3 / Ogg sound as a native Graphene asset."
            }
        ).with_added_classes("g-asset-import-dialog-4"))
    dialog.push(picker.view(file_picker_icons(icons)))
    let mut actions = Widget::panel("asset-import-actions")
    .with_added_classes("g-asset-import-dialog-5")
    let message = if error != "" {
        error
    } else {
        if picker.error() != "" {
            picker.error()
        } else {
            if picker.selected() == "" {
                if texture {
                    "Select a .png file"
                } else {
                    "Select a model, texture or sound file"
                }
            } else {
                picker.selected()
            }
        }
    }
    actions.push(Widget::label(message).with_added_classes("g-asset-import-dialog-6" + if error != "" || picker.error() != "" {
                " state-error-picker-error"
            } else {
                ""
            }
        ))
    actions.push(Widget::button("project-cancel", "Cancel").with_added_classes("g-asset-import-dialog-7"))
    if !texture {
        actions.push(Widget::button("asset-import-character", "Import character").with_added_classes("g-asset-import-dialog-7").with_disabled(!(ends(lower(picker.selected()), ".glb") || ends(lower(picker.selected()), ".gltf"))).with_attribute("aria-label", "Import skeletal GLB or glTF character"))
    }
    actions.push(Widget::button(if texture {
                "material-texture-confirm"
            } else {
                "asset-import-confirm"
            }
            , "Import",).with_disabled(picker.selected()
            == "").with_added_classes("g-asset-import-dialog-8"))
    dialog.push(actions)
    shade.push(dialog)
    ret shade
}

fn split_lines(value: str) -> Vec[str] {
    let mut result = Vec[str]::new()
    let mut start = 0_usize
    let mut index = 0_usize
    while index < value.char_len() {
        if value.slice(index, 1_usize) == "\n" {
            if index > start {
                result.push(value.slice(start, index - start))
            }
            start = index + 1_usize
        }
        index = index + 1_usize
    }
    if start < value.char_len() {
        result.push(value.slice(start, value.char_len() - start))
    }
    ret result
}

fn project_name(path: str) -> str {
    let trimmed = trim_trailing_separator(path)
    let mut index = trimmed.char_len()
    while index > 0_usize {
        let token = trimmed.slice(index - 1_usize, 1_usize)
        if token == "/" || token == "\\" {
            ret trimmed.slice(index, trimmed.char_len() - index)
        }
        index = index - 1_usize
    }
    ret trimmed
}

fn recent_projects_path() -> str {
    ret home_dir() + "/.graphene/recent-projects"
}

fn recent_projects() -> Vec[str] {
    let mut result = Vec[str]::new()
    if !file_exists(recent_projects_path()) {
        ret result
    }
    for path in split_lines(read_file(recent_projects_path())) {
        if project_valid(project_paths(path)) {
            result.push(path)
        }
    }
    ret result
}

fn remember_project(path: str) ->() {
    mkdir_all(home_dir() + "/.graphene")
    let mut output = path + "\n"
    let mut count = 1_usize
    for recent in recent_projects() {
        if recent != path && count < 8_usize {
            output = output + recent + "\n" count = count + 1_usize
        }
    }
    write_file(recent_projects_path(), output)
    ret()
}

fn requested_project_path() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "open" {
                match argv(2_usize) {
                    Option::Some(path) => {
                        ret trim_trailing_separator(path)
                    }
                    Option::None => {
                    }
                }
            }
            if command == "new" {
                ret ""
            }
        }
        Option::None => {
        }
    }
    let mut index = 1_usize
    while index < argc() {
        match argv(index) {
            Option::Some(value) => {
                if value == "--project" && index + 1_usize < argc() {
                    match argv(index + 1_usize) {
                        Option::Some(path) => {
                            ret trim_trailing_separator(path)
                        }
                        Option::None => {
                        }
                    }
                } elif value.char_len() > 0_usize && value.slice(0_usize, 1_usize) != "-" {
                    ret trim_trailing_separator(value)
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    match env("GRAPHENE_PROJECT") {
        Option::Some(path) => {
            ret trim_trailing_separator(path)
        }
        Option::None => {
        }
    }
    ret ""
}

fn requested_new_project_path() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "new" {
                match argv(2_usize) {
                    Option::Some(path) => {
                        ret trim_trailing_separator(path)
                    }
                    Option::None => {
                    }
                }
            }
        }
        Option::None => {
        }
    }
    ret ""
}

fn requested_project_template() -> str {
    let mut index = 3_usize
    while index < argc() {
        match argv(index) {
            Option::Some(value) => {
                if value == "--template" && index + 1_usize < argc() {
                    match argv(index + 1_usize) {
                        Option::Some(template) => {
                            if template == "starter" {
                                ret "starter"
                            }
                        }
                        Option::None => {
                        }
                    }
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret "empty"
}

fn requested_import_project() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "import" {
                match argv(2_usize) {
                    Option::Some(path) => {
                        ret trim_trailing_separator(path)
                    }
                    Option::None => {
                    }
                }
            }
        }
        Option::None => {
        }
    }
    ret ""
}

fn requested_import_source() -> str {
    match argv(1_usize) {
        Option::Some(command) => {
            if command == "import" {
                match argv(3_usize) {
                    Option::Some(path) => {
                        ret path
                    }
                    Option::None => {
                    }
                }
            }
        }
        Option::None => {
        }
    }
    ret ""
}

fn project_actor_count(path: str) -> usize {
    let scene_path = project_paths(path).scene
    if !file_exists(scene_path) {
        ret 0_usize
    }
    match SceneAsset::parse(read_file(scene_path)) {
        Option::Some(asset) => {
            ret asset.len()
        }
        Option::None => {
        }
    }
    ret 0_usize
}

fn project_card(id: str, path: str, hovered: str, icons: EditorIcons) -> Widget {
    let active = hovered == id
    let mut card = Widget::panel(id).with_added_classes("g-project-card" + if active {
            " state-active"
        } else {
            ""
        }
    )
    let mut preview = Widget::panel(id).with_added_classes("g-project-card-2")
    preview.push(Widget::icon(id, icons.level).with_added_classes("g-project-card-3"))
    card.push(preview)
    card.push(Widget::label(project_name(path)).with_added_classes("g-project-card-4"))
    card.push(Widget::label(Debug::fmt(project_actor_count(path)) + " scene objects").with_added_classes("g-project-card-5"))
    card.push(Widget::label(path).with_added_classes("g-project-card-6"))
    ret card
}

