            } elif target == "save" && project_loaded && !simulating {
                request_save = true
            } elif target == "undo" && command_state.can_undo() {
                request_undo = true
            } elif target == "redo" && command_state.can_redo() {
                request_redo = true
            } elif target == "duplicate" && selected_cube > 0_u32 && !simulating {
                request_duplicate = true
            } elif target == "delete" && selected_cube > 0_u32 && !simulating {
                request_delete = true
            } elif target == "build-game" && project_loaded && !building && !simulating {
                request_build = true
            } elif project_loaded &&(target == "play" || target == "simulate") {
                let started = command_state.execute(GrapheneCommand::StartSimulation(
                        SimulationCommand::new(target)))
                if started.success() {
