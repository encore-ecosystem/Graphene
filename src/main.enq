            } elif target == "menu-content-action" {
                show_content = !show_content dirty = true
            } elif target == "menu-about-action" {
                status_message = "Graphene Editor - Vulkan development build" dirty = true
            } elif target == "viewport-camera" {
                open_viewport_menu = if open_viewport_menu == "camera" {
                    ""
                } else {
                    "camera"
                }
                dirty = true
            } elif target == "viewport-lit" {
                open_viewport_menu = if open_viewport_menu == "shading" {
                    ""
                } else {
                    "shading"
                }
                dirty = true
            } elif target == "viewport-speed" {
                open_viewport_menu = if open_viewport_menu == "speed" {
                    ""
                } else {
                    "speed"
                }
                dirty = true
            } elif target == "camera-perspective" || target == "camera-top" || target == "camera-front"
            || target == "camera-right" {
