fn tool_name(tool: str) -> str {
    if tool == "move" {
        ret "MOVE"
    }
    if tool == "rotate" {
        ret "ROTATE"
    }
    if tool == "scale" {
        ret "SCALE"
    }
    ret "SELECT"
}

fn play_style(active: bool, hovered: bool) -> Style {
    let background = if active {
        Color::rgb(31_u8, 111_u8, 67_u8)
    } else {
        if hovered {
            Color::rgb(42_u8, 91_u8, 62_u8)
        } else {
            Color::rgb(34_u8, 57_u8, 45_u8)
        }
    }
    ret Style::default().with_background(background).with_foreground(Color::rgb(232_u8, 238_u8, 234_u8))
    .with_border(1.0_f32, if active {
            Color::rgb(51_u8, 148_u8, 91_u8)
        } else {
            Color::rgb(55_u8, 75_u8, 64_u8)
        }
        ,
    )
    .with_radius(2.0_f32).with_padding(Insets::symmetric(5.0_f32, 9.0_f32)).with_font_size(11.0_f32)
}

fn build_style(building: bool, hovered: bool) -> Style {
    if !building {
        ret control_style(false, hovered)
    }
    ret Style::default().with_background(Color::rgb(105_u8, 73_u8, 29_u8)).with_foreground(Color::rgb(246_u8,
            229_u8, 195_u8,))
    .with_border(1.0_f32, Color::rgb(151_u8, 105_u8, 39_u8)).with_radius(2.0_f32)
    .with_padding(Insets::symmetric(5.0_f32, 9.0_f32)).with_font_size(11.0_f32)
}

fn status_segment(text: str, icon: SvgDocument, color: Color, width: f32, emphasized: bool) -> Widget
{
    let mut segment = Widget::panel("").with_direction(horizontal()).with_flex(width, 0.0_f32).with_style(
        Style::default().with_background(if emphasized {
                Color::rgb(30_u8, 45_u8, 37_u8)
            } else {
                Color::rgb(18_u8, 18_u8, 21_u8)
            }
        )
        .with_border(1.0_f32, Color::rgb(43_u8, 44_u8, 49_u8)).with_padding(Insets::symmetric(2.0_f32,
                5.0_f32,))
        .with_gap(4.0_f32).with_pointer_events(false))
    segment.push(Widget::icon("", icon).with_flex(14.0_f32, 0.0_f32).with_style(
            Style::default().with_foreground(color).with_padding(Insets::all(2.0_f32)).with_pointer_events(false)))
