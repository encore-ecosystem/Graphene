                dragging = false
                dirty = true
            } elif target == "material-texture-clear" && selected_asset == "asset-material" {
                if viewport_renderer.set_base_color_texture(graphene::GpuTexture::unavailable()) {
                    if !texture_loading_normal {
                        texture_loader.cancel()
                    }
                    if !texture_upload_normal {
                        texture_upload_project = ""
                    }
                    texture_restore_path = ""
                    bound_texture_path = ""
                    default_material = default_material.with_base_color_texture("")
                    viewport_renderer.set_default_material(default_material)
                    project_dirty = true status_message = "Base color texture cleared"
                    material_texture_changed = true
                }
                dirty = true
            } elif target == "material-normal-clear" && selected_asset == "asset-material" {
                if viewport_renderer.set_normal_texture(graphene::GpuTexture::unavailable()) {
                    if texture_loading_normal {
                        texture_loader.cancel()
                    }
                    if texture_upload_normal {
                        texture_upload_project = ""
                    }
                    normal_restore_path = "" bound_normal_path = ""
                    default_material = default_material.with_normal_texture("")
                    viewport_renderer.set_default_material(default_material)
                    project_dirty = true status_message = "Normal map cleared"
                    material_texture_changed = true
                }
                dirty = true
            } elif material_edit_action(target) && selected_asset == "asset-material" {
                if target == "material-reset" && !viewport_renderer.clear_material_textures() {
                    status_message = "Unable to reset material textures"
                } else {
                    if target == "material-reset" {
                        texture_loader.cancel() texture_upload_project = "" texture_restore_path = ""
                        normal_restore_path = "" bound_normal_path = "" bound_texture_path = ""
                    }
                    let edited_material = edit_default_material(default_material, target)
                    if viewport_renderer.set_default_material(edited_material) {
                        default_material = edited_material
                        project_dirty = true
                        status_message = "Updated Default material"
                    } else {
                        status_message = "Unable to update Default material"
                    }
                }
                dirty = true
            } elif target == "autolod-edit-group" && ui.mesh.available() && !simulating && !building {
                ui.lod_groups.begin(ui.mesh.settings.group_id) ui.open("ui-lod-groups") ui_chrome_dirty = true dirty = true
            } elif (target == "autolod-enabled" || target.contains("autolod-assign-")) && ui.mesh.available() && !simulating && !building {
                let mut settings = ui.mesh.settings
                let old_settings = settings
                if target == "autolod-enabled" {
                    settings.enabled = !settings.enabled
                }
                for group in ui.lod_groups.catalog.groups {
                    if target == "autolod-assign-" + group.id {
                        settings.group_id = group.id
                    }
                }
                if ui.lod_groups.catalog.save(project_root) && settings.save(ui.mesh.path) {
                    let switched = viewport_renderer.set_mesh_autolod(ui.mesh.mesh, settings.enabled)
                    let quality = viewport_renderer.set_mesh_lod_group(ui.mesh.mesh, ui.lod_groups.catalog.resolve(settings.group_id))
                    if switched && quality {
                        ui.mesh.settings = settings selected_autolod_enabled = settings.enabled ui.lod_groups.refresh_usage()
                        viewport_redraw_pending = true status_message = "AutoLOD group: " + ui.lod_groups.catalog.resolve(settings.group_id).name
                    } else {
                        old_settings.save(ui.mesh.path)
                        viewport_renderer.set_mesh_autolod(ui.mesh.mesh, old_settings.enabled)
                        viewport_renderer.set_mesh_lod_group(ui.mesh.mesh, ui.lod_groups.catalog.resolve(old_settings.group_id))
                        status_message = "AutoLOD runtime unavailable"
                    }
                } else {
                    status_message = "Unable to save AutoLOD settings"
                }
                dirty = true
            } elif target.contains("asset-imported-mesh-") {
                let mut imported_index = 0_usize
                while imported_index < imported_meshes.len() {
                    if target == "asset-imported-mesh-" + imported_index.fmt() {
                        selected_asset = target
                        dragging = true
                        match imported_meshes.get(imported_index) {
                            Option::Some(asset) => {
                                selected_autolod_enabled = asset.autolod_enabled()
                                status_message = "Selected mesh asset " + asset.name()
                            }
                            Option::None => {
                            }
                        }
                        dirty = true
                    }
                    imported_index = imported_index + 1_usize
                }
            } elif target == "tool-select" {
                active_tool = "select" moving_cube = false gizmo_axis = 0_u32 dirty = true
            } elif target == "tool-move" {
                active_tool = "move" moving_cube = false gizmo_axis = 0_u32 dirty = true
            } elif target == "tool-rotate" {
                active_tool = "rotate" moving_cube = false gizmo_axis = 0_u32 dirty = true
            } elif target == "tool-scale" {
                active_tool = "scale" moving_cube = false gizmo_axis = 0_u32 dirty = true
            } elif !moving_cube && !simulation_mode_is_play(simulation_mode) && event.key() == 3_u32 && viewport_location.is_some()
            {
                navigation.orbiting = true navigation.pointer_x = event.x() navigation.pointer_y = event.y()
                navigation.pointer_locked = window.set_relative_mouse_mode(true)
                navigation.dolly = shortcuts.action_down("camera.alt")
                navigation.orbit_pivot = false
                shortcuts.clear()
                flight.clear()
                navigation.tick_ns = performance_counter_ns()
            } elif !moving_cube && !simulation_mode_is_play(simulation_mode) && event.key() == 2_u32 && viewport_location.is_some()
            {
                navigation.panning = true navigation.pointer_x = event.x() navigation.pointer_y = event.y()
            } elif !simulating && event.key() == 1_u32 && viewport_location.is_some() &&
            shortcuts.action_down("camera.alt") {
                navigation.orbiting = true navigation.orbit_pivot = true navigation.dolly = false
                navigation.pointer_x = event.x() navigation.pointer_y = event.y()
                navigation.pointer_locked = window.set_relative_mouse_mode(true)
            } elif !simulating && event.key() == 1_u32 && viewport_location.is_some() {
                match viewport_location {
                    Option::Some(point) => {
                        let gizmo_hit = if selected_cube > 0_u32 && active_tool != "select" {
                            viewport_renderer.pick_gizmo_axis_pose_at(point.0 * window.pixel_density(),
                                point.1 * window.pixel_density(), camera.position, camera.yaw, camera.pitch,
                                camera.fov,)
                        } else {
                            0_u32
                        }
                        let picked = if gizmo_hit > 0_u32 {
                            selected_cube
                        } else {
                            viewport_renderer.pick_cube_pose_at(point.0 * window.pixel_density(),
                                point.1 * window.pixel_density(), camera.position, camera.yaw, camera.pitch,
                                camera.fov,)
                        }
                        if picked > 0_u32 {
                            if gizmo_hit == 0_u32 {
                                selected_cubes = if event.control() {
                                    selection_toggle(selected_cubes, picked)
                                } else {
                                    selection_single(picked)
                                }
                                selected_cube = if selected_cubes.len() == 0_usize {
                                    0_u32
                                } elif event.control() && !selection_contains(selected_cubes, picked) {
                                    selection_last(selected_cubes)
                                } else {
                                    picked
                                }
                                selected = if selected_cube > 0_u32 {
                                    actor_name_at(actor_names, selected_cube)
                                } else {
                                    "Nothing selected"
                                }
                                selected_asset = ""
                                let selection_ids = actor_ids_for_selection(selected_cubes, cube_entities)
                                let primary_id = match cube_entities.get(if selected_cube > 0_u32 {
                                        (selected_cube - 1_u32) as usize
                                    } else {
                                        0_usize
                                    }
                                ) {
                                    Option::Some(actor) => Option[u64]::Some(actor)
                                    Option::None => Option[u64]::None
                                }
                                let _selection = command_state.execute(GrapheneCommand::SelectSet(
                                        ActorSelectionSetCommand::new(selection_ids, primary_id)))
                                viewport_renderer.select_cubes(
                                    selected_cubes, selected_cube,)
                            }
                            gizmo_axis = gizmo_hit
                            if gizmo_hit > 0_u32 &&(active_tool == "move" || active_tool == "rotate" || active_tool == "scale") {
                                navigation.pointer_x = event.x()
                                navigation.pointer_y = event.y()
                                group_start_world_positions.clear()
                                group_start_positions.clear()
                                group_start_rotations.clear()
                                group_start_scales.clear()
                                for group_cube in selected_cubes {
                                    group_start_world_positions.push(actor_world_position(editor_scene, cube_entities,
                                            group_cube, position_at(cube_positions, group_cube),))
                                    group_start_positions.push(position_at(cube_positions, group_cube))
                                    group_start_rotations.push(rotation_at(cube_rotations, group_cube))
                                    group_start_scales.push(scale_at(cube_scales, group_cube))
                                }
                                group_transform_roots = gesture_roots(selected_cubes,
                                    actor_parent_indices(cube_entities, scene_actor_parents(editor_scene, cube_entities)),)
                                let mut root_positions = Vec[Vec3]::new()
                                for root in group_transform_roots {
                                    root_positions.push(actor_world_position(editor_scene, cube_entities,
                                            root, position_at(cube_positions, root),))
                                }
                                group_pivot_world = average_position(root_positions)
                                moving_cube = !group_transform_roots.is_empty()
                            } else {
                                gizmo_axis = 0_u32
                            }
                            if moving_cube {
                                move_start_world = actor_world_position(editor_scene, cube_entities, selected_cube,
                                    position_at(cube_positions, selected_cube),)
                                gizmo_gesture = GizmoGesture::begin(active_tool, gizmo_axis,
                                    GizmoProjection::new(camera.position, camera.yaw, camera.pitch, camera.fov,
                                        render_width as f32 / viewport_density, render_height as f32 / viewport_density,),
                                    move_start_world, point.0, point.1, snap_settings,)
                                moving_cube = gizmo_gesture.active()
                                gesture_generation = viewport_generation
                                transform_editing = moving_cube
                                edit_start_position = position_at(cube_positions, selected_cube)
                                edit_start_rotation = rotation_at(cube_rotations, selected_cube)
                                edit_start_scale = scale_at(cube_scales, selected_cube)
                                gesture_world_value = gizmo_world_value(editor_scene,
                                    cube_entities.get((selected_cube - 1) as usize).unwrap_or(0), active_tool, gizmo_axis,)
                            }
                            dirty = true
                        } else {
                            selected = "Nothing selected"
                            selected_cube = 0_u32
                            selected_cubes.clear()
                            selected_asset = ""
                            parent_menu_open = false
                            moving_cube = false
                            gizmo_axis = 0_u32
                            transform_editing = false
                            let _selection = command_state.execute(GrapheneCommand::Select(
                                    ActorSelectionCommand::new(Option[u64]::None)))
                            viewport_renderer.select_cubes(
                                selected_cubes, selected_cube,)
                            dirty = true
                        }
                    }
                    Option::None => {
                    }
                }
            } elif !simulating && selected_cube > 0_u32 && transform_step_kind(target) != "" {
                let kind = transform_step_kind(target)
                let before_position = position_at(cube_positions, selected_cube)
                let before_rotation = rotation_at(cube_rotations, selected_cube)
                let before_scale = scale_at(cube_scales, selected_cube)
                if kind == "move" {
                    cube_positions = set_position(cube_positions, selected_cube,
                        stepped_vector(before_position, target, 0.25_f32, 0.0_f32),)
                } elif kind == "rotate" {
                    cube_rotations = set_rotation(cube_rotations, selected_cube,
                        stepped_vector(before_rotation, target, if snap_settings.enabled("rotate") {
                                snap_settings.step("rotate") * 0.0174532925_f32
                            } else {
                                0.01745329_f32
                            }
                            , 0.0_f32,),)
                    render_rotations = cube_rotations
                } else {
                    cube_scales = set_scale(cube_scales, selected_cube,
                        stepped_vector(before_scale, target, 0.1_f32, 0.1_f32),)
                }
                let after_position = position_at(cube_positions, selected_cube)
                let after_rotation = rotation_at(cube_rotations, selected_cube)
                let after_scale = scale_at(cube_scales, selected_cube)
                status_message = "Adjusted " + kind + " for " + selected
                match cube_entities.get((selected_cube - 1_u32) as usize) {
                    Option::Some(entity) => {
                        let changed = command_state.execute(GrapheneCommand::SetTransform(
                                ActorTransformCommand::new(entity, Transform::identity()
                                    .with_position(after_position).with_rotation(after_rotation)
                                    .with_scale(after_scale),)))
                        if changed.success() {
                            editor_scene = command_state.scene()
                            project_dirty = command_state.dirty()
                        } else {
                            cube_positions = set_position(cube_positions, selected_cube, before_position)
                            cube_rotations = set_rotation(cube_rotations, selected_cube, before_rotation)
                            cube_scales = set_scale(cube_scales, selected_cube, before_scale)
                            render_rotations = cube_rotations
                            status_message = changed.message()
                        }
                    }
                    Option::None => {
                    }
                }
                dirty = true
            } else {
                let mut cube_index = 0_u32
                while cube_index < object_count {
                    if target == "entity-cube-" + Debug::fmt(cube_index + 1_u32) {
                        selected = actor_name_at(actor_names, cube_index + 1_u32)
                        selected_cube = cube_index + 1_u32
                        match cube_entities.get(cube_index as usize) {
                            Option::Some(actor) => {
                                let _selection = command_state.execute(GrapheneCommand::Select(
                                        ActorSelectionCommand::new(Option[u64]::Some(actor))))
                            }
                            Option::None => {
                                if gizmo_axis > 0_u32 {
                                    let pointer_delta = if gizmo_axis == 2_u32 {
                                        (navigation.pointer_y - event.y()) * camera.distance * 0.012_f32
                                    } else {
                                        (event.x() - navigation.pointer_x) * camera.distance * 0.012_f32
                                    }
                                    let before = position_at(cube_positions, selected_cube)
                                    let before_world = actor_world_position(editor_scene, cube_entities,
                                        selected_cube, before,)
                                    let raw_delta = if gizmo_axis == 1_u32 {
                                        Vec3::new(pointer_delta, 0.0_f32, 0.0_f32)
                                    } elif gizmo_axis == 2_u32 {
                                        Vec3::new(0.0_f32, pointer_delta, 0.0_f32)
                                    } else {
                                        Vec3::new(0.0_f32, 0.0_f32, pointer_delta)
                                    }
                                    let local = actor_local_position_for_world(editor_scene, cube_entities,
                                        selected_cube, before_world.add(raw_delta), before,)
                                    cube_positions = set_position(cube_positions, selected_cube, local)
                                    navigation.pointer_x = event.x()
                                    navigation.pointer_y = event.y()
                                }
                            }
                        }
                        selected_asset = ""
                        parent_menu_open = false
                        dirty = true
                    }
                    cube_index = cube_index + 1_u32
                }
            }
            if target == "code-editor" {
                match retained_bounds(reactive_ui, "code-editor") {
                    Option::Some(bounds) => {
                        let cursor = window.wrapped_text_index(code_editor.value(), bounds.width() -
                            20.0_f32,
                            event.x() - bounds.x() - 10.0_f32, event.y() - bounds.y() - 10.0_f32,)
                        code_editor = code_editor.with_cursor(cursor)
                    }
                    Option::None => {
                    }
                }
            }
            if target == "command-console" {
                match retained_bounds(reactive_ui, "command-console") {
                    Option::Some(bounds) => {
                        let cursor = window.text_index(console_editor.value(),
                            event.x() - bounds.x() - 7.0_f32,)
                        console_editor = console_editor.with_cursor(cursor)
                    }
                    Option::None => {
                    }
                }
            }
            code_focused = false
            console_focused = target == "command-console"
            if console_focused {
                code_focused = false
                actor_name_focused = false
                outliner_search_focused = false
                asset_search_focused = false
            }
            let next_asset_search_focused = target == "asset-search"
            if next_asset_search_focused != asset_search_focused {
                dirty = true
            }
            asset_search_focused = next_asset_search_focused
            if asset_search_focused {
                code_focused = false
                actor_name_focused = false
                outliner_search_focused = false
            }
            if target != "entity-name" {
                actor_name_focused = false actor_name_before_edit = selected actor_name_editor = TextEditor::new(selected)
            }
            if target != "scene-search" {
                outliner_search_focused = false
            }
        }
        if previous_open_menu != open_menu ||
        previous_add_actor_open != add_actor_open ||
        previous_outliner_settings_open != outliner_settings_open ||
        previous_open_viewport_menu != open_viewport_menu ||
        previous_parent_menu_open != parent_menu_open ||
        previous_open_viewport_menu != open_viewport_menu {
            dirty = true
        }
        if request_exit {
            break
        }
        if event.kind() == event_pointer_move() &&
        text_selection_target == "code-editor" {
            match retained_bounds(reactive_ui, "code-editor") {
                Option::Some(bounds) => {
                    let cursor = window.wrapped_text_index(code_editor.value(),
                        bounds.width() - 20.0_f32,
                        event.x() - bounds.x() - 10.0_f32,
                        event.y() - bounds.y() - 10.0_f32,)
                    code_editor = code_editor.with_selection(
                        code_editor.selection_anchor(), cursor,)
                    dirty = true
                }
                Option::None => {
                }
            }
        } elif event.kind() == event_pointer_move() &&
        text_selection_target == "command-console" {
            match retained_bounds(reactive_ui, "command-console") {
                Option::Some(bounds) => {
                    let cursor = window.text_index(console_editor.value(),
                        event.x() - bounds.x() - 7.0_f32,)
                    console_editor = console_editor.with_selection(
                        console_editor.selection_anchor(), cursor,)
                    dirty = true
                }
                Option::None => {
                }
            }
        }
        // UE-style viewport flight: hold RMB and use WASD to move in the
        // view plane, Q/E to move vertically, and Shift for a speed boost.
        if event.kind() == event_pointer_move() && navigation.orbiting {
            if navigation.dolly {
                camera.distance = camera.distance - event.dy() * 0.025_f32
                if camera.distance < 0.5_f32 {
                    camera.distance = 0.5_f32
                }
                if camera.distance > 10000.0_f32 {
                    camera.distance = 10000.0_f32
                }
                camera.position = camera.target.add(Vec3::from_spherical(camera.yaw, camera.pitch).scale(camera.distance))
            } else {
                let delta_x = if navigation.pointer_locked {
                    event.dx()
                } else {
                    event.x() - navigation.pointer_x
                }
                let delta_y = if navigation.pointer_locked {
                    event.dy()
                } else {
                    event.y() - navigation.pointer_y
                }
                // UE's editor convention turns the scene opposite to the
                // cursor: dragging right rotates the view to the left.
                camera.look(delta_x, delta_y, navigation.orbit_pivot)
            }
            navigation.pointer_x = event.x()
            navigation.pointer_y = event.y()
            dirty = true
            viewport_only = true
            reactive_only = true
        }
        if event.kind() == event_pointer_move() && navigation.panning {
            camera.pan(event.x() - navigation.pointer_x,
                event.y() - navigation.pointer_y, camera_speed_value(camera_speed),)
            navigation.pointer_x = event.x()
            navigation.pointer_y = event.y()
            dirty = true
            viewport_only = true
            reactive_only = true
        }
        let flight_input_active = flight.active()
        // Keep the timer on the current frame when no flight key is held.
        // UE-style movement has no inertial tail after key-up.
        if navigation.orbiting && !flight_input_active {
            navigation.tick_ns = performance_counter_ns()
        }
        if navigation.orbiting && event.kind() == event_key_down() && event.key() == 122_u32 {
            camera.fov = camera.fov + 0.05_f32
            if camera.fov > 1.45_f32 {
                camera.fov = 1.45_f32
            }
            dirty = true viewport_only = true reactive_only = true
        } elif navigation.orbiting && event.kind() == event_key_down() && event.key() == 99_u32 {
            camera.fov = camera.fov - 0.05_f32
            if camera.fov < 0.55_f32 {
                camera.fov = 0.55_f32
            }
            dirty = true viewport_only = true reactive_only = true
        }
        if navigation.orbiting && !navigation.orbit_pivot && !navigation.dolly && navigation.focused && !simulating {
            let now = performance_counter_ns()
            let elapsed_ns = if now >= navigation.tick_ns {
                now - navigation.tick_ns
            } else {
                0_u64
            }
            navigation.tick_ns = now
            let movement = flight.direction(camera.yaw, camera.pitch)
            let speed = if camera.distance < 1.0_f32 {
                1.0_f32
            } else {
                camera.distance
            }
            * 1.25_f32 * camera_speed_value(camera_speed) *
            flight.speed_multiplier()
            if camera.fly(movement, speed, elapsed_ns) {
                dirty = true
                viewport_only = true
                reactive_only = true
            }
        }
        // Camera navigation must present every tick.  The retained/reactive
        // UI path can legitimately skip the viewport paint when only the
        // camera pose changed; that makes several movement steps appear as a
        // single jump when the next full frame is finally presented.  While
        // the navigation gesture is held, use the regular frame path so the
        // current pose is visible continuously.
        if navigation.orbiting || navigation.panning || flight_input_active || dragging {
            dirty = true
            viewport_only = true
            // Interactive transforms also patch the Details values. Keep the
            // reactive target commit enabled while rendering the viewport so
            // position/rotation/scale remain live during the drag.
            if !moving_cube {
                reactive_only = false
            }
        }
        if hover_only {
            dirty = true
            reactive_only = true
        }
        gesture_transform_changed = false
        if (event.kind() == event_pointer_move() ||(event.kind() == event_scroll() && gizmo_axis == 7 && gizmo_gesture.tool() == "move")) && moving_cube && selected_cube > 0_u32 {
            let previous_translation = gizmo_gesture.translation()
            let previous_delta = gizmo_gesture.applied()
            if event.kind() == event_scroll() {
                gizmo_gesture.adjust_depth(event.wheel_y())
            }
            let _sample = gizmo_gesture.update(
                event.x() - viewport_pixel_x as f32 / viewport_density,
                event.y() - viewport_pixel_y as f32 / viewport_density,)
            if gizmo_gesture.tool() == "scale" {
                let mut smallest = 0.0_f32
                let mut first_root = true
                let mut index = 0_usize
                for actor in selected_cubes {
                    if selection_contains(group_transform_roots, actor) {
                        let start = group_start_scales.get(index).unwrap_or(edit_start_scale)
                        let mut value = gesture_axis_value(start, gizmo_axis)
                        if gizmo_axis > 3 {
                            value = 1000000_f32
                            for axis in 1..4 {
                                if gizmo_handle_contains(gizmo_axis, axis as u32) {
                                    let component = gesture_axis_value(start, axis as u32)
                                    let magnitude = if component < 0 {
                                        - component
                                    } else {
                                        component
                                    }
                                    if magnitude > 0 && magnitude < value {
                                        value = magnitude
                                    }
                                }
                            }
                        }
                        if first_root || value < smallest {
                            smallest = value
                        }
                        first_root = false
                    }
                    index += 1
                }
                gizmo_gesture.limit_scale(smallest)
            }
            let delta = gizmo_gesture.applied()
            let translation = gizmo_gesture.translation()
            gesture_transform_changed = if gizmo_gesture.tool() == "move" {
                previous_translation.x() != translation.x() || previous_translation.y() != translation.y() || previous_translation.z() != translation.z()
            } else {
                previous_delta != delta
            }
            if gesture_transform_changed {
                let mut group_index = 0_usize
                while group_index < selected_cubes.len() {
                    let group_cube = selected_cubes.get(group_index).unwrap_or(0_u32)
                    if !selection_contains(group_transform_roots, group_cube) {
                        group_index += 1
                        continue
                    }
                    if gizmo_gesture.tool() == "move" {
                        let start_world = group_start_world_positions.get(group_index).unwrap_or(move_start_world)
                        let start_local = group_start_positions.get(group_index).unwrap_or(edit_start_position)
                        let local = actor_local_position_for_world(editor_scene, cube_entities, group_cube,
                            start_world.add(translation), start_local,)
                        cube_positions = set_position(cube_positions, group_cube, local)
                    } elif gizmo_gesture.tool() == "rotate" {
                        let start = group_start_rotations.get(group_index).unwrap_or(edit_start_rotation)
                        let next = gesture_axis_add(start, gizmo_axis, delta)
                        cube_rotations = set_rotation(cube_rotations, group_cube, next)
                        render_rotations = set_rotation(render_rotations, group_cube, next)
                    } else {
                        let start = group_start_scales.get(group_index).unwrap_or(edit_start_scale)
                        let next = if gizmo_axis > 3 {
                            gizmo_handle_scale(start, gizmo_axis, 1 + delta)
                        } else {
                            gesture_axis_add(start, gizmo_axis, delta)
                        }
                        cube_scales = set_scale(cube_scales, group_cube, next)
                        let factor = if gizmo_axis > 3 {
                            1 + delta
                        } else {
                            gesture_axis_value(next, gizmo_axis) / gesture_axis_value(start, gizmo_axis)
                        }
                        let world = group_start_world_positions.get(group_index).unwrap_or(move_start_world)
                        let offset = world.sub(group_pivot_world)
                        let scaled = if gizmo_axis > 3 {
                            gizmo_handle_scale(offset, gizmo_axis, 1 + delta)
                        } else {
                            gesture_axis_add(offset, gizmo_axis, gesture_axis_value(offset, gizmo_axis) *(factor - 1))
                        }
                        let before = group_start_positions.get(group_index).unwrap_or(edit_start_position)
                        cube_positions = set_position(cube_positions, group_cube,
                            actor_local_position_for_world(editor_scene, cube_entities, group_cube,
                                group_pivot_world.add(scaled), before,),)
                    }
                    group_index += 1
                }
                let mut transforms = Vec[ActorTransformCommand]::new()
                for group_cube in group_transform_roots {
                    match cube_entities.get((group_cube - 1_u32) as usize) {
                        Option::Some(entity) => {
                            transforms.push(ActorTransformCommand::new(entity, Transform::identity()
                                    .with_position(position_at(cube_positions, group_cube))
                                    .with_rotation(rotation_at(cube_rotations, group_cube))
                                    .with_scale(scale_at(cube_scales, group_cube)),))
                        }
                        Option::None => {
                        }
                    }
                }
                if transforms.len() > 0_usize {
                    let command = if transforms.len() == 1_usize {
                        match transforms.get(0_usize) {
                            Option::Some(value) => GrapheneCommand::SetTransform(value)
                            Option::None => GrapheneCommand::SetTransforms(ActorTransformsCommand::new(transforms))
                        }
                    } else {
                        GrapheneCommand::SetTransforms(ActorTransformsCommand::new(transforms))
                    }
                    let changed = if command_state.interactive_active() {
                        command_state.preview_interactive(command)
                    } else {
                        command_state.begin_interactive(command)
                    }
                    if changed.success() {
                        editor_scene = command_state.scene()
                        gesture_world_value = gizmo_world_value(editor_scene,
                            cube_entities.get((selected_cube - 1) as usize).unwrap_or(0), gizmo_gesture.tool(), gizmo_axis,)
                    } else {
                        status_message = changed.message()
                    }
                }
            }
            dirty = true
            viewport_only = gesture_transform_changed
            reactive_only = !gesture_transform_changed
        }
        if event.kind() == event_pointer_up() && event.key() == 3_u32 {
            navigation.cancel_pointer()
            window.set_relative_mouse_mode(false)
            shortcuts.clear()
            flight.clear()
        }
        if event.kind() == event_pointer_up() && event.key() == 2_u32 {
            navigation.panning = false
        }
        if event.kind() == event_pointer_up() && event.key() == 1_u32 {
            if navigation.orbit_pivot {
                navigation.orbiting = false
                navigation.orbit_pivot = false
                navigation.pointer_locked = false
                window.set_relative_mouse_mode(false)
            }
            text_selection_target = ""
            if transform_editing && selected_cube > 0_u32 {
                if command_state.interactive_active() {
                    let committed = command_state.commit_interactive()
                    if committed.success() {
                        editor_scene = command_state.scene()
                        project_dirty = command_state.dirty()
                    } else {
                        status_message = committed.message()
                    }
                }
                dirty = true
            }
            transform_editing = false
            moving_cube = false
            gizmo_axis = 0_u32
        }
        if shortcuts.action_triggered("camera.focus") && navigation.focused && !navigation.orbiting && selected_cube
        > 0_u32 &&
        !simulation_mode_is_play(simulation_mode) {
            camera.target = actor_world_position(editor_scene, cube_entities, selected_cube,
                position_at(cube_positions, selected_cube),)
            camera.position = camera.target.add(Vec3::from_spherical(camera.yaw, camera.pitch).scale(camera.distance))
            dirty = true
            viewport_only = true
        }
        if navigation.focused && !code_focused && !navigation.orbiting && !moving_cube &&
        !simulation_mode_is_play(simulation_mode)
        {
            if shortcuts.action_triggered("tool.select") {
                active_tool = "select" dirty = true
            } elif shortcuts.action_triggered("tool.move") {
                active_tool = "move" dirty = true
            } elif shortcuts.action_triggered("tool.rotate") {
                active_tool = "rotate" dirty = true
            } elif shortcuts.action_triggered("tool.scale") {
                active_tool = "scale" dirty = true
            }
        }
        if event.kind() == event_key_down() && event.key() == 27_u32 && unsaved_action != "" {
            unsaved_action = "" action_after_save = "" dirty = true
        } elif event.kind() == event_key_down() && event.key() == 27_u32 && add_actor_open {
            add_actor_open = false
            dirty = true
        } elif event.kind() == event_key_down() && event.key() == 27_u32 && outliner_settings_open {
            outliner_settings_open = false
            dirty = true
        } elif event.kind() == event_key_down() && event.key() == 27_u32 && simulating {
            request_stop = true
        }
        if request_stop && simulating {
            let stopped_play = simulation_mode_is_play(simulation_mode)
            let stopped = command_state.execute(GrapheneCommand::StopSimulation)
            if !stopped.success() {
                status_message = stopped.message()
            }
            simulating = command_state.simulation_mode() != ""
            simulation_mode = command_state.simulation_mode()
            render_rotations = copy_vec3_values(cube_rotations)
            if stopped_play {
                shading_mode = shading_mode_from_value(editor_shading_mode)
                viewport_renderer.set_shading_mode(
                    shading_mode_value(shading_mode),)
                editor_shading_mode_saved = false
                camera.restore_editor_pose()
            }
            navigation.cancel_pointer()
            moving_cube = false
            navigation.focused = false
            status_message = "Simulation stopped"
            dirty = true
        }
        if event.kind() == event_key_down() && event.control() && !code_focused && !console_focused &&
        !outliner_search_focused &&
        !asset_search_focused && !actor_name_focused && transform_field == "" && unsaved_action == ""
        {
            if event.key() == 122_u32 && event.shift() {
                request_redo = true
            } elif event.key() == 122_u32 {
                request_undo = true
            } elif event.key() == 121_u32 {
                request_redo = true
            } elif event.key() == 100_u32 && selected_cube > 0_u32 && !simulating {
                request_duplicate = true
            }
        }
        if event.kind() == event_key_down() && event.control() && event.key() == 115_u32 && project_loaded
        && !simulating && unsaved_action == "" {
            request_save = true
        }
        if event.kind() == event_key_down() && event.key() == key_delete() && ui.scene_keyboard_focus(navigation.focused) &&
        selected_cube > 0_u32 && !simulating && !moving_cube && !navigation.orbiting &&
        !code_focused && !console_focused && !outliner_search_focused && !asset_search_focused &&
        !actor_name_focused && transform_field == "" && !ui.actors.editing() && !ui.browser.focused &&
        ui.browser.popup == "" && ui.popup() == "" && !material_editor.popup_open() && !blueprint_editor.popup_open() &&
        project_dialog_mode == "" && unsaved_action == "" {
            request_delete = true
        }
        if event.kind() == event_scroll() {
            if asset_picker_mode(project_dialog_mode) {
                asset_picker = asset_picker.scroll_by(0.0_f32 - event.wheel_y() * 24.0_f32)
                dirty = true
            } elif viewport_point_extent(viewport_pixel_x, viewport_pixel_y,
                render_width, render_height, viewport_density,
                event.x(), event.y(),).is_some() && !simulation_mode_is_play(simulation_mode) && !moving_cube
            {
                if navigation.orbiting {
                    camera_speed = if event.wheel_y() > 0.0_f32 {
                        if camera_speed == "0.25" {
                            "0.5"
                        } elif camera_speed == "0.5" {
                            "1"
                        } elif camera_speed == "1" {
                            "2"
                        } else {
                            "4"
                        }
                    } else {
                        if camera_speed == "4" {
                            "2"
                        } elif camera_speed == "2" {
                            "1"
                        } elif camera_speed == "1" {
                            "0.5"
                        } else {
                            "0.25"
                        }
                    }
                    status_message = "Camera speed " + camera_speed_name(camera_speed)
                } else {
                    let forward = Vec3::zero().sub(Vec3::from_spherical(camera.yaw,
                            camera.pitch,)).normalized()
                    let dolly = camera_wheel_dolly(forward, event.wheel_y(),
                        camera.distance, camera_speed_value(camera_speed),)
                    camera.position = camera.position.add(dolly)
                    camera.target = camera.target.add(dolly)
                }
                dirty = true
                viewport_only = true
            }
        }
        if !simulating && event.kind() == event_pointer_up() && dragging {
            match viewport_point_extent(viewport_pixel_x, viewport_pixel_y,
                render_width, render_height, viewport_density,
                event.x(), event.y(),) {
                Option::Some(point) => {
                    let previous_count = object_count
                    let mut position = Vec3::zero()
                    match viewport_renderer.ground_point_pose_at(point.0 * window.pixel_density(), point.1
                        * window.pixel_density(), camera.position, camera.yaw, camera.pitch, camera.fov,)
                    {
                        Option::Some(ground) => {
                            position = ground
                        }
                        Option::None => {
                        }
                    }
                    let mut placed_mesh_name = if selected_asset == "asset-character" {
                        "@skeletal-mesh"
                    } elif selected_asset == "asset-particle-system" {
                        "@particle-system"
                    } elif selected_asset == "asset-audio-source" {
                        "@audio-source"
                    } elif selected_asset == "asset-plane" {
                        "@plane"
                    } elif selected_asset == "asset-sphere" {
                        "@sphere"
                    } else {
                        ""
                    }
                    let mut placed_mesh = MeshId::new(0_u64)
                    let mut placed_asset_index = 0_usize
                    while placed_asset_index < imported_meshes.len() {
                        if selected_asset == "asset-imported-mesh-" + placed_asset_index.fmt() {
                            match imported_meshes.get(placed_asset_index) {
                                Option::Some(asset) => {
                                    placed_mesh_name = asset.name()
                                }
                                Option::None => {
                                }
                            }
                            match imported_gpu_meshes.get(placed_asset_index) {
                                Option::Some(mesh) => {
                                    placed_mesh = mesh
                                }
                                Option::None => {
                                }
                            }
                        }
                        placed_asset_index = placed_asset_index + 1_usize
                    }
                    let actor_name = actor_name_for_mesh(placed_mesh_name, object_count + 1_u32)
                    let mut add_command = AddActorCommand::with_asset(actor_name, Transform::identity().with_position(position), placed_mesh_name)
                    if placed_mesh_name == "@skeletal-mesh" {
                        let mut c = SkeletalMeshComponent::defaults() c.asset = selected_character_path add_command = add_command.with_component(SceneComponent::SkeletalMesh(c))
                    }
                    if placed_mesh_name == "@audio-source" {
                        let mut source = AudioSource::defaults() source.asset = audio_panel.selected add_command = add_command.with_component(SceneComponent::Audio(source))
                    }
                    if placed_mesh_name == "@particle-system" {
                        let mut c = ParticleComponent::defaults() c.asset = particle_editor.selected_path c.preview = true add_command = add_command.with_component(SceneComponent::Particle(c))
                    }
                    let added = command_state.execute(GrapheneCommand::AddActor(add_command))
                    if added.success() {
                        editor_scene = command_state.scene()
                        let projection = editor_actors_from_scene(editor_scene, cube_entities,
                            cube_mesh_names,)
                        cube_entities = projection.ids()
                        actor_names = projection.names()
                        cube_mesh_names = command_state.asset_names(cube_entities)
                        actor_visibilities = projection.visibilities()
                        cube_positions = projection.positions()
                        cube_rotations = projection.rotations()
                        cube_scales = projection.scales()
                        render_rotations = cube_rotations
                        object_count = cube_entities.len() as u32
                        selected_cube = object_count
                        selected = actor_name
                        match added.events().get(0_usize) {
                            Option::Some(command_event) => {
                                let _selection = command_state.execute(GrapheneCommand::Select(
                                        ActorSelectionCommand::new(command_event.actor())))
                            }
                            Option::None => {
                            }
                        }
                        rebuild_viewport_actors(viewport_renderer, previous_count, cube_mesh_names,
                            actor_visibilities, cube_positions, render_rotations, cube_scales,
                            plane_gpu_mesh, sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,
                            selected_cube, cube_entities,
                            scene_actor_parents(editor_scene, cube_entities),)
                        if placed_mesh.valid() {
                            viewport_renderer.set_cube_mesh(selected_cube, placed_mesh)
                        }
                        project_dirty = command_state.dirty()
                        selected_asset = "" ui.browser.focused = false ui.browser.query_focused = false
                        ui.focus("viewport-surface") navigation.focused = true
                    } else {
                        status_message = added.message()
                    }
                }
                Option::None => {
                }
            }
            dragging = false
            dirty = true
        }
        if request_save {
            let mut request_accepted = command_state.save_pending()
            let mut request_error = ""
            if !request_accepted {
                let requested = command_state.execute(GrapheneCommand::RequestSave)
                request_accepted = requested.success()
                request_error = requested.message()
            }
            if request_accepted {
                let saved = material_editor.save(window.stylesheet()) && save_blueprint_document(command_state, blueprint_path) && save_editor_project(scene_path, script_path, cube_positions, cube_rotations,
                    cube_scales, actor_names, cube_mesh_names, actor_visibilities,
                    cube_entities, scene_actor_parents(editor_scene, cube_entities), material_path,
                    default_material, code_editor.value(), editor_scene,)
                let completion_message = if saved {
                    "Saved scene and " + script_path
                } else {
                    "Unable to save editor project"
                }
                let _completed = command_state.execute(GrapheneCommand::CompleteSave(
                        OperationCompletionCommand::new(saved, completion_message)))
                status_message = completion_message
                project_dirty = command_state.dirty()
                if saved {
                    if action_after_save != "" {
                        let action = action_after_save
                        action_after_save = ""
                        if action == "exit" {
                            request_exit = true
                        } else {
                            project_dialog_mode = action
                            project_path_editor = TextEditor::new(if action == "new" {
                                    cwd() + "/GrapheneProject"
                                } else {
                                    project_root
                                }
                            )
                            project_path_focused = true project_error = ""
                        }
                    }
                } else {
                    if action_after_save != "" {
                        unsaved_action = action_after_save action_after_save = ""
                    }
                }
            } else {
                status_message = request_error
            }
            dirty = true
        }
        if request_exit {
            break
        }
        if request_build {
            let mut request_accepted = command_state.building()
            let mut request_error = ""
            if !request_accepted {
                let requested = command_state.execute(GrapheneCommand::RequestBuild)
                request_accepted = requested.success()
                request_error = requested.message()
            }
            if request_accepted {
                if save_editor_project(scene_path, script_path, cube_positions, cube_rotations, cube_scales,
                    actor_names, cube_mesh_names, actor_visibilities,
                    cube_entities, scene_actor_parents(editor_scene, cube_entities), material_path, default_material,
                    code_editor.value(), editor_scene,) {
                    let _prepared = command_state.execute(GrapheneCommand::BuildPrepared)
                    project_dirty = command_state.dirty()
                    remove_file(build_completion_path)
                    remove_file(build_log_path)
                    build_handle = Option[JoinHandle[i32]]::Some(
                        spawn compile_game(compiler, game_manifest, build_profile, run_after_build,
                            build_log_path, build_completion_path,))
                    building = command_state.building()
                    build_output = if run_after_build {
                        "Building and running gameplay project (" + build_profile + ")..."
                    } else {
                        "Compiling gameplay project (" + build_profile + ")..."
                    }
                    status_message = build_output
                } else {
                    build_output = "Unable to save gameplay project"
                    status_message = build_output
                    let _completed = command_state.execute(GrapheneCommand::CompleteBuild(
                            OperationCompletionCommand::new(false, build_output)))
                    building = command_state.building()
                }
            } else {
                build_output = request_error
                status_message = build_output
            }
            dirty = true
        }
        if request_duplicate && selected_cube > 0_u32 {
            let previous_count = object_count
            let source_actor_name = actor_name_at(actor_names, selected_cube)
            let source_mesh_name = match cube_mesh_names.get((selected_cube - 1_u32) as usize) {
                Option::Some(value) => value Option::None => ""
            }
            let source_position = position_at(cube_positions, selected_cube)
            let position = source_position.add(Vec3::new(0.75_f32, 0.0_f32, 0.0_f32))
            let rotation = rotation_at(cube_rotations, selected_cube)
            let scale = scale_at(cube_scales, selected_cube)
            let duplicate_name = source_actor_name + " Copy " + Debug::fmt(object_count + 1_u32)
            let source_id = match cube_entities.get((selected_cube - 1_u32) as usize) {
                Option::Some(actor) => actor
                Option::None => 0_u64
            }
            let duplicated = command_state.execute(GrapheneCommand::DuplicateActor(
                    DuplicateActorCommand::new(source_id, duplicate_name,
                        Transform::identity().with_position(position)
                        .with_rotation(rotation).with_scale(scale),)))
            if duplicated.success() {
                editor_scene = command_state.scene()
                let projection = editor_actors_from_scene(editor_scene, cube_entities,
                    cube_mesh_names,)
                cube_entities = projection.ids()
                actor_names = projection.names()
                cube_mesh_names = command_state.asset_names(cube_entities)
                actor_visibilities = projection.visibilities()
                cube_positions = projection.positions()
                cube_rotations = projection.rotations()
                cube_scales = projection.scales()
                render_rotations = cube_rotations
                object_count = cube_entities.len() as u32
                selected_cube = object_count
                selected = duplicate_name
                match duplicated.events().get(0_usize) {
                    Option::Some(command_event) => {
                        let _selection = command_state.execute(GrapheneCommand::Select(
                                ActorSelectionCommand::new(command_event.actor())))
                    }
                    Option::None => {
                    }
                }
                rebuild_viewport_actors(viewport_renderer, previous_count, cube_mesh_names,
                    actor_visibilities, cube_positions, render_rotations, cube_scales,
                    plane_gpu_mesh, sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,
                    selected_cube, cube_entities,
                    scene_actor_parents(editor_scene, cube_entities),)
                let duplicate_mesh = resolve_actor_gpu_mesh(source_mesh_name, plane_gpu_mesh,
                    sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,)
                if duplicate_mesh.valid() {
                    viewport_renderer.set_cube_mesh(selected_cube, duplicate_mesh)
                }
                status_message = "Duplicated " + selected
                project_dirty = command_state.dirty()
            } else {
                status_message = duplicated.message()
            }
            dirty = true
        }
        if request_delete && selected_cube > 0_u32 && selected_cube <= object_count {
            let removed = selected_cube
            let removed_index =(removed - 1_u32) as usize
            let removed_name = actor_name_at(actor_names, removed)
            match cube_entities.get(removed_index) {
                Option::Some(entity) => {
                    let changed = command_state.execute(GrapheneCommand::DeleteActor(
                            ActorCommand::new(entity)))
                    if changed.success() {
                        editor_scene = command_state.scene()
                        let projection = editor_actors_from_scene(editor_scene, cube_entities,
                            cube_mesh_names,)
                        cube_entities = projection.ids()
                        actor_names = projection.names()
                        cube_mesh_names = command_state.asset_names(cube_entities)
                        actor_visibilities = projection.visibilities()
                        cube_positions = projection.positions()
                        cube_rotations = projection.rotations()
                        cube_scales = projection.scales()
                        render_rotations = cube_rotations
                        object_count = cube_entities.len() as u32
                        selected_cube = if object_count == 0_u32 {
                            0_u32
                        } else {
                            if removed > object_count {
                                object_count
                            } else {
                                removed
                            }
                        }
                        selected = if selected_cube > 0_u32 {
                            actor_name_at(actor_names, selected_cube)
                        } else {
                            "Camera"
                        }
                        if selected_cube > 0_u32 {
                            match cube_entities.get((selected_cube - 1_u32) as usize) {
                                Option::Some(actor) => {
                                    let _selection = command_state.execute(GrapheneCommand::Select(
                                            ActorSelectionCommand::new(Option[u64]::Some(actor))))
                                }
                                Option::None => {
                                }
                            }
                        }
                        // Keep surviving viewport entities and mesh bindings. A
                        // deletion must not tear down and recreate the scene.
                        let _removed = viewport_renderer.remove_cube(removed)
                        viewport_renderer.sync_cube_transforms_hierarchical(cube_positions,
                            render_rotations, cube_scales, actor_parent_indices(cube_entities,
                                scene_actor_parents(editor_scene, cube_entities),),)
                        viewport_renderer.select_cube(selected_cube)
                        parent_menu_open = false
                        transform_editing = false
                        moving_cube = false
                        status_message = "Deleted " + removed_name
                        project_dirty = command_state.dirty()
                    } else {
                        status_message = changed.message()
                    }
                }
                Option::None => {
                }
            }
            dirty = true
        }
        let command_history_requested =(request_undo && command_state.can_undo()) ||
        (request_redo && command_state.can_redo())
        if command_history_requested {
            let previous_count = object_count
            let command_history_redo = request_redo
            let changed = command_state.execute(if command_history_redo {
                    GrapheneCommand::Redo
                } else {
                    GrapheneCommand::Undo
                }
            )
            request_undo = false
            request_redo = false
            if changed.success() {
                editor_scene = command_state.scene()
                let projection = editor_actors_from_scene(editor_scene, cube_entities, cube_mesh_names)
                cube_entities = projection.ids()
                actor_names = projection.names()
                cube_mesh_names = command_state.asset_names(cube_entities)
                actor_visibilities = projection.visibilities()
                cube_positions = projection.positions()
                cube_rotations = projection.rotations()
                render_rotations = cube_rotations
                cube_scales = projection.scales()
                object_count = cube_entities.len() as u32
                selected_cube = match command_state.selection() {
                    Option::Some(actor) => {
                        actor_index_for_id(cube_entities, actor)
                    }
                    Option::None => {
                        0_u32
                    }
                }
                selected = if selected_cube > 0_u32 {
                    actor_name_at(actor_names, selected_cube)
                } else {
                    "Nothing selected"
                }
                rebuild_viewport_actors(viewport_renderer, previous_count, cube_mesh_names,
                    actor_visibilities, cube_positions, render_rotations, cube_scales,
                    plane_gpu_mesh, sphere_gpu_mesh, imported_meshes, imported_gpu_meshes,
