        .with_font_family("Roboto").with_padding(Insets::all(24.0_f32)).with_gap(14.0_f32))
    let mut brand = Widget::panel("project-browser-brand").with_direction(horizontal()).with_flex(72.0_f32,
        0.0_f32,).with_style(Style::default().with_gap(12.0_f32))
