fn inspector(selected: str, name_editor: TextEditor, name_focused: bool, position: Vec3, rotation: Vec3,
    scale: Vec3,
    transform_field: str, transform_editor: TextEditor, transform_invalid: bool,
    cube_selected: bool, selected_id: u64, selected_parent: Option[u64], actor_ids: Vec[u64], actor_names:
    Vec[str],
    parent_menu_open: bool, selected_mesh_name: str, hovered: str, icons: EditorIcons, ui: EditorUiState,) -> Widget {
    let mut panel = Widget::panel("details-panel").with_attribute("data-luma-scrollable", "true").with_added_classes(panel_classes() + " g-inspector")
    let mut identity = Widget::panel("object-identity").with_added_classes("g-inspector-2")
    identity.push(Widget::icon("", if ui.actors.component_kind() == "skeletal-mesh" {
                icons.mesh
            } elif ui.actors.component_kind() == "audio-source" {
                icons.content.sound
            } elif ui.actors.component_kind() == "camera" {
                icons.camera
            } elif ui.actors.component_kind() != "" {
                icons.light
            } elif cube_selected {
                icons.mesh
            } else {
                if selected == "Camera" {
                    icons.camera
                } elif selected == "Directional Light" {
                    icons.light
                } else {
                    icons.select
                }
            }
            ,
        ).with_added_classes("g-inspector-3"))
    identity.push(Widget::input("entity-name", if name_focused {
                name_editor.value()
            } else {
                selected
            }
            ,
        )
        .with_focus(name_focused).with_disabled(!cube_selected).with_added_classes("g-inspector-4"))
    identity.push(Widget::label(if cube_selected {
                "ACTOR"
            } else {
                "SCENE"
            }
        ).with_added_classes("g-inspector-5"))
    panel.push(identity)
    if !cube_selected && selected == "Nothing selected" {
        let mut empty = Widget::panel("details-empty-state")
        .with_added_classes("g-inspector-6")
        empty.push(Widget::icon("", icons.select).with_added_classes("g-inspector-7"))
        empty.push(Widget::label("Nothing selected").with_added_classes("g-inspector-8"))
        empty.push(Widget::label("Click an object in the viewport or Outliner to inspect it.").with_added_classes("g-inspector-9"))
        empty.push(Widget::spacer(1.0_f32))
        panel.push(empty)
        ret panel
    }
    if cube_selected {
        let hierarchy_content = Widget::panel("details-hierarchy-content").with_direction(vertical()).with_child(
            parent_selector(selected_id, selected_parent, actor_ids, actor_names, parent_menu_open, hovered, icons))
        panel.push(property_section("ui-section-hierarchy", "Hierarchy", ui.expanded("ui-section-hierarchy"), hierarchy_content))
    }
    let mut transform = Widget::panel("details-transform-content").with_direction(vertical()).with_classes("g-property-content")
    for prefix in vec!["location", "rotation", "scale"] {
        let name = if prefix == "location" {
            "Location"
        } elif prefix == "rotation" {
            "Rotation"
        } else {
            "Scale"
        }
        let value = if prefix == "location" {
            position
        } elif prefix == "rotation" {
            rotation
        } else {
            scale
        }
        let mut row = transform_property(name, prefix, value, transform_field, transform_editor, transform_invalid, !cube_selected)
        row.push(Widget::icon_button("ui-transform-" + prefix, "", icons.settings).with_classes("g-property-menu").with_disabled(!cube_selected).with_attribute("aria-label", name + " step controls"))
        transform.push(row)
    }
    panel.push(property_section("ui-section-transform", "Transform", ui.expanded("ui-section-transform") || transform_invalid, transform))
    if ui.actors.component_kind() != "" {
        panel.push(property_section("ui-section-component", if ui.actors.component_kind() == "camera" {
                    "Camera"
                } elif ui.actors.component_kind() == "skeletal-mesh" {
                    "Animation"
                } elif ui.actors.component_kind() == "particle-system" {
                    "Particle System"
                } elif ui.actors.component_kind() == "audio-source" {
                    "Audio Source"
                } else {
                    "Light"
                }
                , ui.expanded("ui-section-component"), ui.actors.widget(),))
    } else {
        let mut mesh = Widget::panel("mesh-component").with_added_classes("g-property-content")
        mesh.push(detail_row("Static Mesh", if cube_selected {
                    mesh_display_name(selected_mesh_name)
                } else {
                    "None"
                }
                , "tone-info",))
        mesh.push(detail_row("Material", if cube_selected {
                    "Graphene Default"
                } else {
                    "None"
                }
                , "tone-warning",))
        panel.push(property_section("ui-section-mesh", "Static Mesh", ui.expanded("ui-section-mesh"), mesh))
        if ui.mesh.available() {
            panel.push(property_section("ui-section-autolod", "AutoLOD", ui.expanded("ui-section-autolod"), ui.mesh.widget(ui.lod_groups.catalog)))
        }
    }
    panel.push(Widget::spacer(1.0_f32))
    ret panel
}

fn content_live_references(scene: Scene, names: Vec[str], project: str, material_path: str, blueprint_path: str, material: StandardMaterial) -> Vec[str] {
    let mut references = Vec[str]::new() references.extend(names)
    references.push("Content/Materials/Default.graphene-material.json")
    references.push(material.base_color_texture()) references.push(material.normal_texture())
    for path in vec![material_path, blueprint_path] {
        if path.byte_len() > project.byte_len() + 1 && path.slice_bytes(0, project.byte_len() + 1) == project + "/" {
            references.push(path.slice_bytes(project.byte_len() + 1, path.byte_len() - project.byte_len() - 1))
        }
    }
    for entity in scene.entities() {
        match entity.component() {
            Particle(c) => {
                references.push(c.asset)
            }
            Audio(source) => {
                references.push(source.asset)
            }
            _ => {
            }
        }
        match entity.blueprint() {
            Some(instance) => references.push(instance.asset) None => {
            }
        }
    }
    ret references
}

fn content_browser(icons: EditorIcons, ui: EditorUiState) -> Widget {
    ret content_widget(ui.browser, icons.content, ui.browser.editable)
}

fn save_blueprint_document(state: mut EditorState, path: str) -> bool {
    if !state.blueprint_dirty() {
        ret true
    }
    match save_blueprint(path, state.blueprint_asset()) {
        Ok(_) => {
            state.blueprint_saved() ret true
        }
        Err(_) => {
            ret false
        }
    }
}

fn code_line_numbers(text: str) -> str {
    let mut result = "1"
    let mut line = 1_usize
    let length = text.len()
    let mut index = 0_usize
    while index < length {
        match text.get_byte(index) {
            Option::Some(byte) => {
                if byte == 10_u8 && index + 1_usize < length {
                    line = line + 1_usize
                    result = result + "\n" + Debug::fmt(line)
                }
            }
            Option::None => {
            }
        }
        index = index + 1_usize
    }
    ret result
}

fn code_cursor_location(text: str, cursor: usize) ->(usize, usize) {
    let mut line = 1_usize
    let mut column = 1_usize
    let mut byte_index = 0_usize
    let mut character_index = 0_usize
    let length = text.len()
    while character_index < cursor && byte_index < length {
        match text.get_byte(byte_index) {
            Option::Some(byte) => {
                // UTF-8 continuation bytes do not advance the editor's
                // character cursor. Newline is always the single byte LF.
                if byte < 128_u8 || byte >= 192_u8 {
                    if byte == 10_u8 {
                        line = line + 1_usize column = 1_usize
                    } else {
                        column = column + 1_usize
                    }
                    character_index = character_index + 1_usize
                }
            }
            Option::None => {
            }
        }
        byte_index = byte_index + 1_usize
    }
    ret(line, column)
}

fn patch_reactive_editor(window: Window, ui: mut ReactiveUi, id: str, editor: TextEditor, focused: bool) -> bool {
    match window.authored_widget(ui, id) {
        Option[Widget]::Some(widget) => {
            ret window.stage_component(ui, id, widget.with_text(editor.value()).with_focus(focused)
                .with_selection(editor.selection_start(), editor.selection_end()),)
        }
        Option[Widget]::None => {
            ret false
        }
    }
}

fn patch_transform_display(window: Window, ui: mut ReactiveUi, position: Vec3, rotation: Vec3,
    scale: Vec3,) -> bool {
    let displayed_rotation = rotation.scale(57.29578_f32)
    let mut patched = true
    patched = window.stage_text(ui, "transform-location-x", transform_scalar(position.x())) && patched
    patched = window.stage_text(ui, "transform-location-y", transform_scalar(position.y())) && patched
    patched = window.stage_text(ui, "transform-location-z", transform_scalar(position.z())) && patched
    patched = window.stage_text(ui, "transform-rotation-x", transform_scalar(displayed_rotation.x())) && patched
    patched = window.stage_text(ui, "transform-rotation-y", transform_scalar(displayed_rotation.y())) && patched
    patched = window.stage_text(ui, "transform-rotation-z", transform_scalar(displayed_rotation.z())) && patched
    patched = window.stage_text(ui, "transform-scale-x", transform_scalar(scale.x())) && patched
    patched = window.stage_text(ui, "transform-scale-y", transform_scalar(scale.y())) && patched
    patched = window.stage_text(ui, "transform-scale-z", transform_scalar(scale.z())) && patched
    ret patched
}

fn hoverable_widget(widget: Widget) -> bool {
    let kind = widget.kind()
    ret kind == widget_button() || kind == widget_icon_button() ||
    kind == widget_icon_card() || kind == widget_input() ||
    kind == widget_textarea() || kind == widget_checkbox() ||
    kind == widget_radio() || kind == widget_switch() ||
    kind == widget_select() || kind == widget_slider() ||
    kind == widget_link() || kind == widget_color_picker() ||
    kind == widget_color_swatch() || kind == widget_color_channel() ||
    widget.id() == "parent-selector" || widget.id().contains("transform-") ||
    widget.id() == "viewport-surface"
}

