    if mode != "home" {
        brand.push(Widget::button("browser-back", "Back to Projects").with_flex(130.0_f32, 0.0_f32).with_style(
                Style::default().with_background(Color::rgb(34_u8, 36_u8, 41_u8)).with_foreground(Color::rgb(218_u8,
                        221_u8, 226_u8,))
                .with_border(1.0_f32, Color::rgb(60_u8, 63_u8, 70_u8)).with_radius(4.0_f32)))
    }
