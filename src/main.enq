            } elif target == "tool-rotate" {
                active_tool = "rotate" moving_cube = false dirty = true
            } elif target == "tool-scale" {
                active_tool = "scale" moving_cube = false dirty = true
            } elif !simulation_mode_is_play(simulation_mode) && event.key() == 3_u32 && viewport_location.is_some()
            {
