                if started.success() {
                    simulation_mode = command_state.simulation_mode()
                    simulation_started = perf_counter_ms()
                    simulating = true
                    dragging = false
                    moving_cube = false
                    navigation.orbiting = false
                    navigation.panning = false
                    open_viewport_menu = ""
                    if simulation_mode_is_play(simulation_mode) {
                        if !editor_shading_mode_saved {
                            editor_shading_mode = shading_mode_value(shading_mode)
                            editor_shading_mode_saved = true
                        }
                        shading_mode = "lit"
                        viewport_renderer.set_shading_mode(0_u32)
                        camera.enter_play_pose()
                        let _camera_loaded = load_scene_camera(camera, editor_scene, first_scene_camera(editor_scene))
                        status_message = "Play in editor started"
                    } else {
                        status_message = "Editor simulation started"
                    }
                } else {
                    status_message = started.message()
                }
                dirty = true
            } elif target == "stop" {
                request_stop = true
            } elif target == "scene-search" {
                outliner_search_focused = true
                actor_name_focused = false
                code_focused = false
                dirty = true
            } elif target == "outliner-add" && project_loaded && !simulating {
                add_actor_open = !add_actor_open
                outliner_settings_open = false
                open_menu = ""
                actor_name_focused = false
                outliner_search_focused = false
                code_focused = false
                dirty = true
            } elif target == "outliner-settings" {
                outliner_settings_open = !outliner_settings_open
                add_actor_open = false
                open_menu = ""
                actor_name_focused = false
                outliner_search_focused = false
                code_focused = false
                dirty = true
            } elif target == "outliner-show-editor-actors" {
                outliner_show_editor_actors = !outliner_show_editor_actors
                status_message = if outliner_show_editor_actors {
                    "Lights and cameras shown in Outliner"
                } else {
                    "Lights and cameras hidden from Outliner"
                }
                dirty = true
            } elif target == "outliner-show-hidden-actors" {
                outliner_show_hidden_actors = !outliner_show_hidden_actors
                status_message = if outliner_show_hidden_actors {
                    "Hidden actors shown in Outliner"
                } else {
                    "Hidden actors filtered from Outliner"
                }
                dirty = true
            } elif (target == "add-actor-cube" || target == "add-actor-plane" || target == "add-actor-sphere" || target == "add-actor-camera" || target == "add-actor-directional-light" || target == "add-actor-point-light" || target == "add-actor-spot-light" || target == "add-actor-sky-atmosphere" || target == "add-actor-sky-light" || target == "add-actor-cloud-layer" || target == "add-actor-height-fog" || target == "add-actor-weather-controller" || target == "add-actor-weather-volume"
                ||
                target.contains("add-actor-imported-")) && project_loaded && !simulating {
                let mut mesh_name = ""
                let mut valid_add = false
                match add_actor_mesh_name(target, imported_meshes) {
                    Option::Some(name) => {
                        mesh_name = name valid_add = true
                    }
                    Option::None => {
                    }
                }
                for kind in vec!["camera", "directional-light", "point-light", "spot-light", "sky-atmosphere", "sky-light", "cloud-layer", "height-fog", "weather-controller", "weather-volume"] {
                    if target == "add-actor-" + kind {
                        mesh_name = "@" + kind valid_add = true
                    }
                }
                let gpu_mesh = resolve_actor_gpu_mesh(mesh_name, plane_gpu_mesh, sphere_gpu_mesh,
                    imported_meshes, imported_gpu_meshes,)
                if valid_add {
                    let previous_count = object_count
                    let actor_name = actor_name_for_mesh(mesh_name, object_count + 1_u32)
                    let placement = if mesh_name == "@camera" {
                        Transform::identity().with_position(camera.position).with_rotation(Vec3::new( - camera.pitch, camera.yaw, 0.0_f32))
                    } elif mesh_name == "@point-light" {
                        Transform::identity().with_position(camera.target.add(Vec3::new(0.0_f32, 2.0_f32, 1.0_f32)))
                    } elif mesh_name == "@spot-light" || mesh_name == "@directional-light" {
                        Transform::identity().with_position(camera.target.add(Vec3::new(0.0_f32, 3.0_f32, 1.0_f32))).with_rotation(Vec3::new( - 1.0_f32, 0.0_f32, 0.0_f32))
                    } else {
                        Transform::identity().with_position(camera.target)
                    }
                    let added = command_state.execute(GrapheneCommand::AddActor(
