fn snap_toolbar_control(tool: str, settings: GizmoSnap, ui: EditorUiState, icons: EditorIcons) -> Widget {
    let enabled = settings.enabled(tool)
    let owner = "ui-snap-step-" + tool
    let icon = if tool == "rotate" {
        icons.rotate
    } elif tool == "scale" {
        icons.scale
    } else {
        icons.move
    }
    let mut group = Widget::panel("").with_classes("g-snap-control").with_direction(horizontal())
    group.push(Widget::icon_button("snap-toggle-" + tool, "", icon)
        .with_classes("g-snap-toggle" + if enabled {
                " state-active"
            } else {
                ""
            }
        )
        .with_attribute("aria-label", snap_tool_name(tool) + " snapping")
        .with_attribute("aria-pressed", if enabled {
                "true"
            } else {
                "false"
            }
            ,
        ))
    let mut value = Widget::button(owner, "").with_classes("g-snap-step" + if ui.popup() == owner {
            " state-active"
        } else {
            ""
        }
    )
    .with_attribute("aria-label", snap_tool_name(tool) + " snap step")
    .with_attribute("aria-haspopup", "menu").with_attribute("aria-expanded", if ui.popup() == owner {
            "true"
        } else {
            "false"
        }
        ,
    )
    value.push(Widget::label(snap_step_label(settings.step(tool), tool)).with_classes("g-snap-readout"))
    value.push(Widget::icon("", icons.expanded).with_classes("g-snap-chevron"))
    group.push(value)
    ret group
}

