fn editable_search_field(id: str, editor: TextEditor, focused: bool, placeholder: str, icon: SvgDocument,
    basis: f32, grow: f32,) -> Widget {
    let mut field = Widget::panel(id + "-surface").with_flex(basis, grow).with_added_classes("g-editable-search-field" + if focused {
            " state-focused"
        } else {
            ""
        }
    )
    field.push(Widget::icon("", icon).with_added_classes("g-editable-search-field-2" + if focused {
                " state-focused"
            } else {
                ""
            }
        ))
    let value = if !focused && editor.value() == "" {
        placeholder
    } else {
        editor.value()
    }
    field.push(Widget::input(id, value).with_focus(focused).with_added_classes("g-editable-search-field-3" + if !focused && editor.value() == "" {
                " state-focused-editor-value"
            } else {
                ""
            }
        ))
    ret field
}

