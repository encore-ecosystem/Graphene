            } elif target == "asset-material" {
                selected_asset = target
                dragging = false
                status_message = "Selected Default material"
                dirty = true
            } elif target == "asset-script" {
                selected_asset = target
                dragging = false
                code_focused = true
                actor_name_focused = false
                outliner_search_focused = false
                asset_search_focused = false
                status_message = "Selected Player script"
