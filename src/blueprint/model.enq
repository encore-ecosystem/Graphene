//! Blueprint documents contain stable identities, not executable editor state.
import core::option::Option
import core::vec::Vec

import linalg::Vec3

import refrain::gameplay::service::gameplay_operation
import refrain::scene::transform::Transform

pub enum BlueprintType {
    Exec
    Bool
    I32
    F32
    String
    Vector
    Actor
    Component
}

pub enum BlueprintValue {
    Bool(bool)
    I32(i32)
    F32(f32)
    String(str)
    Vector(Vec3)
    Actor(u64)
    Component(u64)
}

impl for BlueprintType {
    pub fn name(self: Self) -> str {
        ret match self {
            Exec => "exec" Bool => "bool" I32 => "i32" F32 => "f32"
            String => "str" Vector => "vec3" Actor => "actor" Component => "component"
        }
    }
    pub fn parse(name: str) -> Option[BlueprintType] {
        ret match name {
            "exec" => Option[BlueprintType]::Some(BlueprintType::Exec) "bool" => Option[BlueprintType]::Some(BlueprintType::Bool)
            "i32" => Option[BlueprintType]::Some(BlueprintType::I32) "f32" => Option[BlueprintType]::Some(BlueprintType::F32)
            "str" => Option[BlueprintType]::Some(BlueprintType::String) "vec3" => Option[BlueprintType]::Some(BlueprintType::Vector)
            "actor" => Option[BlueprintType]::Some(BlueprintType::Actor) "component" => Option[BlueprintType]::Some(BlueprintType::Component)
            _ => Option[BlueprintType]::None
        }
    }
}

impl for BlueprintValue {
    pub fn value_type(self: Self) -> BlueprintType {
        ret match self {
            Bool(_) => BlueprintType::Bool I32(_) => BlueprintType::I32 F32(_) => BlueprintType::F32
            String(_) => BlueprintType::String Vector(_) => BlueprintType::Vector
            Actor(_) => BlueprintType::Actor Component(_) => BlueprintType::Component
        }
    }
}

pub struct BlueprintProperty {
    id: u64
    name: str
    default_value: BlueprintValue
}

pub struct BlueprintOverride {
    property: u64
    value: BlueprintValue
}

pub struct BlueprintInstance {
    asset: str
    overrides: Vec[BlueprintOverride]
}

pub struct BlueprintComponent {
    id: u64
    parent: u64
    name: str
    kind: str
    transform: Transform
    mesh: str
    material: str
    visible: bool
}

/// Port names are catalog identities, independent of display labels.
pub struct BlueprintEndpoint {
    node: u64
    pin: str
}

pub struct BlueprintLink {
    source: BlueprintEndpoint
    target: BlueprintEndpoint
}

/// Operation is a closed catalog key; `reference` addresses properties/components.
/// Coordinates are presentation only and are excluded from compilation identity.
pub struct BlueprintNode {
    id: u64
    operation: str
    value_type: BlueprintType
    reference: u64
    text: str
    value: BlueprintValue
    x: f32
    y: f32
}

impl for BlueprintNode {
    pub fn new(id: u64, operation: str, value_type: BlueprintType) -> BlueprintNode {
        ret BlueprintNode { id, operation, value_type, 0, "", BlueprintValue::F32(0), 0, 0 }
    }
    pub fn at(self: Self, x: f32, y: f32) -> BlueprintNode {
        ret BlueprintNode {
            self.id, self.operation, self.value_type, self.reference, self.text, self.value, x, y
        }
    }
    pub fn with_reference(self: Self, reference: u64) -> BlueprintNode {
        ret BlueprintNode {
            self.id, self.operation, self.value_type, reference, self.text, self.value, self.x, self.y
        }
    }
    pub fn with_value(self: Self, value: BlueprintValue) -> BlueprintNode {
        ret BlueprintNode {
            self.id, self.operation, value.value_type(), self.reference, self.text, value, self.x, self.y
        }
    }
    pub fn with_text(self: Self, text: str) -> BlueprintNode {
        ret BlueprintNode {
            self.id, self.operation, self.value_type, self.reference, text, self.value, self.x, self.y
        }
    }
}

pub struct BlueprintPin {
    key: str
    value_type: BlueprintType
    output: bool
    required: bool
}

pub struct BlueprintAsset {
    id: str
    name: str
    components: Vec[BlueprintComponent]
    properties: Vec[BlueprintProperty]
    nodes: Vec[BlueprintNode]
    links: Vec[BlueprintLink]
    domain: str
}

impl for BlueprintAsset {
    pub fn new(id: str, name: str) -> BlueprintAsset {
        ret BlueprintAsset {
            id, name,
            vec![BlueprintComponent { 1, 0, "Root", "scene", Transform::identity(), "", "", true }],
            Vec[BlueprintProperty]::new(), Vec[BlueprintNode]::new(), Vec[BlueprintLink]::new(), "actor"
        }
    }
    pub fn node(self: Self, id: u64) -> Option[BlueprintNode] {
        for node in self.nodes {
            if node.id == id {
                ret Option[BlueprintNode]::Some(node)
            }
        }
        ret Option[BlueprintNode]::None
    }
    pub fn property(self: Self, id: u64) -> Option[BlueprintProperty] {
        for property in self.properties {
            if property.id == id {
                ret Option[BlueprintProperty]::Some(property)
            }
        }
        ret Option[BlueprintProperty]::None
    }
    pub fn component(self: Self, id: u64) -> Option[BlueprintComponent] {
        for component in self.components {
            if component.id == id {
                ret Option[BlueprintComponent]::Some(component)
            }
        }
        ret Option[BlueprintComponent]::None
    }
    pub fn next_node_id(self: Self) -> u64 {
        let mut id = 1_u64
        for node in self.nodes {
            if node.id >= id {
                id = node.id + 1
            }
        }
        ret id
    }
    pub fn connect(self: mut Self, source: u64, source_pin: str, target: u64, target_pin: str) ->() {
        self.links.push(BlueprintLink {
                BlueprintEndpoint { source, source_pin }, BlueprintEndpoint {
                    target, target_pin
                }
            }
            ,
        )
    }
}

pub struct BlueprintDiagnostic {
    node: u64
    pin: str
    message: str
}

fn input(key: str, value_type: BlueprintType) -> BlueprintPin {
    ret BlueprintPin { key, value_type, false, true }
}
fn output(key: str, value_type: BlueprintType) -> BlueprintPin {
    ret BlueprintPin { key, value_type, true, false }
}
/// UI control flow is compiled like any other node; the host only copies typed state.
pub fn blueprint_ui_action(operation: str) -> i32 {
    ret match operation {
        "ui-resume" => 1_i32
        "ui-open-settings" => 2_i32
        "ui-open-pause" => 3_i32
        "ui-close" => 4_i32
        "ui-apply-settings" => 5_i32
        "ui-reset-settings" => 6_i32
        "ui-cancel-settings" => 7_i32
        "ui-stop-play" => 8_i32
        _ => 0_i32
    }
}

pub fn blueprint_event(operation: str) -> bool {
    ret operation == "game-event" || operation == "placement-completed" || operation == "placement-failed" || operation == "placement-cancelled" || operation == "primary-pressed" || operation == "secondary-pressed" || operation == "move-completed" || operation == "move-failed" || operation == "construction" || operation == "begin-play" || operation == "tick" ||
    operation == "input-pressed" || operation == "input-released" || operation == "ui-click" || operation == "ui-change" || operation == "ui-destruct"
}
pub fn blueprint_pins(node: BlueprintNode) -> Vec[BlueprintPin] {
    let exec = BlueprintType::Exec
    let value_type = node.value_type
    let operation = node.operation
    if gameplay_operation(operation) {
        let mut pins = vec![input("in", exec), output("completed", exec), output("failed", exec), output("count", BlueprintType::I32), output("actor", BlueprintType::Actor), output("text", BlueprintType::String)]
        if operation == "physics-static-box" {
            pins.push(input("actor", BlueprintType::Actor)) pins.push(input("extents", BlueprintType::Vector)) ret pins
        }
        if operation == "world-broadcast" || operation == "actor-find" {
            pins.push(input("name", BlueprintType::String)) ret pins
        }
        if operation == "team-value-get" || operation == "team-value-set" {
            pins.push(input("team", BlueprintType::I32)) pins.push(input("key", BlueprintType::String))
            if operation == "team-value-set" {
                pins.push(input("value", BlueprintType::I32))
            }
            ret pins
        }
        if operation == "health-register" {
            pins.push(input("actor", BlueprintType::Actor)) pins.push(input("team", BlueprintType::I32)) pins.push(input("maximum", BlueprintType::I32)) ret pins
        }
        if operation == "health-get" || operation == "health-team" {
            pins.push(input("actor", BlueprintType::Actor)) ret pins
        }
        if operation == "health-damage" || operation == "health-heal" {
            pins.push(input("actor", BlueprintType::Actor)) pins.push(input("amount", BlueprintType::I32)) ret pins
        }
        if operation == "inventory-transfer-all" || operation == "distance-to" || operation == "actor-teleport" || operation == "control-seat-ai" {
            pins.push(input("actor", BlueprintType::Actor)) pins.push(input("target", BlueprintType::Actor)) ret pins
        }
        if operation == "find-nearest" {
            pins.push(input("actor", BlueprintType::Actor)) pins.push(input("asset", BlueprintType::String)) ret pins
        }
        if operation == "spawn-blueprint" {
            pins.push(input("actor", BlueprintType::Actor)) pins.push(input("asset", BlueprintType::String)) pins.push(input("distance", BlueprintType::I32)) pins.push(input("clearance", BlueprintType::I32)) ret pins
        }
        if operation == "move-to-actor" {
            pins.push(input("actor", BlueprintType::Actor)) pins.push(input("target", BlueprintType::Actor)) pins.push(input("speed", BlueprintType::I32)) pins.push(input("clearance", BlueprintType::I32)) ret pins
        }
        if operation == "control-autonomy" {
            pins.push(input("actor", BlueprintType::Actor)) pins.push(input("enabled", BlueprintType::I32)) ret pins
        }
        if operation == "control-body" {
            ret pins
        }
        if operation == "control-set-power" {
            pins.push(input("actor", BlueprintType::Actor)) pins.push(input("enabled", BlueprintType::I32)) ret pins
        }
        if operation != "world-save" && operation != "world-load" && operation != "control-leave-vehicle" && operation != "control-return" && operation != "control-exit-terminal" && operation != "control-state" {
            pins.push(input("actor", BlueprintType::Actor))
        }
        if operation == "inventory-transfer" {
            pins.push(input("target", BlueprintType::Actor))
        }
        if operation == "inventory-add" || operation == "inventory-remove" || operation == "inventory-count" || operation == "inventory-transfer" {
            pins.push(input("item", BlueprintType::I32))
        }
        if operation == "control-register" || operation == "control-start" {
            pins.push(input("team", BlueprintType::I32))
        }
        if operation == "inventory-create" {
            pins.push(input("capacity", BlueprintType::I32))
        }
        if operation == "inventory-add" || operation == "inventory-remove" || operation == "inventory-transfer" {
            pins.push(input("count", BlueprintType::I32))
        }
        if operation == "control-start" {
            pins.push(input("player", BlueprintType::I32))
        }
        if operation == "control-register" {
            pins.push(input("kind", BlueprintType::String))
        }
        if operation == "craft-recipe" || operation == "production-configure" {
            pins.push(input("recipe", BlueprintType::String))
        }
        if operation == "production-configure" {
            pins.push(input("grid", BlueprintType::I32))
        }
        if operation == "production-enable" {
            pins.push(input("enabled", BlueprintType::I32))
        }
        if operation == "world-save" || operation == "world-load" {
            pins.push(input("slot", BlueprintType::String))
        }
        if operation == "conveyor-connect" {
            pins.push(input("target", BlueprintType::Actor)) pins.push(input("item", BlueprintType::I32)) pins.push(input("rate", BlueprintType::I32)) pins.push(input("seconds", BlueprintType::F32))
            pins.push(BlueprintPin { "visual", BlueprintType::String, false, false })
        }
        ret pins
    }
    if operation == "game-event" || operation == "placement-completed" || operation == "placement-failed" || operation == "placement-cancelled" || operation == "primary-pressed" || operation == "secondary-pressed" || operation == "move-completed" || operation == "move-failed" || operation == "construction" || operation == "begin-play" || operation == "input-pressed" || operation == "input-released" || operation == "ui-click" || operation == "ui-change" || operation == "ui-destruct" {
        ret vec![output("then", exec)]
    }
    if operation == "to-text" {
        ret vec![input("value", value_type), output("text", BlueprintType::String)]
    }
    if operation == "publish-value" {
        ret vec![input("in", exec), input("name", BlueprintType::String), input("value", BlueprintType::String), output("then", exec)]
    }
    if operation == "emit-event" {
        ret vec![input("in", exec), input("value", BlueprintType::String), output("then", exec)]
    }
    if operation == "begin-placement" {
        ret vec![input("in", exec), input("asset", BlueprintType::String), input("radius", BlueprintType::F32), output("then", exec)]
    }
    if operation == "strategy-camera" {
        ret vec![input("in", exec), output("then", exec)]
    }
    if operation == "cancel-placement" {
        ret vec![input("in", exec), output("then", exec)]
    }
    if operation == "cursor-position" {
        ret vec![output("value", BlueprintType::Vector)]
    }
    if operation == "cursor-actor" || operation == "self-actor" {
        ret vec![output("value", BlueprintType::Actor)]
    }
    if operation == "cursor-valid" || operation == "is-selected" {
        ret vec![output("value", BlueprintType::Bool)]
    }
    if operation == "set-selected" {
        ret vec![input("in", exec), input("value", BlueprintType::Bool), output("then", exec)]
    }
    if operation == "move-to" {
        ret vec![input("in", exec), input("value", BlueprintType::Vector), input("speed", BlueprintType::F32), input("radius", BlueprintType::F32), output("then", exec)]
    }
    if operation == "stop-movement" {
        ret vec![input("in", exec), output("then", exec)]
    }
    if blueprint_ui_action(operation) != 0 {
        ret vec![input("in", exec), output("then", exec)]
    }
    if operation == "constant" || operation == "get-variable" {
        ret vec![output("value", value_type)]
    }
    if operation == "add" || operation == "subtract" || operation == "multiply" || operation == "divide" {
        ret vec![input("a", value_type), input("b", value_type), output("value", value_type)]
    }
    if operation == "equal" || operation == "less" || operation == "greater" {
        ret vec![input("a", value_type), input("b", value_type), output("value", BlueprintType::Bool)]
    }
    if operation == "and" || operation == "or" {
        ret vec![input("a", BlueprintType::Bool), input("b", BlueprintType::Bool), output("value", BlueprintType::Bool)]
    }
    if operation == "get-position" || operation == "get-rotation" || operation == "get-scale" {
        ret vec![output("value", BlueprintType::Vector)]
    }
    if operation == "set-position" || operation == "set-rotation" || operation == "set-scale" || operation == "add-offset" || operation == "add-rotation" {
        ret vec![input("in", exec), input("value", BlueprintType::Vector), output("then", exec)]
    }
    ret match operation {
        "tick" => vec![output("then", exec), output("delta", BlueprintType::F32)]
        "set-variable" => vec![input("in", exec), input("value", value_type), output("then", exec)]
        "not" => vec![input("value", BlueprintType::Bool), output("result", BlueprintType::Bool)]
        "make-vector" => vec![input("x", BlueprintType::F32), input("y", BlueprintType::F32), input("z", BlueprintType::F32), output("value", BlueprintType::Vector)]
        "break-vector" => vec![input("value", BlueprintType::Vector), output("x", BlueprintType::F32), output("y", BlueprintType::F32), output("z", BlueprintType::F32)]
        "branch" => vec![input("in", exec), input("condition", BlueprintType::Bool), output("true", exec), output("false", exec)]
        "sequence" => vec![input("in", exec), output("first", exec), output("second", exec)]
        "get-visible" => vec![output("value", BlueprintType::Bool)]
        "set-visible" => vec![input("in", exec), input("value", BlueprintType::Bool), output("then", exec)]
        "print" => vec![input("in", exec), input("value", BlueprintType::String), output("then", exec)]
        _ => Vec[BlueprintPin]::new()
    }
}

pub fn blueprint_pin(node: BlueprintNode, key: str, output_pin: bool) -> Option[BlueprintPin] {
    for pin in blueprint_pins(node) {
        if pin.key == key && pin.output == output_pin {
            ret Option[BlueprintPin]::Some(pin)
        }
    }
    ret Option[BlueprintPin]::None
}
