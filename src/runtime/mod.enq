pub struct Actor {
    id: u64
    name: str
    transform: RuntimeTransform
    parent: Option[u64]
    active: bool
}

impl for Actor {
    pub fn id(self: Self) -> u64 {
        ret self.id
    }
    pub fn name(self: Self) -> str {
        ret self.name
    }
    pub fn transform(self: Self) -> RuntimeTransform {
        ret self.transform
    }
    pub fn parent(self: Self) -> Option[u64] {
        ret self.parent
    }
    pub fn active(self: Self) -> bool {
        ret self.active
    }
}

pub struct World {
    actors: Vec[Actor]
    next_id: u64
}

fn actor_index(actors: Vec[Actor], id: u64) -> usize {
    let mut index = 0_usize
    while index < actors.len() {
        match actors.get(index) {
            Option[Actor]::Some(actor) => {
                if actor.id() == id {
                    ret index
                }
            }
            Option[Actor]::None => {
            }
        }
        index = index + 1_usize
    }
    ret actors.len()
}

impl for World {
    pub fn new() -> World {
        ret World {
            Vec[Actor]::new(), 1_u64
        }
    }
    pub fn actor_count(self: Self) -> usize {
        ret self.actors.len()
    }
    pub fn actor_ids(self: Self) -> Vec[u64] {
        let mut ids = Vec[u64]::new()
        for actor in self.actors {
            ids.push(actor.id())
        }
        ret ids
    }
    pub fn spawn_actor(self: mut Self, name: str, transform: RuntimeTransform) -> u64 {
        let id = self.next_id
        self.next_id = self.next_id + 1_u64
        self.actors.push(Actor {
                id, name, transform, Option[u64]::None, true
            }
            ,
        )
        ret id
    }
    pub fn spawn_actor_with_id(self: mut Self, id: u64, name: str, transform: RuntimeTransform) -> bool {
        if id == 0 || self.contains(id) {
            ret false
        }
        self.actors.push(Actor { id, name, transform, Option[u64]::None, true })
        if id >= self.next_id {
            self.next_id = id + 1
        }
        ret true
    }
    pub fn despawn_actor(self: mut Self, id: u64) -> bool {
        let index = actor_index(self.actors, id)
        if index >= self.actors.len() {
            ret false
        }
        let mut remaining = Vec[Actor]::new()
        let mut cursor = 0_usize
        for actor in self.actors {
            if cursor != index {
                remaining.push(actor)
            }
            cursor = cursor + 1_usize
        }
        self.actors = remaining
        ret true
    }
    pub fn contains(self: Self, id: u64) -> bool {
        ret actor_index(self.actors, id) < self.actors.len()
    }
    pub fn actor(self: Self, id: u64) -> Option[Actor] {
        match self.actors.get(actor_index(self.actors, id)) {
            Option[Actor]::Some(actor) => {
                ret Option[Actor]::Some(actor)
            }
            Option[Actor]::None => {
            }
        }
        ret Option[Actor]::None
    }
    pub fn transform(self: Self, id: u64) -> Option[RuntimeTransform] {
        match self.actor(id) {
            Option[Actor]::Some(actor) => {
                ret Option[RuntimeTransform]::Some(actor.transform())
            }
            Option[Actor]::None => {
            }
        }
        ret Option[RuntimeTransform]::None
    }
    pub fn set_transform(self: mut Self, id: u64, transform: RuntimeTransform) -> bool {
        let index = actor_index(self.actors, id)
        if index >= self.actors.len() {
            ret false
        }
        match self.actors.get(index) {
            Option[Actor]::Some(actor) => {
                self.actors.set(index, Actor {
                        actor.id(), actor.name(), transform, actor.parent(), actor.active()
                    }
                    ,
                )
            }
            Option[Actor]::None => {
                ret false
            }
        }
        ret true
    }
    pub fn translate(self: mut Self, id: u64, delta: Vec3) -> bool {
        match self.transform(id) {
            Option[RuntimeTransform]::Some(transform) => {
                ret self.set_transform(id, transform.with_position(transform.position().add(delta)))
            }
            Option[RuntimeTransform]::None => {
            }
        }
        ret false
    }
    pub fn set_parent(self: mut Self, id: u64, parent: Option[u64]) -> bool {
        let index = actor_index(self.actors, id)
        if index >= self.actors.len() {
            ret false
        }
        match self.actors.get(index) {
            Option[Actor]::Some(actor) => {
                self.actors.set(index, Actor {
                        actor.id(), actor.name(), actor.transform(), parent, actor.active()
                    }
                    ,
                )
            }
            Option[Actor]::None => {
                ret false
            }
        }
        ret true
    }
}

/// Graphene actor binding for the reusable Encore physics solver.
pub struct RigidBody {
    actor: u64
    velocity: Vec3
    mass: f32
    radius: f32
    gravity_scale: f32
    restitution: f32
    dynamic: bool
    enabled: bool
    shape: Shape
    friction: f32
    angular_velocity: Vec3
}

impl for RigidBody {
    pub fn dynamic(actor: u64, mass: f32, radius: f32) -> Self {
        let r = if radius > 0_f32 {
            radius
        } else {
            0.5_f32
        }
        ret Self {
            actor, Vec3::zero(), if mass > 0.000001_f32 {
                mass
            } else {
                1_f32
            }
            , r, 1_f32, 0_f32, true, true, Shape::Sphere(r), 0.6_f32, Vec3::zero()
        }
    }
    pub fn static(actor: u64, radius: f32) -> Self {
        let r = if radius > 0_f32 {
            radius
        } else {
            0.5_f32
        }
        ret Self {
            actor, Vec3::zero(), 0_f32, r, 0_f32, 0_f32, false, true, Shape::Sphere(r), 0.6_f32, Vec3::zero()
        }
    }
    pub fn actor(self: Self) -> u64 {
        ret self.actor
    }
    pub fn velocity(self: Self) -> Vec3 {
        ret self.velocity
    }
    pub fn mass(self: Self) -> f32 {
        ret self.mass
    }
    pub fn radius(self: Self) -> f32 {
        ret self.radius
    }
    pub fn gravity_scale(self: Self) -> f32 {
        ret self.gravity_scale
    }
    pub fn restitution(self: Self) -> f32 {
        ret self.restitution
    }
    pub fn dynamic_body(self: Self) -> bool {
        ret self.dynamic
    }
    pub fn enabled(self: Self) -> bool {
        ret self.enabled
    }
    pub fn shape(self: Self) -> Shape {
        ret self.shape
    }
    pub fn with_velocity(self: Self, v: Vec3) -> Self {
        ret Self {
            self.actor, v, self.mass, self.radius, self.gravity_scale, self.restitution, self.dynamic, self.enabled, self.shape, self.friction, self.angular_velocity
        }
    }
    pub fn with_gravity_scale(self: Self, v: f32) -> Self {
        ret Self {
            self.actor, self.velocity, self.mass, self.radius, v, self.restitution, self.dynamic, self.enabled, self.shape, self.friction, self.angular_velocity
        }
    }
    pub fn with_restitution(self: Self, v: f32) -> Self {
        ret Self {
            self.actor, self.velocity, self.mass, self.radius, self.gravity_scale, if v < 0_f32 {
                0_f32
            } elif v > 1_f32 {
                1_f32
            } else {
                v
            }
            , self.dynamic, self.enabled, self.shape, self.friction, self.angular_velocity
        }
    }
    pub fn set_enabled(self: Self, v: bool) -> Self {
        ret Self {
            self.actor, self.velocity, self.mass, self.radius, self.gravity_scale, self.restitution, self.dynamic, v, self.shape, self.friction, self.angular_velocity
        }
    }
    pub fn with_shape(self: Self, v: Shape) -> Self {
        ret Self {
            self.actor, self.velocity, self.mass, self.radius, self.gravity_scale, self.restitution, self.dynamic, self.enabled, v, self.friction, self.angular_velocity
        }
    }
    pub fn with_friction(self: Self, v: f32) -> Self {
        ret Self {
            self.actor, self.velocity, self.mass, self.radius, self.gravity_scale, self.restitution, self.dynamic, self.enabled, self.shape, v, self.angular_velocity
        }
    }
    pub fn with_angular_velocity(self: Self, v: Vec3) -> Self {
        ret Self {
            self.actor, self.velocity, self.mass, self.radius, self.gravity_scale, self.restitution, self.dynamic, self.enabled, self.shape, self.friction, v
        }
    }
}
