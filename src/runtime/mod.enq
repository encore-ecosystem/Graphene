struct CharacterBinding {
    actor: u64
    config: CharacterConfig
    state: CharacterState
    wish: Vec3
    jump: bool
}
pub struct PhysicsWorld {
    solver: DynamicsWorld
    events: Vec[CollisionEvent]
    characters: Vec[CharacterBinding]
    legacy_floor: bool
}

impl for PhysicsWorld {
    /// Compatibility floor for existing gameplay scripts. Scene physics uses
    /// without_floor(), so only explicitly authored colliders block movement.
    pub fn new(gravity: Vec3) -> Self {
        let mut result = Self::without_floor(gravity)
        result.solver.add(Body::new(18446744073709551615_u64, Shape::Box(Vec3::new(100000_f32, 1_f32, 100000_f32)), Vec3::new(0_f32, - 1_f32, 0_f32), 0_f32))
        result.legacy_floor = true ret result
    }
    pub fn without_floor(gravity: Vec3) -> Self {
        ret Self {
            DynamicsWorld::new(gravity), Vec[CollisionEvent]::new(), Vec[CharacterBinding]::new(), false
        }
    }
    pub fn gravity(self: Self) -> Vec3 {
        ret self.solver.gravity()
    }
    pub fn body_count(self: Self) -> usize {
        ret self.solver.bodies().len() - if self.legacy_floor {
            1_usize
        } else {
            0_usize
        }
    }
    pub fn add_body(self: mut Self, b: RigidBody) -> bool {
        let mut body = Body::new(b.actor, b.shape, Vec3::zero(), b.mass)
        body.velocity = b.velocity body.angular_velocity = b.angular_velocity body.gravity_scale = b.gravity_scale
        body.restitution = b.restitution body.friction = b.friction body.enabled = b.enabled
        ret self.add_native_body(body)
    }
    /// Adds an Encore body with an actor ID and world-space pose.
    pub fn add_native_body(self: mut Self, b: Body) -> bool {
        if b.id == 18446744073709551615_u64 || b.id == 0_u64 {
            ret false
        }
        ret self.solver.add(b)
    }
    pub fn body(self: Self, actor: u64) -> Option[RigidBody] {
        match self.solver.body(actor) {
            Some(b) => {
                ret Option[RigidBody]::Some(RigidBody {
                        b.id, b.velocity, b.mass, b.shape.extent().x(), b.gravity_scale, b.restitution, b.motion == 1_u32, b.enabled, b.shape, b.friction, b.angular_velocity
                    }
                )
            }
            None => {
                ret Option[RigidBody]::None
            }
        }
    }
    /// Applies an impulse at a world-space point and wakes a dynamic body.
    pub fn apply_impulse(self: mut Self, actor: u64, point: Vec3, impulse: Vec3) -> bool {
        ret self.solver.impulse(actor, point, impulse)
    }
    pub fn character_state(self: Self, actor: u64) -> Option[CharacterState] {
        for c in self.characters {
            if c.actor == actor {
                ret Option[CharacterState]::Some(c.state)
            }
        }
        ret Option[CharacterState]::None
    }
    pub fn solver(self: Self) -> DynamicsWorld {
        ret self.solver
    }
    pub fn stats(self: Self) -> PhysicsStats {
        ret self.solver.stats()
    }
    pub fn events(self: Self) -> Vec[CollisionEvent] {
        ret self.events
    }
    pub fn clear_events(self: mut Self) ->() {
        self.events.clear() ret()
    }
    pub fn add_character(self: mut Self, actor: u64, p: Vec3, c: CharacterConfig) -> bool {
        if !c.valid() || self.solver.body(actor).is_some() {
            ret false
        }
        let mut body = Body::new(actor, Shape::capsule(c.radius, c.half_height), p, 0_f32) body.motion = 2_u32
        if !self.add_native_body(body) {
            ret false
        }
        self.characters.push(CharacterBinding {
                actor, c, CharacterState::new(p), Vec3::zero(), false
            }
        ) ret true
    }
    pub fn character_input(self: mut Self, actor: u64, wish: Vec3, jump: bool) -> bool {
        for i in 0_usize..self.characters.len() {
            match self.characters.get(i) {
                Some(c) => {
                    if c.actor == actor {
                        self.characters.set(i, CharacterBinding {
                                c.actor, c.config, c.state, wish, c.jump || jump
                            }
                            ,
                        ) ret true
                    }
                }
                None => {
                }
            }
        }
        ret false
    }
    pub fn step(self: mut Self, world: mut World, dt: f32) ->() {
        if dt <= 0_f32 || dt > 0.1_f32 {
            ret()
        }
        self.events.clear()
        let mut removed = Vec[u64]::new()
        for body in self.solver.bodies() {
            if body.id != 18446744073709551615_u64 {
                match world.transform(body.id) {
                    Some(t) => {
                        self.solver.replace(body.with_pose(t.position(), Rotation::from_euler(t.rotation())))
                    }
                    None => {
                        removed.push(body.id)
                    }
                }
            }
        }
        for id in removed {
            self.solver.remove(id)
        }
        for i in 0_usize..self.characters.len() {
            match self.characters.get(i) {
                Some(c) => {
                    match world.transform(c.actor) {
                        Some(t) => {
                            let state = if t.position().sub(c.state.position).dot(t.position().sub(c.state.position)) > 0.000001_f32 {
                                CharacterState::new(t.position())
                            } else {
                                c.state
                            }
                            let next = move_character(self.solver, state, c.config, c.wish, c.jump, dt, c.actor)
                            world.set_transform(c.actor, t.with_position(next.position))
                            match self.solver.body(c.actor) {
                                Some(b) => {
                                    self.solver.replace(b.with_pose(next.position, Rotation::identity()))
                                }
                                None => {
                                }
                            }
                            self.characters.set(i, CharacterBinding {
                                    c.actor, c.config, next, c.wish, false
                                }
                                ,
                            )
                        }
                        None => {
                        }
                    }
                }
                None => {
                }
            }
        }
        self.solver.step(dt)
        for body in self.solver.bodies() {
            if body.id != 18446744073709551615_u64 && body.motion == 1_u32 {
                match world.transform(body.id) {
                    Some(t) => {
                        world.set_transform(body.id, t.with_position(body.position).with_rotation(body.rotation.euler()))
                    }
                    None => {
                    }
                }
            }
        }
        for event in self.solver.events() {
            let floor = 18446744073709551615_u64
            if event.first == floor {
                self.events.push(CollisionEvent {
                        event.second, 0_u64, event.contact.normal, event.contact.penetration
                    }
                )
            } elif event.second == floor {
                self.events.push(CollisionEvent {
                        event.first, 0_u64, event.contact.normal.scale( - 1_f32), event.contact.penetration
                    }
                )
            } else {
                self.events.push(CollisionEvent {
                        event.first, event.second, event.contact.normal, event.contact.penetration
                    }
                )
            }
        }
        ret()
    }
}

/// Owns the complete gameplay frame pipeline: input sampling, fixed-step
/// clocking and physics. A child Encore process can keep one session for its
/// whole lifetime and expose only its World to gameplay systems.
pub struct RuntimeSession {
    clock: RuntimeClock
    world: World
    physics: PhysicsWorld
}

impl for RuntimeSession {
    pub fn new(config: RuntimeConfig, world: World, physics: PhysicsWorld) -> RuntimeSession {
        ret RuntimeSession {
            RuntimeClock::new(config), world, physics
        }
    }
    pub fn clock(self: Self) -> RuntimeClock {
        ret self.clock
    }
    pub fn world(self: Self) -> World {
        ret self.world
    }
    pub fn physics(self: Self) -> PhysicsWorld {
        ret self.physics
    }
    pub fn apply_impulse(self: mut Self, actor: u64, point: Vec3, impulse: Vec3) -> bool {
        ret self.physics.apply_impulse(actor, point, impulse)
    }
    pub fn set_physics(self: mut Self, physics: PhysicsWorld) ->() {
        self.physics = physics ret()
    }
    pub fn character_input(self: mut Self, actor: u64, wish: Vec3, jump: bool) -> bool {
        ret self.physics.character_input(actor, wish, jump)
    }
    pub fn set_world(self: mut Self, world: World) ->() {
        self.world = world
        ret()
    }
    pub fn tick(self: mut Self, elapsed_seconds: f32, input: InputSnapshot) -> RuntimeFrame {
        let frame = self.begin_frame(elapsed_seconds, input)
        self.finish_frame(frame)
        ret frame
    }
    /// Behavior systems run between begin_frame and finish_frame, before physics.
    pub fn begin_frame(self: mut Self, elapsed_seconds: f32, input: InputSnapshot) -> RuntimeFrame {
        ret self.clock.begin_frame(elapsed_seconds, input)
    }
    pub fn set_transform(self: mut Self, actor: u64, transform: RuntimeTransform) -> bool {
        ret self.world.set_transform(actor, transform)
    }
    pub fn finish_frame(self: mut Self, frame: RuntimeFrame) ->() {
        let mut runtime_world = self.world
        let mut simulation = self.physics
        let mut fixed_step = 0_u32
        while fixed_step < frame.fixed_steps() {
            simulation.step(runtime_world, frame.fixed_delta_seconds())
            fixed_step = fixed_step + 1_u32
        }
        self.world = runtime_world
        self.physics = simulation
        ret()
    }
}
