import core::fmt::Debug
import core::option::Option
import core::vec::Vec

import std::io::println

import linalg::{Mat4, Vec3}

import mod::assets::{MaterialAssets, MeshAssets, StandardMaterial}
import mod::material_program::{MaterialPipelines, MaterialProgram, material_program_fallback}
import mod::ray_lighting::{RayLightingView, RayPipelineSet}
import mod::rhi::*
import mod::scene::camera::PerspectiveCamera
import mod::scene::light::DirectionalLight
import mod::scene::renderable::{MeshId, RenderItem}
import mod::scene::world::Scene
import mod::temporal_view::TemporalView

struct SceneMaterialProgram {
    id: u64
    program: MaterialProgram<H>
}
struct SceneMaterialPipelines {
    key: str
    pipelines: MaterialPipelines<H>
}
struct MaterialTextureGroups {
    id: u64
    groups: Vec[BindGroup]
}

pub struct ObjectUniforms {
    buffers: Vec[GpuBuffer]
    groups: Vec[BindGroup]
    frame_count: u32
    available: bool
}
pub struct SceneRenderer {
    device: GraphicsDevice
    layout: BindGroupLayout
    frame_count: u32
    frame_buffers: Vec[GpuBuffer]
    instance_buffers: Vec[GpuBuffer]
    groups: Vec[BindGroup]
    solid_pipeline: RenderPipeline
    double_sided_pipeline: RenderPipeline
    rendered_objects: usize
    available: bool
    indirect_ambient: Vec3
    frame_values: Vec[f32]
    instance_values: Vec[f32]
    gi_buffers: Vec[GpuBuffer]
    light_values: Vec[f32]
    temporal: bool
    temporal_view: TemporalView<H>
    sky_entity: u64
    shelter_texture: GpuTexture
    material_groups: Vec[MaterialTextureGroups]
    ray: RayPipelineSet<H>
    material_programs: Vec[SceneMaterialProgram]
    material_pipelines: Vec[SceneMaterialPipelines]
    material_bindings: bool
}

impl for ObjectUniforms {
    pub fn create(device: GraphicsDevice, layout: BindGroupLayout, frame_count: u32) -> ObjectUniforms
    {
        let mut buffers = Vec[GpuBuffer]::new()
        let mut groups = Vec[BindGroup]::new()
        let mut available = frame_count > 0_u32
        let mut slot = 0_u32
        while slot < frame_count {
            let buffer = device.create_buffer(192_u64, buffer_uniform(), true)
            let group = device.create_uniform_bind_group(layout, buffer, 0_u64, 192_u64)
            if !buffer.available() || !group.available() {
                available = false
            }
            buffers.push(buffer)
            groups.push(group)
            slot = slot + 1_u32
        }
        ret ObjectUniforms {
            buffers, groups, frame_count, available
        }
    }
    pub fn available(self: Self) -> bool {
        ret self.available
    }
    pub fn frame_count(self: Self) -> u32 {
        ret self.frame_count
    }
    pub fn update(self: Self, slot: u32, camera: PerspectiveCamera, model: Mat4,
        aspect: f32, light: DirectionalLight, material: StandardMaterial,) -> bool {
        if !self.available || slot >= self.frame_count {
            ret false
        }
        match self.buffers.get(slot as usize) {
            Option::Some(buffer) => {
                ret buffer.write_f32s(0_u64, camera.model_view_projection(model, aspect).values()) &&
                buffer.write_f32s(64_u64, model.values()) &&
                buffer.write_f32s(128_u64, light.uniform_values()) &&
                buffer.write_f32s(160_u64, material.uniform_values())
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn bind(self: Self, pass: RenderPassEncoder, slot: u32) -> bool {
        if !self.available || slot >= self.frame_count {
            ret false
        }
        match self.groups.get(slot as usize) {
            Option::Some(group) => {
                ret pass.bind_group(group)
            }
            Option::None => {
                ret false
            }
        }
    }
    pub fn destroy(self: Self) -> bool {
        let mut destroyed = true
        for group in self.groups {
            if !group.destroy() {
                destroyed = false
            }
        }
        for buffer in self.buffers {
            if !buffer.destroy() {
                destroyed = false
            }
        }
        ret destroyed
    }
}

impl for SceneRenderer {
    pub fn create(device: GraphicsDevice, layout: BindGroupLayout, frame_count: u32,
        solid_pipeline: RenderPipeline, double_sided_pipeline: RenderPipeline,) -> SceneRenderer
    {
        let mut frame_buffers = Vec[GpuBuffer]::new()
        let mut instance_buffers = Vec[GpuBuffer]::new()
        let mut groups = Vec[BindGroup]::new()
        let mut available = device.available() && layout.available() && frame_count > 0_u32 &&
        solid_pipeline.available() && double_sided_pipeline.available()
        let mut slot = 0_u32
        while slot < frame_count {
            let frame_buffer = device.create_buffer(12752_u64, buffer_uniform(), true)
            let instance_buffer = device.create_buffer(98304_u64, buffer_storage(), true)
            let group = device.create_scene_bind_group(
                layout, 0_u32, frame_buffer, 12752_u64, 1_u32, instance_buffer, 98304_u64,)
            if !frame_buffer.available() || !instance_buffer.available() || !group.available() {
                available = false
            }
            frame_buffers.push(frame_buffer)
            instance_buffers.push(instance_buffer)
            groups.push(group)
            slot = slot + 1_u32
        }
        ret SceneRenderer {
            device, layout, frame_count, frame_buffers, instance_buffers, groups,
            solid_pipeline, double_sided_pipeline, 0_usize, available,
            Vec3::new(0.28_f32, 0.28_f32, 0.28_f32),
            Vec[f32]::with_capacity(32_usize), Vec[f32]::new(), Vec[GpuBuffer]::new(), Vec[f32]::new(), false, TemporalView::new(), 0_u64, GpuTexture::unavailable(), Vec[MaterialTextureGroups]::new(), RayPipelineSet::new(), Vec[SceneMaterialProgram]::new(), Vec[SceneMaterialPipelines]::new(), false
        }
    }
    pub fn create_with_gi(device: GraphicsDevice, layout: BindGroupLayout, frame_count: u32, solid_pipeline: RenderPipeline, double_sided_pipeline: RenderPipeline, gi_scene: GpuBuffer, gi_surfaces: GpuBuffer, gi_history: GpuBuffer, texture: GpuTexture, normal: GpuTexture, sampler: GpuSampler) -> SceneRenderer {
        ret Self::create_with_gi_mode(device, layout, frame_count, solid_pipeline, double_sided_pipeline, gi_scene, gi_surfaces, gi_history, texture, normal, sampler, false)
    }
    pub fn create_with_material_programs(device: GraphicsDevice, layout: BindGroupLayout, frame_count: u32, solid_pipeline: RenderPipeline, double_sided_pipeline: RenderPipeline, gi_scene: GpuBuffer, gi_surfaces: GpuBuffer, gi_history: GpuBuffer, texture: GpuTexture, normal: GpuTexture, sampler: GpuSampler) -> SceneRenderer {
        ret Self::create_with_gi_mode(device, layout, frame_count, solid_pipeline, double_sided_pipeline, gi_scene, gi_surfaces, gi_history, texture, normal, sampler, true)
    }
    fn create_with_gi_mode(device: GraphicsDevice, layout: BindGroupLayout, frame_count: u32, solid_pipeline: RenderPipeline, double_sided_pipeline: RenderPipeline, gi_scene: GpuBuffer, gi_surfaces: GpuBuffer, gi_history: GpuBuffer, texture: GpuTexture, normal: GpuTexture, sampler: GpuSampler, material_bindings: bool) -> SceneRenderer {
        let mut frame_buffers = Vec[GpuBuffer]::new()
        let mut instance_buffers = Vec[GpuBuffer]::new()
        let mut groups = Vec[BindGroup]::new()
        let mut available = device.available() && layout.available() &&
        frame_count > 0_u32 && solid_pipeline.available() &&
        double_sided_pipeline.available() && gi_scene.available() &&
        gi_surfaces.available() && gi_history.available()
        let mut slot = 0_u32
        while slot < frame_count {
            let frame_buffer = device.create_buffer(12752_u64, buffer_uniform(), true)
            let instance_buffer = device.create_buffer(196608_u64, buffer_storage(), true)
            let mut bindings = Vec[u32]::new()
            bindings.push(0_u32) bindings.push(1_u32) bindings.push(2_u32)
            bindings.push(3_u32) bindings.push(4_u32)
            let mut buffers = Vec[GpuBuffer]::new()
            buffers.push(frame_buffer) buffers.push(instance_buffer)
            buffers.push(gi_scene) buffers.push(gi_surfaces) buffers.push(gi_history)
            let mut offsets = Vec[u64]::new()
            offsets.push(0_u64) offsets.push(0_u64) offsets.push(0_u64)
            offsets.push(0_u64) offsets.push(0_u64)
            let mut ranges = Vec[u64]::new()
            ranges.push(12752_u64) ranges.push(196608_u64)
            ranges.push(gi_scene.size()) ranges.push(gi_surfaces.size())
            ranges.push(gi_history.size())
            let mut texture_bindings = vec![5_u32, 6_u32, 7_u32, 8_u32]
            let mut textures = vec![texture, normal, texture, texture]
            let mut samplers = vec![sampler, sampler, sampler, sampler]
            if material_bindings {
                material_program_fallback(frame_buffer, texture, sampler, bindings, buffers, offsets, ranges, texture_bindings, textures, samplers)
            }
            let group = device.create_buffer_textures_bind_group_many(layout, bindings, buffers, offsets, ranges, texture_bindings, textures, samplers)
            if !frame_buffer.available() || !instance_buffer.available() ||
            !group.available() {
                available = false
            }
            frame_buffers.push(frame_buffer)
            instance_buffers.push(instance_buffer)
            groups.push(group)
            slot += 1_u32
        }
        ret SceneRenderer {
            device, layout, frame_count, frame_buffers, instance_buffers, groups,
            solid_pipeline, double_sided_pipeline, 0_usize, available,
            Vec3::new(0.28_f32, 0.28_f32, 0.28_f32),
            Vec[f32]::with_capacity(32_usize), Vec[f32]::new(), vec![gi_scene, gi_surfaces, gi_history], Vec[f32]::new(), false, TemporalView::new(), 0_u64, texture, Vec[MaterialTextureGroups]::new(), RayPipelineSet::new(), Vec[SceneMaterialProgram]::new(), Vec[SceneMaterialPipelines]::new(), material_bindings
        }
    }
    /// Prepares replacement descriptor sets without mutating in-flight ones.
    pub fn set_shelter_texture(self: mut Self, texture: GpuTexture) ->() {
        self.shelter_texture = texture
    }
    pub fn texture_groups(self: Self, texture: GpuTexture, normal: GpuTexture, sampler: GpuSampler) -> Vec[BindGroup] {
        ret self.pbr_groups(texture, normal, texture, sampler)
    }
    pub fn pbr_groups(self: Self, texture: GpuTexture, normal: GpuTexture, orm: GpuTexture, sampler: GpuSampler) -> Vec[BindGroup] {
        ret self.program_groups(texture, normal, orm, sampler, Option::None)
    }
    pub fn program_groups(self: Self, texture: GpuTexture, normal: GpuTexture, orm: GpuTexture, sampler: GpuSampler, program: Option[MaterialProgram<H>]) -> Vec[BindGroup] {
        let mut groups = Vec[BindGroup]::new()
        for slot in 0..self.groups.len() {
            let mut buffers = Vec[GpuBuffer]::new()
            buffers.push(self.frame_buffers.get(slot).unwrap_or(GpuBuffer::unavailable()))
            buffers.push(self.instance_buffers.get(slot).unwrap_or(GpuBuffer::unavailable()))
            for buffer in self.gi_buffers {
                buffers.push(buffer)
            }
            let mut bindings = Vec[u32]::new()
            let mut offsets = Vec[u64]::new()
            let mut ranges = Vec[u64]::new()
            for index in 0..buffers.len() {
                bindings.push(index as u32) offsets.push(0)
                ranges.push(buffers.get(index).unwrap_or(GpuBuffer::unavailable()).size())
            }
            let mut texture_bindings = vec![5_u32, 6_u32, 7_u32, 8_u32]
            let mut textures = vec![texture, normal, self.shelter_texture, orm]
            let mut samplers = vec![sampler, sampler, sampler, sampler]
            match program {
                Some(program) => program.append(bindings, buffers, offsets, ranges, texture_bindings, textures, samplers, sampler) None => {
                    if self.material_bindings {
                        material_program_fallback(self.frame_buffers.get_unchecked_borrowed(slot), texture, sampler, bindings, buffers, offsets, ranges, texture_bindings, textures, samplers)
                    }
                }
            }
            let group = self.device.create_buffer_textures_bind_group_many(self.layout, bindings, buffers, offsets, ranges, texture_bindings, textures, samplers)
            if !group.available() {
                group.destroy()
                for previous in groups {
                    previous.destroy()
                }
                ret Vec[BindGroup]::new()
            }
            groups.push(group)
        }
        ret groups
    }
    pub fn register_material_groups(self: mut Self, id: u64, groups: Vec[BindGroup]) -> bool {
        if groups.len() != self.groups.len() {
            ret false
        }
        self.material_groups.push(MaterialTextureGroups { id, groups }) ret true
    }
    pub fn replace_material_groups(self: mut Self, id: u64, groups: Vec[BindGroup]) -> Vec[BindGroup] {
        for i in 0_usize..self.material_groups.len() {
            let old = self.material_groups.get_unchecked_borrowed(i)
            if old.id == id {
                self.material_groups.set(i, MaterialTextureGroups { id, groups }) ret old.groups
            }
        }
        self.material_groups.push(MaterialTextureGroups { id, groups }) ret Vec[BindGroup]::new()
    }
    fn bind_material(self: Self, pass: RenderPassEncoder, slot: u32, id: u64) -> bool {
        for entry in self.material_groups {
            if entry.id == id {
                ret pass.bind_group(entry.groups.get(slot as usize).unwrap_or(BindGroup::unavailable()))
            }
        }
        ret pass.bind_group(self.groups.get(slot as usize).unwrap_or(BindGroup::unavailable()))
    }
    pub fn replace_texture_groups(self: mut Self, groups: Vec[BindGroup]) -> Vec[BindGroup] {
        let previous = self.groups self.groups = groups ret previous
    }
    pub fn available(self: Self) -> bool {
        ret self.available
    }
    pub fn object_count(self: Self) -> usize {
        ret self.rendered_objects
    }
    pub fn set_sky_entity(self: mut Self, entity: u64) ->() {
        self.sky_entity = entity
    }
    pub fn set_lights(self: mut Self, values: Vec[f32]) ->() {
        self.light_values = values
    }
    pub fn set_indirect_ambient(self: mut Self, value: Vec3) ->() {
        self.indirect_ambient = value
        ret()
    }
    /// Borrowed frame/GI storage used by the procedural displacement pipelines.
    pub fn frame_bindings(self: Self, slot: usize) -> Vec[GpuBuffer] {
        let mut buffers = vec![self.frame_buffers.get(slot).unwrap_or(GpuBuffer::unavailable()), self.instance_buffers.get(slot).unwrap_or(GpuBuffer::unavailable())]
        for buffer in self.gi_buffers {
            buffers.push(buffer)
        }
        ret buffers
    }
    pub fn render_scene(self: mut Self, scene: Scene, camera: PerspectiveCamera, light: DirectionalLight,
        meshes: MeshAssets, materials: MaterialAssets, pass: RenderPassEncoder,
        frame_slot: u32, aspect: f32,) -> bool {
        ret self.render_items(scene.visible_render_items(), camera, light,
            meshes, materials, pass, frame_slot, aspect,)
    }
    pub fn render_items(self: mut Self, items: Vec[RenderItem],
        camera: PerspectiveCamera, light: DirectionalLight,
        meshes: MeshAssets, materials: MaterialAssets, pass: RenderPassEncoder,
        frame_slot: u32, aspect: f32,) -> bool {
        if !self.available || !pass.available() || frame_slot >= self.frame_count {
            println("Graphene scene render: unavailable renderer, pass, or frame slot")
            ret false
        }
        if items.len() > 1024_usize {
            ret false
        }
        self.rendered_objects = items.len()
        // CPU staging storage is reusable once write_f32s has copied it into
        // the selected frame slot's mapped GPU buffer.
        self.frame_values.clear()
        for value in camera.view_projection(aspect).values() {
            self.frame_values.push(value)
        }
        for value in light.uniform_values() {
            self.frame_values.push(value)
        }
        self.frame_values.push(self.indirect_ambient.x())
        self.frame_values.push(self.indirect_ambient.y())
        self.frame_values.push(self.indirect_ambient.z())
        self.frame_values.push(1.0_f32)
        self.frame_values.push(camera.position().x())
        self.frame_values.push(camera.position().y())
        self.frame_values.push(camera.position().z())
        self.frame_values.push(1.0_f32)
        if self.light_values.len() == 3140_usize {
            for value in self.light_values {
                self.frame_values.push(value)
            }
        } else {
            while self.frame_values.len() < 3172_usize {
                self.frame_values.push(0.0_f32)
            }
        }
        if self.temporal {
            for value in self.temporal_view.view_projection().values() {
                self.frame_values.push(value)
            }
        }
        self.instance_values.clear()
        self.instance_values.reserve(items.len() * 28_usize)
        for item in items {
            match materials.get(item.material()) {
                Option::Some(material) => {
                    for value in item.world().values() {
                        self.instance_values.push(value)
                    }
                    let material_start = self.instance_values.len()
                    for value in material.uniform_values() {
                        self.instance_values.push(value)
                    }
                    if item.entity() == self.sky_entity {
                        self.instance_values.set(material_start + 6_usize, 2.0_f32)
                    }
                    if self.gi_buffers.len() > 0 {
                        for value in material.texture_uniform_values() {
                            self.instance_values.push(value)
                        }
                    }
                    if self.temporal {
                        let previous = self.temporal_view.previous(item)
                        for value in previous.0.values() {
                            self.instance_values.push(value)
                        }
                        self.instance_values.push(if previous.1 {
                                1.0_f32
                            } else {
                                0.0_f32
                            }
                        )
                        self.instance_values.push(0.0_f32) self.instance_values.push(0.0_f32) self.instance_values.push(0.0_f32)
                    }
                }
                Option::None => {
                    ret false
                }
            }
        }
        let mut uploaded = false
        match self.frame_buffers.get(frame_slot as usize) {
            Option::Some(frame_buffer) => {
                match self.instance_buffers.get(frame_slot as usize) {
                    Option::Some(instance_buffer) => {
                        let frame_uploaded = frame_buffer.write_f32s(0_u64, self.frame_values)
                        let instances_uploaded = self.instance_values.len() == 0 || instance_buffer.write_f32s(0_u64, self.instance_values)
                        if !frame_uploaded {
                            println("Graphene scene render: frame uniform write failed")
                        }
                        if !instances_uploaded {
                            println("Graphene scene render: instance storage write failed values=" +
                                Debug::fmt(self.instance_values.len()) + " bytes=" +
                                Debug::fmt(instance_buffer.size()))
                        }
                        uploaded = frame_uploaded && instances_uploaded
                    }
                    Option::None => {
                    }
                }
            }
            Option::None => {
            }
        }
        if !uploaded {
            println("Graphene scene render: frame or instance upload failed")
            ret false
        }
        match self.groups.get(frame_slot as usize) {
            Option::Some(group) => {
                if !pass.bind_group(group) {
                    println("Graphene scene render: scene bind group failed")
                    ret false
                }
            }
            Option::None => {
                ret false
            }
        }
        let mut batch_material = 0_u64
        let mut batch_mesh = MeshId::new(0_u64)
        let mut batch_double_sided = false
        let mut batch_first = 0_u32
        let mut batch_count = 0_u32
        let mut item_index = 0_u32
        for item in items {
            let material = match materials.get(item.material()) {
                Option::Some(value) => value
                Option::None => {
                    ret false
                }
            }
            let changes = batch_count >= 64_u32 ||
            (batch_count > 0_u32 &&(item.mesh().value() != batch_mesh.value() || item.material().value() != batch_material ||
                    material.double_sided() != batch_double_sided)
            )
            if changes {
                if !pass.bind_pipeline(self.material_pipeline(batch_material, batch_double_sided)
                ) || !self.bind_material_lighting(pass, batch_material) ||
                !self.bind_material(pass, frame_slot, batch_material) ||
                !meshes.draw_instanced(pass, batch_mesh, batch_count, batch_first) {
                    println("Graphene scene render: instanced batch draw failed")
                    ret false
                }
                batch_first = item_index
                batch_count = 0_u32
            }
            if batch_count == 0_u32 {
                batch_material = item.material().value()
                batch_mesh = item.mesh()
                batch_double_sided = material.double_sided()
            }
            batch_count = batch_count + 1_u32
            item_index = item_index + 1_u32
        }
        if batch_count > 0_u32 &&
        (!pass.bind_pipeline(self.material_pipeline(batch_material, batch_double_sided)
            ) || !self.bind_material_lighting(pass, batch_material) ||
            !self.bind_material(pass, frame_slot, batch_material) ||
            !meshes.draw_instanced(pass, batch_mesh, batch_count, batch_first)) {
            println("Graphene scene render: final instanced batch draw failed")
            ret false
        }
        ret true
    }
    pub fn destroy(self: mut Self) -> bool {
        let mut destroyed = self.ray.destroy()
        for entry in self.material_pipelines {
            destroyed = entry.pipelines.destroy() && destroyed
        }
        for entry in self.material_groups {
            for group in entry.groups {
                if !group.destroy() {
                    destroyed = false
                }
            }
        }
        for group in self.groups {
            if !group.destroy() {
                destroyed = false
            }
        }
        for buffer in self.frame_buffers {
            if !buffer.destroy() {
                destroyed = false
            }
        }
        for buffer in self.instance_buffers {
            if !buffer.destroy() {
                destroyed = false
            }
        }
        ret destroyed
    }
}

impl for SceneRenderer {
    pub fn prepare_ray_lighting(self: mut Self, target: Swapchain, frame: RenderFrame, vertex: ShaderModule, vertex_layout: VertexBufferLayout, variant: u32, lighting: RayLightingView) -> bool {
        self.collect_material_pipelines()
        if !self.ray.prepare(self.device, target, frame, vertex, self.layout, vertex_layout, self.solid_pipeline, 0, variant, true, lighting) {
            ret false
        }
        for entry in self.material_programs {
            let key = entry.program.key()
            let mut pipeline = Option[MaterialPipelines<H>]::None
            for known in self.material_pipelines {
                if known.key == key {
                    pipeline = Option[MaterialPipelines<H>]::Some(known.pipelines)
                }
            }
            let mut pipelines = match pipeline {
                Some(value) => value None => {
                    let mut value = MaterialPipelines::new() self.material_pipelines.push(SceneMaterialPipelines {
                            key, value
                        }
                    ) value
                }
            }
            entry.program.use_frame(frame)
            if !pipelines.prepare(self.device, target, frame, vertex, self.layout, vertex_layout, entry.program, if variant == 2 {
                    1_usize
                } elif variant == 1 {
                    0_usize
                } else {
                    6_usize
                }
                , true, lighting,) {
                ret false
            }
        }
        ret true
    }
    fn collect_material_pipelines(self: mut Self) ->() {
        let mut retained = Vec[SceneMaterialPipelines]::new()
        for pipeline in self.material_pipelines {
            let mut used = false
            for program in self.material_programs {
                if program.program.key() == pipeline.key {
                    used = true break
                }
            }
            if used {
                pipeline.pipelines.collect() retained.push(pipeline)
            } elif !pipeline.pipelines.destroy() {
                retained.push(pipeline)
            }
        }
        self.material_pipelines = retained
    }
    pub fn set_material_program(self: mut Self, id: u64, program: Option[MaterialProgram<H>]) ->() {
        let mut next = Vec[SceneMaterialProgram]::new()
        for entry in self.material_programs {
            if entry.id != id {
                next.push(entry)
            }
        }
        match program {
            Some(program) => next.push(SceneMaterialProgram { id, program }) None => {
            }
        }
        self.material_programs = next
    }
    fn material_pipeline(self: Self, id: u64, double_sided: bool) -> RenderPipeline {
        for entry in self.material_programs {
            if entry.id == id {
                for known in self.material_pipelines {
                    if known.key == entry.program.key() {
                        ret known.pipelines.pipeline(double_sided)
                    }
                }
            }
        }
        ret self.ray.pipeline(if double_sided {
                self.double_sided_pipeline
            } else {
                self.solid_pipeline
            }
            , double_sided,)
    }
    fn bind_material_lighting(self: Self, pass: RenderPassEncoder, id: u64) -> bool {
        for entry in self.material_programs {
            if entry.id == id {
                for known in self.material_pipelines {
                    if known.key == entry.program.key() {
                        ret known.pipelines.bind(pass)
                    }
                }
            }
        }
        ret self.ray.bind(pass)
    }
    pub fn set_view_pipelines(self: mut Self, solid: RenderPipeline, double_sided: RenderPipeline, temporal: bool, view: TemporalView<H>) ->() {
        self.solid_pipeline = solid self.double_sided_pipeline = double_sided self.temporal = temporal self.temporal_view.copy_from(view)
    }
}
