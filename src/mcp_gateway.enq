//! Embedded MCP command dispatcher; editor-specific operations are handled by the host.
import core::option::Option
import core::vec::Vec
import json::{Json, field, stringify}
import mod::automation::AutomationServer
import mod::mcp::protocol::{mcp_immediate, mcp_arguments, mcp_operation, mcp_tool_result, mcp_failure, mcp_json, mcp_unsigned}

pub struct GrapheneMcpGateway {
    api: AutomationServer
    token: str
}

impl for GrapheneMcpGateway {
    pub fn new(api: AutomationServer, token: str) -> Self {
        ret Self { api, token }
    }
    pub fn api(self: Self) -> Option[AutomationServer] {
        ret Option[AutomationServer]::Some(self.api)
    }
    pub fn into_api(self: Self) -> AutomationServer {
        ret self.api
    }
    pub fn handle(self: mut Self, source: str) -> str {
        match mcp_immediate(source) {
            Some(response) => {
                ret response
            }
            None => {
            }
        }
        let method = mcp_operation(source)
        if method.contains("editor.") || method == "" {
            ret mcp_failure(source, "This operation requires the running editor host")
        }
        let arguments = mcp_arguments(source)
        if method == "graphene.actor" && mcp_unsigned(arguments.get("actor").unwrap_or(Json::Null)).unwrap_or(0) == 0 {
            ret mcp_failure(source, "Actor ID must be positive")
        }
        let mut params = Vec[(str, Json)]::new()
        match arguments {
            Json::Object(fields) => {
                for entry in fields {
                    params.push(entry)
                }
            }
            _ => {
            }
        }
        if method == "graphene.actors" || method == "graphene.actor" || method == "graphene.status" {
            params.push(field("_paged", Json::Bool(true)))
            params.push(field("_status", Json::Bool(method == "graphene.status")))
        }
        let request = stringify(Json::Object(vec![field("id", Json::String("mcp")), field("token", Json::String(self.token)), field("method", Json::String(method)), field("params", Json::Object(params))]))
        let updated = self.api.updated(request) self.api = updated.0
        let value = mcp_json(updated.1)
        if method == "graphene.actor" && value.get("state").unwrap_or(Json::Null).get("total").unwrap_or(Json::Number("0")).as_number().unwrap_or("0") == "0" {
            ret mcp_failure(source, "Actor was not found")
        }
        ret mcp_tool_result(source, value)
    }
}
