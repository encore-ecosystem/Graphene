            native_bind_group_layout_create(self.handle, binding, stage)
        }
    }
    pub fn create_bind_group_layout(self: Self, entries: Vec[BindGroupLayoutEntry]) -> BindGroupLayout
    {
        let mut bindings = Vec[u32]::new()
        let mut kinds = Vec[u32]::new()
        let mut stages = Vec[u32]::new()
        for entry in entries {
            bindings.push(entry.binding)
            kinds.push(entry.kind)
            stages.push(entry.stage)
        }
        ret BindGroupLayout {
            native_bind_group_layout_create_entries(self.handle, bindings, kinds, stages)
        }
    }
