impl for BindGroupLayout {
    pub fn available(self: Self) -> bool {
        ret self.handle != 0_usize && native_bind_group_layout_available(self.handle)
    }
    pub fn error(self: Self) -> str {
        ret if self.handle == 0_usize {
            "No bind group layout"
        } else {
            native_bind_group_layout_error(self.handle)
        }
    }
    pub fn destroy(self: Self) -> bool {
        ret self.handle != 0_usize && native_bind_group_layout_destroy(self.handle)
    }
}

impl for BindGroup {
    pub fn unavailable() -> Self {
        ret Self {
            0_usize
        }
    }
    pub fn available(self: Self) -> bool {
        ret self.handle != 0_usize && native_bind_group_available(self.handle)
    }
    pub fn error(self: Self) -> str {
        ret if self.handle == 0_usize {
            "Unable to allocate bind group"
        } else {
            native_bind_group_error(self.handle)
        }
    }
    pub fn destroy(self: Self) -> bool {
        ret self.handle != 0_usize && native_bind_group_destroy(self.handle)
    }
    pub fn update_buffer(self: Self, binding: u32, buffer: GpuBuffer) -> bool {
        ret self.handle != 0_usize && buffer.handle != 0_usize &&
        native_bind_group_update_buffer(
            self.handle, binding, buffer.handle, 0_u64, buffer.size(),)
    }
}

