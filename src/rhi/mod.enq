impl for GrapheneWindow {
    pub fn available(self: Self) -> bool {
        ret self.handle != 0_usize && native_window_available(self.handle)
    }
    pub fn error(self: Self) -> str {
        ret if self.handle == 0_usize {
            "Unable to allocate Graphene window"
        } else {
            native_window_error(self.handle)
        }
    }
    pub fn open(self: Self) -> bool {
        ret self.handle != 0_usize && native_window_open(self.handle)
    }
    pub fn poll(self: Self) -> bool {
        ret self.handle != 0_usize && native_window_poll(self.handle)
    }
    pub fn width(self: Self) -> u32 {
        ret if self.handle == 0_usize {
            self.width
        } else {
            native_window_width(self.handle)
        }
    }
    pub fn height(self: Self) -> u32 {
        ret if self.handle == 0_usize {
            self.height
        } else {
            native_window_height(self.handle)
        }
    }
    pub fn key_down(self: Self, scancode: u32) -> bool {
        ret self.handle != 0_usize && native_window_key_down(self.handle, scancode)
    }
    pub fn mouse_x(self: Self) -> f32 {
        ret if self.handle == 0_usize {
            0.0_f32
        } else {
            native_window_mouse_x(self.handle)
        }
    }
    pub fn mouse_y(self: Self) -> f32 {
        ret if self.handle == 0_usize {
            0.0_f32
        } else {
            native_window_mouse_y(self.handle)
        }
    }
    pub fn mouse_dx(self: Self) -> f32 {
        ret if self.handle == 0_usize {
            0.0_f32
        } else {
            native_window_mouse_dx(self.handle)
        }
    }
    pub fn mouse_dy(self: Self) -> f32 {
        ret if self.handle == 0_usize {
            0.0_f32
        } else {
            native_window_mouse_dy(self.handle)
        }
    }
    pub fn mouse_down(self: Self, button: u32) -> bool {
        ret self.handle != 0_usize && native_window_mouse_down(self.handle, button)
    }
    pub fn destroy(self: Self) -> bool {
        ret self.handle != 0_usize && native_window_destroy(self.handle)
    }
}

