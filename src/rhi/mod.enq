        ret BindGroupLayoutEntry {
            binding, binding_storage_buffer(), stage
        }
    }
    pub fn acceleration_structure(binding: u32, stage: u32) -> BindGroupLayoutEntry {
        ret BindGroupLayoutEntry {
            binding, binding_acceleration_structure(), stage
        }
    }
}

