    pub fn create_material_bind_group(self: Self, layout: BindGroupLayout,
        uniform_binding: u32, buffer: GpuBuffer, offset: u64, range: u64,
        texture_binding: u32, texture: GpuTexture, sampler: GpuSampler,) -> BindGroup {
        ret BindGroup {
            native_material_bind_group_create(self.handle, layout.handle, uniform_binding,
                buffer.handle, offset, range, texture_binding, texture.handle, sampler.handle,)
        }
    }
    pub fn create_render_pipeline(self: Self, swapchain: Swapchain,
        vertex: ShaderModule, fragment: ShaderModule,) -> RenderPipeline {
        ret self.create_render_pipeline_with_layout(swapchain, vertex, fragment, VertexBufferLayout::empty())
    }
    pub fn create_render_pipeline_with_layout(self: Self, swapchain: Swapchain,
        vertex: ShaderModule, fragment: ShaderModule, layout: VertexBufferLayout,) -> RenderPipeline
    {
        ret self.create_render_pipeline_with_bind_group(swapchain, vertex, fragment, layout, BindGroupLayout
            {
                0_usize
            }
            ,
        )
    }
    pub fn create_render_pipeline_with_bind_group(self: Self, swapchain: Swapchain,
        vertex: ShaderModule, fragment: ShaderModule, layout: VertexBufferLayout,
        bind_group_layout: BindGroupLayout,) -> RenderPipeline {
        ret self.create_render_pipeline_configured(swapchain, vertex, fragment, layout, bind_group_layout,
            RenderPipelineOptions::opaque(),)
    }
    pub fn create_mesh_pipeline_with_bind_group(self: Self, swapchain: Swapchain,
        mesh: ShaderModule, fragment: ShaderModule,
        bind_group_layout: BindGroupLayout,) -> RenderPipeline {
        ret self.create_render_pipeline_configured(swapchain, mesh, fragment,
            VertexBufferLayout::empty(), bind_group_layout, RenderPipelineOptions::depth(),)
    }
    pub fn create_mesh_pipeline_with_options(self: Self, swapchain: Swapchain,
        mesh: ShaderModule, fragment: ShaderModule,
        bind_group_layout: BindGroupLayout,
        options: RenderPipelineOptions,) -> RenderPipeline {
        ret self.create_render_pipeline_configured(swapchain, mesh, fragment,
            VertexBufferLayout::empty(), bind_group_layout, options,)
    }
    pub fn create_depth_render_pipeline(self: Self, swapchain: Swapchain,
        vertex: ShaderModule, fragment: ShaderModule, layout: VertexBufferLayout,) -> RenderPipeline
    {
        ret self.create_render_pipeline_configured(swapchain, vertex, fragment, layout, BindGroupLayout
            {
                0_usize
            }
            ,
            RenderPipelineOptions::depth(),)
    }
    pub fn create_depth_render_pipeline_with_bind_group(self: Self, swapchain: Swapchain,
        vertex: ShaderModule, fragment: ShaderModule, layout: VertexBufferLayout,
        bind_group_layout: BindGroupLayout,) -> RenderPipeline {
        ret self.create_render_pipeline_configured(swapchain, vertex, fragment, layout, bind_group_layout,
            RenderPipelineOptions::depth(),)
    }
    pub fn create_render_pipeline_with_options(self: Self, swapchain: Swapchain,
        vertex: ShaderModule, fragment: ShaderModule, layout: VertexBufferLayout,
        bind_group_layout: BindGroupLayout, options: RenderPipelineOptions,) -> RenderPipeline {
        ret self.create_render_pipeline_configured(swapchain, vertex, fragment, layout, bind_group_layout,
            options,)
    }
    fn create_render_pipeline_configured(self: Self, swapchain: Swapchain,
        vertex: ShaderModule, fragment: ShaderModule, layout: VertexBufferLayout,
        bind_group_layout: BindGroupLayout, options: RenderPipelineOptions,) -> RenderPipeline {
        let mut locations = Vec[u32]::new()
        let mut formats = Vec[u32]::new()
        let mut offsets = Vec[u32]::new()
        for attribute in layout.attributes {
            locations.push(attribute.location)
            formats.push(attribute.format)
            offsets.push(attribute.offset)
        }
        ret RenderPipeline {
            native_pipeline_create_configured(
                self.handle, swapchain.handle, vertex.handle, fragment.handle,
                bind_group_layout.handle, options.depth_attachment,
                options.depth_test, options.depth_write,
                options.cull_mode, options.alpha_blend,
                options.additive_blend, options.load_color,
                layout.stride, locations, formats, offsets,)
        }
    }
    pub fn create_buffer(self: Self, size: u64, usage: u32, host_visible: bool) -> GpuBuffer {
        ret GpuBuffer {
            native_buffer_create(self.handle, size, usage, host_visible), size, host_visible
        }
    }
    pub fn create_triangle_blas(self: Self,
        vertices: GpuBuffer, vertex_stride: u64, vertex_count: u32,
        indices: GpuBuffer, index_count: u32,) -> AccelerationStructure {
        ret AccelerationStructure {
            native_blas_create_triangles(self.handle,
                vertices.handle, vertex_stride, vertex_count,
                indices.handle, index_count,)
        }
    }
    pub fn create_tlas(self: Self, structures: Vec[AccelerationStructure],
        transforms: Vec[Mat4],) -> AccelerationStructure {
        if structures.len() != transforms.len() {
            ret AccelerationStructure {
                0_usize
            }
        }
        let mut handles = Vec[usize]::new()
        for structure in structures {
            handles.push(structure.handle)
        }
        let mut values = Vec[f32]::new()
        for transform in transforms {
            for value in transform.values() {
                values.push(value)
            }
        }
        ret AccelerationStructure {
            native_tlas_create_instances(self.handle, handles, values)
        }
    }
    pub fn create_mesh(self: Self, vertices: Vec[f32], indices: Vec[u32]) -> GpuMesh {
        let vertex_size =(vertices.len() as u64) * 4_u64
        let index_size =(indices.len() as u64) * 4_u64
        if vertex_size == 0_u64 || index_size == 0_u64 {
            ret GpuMesh {
                GpuBuffer {
                    0_usize, 0_u64, false
                }
                , GpuBuffer {
                    0_usize, 0_u64, false
                }
                , 0_u32, false
            }
        }
        let vertex_staging = self.create_buffer(vertex_size, buffer_transfer_source(), true)
        let index_staging = self.create_buffer(index_size, buffer_transfer_source(), true)
        let vertex = self.create_buffer(vertex_size, buffer_vertex() | buffer_transfer_destination(),
            false,)
        let index = self.create_buffer(index_size, buffer_index() | buffer_transfer_destination(), false)
        let encoder = self.create_encoder()
        let uploaded = vertex_staging.write_f32s(0_u64, vertices) && index_staging.write_u32s(0_u64,
            indices,) &&
        vertex.available() && index.available() && encoder.available() &&
        encoder.copy_buffer(vertex_staging, vertex, 0_u64, 0_u64, vertex_size) &&
        encoder.copy_buffer(index_staging, index, 0_u64, 0_u64, index_size) &&
        encoder.transfer_geometry_barrier() && encoder.submit_and_wait()
        encoder.destroy()
        vertex_staging.destroy()
        index_staging.destroy()
        ret GpuMesh {
            vertex, index,(index_size / 4_u64) as u32, uploaded
        }
    }
    pub fn create_texture_2d(self: Self, width: u32, height: u32, mip_levels: u32,
        format: u32, usage: u32,) -> GpuTexture {
        ret GpuTexture {
            native_texture_create(self.handle, width, height, mip_levels, format, usage),
            width, height, mip_levels, format
        }
    }
    pub fn create_swapchain(self: Self, window: GrapheneWindow) -> Swapchain {
        ret Swapchain {
            native_swapchain_create(self.handle, window.handle)
        }
    }
    pub fn create_offscreen_target(self: Self, width: u32, height: u32) -> Swapchain {
        ret Swapchain {
            native_offscreen_create(self.handle, width, height)
        }
    }
    pub fn create_shared_offscreen_target(self: Self, width: u32, height: u32) -> Swapchain {
        ret Swapchain {
            native_shared_offscreen_create(self.handle, width, height)
        }
    }
    pub fn destroy(self: Self) -> bool {
        ret self.handle != 0_usize && native_device_destroy(self.handle)
    }
}

impl for GraphicsInstance {
    pub fn create() -> GraphicsInstance {
        ret GraphicsInstance::with_debug(false)
    }
    pub fn with_debug(debug: bool) -> GraphicsInstance {
        ret GraphicsInstance {
            native_create(debug, false, false), debug, false
        }
    }
    pub fn with_window_support(debug: bool) -> GraphicsInstance {
        ret GraphicsInstance {
            native_create(debug, true, false), debug, true
        }
    }
    pub fn with_external_window_support(debug: bool) -> GraphicsInstance {
        ret GraphicsInstance {
            native_create(debug, true, true), debug, true
        }
    }
    pub fn borrow(instance: usize, physical_device: usize) -> GraphicsInstance {
        ret GraphicsInstance {
            native_borrow(instance, physical_device), false, false
        }
    }
    pub fn available(self: Self) -> bool {
        ret self.handle != 0_usize && native_available(self.handle)
    }
    pub fn debug(self: Self) -> bool {
        ret self.debug
    }
    pub fn supports_windows(self: Self) -> bool {
        ret self.window_support
    }
    pub fn error(self: Self) -> str {
        ret if self.handle == 0_usize {
            "Unable to allocate Vulkan context"
        } else {
            native_error(self.handle)
        }
    }
    pub fn api_version(self: Self) -> ApiVersion {
        ret ApiVersion::from_raw(if self.handle == 0_usize {
                0_u32
            } else {
                native_api_version(self.handle)
            }
        )
    }
    pub fn adapters(self: Self) -> Vec[AdapterInfo] {
        let mut result = Vec[AdapterInfo]::new()
        if !self.available() {
            ret result
        }
        let count = native_adapter_count(self.handle)
        let mut index = 0_usize
        while index < count {
            result.push(AdapterInfo {
                    index,
                    native_adapter_name(self.handle, index),
                    native_adapter_vendor(self.handle, index),
                    native_adapter_device(self.handle, index),
                    native_adapter_kind(self.handle, index),
                    ApiVersion::from_raw(native_adapter_api_version(self.handle, index)),
                    RenderCapabilities {
                        native_adapter_tier(self.handle, index),
                        native_adapter_ray_query(self.handle, index),
                        native_adapter_ray_pipeline(self.handle, index),
                        native_adapter_mesh_shader(self.handle, index)
                    }
                }
                ,)
            index = index + 1_usize
        }
        ret result
    }
    pub fn preferred_adapter(self: Self) -> Option[AdapterInfo] {
        let adapters = self.adapters()
        let mut fallback = Option[AdapterInfo]::None
        let mut index = 0_usize
        while index < adapters.len() {
            match adapters.get(index) {
                Option[AdapterInfo]::Some(adapter) => {
                    if adapter.discrete() {
                        ret Option[AdapterInfo]::Some(adapter)
                    }
                    if fallback.is_none() {
                        fallback = Option[AdapterInfo]::Some(adapter)
                    }
                }
                Option[AdapterInfo]::None => {
                }
            }
            index = index + 1_usize
        }
        ret fallback
    }
    pub fn create_device(self: Self, adapter: AdapterInfo) -> GraphicsDevice {
        ret GraphicsDevice {
            native_device_create(self.handle, adapter.index()), adapter
        }
    }
    pub fn create_device_with_features(self: Self, adapter: AdapterInfo,
        required: DeviceFeatures, optional: DeviceFeatures,) -> GraphicsDevice {
        ret GraphicsDevice {
            native_device_create_features(self.handle, adapter.index(),
                required.mask(), optional.mask(),), adapter
        }
    }
    pub fn borrow_device(self: Self, device: usize, queue_family: u32) -> GraphicsDevice {
        let adapters = self.adapters()
        match adapters.get(0_usize) {
            Option::Some(adapter) => {
                ret GraphicsDevice {
                    native_device_borrow(self.handle, device, queue_family), adapter
                }
            }
            Option::None => {
                ret GraphicsDevice {
                    0_usize,
                    AdapterInfo {
                        0_usize, "Unavailable borrowed Vulkan device", 0_u32, 0_u32,
                        adapter_other(), ApiVersion::from_raw(0_u32),
                        RenderCapabilities {
                            0_u32, false, false, false
                        }
                    }
                }
            }
        }
    }
    pub fn create_present_device(self: Self, adapter: AdapterInfo, window: GrapheneWindow) -> GraphicsDevice
    {
        ret GraphicsDevice {
            native_present_device_create(self.handle, adapter.index(), window.handle), adapter
        }
    }
    pub fn create_window(self: Self, title: str, width: u32, height: u32) -> GrapheneWindow {
        ret GrapheneWindow {
            native_window_create(self.handle, title, width, height), width, height
        }
    }
    pub fn attach_window(self: Self, platform_handle: usize, width: u32, height: u32) -> GrapheneWindow
    {
        ret GrapheneWindow {
            native_window_attach(self.handle, platform_handle, width, height), width, height
        }
    }
    pub fn destroy(self: Self) -> bool {
        ret self.handle != 0_usize && native_destroy(self.handle)
    }
}
