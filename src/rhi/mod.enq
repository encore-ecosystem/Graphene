        bindings: Vec[u32], buffers: Vec[GpuBuffer],
        offsets: Vec[u64], ranges: Vec[u64],) -> BindGroup {
        let mut handles = Vec[usize]::new()
        for buffer in buffers {
            handles.push(buffer.handle)
        }
        ret BindGroup {
