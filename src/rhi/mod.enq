pub struct RenderPipelineOptions {
    depth_attachment: bool depth_test: bool depth_write: bool
    cull_mode: u32 alpha_blend: bool additive_blend: bool
    load_color: bool
}

impl for RenderPipelineOptions {
    pub fn opaque() -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            false, false, false, 0_u32, false, false, false
        }
    }
    pub fn depth() -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            true, true, true, 0_u32, false, false, false
        }
    }
    pub fn with_depth(self: Self, enabled: bool) -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            enabled, enabled, enabled, self.cull_mode, self.alpha_blend,
            self.additive_blend, self.load_color
        }
    }
    pub fn with_depth_attachment(self: Self, enabled: bool) -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            enabled, self.depth_test, self.depth_write,
            self.cull_mode, self.alpha_blend,
            self.additive_blend, self.load_color
        }
    }
    pub fn with_depth_test(self: Self, enabled: bool) -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            self.depth_attachment, enabled, self.depth_write,
            self.cull_mode, self.alpha_blend,
            self.additive_blend, self.load_color
        }
    }
    pub fn with_depth_write(self: Self, enabled: bool) -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            self.depth_attachment, self.depth_test, enabled,
            self.cull_mode, self.alpha_blend,
            self.additive_blend, self.load_color
        }
    }
    pub fn with_backface_culling(self: Self) -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            self.depth_attachment, self.depth_test, self.depth_write,
            2_u32, self.alpha_blend, self.additive_blend, self.load_color
        }
    }
    pub fn with_frontface_culling(self: Self) -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            self.depth_attachment, self.depth_test, self.depth_write,
            1_u32, self.alpha_blend, self.additive_blend, self.load_color
        }
    }
    pub fn with_alpha_blending(self: Self) -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            self.depth_attachment, self.depth_test, self.depth_write,
            self.cull_mode, true, false, self.load_color
        }
    }
    pub fn with_additive_blending(self: Self) -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            self.depth_attachment, self.depth_test, self.depth_write,
            self.cull_mode, false, true, self.load_color
        }
    }
    pub fn with_color_load(self: Self, enabled: bool) -> RenderPipelineOptions {
        ret RenderPipelineOptions {
            self.depth_attachment, self.depth_test, self.depth_write,
            self.cull_mode, self.alpha_blend, self.additive_blend, enabled
        }
    }
    pub fn depth_attachment(self: Self) -> bool {
        ret self.depth_attachment
    }
    pub fn depth_test(self: Self) -> bool {
        ret self.depth_test
    }
    pub fn depth_write(self: Self) -> bool {
        ret self.depth_write
    }
    pub fn cull_mode(self: Self) -> u32 {
        ret self.cull_mode
    }
    pub fn alpha_blend(self: Self) -> bool {
        ret self.alpha_blend
    }
    pub fn additive_blend(self: Self) -> bool {
        ret self.additive_blend
    }
    pub fn load_color(self: Self) -> bool {
        ret self.load_color
    }
}

