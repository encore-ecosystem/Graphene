pub struct ApiVersion {
    value: u32
}

impl for ApiVersion {
    pub fn from_raw(value: u32) -> ApiVersion {
        ret ApiVersion {
            value
        }
    }
    pub fn raw(self: Self) -> u32 {
        ret self.value
    }
    pub fn major(self: Self) -> u32 {
        ret self.value >> 22_u32
    }
    pub fn minor(self: Self) -> u32 {
        ret(self.value >> 12_u32) & 1023_u32
    }
    pub fn patch(self: Self) -> u32 {
        ret self.value & 4095_u32
    }
    pub fn at_least(self: Self, major: u32, minor: u32) -> bool {
        ret self.major() > major ||(self.major() == major && self.minor() >= minor)
    }
}

pub struct RenderCapabilities {
    tier: u32
    ray_query: bool
    ray_pipeline: bool
    mesh_shader: bool
}

/// Vulkan features actually requested or enabled on the logical device.
/// Adapter capabilities alone are insufficient for selecting a render path.
pub struct DeviceFeatures {
    mask: u32
}

impl for DeviceFeatures {
    pub fn from_mask(mask: u32) -> Self {
        ret Self {
            mask
        }
    }
    pub fn none() -> Self {
        ret Self::from_mask(0_u32)
    }
    pub fn mask(self: Self) -> u32 {
        ret self.mask
    }
    pub fn contains(self: Self, feature: DeviceFeatures) -> bool {
        ret(self.mask & feature.mask) == feature.mask
    }
    pub fn descriptor_indexing() -> Self {
        ret Self::from_mask(1_u32)
    }
    pub fn buffer_device_address() -> Self {
        ret Self::from_mask(2_u32)
    }
    pub fn timeline_semaphore() -> Self {
        ret Self::from_mask(4_u32)
    }
    pub fn synchronization_2() -> Self {
        ret Self::from_mask(8_u32)
    }
    pub fn dynamic_rendering() -> Self {
        ret Self::from_mask(16_u32)
    }
    pub fn mesh_shader() -> Self {
        ret Self::from_mask(32_u32)
    }
    pub fn ray_query() -> Self {
        ret Self::from_mask(64_u32)
    }
    pub fn draw_indirect_count() -> Self {
        ret Self::from_mask(128_u32)
    }
    pub fn shader_int64_atomics() -> Self {
        ret Self::from_mask(256_u32)
    }
    /// Fragment barycentric coordinates used by diagnostic triangle-edge
    /// overlays. This is optional and may be absent on older adapters.
    pub fn fragment_shader_barycentric() -> Self {
        ret Self::from_mask(512_u32)
    }
}

impl for RenderCapabilities {
    pub fn tier(self: Self) -> u32 {
        ret self.tier
    }
    pub fn ray_query(self: Self) -> bool {
        ret self.ray_query
    }
    pub fn ray_pipeline(self: Self) -> bool {
        ret self.ray_pipeline
    }
    pub fn mesh_shader(self: Self) -> bool {
        ret self.mesh_shader
    }
    pub fn hardware_ray_tracing(self: Self) -> bool {
        ret self.ray_query || self.ray_pipeline
    }
}

pub struct AdapterInfo {
    index: usize
    name: str
    vendor_id: u32
    device_id: u32
    kind: u32
    api_version: ApiVersion
    capabilities: RenderCapabilities
}

impl for AdapterInfo {
    pub fn index(self: Self) -> usize {
        ret self.index
    }
    pub fn name(self: Self) -> str {
        ret self.name
    }
    pub fn vendor_id(self: Self) -> u32 {
        ret self.vendor_id
    }
    pub fn device_id(self: Self) -> u32 {
        ret self.device_id
    }
    pub fn kind(self: Self) -> u32 {
        ret self.kind
    }
    pub fn discrete(self: Self) -> bool {
        ret self.kind == adapter_discrete()
    }
    pub fn api_version(self: Self) -> ApiVersion {
        ret self.api_version
    }
    pub fn capabilities(self: Self) -> RenderCapabilities {
        ret self.capabilities
    }
}

