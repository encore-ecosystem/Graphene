        ret self.available() && native_frame_draw_mesh_tasks_indirect(
            self.handle, commands.handle, offset,)
    }
    pub fn end(self: Self) -> bool {
        ret self.available() && native_frame_end_render_pass(self.handle)
    }
}

impl for GpuMesh {
    pub fn draw_instanced(self: Self, pass: RenderPassEncoder,
        instance_count: u32, first_instance: u32,) -> bool {
        ret self.available() && pass.bind_vertex_buffer(self.vertex) &&
        pass.bind_index_buffer(self.index) &&
        pass.draw_indexed_instanced(self.index_count, instance_count,
            0_u32, 0_i32, first_instance,)
    }
}

