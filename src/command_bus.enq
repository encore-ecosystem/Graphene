//! Typed editor commands, transactional history, and ordered state events.

import core::option::Option
import core::vec::Vec
import mod::scene::renderable::{MaterialId, MeshId, Renderable}
import mod::scene::transform::Transform
import mod::scene::world::{Entity, Scene}

pub struct AddActorCommand {
    name: str value: Transform asset_name: str
}
pub struct ActorCommand {
    actor: u64
}
pub struct DuplicateActorCommand {
    actor: u64
    name: str
    value: Transform
}
pub struct ActorParentCommand {
    actor: u64 parent: Option[u64]
}

pub struct ActorNameCommand {
    actor: u64 value: str
}
pub struct ActorVisibilityCommand {
    actor: u64 value: bool
}
pub struct ActorTransformCommand {
    actor: u64 value: Transform
}
pub struct ActorSelectionCommand {
    actor: Option[u64]
}
pub struct ActorSelectionSetCommand {
    actors: Vec[u64]
    primary: Option[u64]
}
pub struct ActorTransformsCommand {
    values: Vec[ActorTransformCommand]
}
pub struct SimulationCommand {
    mode: str
}
pub struct OperationCompletionCommand {
    success: bool
    message: str
}
pub struct ProjectRequestCommand {
    operation: str
    path: str
    template_name: str
}
pub struct ProjectLoadedCommand {
    scene: Option[Scene]
    actor_ids: Vec[u64]
    asset_names: Vec[str]
    message: str
}
pub struct AssetImportCommand {
    source: str
}

pub struct GrapheneTask {
    id: str
    kind: str
    state: str
    message: str
}

pub struct GrapheneDiagnostic {
    severity: str
    message: str
    path: str
    line: u32
    column: u32
}

pub enum GrapheneCommand {
    AddActor(AddActorCommand)
    DuplicateActor(DuplicateActorCommand)
    DeleteActor(ActorCommand)
    SetParent(ActorParentCommand)
    Rename(ActorNameCommand)
    SetVisibility(ActorVisibilityCommand)
    SetTransform(ActorTransformCommand)
    Select(ActorSelectionCommand)
    SelectSet(ActorSelectionSetCommand)
    SetTransforms(ActorTransformsCommand)
    StartSimulation(SimulationCommand)
    StopSimulation
    RequestProject(ProjectRequestCommand)
    CompleteProjectLoad(ProjectLoadedCommand)
    RequestImportAsset(AssetImportCommand)
    CompleteImport(OperationCompletionCommand)
    RequestSave
    CompleteSave(OperationCompletionCommand)
    RequestBuild
    BuildPrepared
    CompleteBuild(OperationCompletionCommand)
    Undo
    Redo
}

pub struct GrapheneEvent {
    kind: str actor: Option[u64] revision: u64
}

pub struct CommandResult {
    success: bool message: str revision: u64 events: Vec[GrapheneEvent]
}

enum CommandEdit {
    RemoveActor(ActorCommand)
    RestoreActor(ActorSnapshot)
    Parent(ActorParentEdit)
    Rename(ActorNameCommand)
    Visibility(ActorVisibilityCommand)
    Transform(ActorTransformCommand)
    Transforms(ActorTransformsCommand)
}

struct ActorSnapshot {
    entity: Entity
    children: Vec[u64]
    asset_name: str
}
struct ActorParentEdit {
    actor: u64
    parent: Option[u64]
    transform: Transform
}
struct InteractiveEdit {
    inverse: CommandEdit
    actor: u64
    kind: str
    event_kind: str
}
struct ActorAsset {
    actor: u64
    name: str
}

/// Owns editor state and is the only mutation boundary exposed to UI, API,
/// console, and agent frontends.
pub struct EditorState {
    scene: Scene
    selection: Option[u64]
    selection_ids: Vec[u64]
    revision: u64
    dirty: bool
    undo: Vec[CommandEdit]
    redo: Vec[CommandEdit]
    interactive: Option[InteractiveEdit]
    assets: Vec[ActorAsset]
    history_position: i64
    saved_history_position: i64
    event_log: Vec[GrapheneEvent]
    project_loaded: bool
    simulation_mode: str
    save_pending: bool
    building: bool
    project_operation: str
    project_path: str
    project_template: str
    import_source: str
    task: Option[GrapheneTask]
    diagnostics: Vec[GrapheneDiagnostic]
}

impl for ActorNameCommand {
    pub fn new(actor: u64, value: str) -> Self {
        ret Self {
            actor, value
        }
    }
    pub fn actor(self: Self) -> u64 {
        ret self.actor
    }
    pub fn value(self: Self) -> str {
        ret self.value
    }
}

