//! Bounded HTTP transfers run on owned Encore workers, never on the editor thread.

import refrain::texture_asset::decode_png
extern fn graphene_content_pixels(address: usize, count: usize) -> str
import core::ops::ContextManager
import core::option::Option
import core::result::Result

import std::fs::File
import std::http::{HTTPSyncClient, HttpClientConfig, HttpRequest, Url}

import mod::importer::{GeneratedMap, decoded_map}
import mod::model::{Provider, text, value}
pub struct Transfer {
    operation: str
    status: u16
    body: str
    error: str
    map: Option[GeneratedMap]
}
pub fn transfer(provider: Provider, operation: str, path: str, body: str, idem: str, method: str, content_type: str, manifest_source: str) -> sending Transfer {
    let manifest = value(manifest_source)
    let url = match Url::parse(provider.url + path) {
        Ok(url) => url Err(error) => {
            ret Transfer {
                operation, 0_u16, "", error, Option::None
            }
        }
    }
    let client = HTTPSyncClient::with_config(HttpClientConfig::default().with_max_body_size(16777216).with_timeout_ms(20000))
    let mut request = HttpRequest::new(method, url).with_header("Authorization", "Bearer " + provider.key).with_header("Content-Type", content_type).with_body(body)
    if idem != "" {
        request = request.with_header("Idempotency-Key", idem)
    }
    match client.send(request) {
        Ok(response) => {
            if response.status() >= 200 && response.status() < 300 {
                if operation.byte_len() > 4 && operation.slice_bytes(0, 4) == "map-" {
                    match decoded_map(operation.slice_bytes(4, operation.byte_len() - 4), response.body(), manifest) {
                        Ok(map) => {
                            ret Transfer { operation, response.status(), "", "", Option::Some(map) }
                        }
                        Err(error) => {
                            ret Transfer { operation, response.status(), "", error, Option::None }
                        }
                    }
                }
                ret Transfer { operation, response.status(), response.body(), "", Option::None }
            }
            let message = text(value(response.body()), "error")
            ret Transfer {
                operation, response.status(), "", if message != "" && !message.contains(provider.key) {
                    message
                } else {
                    "Provider returned HTTP " + response.status().fmt()
                }
                , Option::None
            }
        }
        Err(_) => {
            ret Transfer {
                operation, 0_u16, "", "Provider connection failed; reconnect to retry the same request", Option::None
            }
        }
    }
}

// Read one byte beyond the limit to reject large inputs without loading them fully.
fn read_reference(path: str) -> Result[str, str] {
    let file = match File::open(path) {
        Ok(file) => file Err(_) => {
            ret Result::Err("Unable to open reference PNG")
        }
    }
    with file as stream {
        let bytes = match stream.read(8388609) {
            Ok(bytes) => bytes Err(_) => {
                ret Result::Err("Unable to read reference PNG")
            }
        }
        if stream.close().is_err() {
            ret Result::Err("Unable to close reference PNG")
        }
        if bytes.byte_len() > 8388608 {
            ret Result::Err("Choose a PNG reference up to 8 MiB")
        }
        ret Result::Ok(bytes)
    }
}

pub fn upload(provider: Provider, path: str) -> sending Transfer {
    let bytes = match read_reference(path) {
        Ok(bytes) => bytes Err(error) => {
            ret Transfer { "upload", 0_u16, "", error, Option::None }
        }
    }
    if bytes.byte_len() < 33 || bytes.byte_len() > 8388608 || bytes.slice_bytes(1, 3) != "PNG" {
        ret Transfer {
            "upload", 0_u16, "", "Choose a PNG reference up to 8 MiB", Option::None
        }
    }
    ret transfer(provider, "upload", "/v1/uploads", bytes, "", "POST", "image/png", "null")
}

/// Preview the same centered square reference crop that is submitted to the model.
pub fn reference_preview(path: str) -> sending Transfer {
    let bytes = match read_reference(path) {
        Ok(bytes) => bytes Err(error) => {
            ret Transfer {
                "reference", 0_u16, "", error, Option::None
            }
        }
    }
    if bytes.byte_len() < 33 || bytes.byte_len() > 8388608 {
        ret Transfer {
            "reference", 0_u16, "", "Choose a PNG reference up to 8 MiB", Option::None
        }
    }
    let mut width = 0_u64 let mut height = 0_u64
    for i in 0_usize..4_usize {
        width = width * 256 +(bytes.byte_at(16 + i) as u64) height = height * 256 +(bytes.byte_at(20 + i) as u64)
    }
    if width == 0 || height == 0 || width > 4096 || height > 4096 {
        ret Transfer {
            "reference", 0_u16, "", "Reference dimensions must be 1..4096", Option::None
        }
    }
    match decode_png(bytes) {
        Err(error) => {
            ret Transfer { "reference", 0_u16, "", error, Option::None }
        }
        Ok(image) => {
            let side = if image.width < image.height {
                image.width
            } else {
                image.height
            }
            let left =(image.width - side) / 2 let top =(image.height - side) / 2
            let mut pixels = vec![256_u32, 256_u32]
            for y in 0_usize..256_usize {
                for x in 0_usize..256_usize {
                    let ix =(left as usize) + x *(side as usize) / 256 let iy =(top as usize) + y *(side as usize) / 256
                    pixels.push(image.pixels.get_unchecked_borrowed(iy *(image.width as usize) + ix) | 4278190080_u32)
                }
            }
            unsafe {
                ret Transfer {
                    "reference", 200_u16, graphene_content_pixels(pixels.as_ptr() as usize, pixels.len()), "", Option::None
                }
            }
        }
    }
}
