import core::option::Option
import core::vec::Vec
import json::{parse, stringify}
import linalg::{Mat4, Vec3}
import mod::component::SceneComponent
import mod::renderable::{RenderItem, Renderable}
import mod::transform::Transform
import refrain::blueprint::codec::{blueprint_instance_json, blueprint_instance_parse}
import refrain::blueprint::model::BlueprintInstance

pub struct Entity {
    id: u64
    name: str
    transform: Transform
    parent: Option[u64]
    visible: bool
    renderable: Option[Renderable]
    blueprint_source: str
    component: SceneComponent
}
pub struct Scene {
    entities: Vec[Entity]
    next_id: u64
    revision: u64
}

impl for Entity {
    pub fn component(self: Self) -> SceneComponent {
        ret self.component
    }
    pub fn id(self: Self) -> u64 {
        ret self.id
    }
    pub fn name(self: Self) -> str {
        ret self.name
    }
    pub fn transform(self: Self) -> Transform {
        ret self.transform
    }
    pub fn parent(self: Self) -> Option[u64] {
        ret self.parent
    }
    pub fn visible(self: Self) -> bool {
        ret self.visible
    }
    pub fn renderable(self: Self) -> Option[Renderable] {
        ret self.renderable
    }
    pub fn blueprint(self: Self) -> Option[BlueprintInstance] {
        if self.blueprint_source == "" {
            ret Option[BlueprintInstance]::None
        }
        match parse(self.blueprint_source) {
            Ok(value) => {
                match blueprint_instance_parse(value) {
                    Ok(instance) => {
                        ret Option[BlueprintInstance]::Some(instance)
                    }
                    Err(_) => {
                    }
                }
            }
            Err(_) => {
            }
        }
        ret Option[BlueprintInstance]::None
    }
}

impl for Scene {
    pub fn new() -> Scene {
        ret Scene {
            Vec[Entity]::new(), 1_u64, 1_u64
        }
    }
    /// Monotonic invalidation token for render snapshots; scene files omit it.
    pub fn revision(self: Self) -> u64 {
        ret self.revision
    }
    pub fn len(self: Self) -> usize {
        ret self.entities.len()
    }
    pub fn entities(self: Self) -> Vec[Entity] {
        ret self.entities
    }
    pub fn create_entity(self: mut Self, name: str, transform: Transform) -> u64 {
        self.revision += 1_u64
        let id = self.next_id
        self.create_entity_with_id(id, name, transform)
        ret id
    }
    pub fn create_entity_with_id(self: mut Self, id: u64, name: str, transform: Transform) -> bool {
        self.revision += 1_u64
        if id == 0_u64 || self.get(id).is_some() {
            ret false
        }
        self.entities.push(Entity {
                id, name, transform, Option[u64]::None, true, Option[Renderable]::None, "", SceneComponent::None
            }
            ,
        )
        if id >= self.next_id {
            self.next_id = id + 1_u64
        }
        ret true
    }
    fn index_of(self: Self, id: u64) -> usize {
        if id > 0_u64 && id <= self.entities.len() as u64 {
            match self.entities.get((id - 1_u64) as usize) {
                Some(entity) => {
                    if entity.id == id {
                        ret(id - 1_u64) as usize
                    }
                }
                None => {
                }
            }
        }
        let mut index = 0_usize
        for entity in self.entities {
            if entity.id == id {
                ret index
            }
            index += 1_usize
        }
        ret self.entities.len()
    }
    pub fn get(self: Self, id: u64) -> Option[Entity] {
        // Dense actor IDs are the common path. Retain sparse/imported IDs
        // and deletion semantics through the existing checked fallback.
        if id > 0_u64 && id <= self.entities.len() as u64 {
            match self.entities.get((id - 1_u64) as usize) {
                Some(entity) => {
                    if entity.id == id {
                        ret Option[Entity]::Some(entity)
                    }
                }
                None => {
                }
            }
        }
        let mut index = 0_usize
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        ret Option[Entity]::Some(entity)
                    }
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
        ret Option[Entity]::None
    }
    pub fn remove(self: mut Self, id: u64) -> bool {
        self.revision += 1_u64
        let mut found = false
        let mut remaining = Vec[Entity]::new()
        for entity in self.entities {
            if entity.id == id {
                found = true
            } else {
                let parent = match entity.parent {
                    Option::Some(parent_id) => {
                        if parent_id == id {
                            Option[u64]::None
                        } else {
                            entity.parent
                        }
                    }
                    Option::None => {
                        Option[u64]::None
                    }
                }
                remaining.push(Entity {
                        entity.id, entity.name, entity.transform, parent,
                        entity.visible, entity.renderable, entity.blueprint_source, entity.component
                    }
                    ,)
            }
        }
        if found {
            self.entities = remaining
        }
        ret found
    }
    pub fn set_transform(self: mut Self, id: u64, transform: Transform) -> bool {
        self.revision += 1_u64
        let mut index = self.index_of(id)
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                                entity.id, entity.name, transform, entity.parent, entity.visible, entity.renderable, entity.blueprint_source, entity.component
                            }
                            ,)
                        ret true
                    }
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn rename(self: mut Self, id: u64, name: str) -> bool {
        self.revision += 1_u64
        if name == "" {
            ret false
        }
        let mut index = self.index_of(id)
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                                entity.id, name, entity.transform, entity.parent, entity.visible, entity.renderable, entity.blueprint_source, entity.component
                            }
                            ,)
                        ret true
                    }
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn set_visible(self: mut Self, id: u64, visible: bool) -> bool {
        self.revision += 1_u64
        let mut index = self.index_of(id)
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                                entity.id, entity.name, entity.transform, entity.parent, visible, entity.renderable, entity.blueprint_source, entity.component
                            }
                            ,)
                        ret true
                    }
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn set_parent(self: mut Self, id: u64, parent: Option[u64]) -> bool {
        self.revision += 1_u64
        if id == 0_u64 {
            ret false
        }
        match self.get(id) {
            Option::None => {
                ret false
            }
            Option::Some(_) => {
            }
        }
        match parent {
            Option::Some(parent_id) => {
                if parent_id == id {
                    ret false
                }
                match self.get(parent_id) {
                    Option::None => {
                        ret false
                    }
                    Option::Some(_) => {
                    }
                }
                let mut cursor = Option[u64]::Some(parent_id)
                let mut steps = 0_usize
                while steps < self.entities.len() {
                    match cursor {
                        Option::Some(cursor_id) => {
                            if cursor_id == id {
                                ret false
                            }
                            match self.get(cursor_id) {
                                Option::Some(entity) => {
                                    cursor = entity.parent
                                }
                                Option::None => {
                                    ret false
                                }
                            }
                        }
                        Option::None => {
                            steps = self.entities.len()
                        }
                    }
                    steps = steps + 1_usize
                }
                match cursor {
                    Option::Some(_) => {
                        ret false
                    }
                    Option::None => {
                    }
                }
            }
            Option::None => {
            }
        }
        let mut index = self.index_of(id)
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                                entity.id, entity.name, entity.transform, parent, entity.visible, entity.renderable, entity.blueprint_source, entity.component
                            }
                            ,)
                        ret true
                    }
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn set_parent_keep_world(self: mut Self, id: u64, parent: Option[u64]) -> bool {
        self.revision += 1_u64
        match self.world_matrix(id) {
            Option::Some(world) => {
                let mut local = Option[Mat4]::Some(world)
                match parent {
                    Option::Some(parent_id) => {
                        match self.world_matrix(parent_id) {
                            Option::Some(parent_world) => {
                                match parent_world.inverse_affine() {
                                    Option::Some(inverse) => {
                                        local = Option[Mat4]::Some(inverse.mul(world))
                                    }
                                    Option::None => {
                                        local = Option[Mat4]::None
                                    }
                                }
                            }
                            Option::None => {
                                local = Option[Mat4]::None
                            }
                        }
                    }
                    Option::None => {
                    }
                }
                match local {
                    Option::Some(matrix) => {
                        match matrix.decompose_trs() {
                            Option::Some(parts) => {
                                match self.get(id) {
                                    Option::Some(entity) => {
                                        let previous_parent = entity.parent
                                        if !self.set_parent(id, parent) {
                                            ret false
                                        }
                                        if self.set_transform(id, Transform::new(parts.0, parts.1, parts.2))
                                        {
                                            ret true
                                        }
                                        self.set_parent(id, previous_parent)
                                    }
                                    Option::None => {
                                    }
                                }
                            }
                            Option::None => {
                            }
                        }
                    }
                    Option::None => {
                    }
                }
            }
            Option::None => {
            }
        }
        ret false
    }
    pub fn world_matrix(self: Self, id: u64) -> Option[Mat4] {
        let mut chain = Vec[Mat4]::new()
        let mut cursor = Option[u64]::Some(id)
        let mut steps = 0_usize
        while steps < self.entities.len() {
            match cursor {
                Option::Some(cursor_id) => {
                    match self.get(cursor_id) {
                        Option::Some(entity) => {
                            chain.push(entity.transform.matrix()) cursor = entity.parent
                        }
                        Option::None => {
                            ret Option[Mat4]::None
                        }
                    }
                }
                Option::None => {
                    steps = self.entities.len()
                }
            }
            steps = steps + 1_usize
        }
        match cursor {
            Option::Some(_) => {
                ret Option[Mat4]::None
            }
            Option::None => {
            }
        }
        let mut result = Mat4::identity()
        let mut remaining = chain.len()
        while remaining > 0_usize {
            remaining = remaining - 1_usize
            match chain.get(remaining) {
                Option::Some(matrix) => {
                    result = result.mul(matrix)
                }
                Option::None => {
                }
            }
        }
        ret Option[Mat4]::Some(result)
    }
    pub fn world_position(self: Self, id: u64) -> Option[Vec3] {
        match self.world_matrix(id) {
            Option::Some(matrix) => {
                ret Option[Vec3]::Some(matrix.transform_point(Vec3::zero()))
            }
            Option::None => {
            }
        }
        ret Option[Vec3]::None
    }
    pub fn local_position_for_world(self: Self, id: u64, position: Vec3) -> Option[Vec3] {
        match self.get(id) {
            Option::Some(entity) => {
                match entity.parent {
                    Option::Some(parent_id) => {
                        match self.world_matrix(parent_id) {
                            Option::Some(parent_world) => {
                                match parent_world.inverse_affine() {
                                    Option::Some(inverse) => {
                                        ret Option[Vec3]::Some(inverse.transform_point(position))
                                    }
                                    Option::None => {
                                    }
                                }
                            }
                            Option::None => {
                            }
                        }
                    }
                    Option::None => {
                        ret Option[Vec3]::Some(position)
                    }
                }
            }
            Option::None => {
            }
        }
        ret Option[Vec3]::None
    }
    pub fn world_visible(self: Self, id: u64) -> bool {
        let mut cursor = Option[u64]::Some(id)
        let mut steps = 0_usize
        while steps < self.entities.len() {
            match cursor {
                Option::Some(cursor_id) => {
                    match self.get(cursor_id) {
                        Option::Some(entity) => {
                            if !entity.visible {
                                ret false
                            }
                            cursor = entity.parent
                        }
                        Option::None => {
                            ret false
                        }
                    }
                }
                Option::None => {
                    ret true
                }
            }
            steps = steps + 1_usize
        }
        ret cursor.is_none()
    }
    pub fn set_renderable(self: mut Self, id: u64, renderable: Option[Renderable]) -> bool {
        self.revision += 1_u64
        let mut index = self.index_of(id)
        while index < self.entities.len() {
            match self.entities.get(index) {
                Option::Some(entity) => {
                    if entity.id == id {
                        self.entities.set(index, Entity {
                                entity.id, entity.name, entity.transform, entity.parent, entity.visible,
                                renderable, entity.blueprint_source, entity.component
                            }
                            ,)
                        ret true
                    }
                }
                Option::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }
    pub fn set_blueprint(self: mut Self, id: u64, instance: Option[BlueprintInstance]) -> bool {
        self.revision += 1_u64
        let source = match instance {
            Some(value) => stringify(blueprint_instance_json(value)) None => ""
        }
        let mut index = 0_usize
        for entity in self.entities {
            if entity.id == id {
                self.entities.set(index, Entity {
                        entity.id, entity.name, entity.transform, entity.parent, entity.visible, entity.renderable, source, entity.component
                    }
                    ,
                )
                ret true
            }
            index += 1
        }
        ret false
    }
    pub fn set_component(self: mut Self, id: u64, component: SceneComponent) -> bool {
        self.revision += 1_u64
        if !component.valid() {
            ret false
        }
        let index = self.index_of(id)
        match self.entities.get(index) {
            Some(entity) => {
                self.entities.set(index, Entity {
                        entity.id, entity.name, entity.transform, entity.parent, entity.visible, entity.renderable, entity.blueprint_source, component
                    }
                    ,
                )
                ret true
            }
            None => {
                ret false
            }
        }
    }
    pub fn visible_render_items(self: Self) -> Vec[RenderItem] {
        let mut items = Vec[RenderItem]::new()
        for entity in self.entities {
            if self.world_visible(entity.id) && entity.component.kind() == "" {
                match entity.renderable {
                    Option::Some(renderable) => {
                        if renderable.valid() {
                            match self.world_matrix(entity.id) {
                                Option::Some(world) => {
                                    items.push(RenderItem::new(entity.id, renderable, world))
                                }
                                Option::None => {
                                }
                            }
                        }
                    }
                    Option::None => {
                    }
                }
            }
        }
        ret items
    }
}
