pub struct VirtualGeometryInstance {
    model: Mat4
    base_color: Vec3
    metallic: f32
    roughness: f32
    unlit: bool
    normal_scale: f32
    normal_flip_y: bool
    previous_model: Mat4
    previous_valid: bool
}

impl for VirtualGeometryInstance {
    pub fn new(model: Mat4, base_color: Vec3,
        metallic: f32, roughness: f32, unlit: bool,) -> Self {
        ret Self {
            model, base_color, metallic, roughness, unlit, 0.0, false, model, false
        }
    }
    pub fn with_previous(self: Self, model: Mat4, valid: bool) -> Self {
        ret Self {
            self.model, self.base_color, self.metallic, self.roughness, self.unlit, self.normal_scale, self.normal_flip_y, model, valid
        }
    }
    pub fn with_normal_map(self: Self, scale: f32, flip_y: bool) -> Self {
        ret Self {
            self.model, self.base_color, self.metallic, self.roughness, self.unlit, scale, flip_y, self.previous_model, self.previous_valid
        }
    }
}

/// Persistent per-mesh GPU resources used by the editor's virtualized scene
/// path. Culling is recorded into Luma's frame and the compacted stream is
/// consumed directly by the mesh shader in the following render pass.
/// Shared immutable geometry and queue-ordered residency. Views own streams,
/// culling history and pipelines; the asset owner retires shared resources once.
pub struct VirtualGeometryResources {
    page_cache: GeometryPagePool<H>
    page_archive: GeometryPageArchive
    vertices: GpuBuffer
    triangles: GpuBuffer
    page_staging_vertices: GpuBuffer
    page_staging_triangles: GpuBuffer
    clusters: Vec[GeometryCluster]
    hierarchy: Vec[ClusterHierarchyNode]
    cluster_lods: Vec[u32]
    lod_roots: Vec[u32]
    lod_budget: LodBudget
    cluster_slots: Vec[u32]
    cluster_resident: Vec[bool]
    frame_index: u64
    residency_version: u64
    resident_mask_version: u64
    resident_mask: u32
    maximum_lod: u32
    object_radius: f32
    object_center: Vec3
    data: VirtualGeometry
    available: bool
    uses: Vec[GpuCompletion]
    page_producer: GpuCompletion
    pending_pages: Vec[u32]
}

pub struct GpuVirtualGeometry {
    resources: VirtualGeometryResources<H>
    skin: Option[SkinGpuSection<H>]
    layout: BindGroupLayout
    groups: Vec[BindGroup]
    light_buffers: Vec[GpuBuffer]
    light_values: Vec[f32]
    temporal_buffers: Vec[GpuBuffer]
    lod_history: GpuBuffer
    previous_view_projection: Mat4
    aa_signature: u32
    graph_key: str
    graph_applied: str
    graph_shaders: Vec[Vec[u32]]
    cull_shader: ShaderModule
    cull_pipeline: ComputePipeline
    post_cull_shader: ShaderModule
    post_cull_pipeline: ComputePipeline
    dispatch_shader: ShaderModule
    dispatch_pipeline: ComputePipeline
    mesh_shader: ShaderModule
    fragment_shader: ShaderModule
    triangle_debug_shader: ShaderModule
    render_pipeline: RenderPipeline
    triangle_debug_pipeline: RenderPipeline
    overdraw_pipeline: RenderPipeline
    streams: Vec[GpuBuffer]
    texture: GpuTexture
    normal_texture: GpuTexture
    shelter_texture: GpuTexture
    shelter_bound: bool
    sampler: GpuSampler
    gi_buffers: Vec[GpuBuffer]
    lod_smooth: bool
    lod_curve: Vec[LodCurvePoint]
    slot_frames: Vec[u64]
    metadata_versions: Vec[u64]
    metadata_modes: Vec[u32]
    metadata_primitives: Vec[u32]
    active_slot: usize
    active_indirect_offset: u64
    target_pixel_error: f32
    autolod_enabled: bool
    lod_focal_y: f32
    lod_near: f32
    maximum_instances: usize
    active_candidates: u32
    active_traversal_instances: u32
    active_post_candidates: u32
    active_main_visible: u32
    active_post_visible: u32
    last_record_error: u32
    view_mode: u32
    primitive_id: u32
    available: bool
    owns_resources: bool
    uses: Vec[GpuCompletion]
    record_completion: GpuCompletion
    request_shader: ShaderModule
    request_pipeline: ComputePipeline
    cache_dispatch_shader: ShaderModule
    cache_dispatch_pipeline: ComputePipeline
    skin_frame: u64
    skin_has_frame: bool
    skin_view_history: bool
    retired_pipelines: Vec[RetiredVirtualPipelines]
}

struct RetiredVirtualPipelines {
    solid: RenderPipeline
    triangles: RenderPipeline
    overdraw: RenderPipeline
    uses: Vec[GpuCompletion]
}
fn collect_virtual_pipelines(retired: mut Vec[RetiredVirtualPipelines]) ->(){
    let mut count=0_usize
    for i in 0_usize..retired.len(){
        let entry=retired.get_unchecked_borrowed(i) let mut ready=true
        for token in entry.uses{if !token.ready(){ready=false}}
        if ready{
            for token in entry.uses{token.destroy()}
            entry.solid.destroy() entry.triangles.destroy() entry.overdraw.destroy()
        }else{retired.set(count,entry) count+=1_usize}
    }
    while retired.len()>count{retired.pop()}
}
fn retire_virtual_pipelines(self: mut GpuVirtualGeometry&) ->(){
    collect_virtual_pipelines(self.retired_pipelines)
    let mut uses=Vec[GpuCompletion]::new()
    for token in self.uses{if !token.ready(){uses.push(token.retained())}}
    self.retired_pipelines.push(RetiredVirtualPipelines{self.render_pipeline,self.triangle_debug_pipeline,self.overdraw_pipeline,uses})
    collect_virtual_pipelines(self.retired_pipelines)
}
/// A page marked resident on the CPU must be uploaded again if its recording
/// was discarded. A second view cannot race a still-recording producer.
fn reconcile_virtual_page_uploads(resources: mut VirtualGeometryResources&,frame: RenderFrame) -> bool {
    if !resources.page_producer.available(){ret true}
    let token=frame.completion() if !token.available(){ret false}
    let same=resources.page_producer.same_submission(token) token.destroy()
    if same{ret true}
    if resources.page_producer.status()==GpuCompletionStatus::Cancelled{
        for page in resources.pending_pages{__borrowed_bool_set(resources.cluster_resident,page as usize,false)}
        resources.residency_version+=1_u64
    }elif !resources.page_producer.submitted(){ret false}
    resources.pending_pages.clear() resources.page_producer.destroy() resources.page_producer=GpuCompletion::unavailable() ret true
}

fn __borrowed_f32_at(values: Vec[f32], index: usize) -> f32 {
    ret values.get(index).unwrap_or(0.0_f32)
}

fn __borrowed_u32_at(values: Vec[u32], index: usize) -> u32 {
    ret values.get(index).unwrap_or(0_u32)
}

fn __borrowed_u32_set(values: mut Vec[u32], index: usize, value: u32) -> bool {
    values.set(index, value)
    ret index < values.len()
}

fn __borrowed_bool_set(values: mut Vec[bool], index: usize, value: bool) -> bool {
    values.set(index, value)
    ret index < values.len()
}

fn __borrowed_u64_set(values: mut Vec[u64], index: usize, value: u64) -> bool {
    values.set(index, value)
    ret index < values.len()
}

fn __borrowed_bind_group_len(values: Vec[BindGroup]) -> usize {
    ret values.len()
}

fn __borrowed_bind_group_at(
    values: Vec[BindGroup], index: usize,) -> BindGroup {
    match values.get(index) {
        Option::Some(value) => {
            ret value
        }
        Option::None => {
            ret BindGroup::unavailable()
        }
    }
}

fn __borrowed_gpu_buffer_len(values: Vec[GpuBuffer]) -> usize {
    ret values.len()
}

fn __borrowed_gpu_buffer_at(
    values: Vec[GpuBuffer], index: usize,) -> GpuBuffer {
    match values.get(index) {
        Option::Some(value) => {
            ret value
        }
        Option::None => {
            ret GpuBuffer::unavailable()
        }
    }
}

fn __borrowed_cluster_word(clusters: Vec[GeometryCluster],
    index: usize, field: usize,) -> usize {
    match clusters.get(index) {
        Option::Some(cluster) => {
            if field == 0_usize {
                ret cluster.vertex_offset()
            }
            if field == 1_usize {
                ret cluster.vertex_count()
            }
            if field == 2_usize {
                ret cluster.triangle_offset()
            }
            if field == 3_usize {
                ret cluster.triangle_count()
            }
        }
        Option::None => {
        }
    }
    ret 0_usize
}

#attr(safe)
fn __gpu_virtual_geometry_address(self: GpuVirtualGeometry&) -> usize {
    unsafe {
        unsafe ehir {
            address: usize = pcast self: GpuVirtualGeometry &, usize
        }
        ret address
    }
}

fn geometry_page_vertices(source_vertices: Vec[f32],
    vertex_offset: usize, vertex_count: usize,) -> Vec[f32] {
    let mut page_vertices = Vec[f32]::new()
    let mut component = 0_usize
    let source_vertex = vertex_offset * 11_usize
    while component < vertex_count * 11_usize {
        page_vertices.push(__borrowed_f32_at(
                source_vertices, source_vertex + component,))
        component += 1_usize
    }
    ret page_vertices
}

fn geometry_page_triangles(source_triangles: Vec[u32],
    triangle_offset: usize, triangle_count: usize,) -> Vec[u32] {
    let mut page_triangles = Vec[u32]::new()
    let mut index = 0_usize
    let source_triangle = triangle_offset
    while index < triangle_count * 3_usize {
        page_triangles.push(__borrowed_u32_at(
                source_triangles, source_triangle + index,))
        index += 1_usize
    }
    ret page_triangles
}


fn create_virtual_geometry_resources(device: GraphicsDevice,geometry: VirtualGeometry,packed_vertices: Vec[f32]) -> VirtualGeometryResources<H> {
        let source_page_vertices = packed_vertices
        let mut clusters = geometry.clusters()
        let hierarchy = geometry.hierarchy()
        let lods = geometry.lods()
        let lod_budget = LodBudget::build(geometry)
        let root_node = geometry.root_node()
        let root_error = if root_node as usize < hierarchy.len() {
            match hierarchy.get(root_node as usize) {
                Option::Some(node) => node.geometric_error()
                Option::None => 0.0_f32
            }
        } else {
            0.0_f32
        }
        let mut cluster_lods = Vec[u32]::new()
        let mut lod_roots = Vec[u32]::new()
        // Slot zero is the continuous DAG root. Remaining header slots are
        // reserved for runtime AutoLOD settings rather than independent
        // whole-object LOD roots.
        lod_roots.push(root_node)
        let mut cluster_index = 0_usize
        while cluster_index < clusters.len() {
            let mut cluster_lod = 0_u32
            let mut lod_index = 0_usize
            for lod in lods {
                if cluster_index >= lod.first_cluster() &&
                cluster_index < lod.first_cluster() + lod.cluster_count() {
                    cluster_lod = lod_index as u32
                }
                lod_index += 1_usize
            }
            cluster_lods.push(cluster_lod)
            cluster_index += 1_usize
        }
        // Bounds come from the source level, independent of the selected cut.
        let mut minimum = Vec3::new(340282346638528859811704183484516925440.0_f32, 340282346638528859811704183484516925440.0_f32, 340282346638528859811704183484516925440.0_f32)
        let mut maximum = minimum.scale( - 1.0_f32)
        let base_count = match lods.get(0) {
            Some(lod) => lod.cluster_count() None => 0_usize
        }
        for index in 0_usize..base_count {
            let cluster = clusters.get_unchecked_borrowed(index)
            let begin = cluster.vertex_offset() let end = begin + cluster.vertex_count()
            for vertex in begin..end {
                let x = __borrowed_f32_at(source_page_vertices, vertex * 11)
                let y = __borrowed_f32_at(source_page_vertices, vertex * 11 + 1)
                let z = __borrowed_f32_at(source_page_vertices, vertex * 11 + 2)
                minimum = Vec3::new(if x < minimum.x() {
                        x
                    } else {
                        minimum.x()
                    }
                    , if y < minimum.y() {
                        y
                    } else {
                        minimum.y()
                    }
                    , if z < minimum.z() {
                        z
                    } else {
                        minimum.z()
                    }
                    ,
                )
                maximum = Vec3::new(if x > maximum.x() {
                        x
                    } else {
                        maximum.x()
                    }
                    , if y > maximum.y() {
                        y
                    } else {
                        maximum.y()
                    }
                    , if z > maximum.z() {
                        z
                    } else {
                        maximum.z()
                    }
                    ,
                )
            }
        }
        let object_center = if base_count > 0 {
            minimum.add(maximum).scale(0.5_f32)
        } else {
            Vec3::zero()
        }
        let object_radius = if base_count > 0 {
            maximum.sub(minimum).length() * 0.5_f32
        } else {
            0.0_f32
        }
        let maximum_lod = if lods.len() == 0_usize {
            0_u32
        } else {
            (lods.len() - 1_usize) as u32
        }
        let mut coarse_count = 0_usize
        for cluster_lod in cluster_lods {
            if cluster_lod == maximum_lod {
                coarse_count += 1_usize
            }
        }
        // The runtime budget is 512 MiB. One physical cluster page occupies
        // 64 * 11 vertex floats plus 126 * 3 local indices (4328 bytes), so
        // 118000 pages stay below the budget. Small and medium assets preload
        // their complete DAG; only larger assets enter feedback streaming.
        let budget_pages = 118000_usize
        let bounded_pages = if clusters.len() < budget_pages {
            clusters.len()
        } else {
            budget_pages
        }
        let page_capacity = if coarse_count > bounded_pages {
            coarse_count
        } else {
            bounded_pages
        }
        let preload_all = clusters.len() <= page_capacity
        let page_cache = GeometryPagePool::create(page_capacity)
        let mut cluster_resident = Vec[bool]::new()
        let mut cluster_slots = Vec[u32]::new()
        let mut resident_index = 0_usize
        while resident_index < clusters.len() {
            let coarse = match cluster_lods.get(resident_index) {
                Option::Some(value) => value == maximum_lod
                Option::None => false
            }
            let mut slot = 0_u32
            let initially_resident = preload_all || coarse
            if initially_resident {
                let allocation = geometry_page_pool_request(
                    page_cache,
                    1_u64, resident_index as u32, 0_u64, 4294967295_u32,)
                slot = allocation.slot()
            }
            cluster_resident.push(initially_resident)
            cluster_slots.push(slot)
            resident_index += 1_usize
        }
        let mut packed_triangles = geometry.triangle_indices()
        let page_archive = GeometryPageArchive::create(
            source_page_vertices, packed_triangles,)
        let vertices = device.create_buffer(
            (geometry_page_pool_capacity(page_cache) as u64) *
            64_u64 * 11_u64 * 4_u64,
            buffer_storage() | buffer_transfer_destination(), true,)
        let triangles = device.create_buffer(
            (geometry_page_pool_capacity(page_cache) as u64) *
            126_u64 * 3_u64 * 4_u64,
            buffer_storage() | buffer_transfer_destination(), true,)
        // Eight bounded upload pages per in-flight slot replace the full-mesh GPU source
        // copy, so VRAM use is governed by the physical pool rather than
        // source-asset size.
        let page_staging_vertices = device.create_buffer(
            16_u64 * 64_u64 * 11_u64 * 4_u64,
            buffer_storage() | buffer_transfer_source(), true,)
        let page_staging_triangles = device.create_buffer(
            16_u64 * 126_u64 * 3_u64 * 4_u64,
            buffer_storage() | buffer_transfer_source(), true,)
        let mut initial_pages_uploaded =
        page_staging_vertices.available() && page_staging_triangles.available()
        resident_index = 0_usize
        while resident_index < clusters.len() {
            let resident = match cluster_resident.get(resident_index) {
                Option::Some(value) => value
                Option::None => false
            }
            if resident {
                let slot = match cluster_slots.get(resident_index) {
                    Option::Some(value) => value
                    Option::None => 0_u32
                }
                let vertex_offset = __borrowed_cluster_word(
                    clusters, resident_index, 0_usize,) as u64
                let vertex_count = __borrowed_cluster_word(
                    clusters, resident_index, 1_usize,) as u64
                let triangle_offset = __borrowed_cluster_word(
                    clusters, resident_index, 2_usize,) as u64
                let triangle_count = __borrowed_cluster_word(
                    clusters, resident_index, 3_usize,) as u64
                let initial_vertices = geometry_page_archive_vertices(
                    page_archive,(vertex_offset as usize) * 11_usize,
                    (vertex_count as usize) * 11_usize,)
                let initial_triangles = geometry_page_archive_triangles(
                    page_archive, triangle_offset as usize,
                    (triangle_count as usize) * 3_usize,)
                initial_pages_uploaded = vertices.write_f32s(
                    (slot as u64) * 64_u64 * 11_u64 * 4_u64,
                    initial_vertices,) &&
                triangles.write_u32s(
                    (slot as u64) * 126_u64 * 3_u64 * 4_u64,
                    initial_triangles,) &&
                initial_pages_uploaded
            }
            resident_index += 1_usize
        }
        let available=geometry.valid() && geometry_page_archive_available(page_archive) && vertices.available() && triangles.available() && initial_pages_uploaded
        ret VirtualGeometryResources<H>{page_cache,page_archive,vertices,triangles,page_staging_vertices,page_staging_triangles,clusters,hierarchy,cluster_lods,lod_roots,lod_budget,cluster_slots,cluster_resident,0_u64,1_u64,0_u64,0_u32,maximum_lod,object_radius,object_center,geometry,available,Vec[GpuCompletion]::new(),GpuCompletion::unavailable(),Vec[u32]::new()}
}

impl for GpuVirtualGeometry {
    pub fn is_ready(self: Self&) -> bool {
        ret self.available
    }

    // Methods keep the retained editor path on the same borrowed ABI as the
    // free-function implementation.
    pub fn error_message(self: Self&) -> str {
        ret gpu_virtual_geometry_error(self)
    }
    pub fn pipeline_for_mode(self: Self&, view_mode: u32) -> RenderPipeline {
        ret gpu_virtual_geometry_pipeline_for_mode(self, view_mode)
    }
    /// Fixed-detail rendering uses the same textured mesh path, refining to
    /// source leaves rather than losing material bindings in a fallback draw.
    pub fn set_autolod_enabled(self: mut Self&, enabled: bool) ->() {
        self.autolod_enabled = enabled
    }
    pub fn autolod_enabled(self: Self&) -> bool {
        ret self.autolod_enabled
    }

    pub fn set_target_error(self: mut Self&, value: f32) ->() {
        self.lod_curve = Vec[LodCurvePoint]::new()
        self.target_pixel_error = AutoLodSettings::bounded_error(value)
    }

    pub fn set_lod_group(self: mut Self&, group: LodGroup) -> bool {
        if !group.valid() {
            ret false
        }
        self.lod_curve = group.curve self.lod_smooth = group.interpolation.smooth()
        ret true
    }
    pub fn set_lod_projection(self: mut Self&, focal_y: f32, near: f32) ->() {
        self.lod_focal_y = if focal_y < 0 {
            - focal_y
        } else {
            focal_y
        }
        self.lod_near = near
    }
    pub fn set_shelter_texture(self: mut Self&, texture: GpuTexture) -> bool {
        if self.shelter_bound {
            ret false
        }
        self.shelter_texture = texture self.shelter_bound = true ret true
    }
    pub fn set_lights(self: mut Self&, values: Vec[f32]) ->() {
        self.light_values = values
    }
    pub fn record_debug(self: mut Self&, frame: RenderFrame,
        view_projection: Mat4, camera: Vec3,
        instances: Vec[VirtualGeometryInstance], maximum_distance: f32,
        light_direction: Vec3, light_color: Vec3, light_intensity: f32,
        indirect_ambient: Vec3, viewport_height: f32,
        view_mode: u32, primitive_id: u32,) -> bool {
        ret gpu_virtual_geometry_record_debug(self, frame, view_projection,
            camera, instances, maximum_distance, light_direction, light_color,
            light_intensity, indirect_ambient, viewport_height, view_mode,
            primitive_id,)
    }
    pub fn record_error(self: Self&) -> u32 {
        ret gpu_virtual_geometry_record_error(self)
    }
    pub fn draw_slot(self: Self&, pass: RenderPassEncoder,
        slot: usize, view_mode: u32,) -> bool {
        ret gpu_virtual_geometry_draw_slot(self, pass, slot, view_mode)
    }
    pub fn pipeline(self: Self&) -> RenderPipeline {
        ret gpu_virtual_geometry_pipeline(self)
    }
    pub fn cluster_count(self: Self&) -> usize {
        ret gpu_virtual_geometry_cluster_count(self)
    }
    pub fn triangle_count(self: Self&) -> usize {
        ret gpu_virtual_geometry_triangle_count(self)
    }
    pub fn resident_pages(self: Self&) -> usize {
        ret gpu_virtual_geometry_resident_pages(self)
    }
    pub fn page_capacity(self: Self&) -> usize {
        ret gpu_virtual_geometry_page_capacity(self)
    }
    pub fn traversal_instances(self: Self&) -> u32 {
        ret gpu_virtual_geometry_traversal_instances(self)
    }
    pub fn candidate_count(self: Self&) -> u32 {
        ret gpu_virtual_geometry_candidate_count(self)
    }
    pub fn post_candidate_count(self: Self&) -> u32 {
        ret gpu_virtual_geometry_post_candidate_count(self)
    }
    pub fn main_visible_count(self: Self&) -> u32 {
        ret gpu_virtual_geometry_main_visible_count(self)
    }
    pub fn post_visible_count(self: Self&) -> u32 {
        ret gpu_virtual_geometry_post_visible_count(self)
    }
    pub fn maximum_lod(self: Self&) -> u32 {
        ret gpu_virtual_geometry_maximum_lod(self)
    }

    pub fn create_from_mesh(device: GraphicsDevice, target: Swapchain,
        data: MeshData, maximum_instances: usize,
        gi_scene: GpuBuffer, gi_surfaces: GpuBuffer,
        gi_history: GpuBuffer,) -> GpuVirtualGeometry<H> {
        let data = data.with_uvs()
        let source_vertices = data.vertices()
        let stride =(data.stride() / 4_u32) as usize
        let geometry = prepare_mesh_geometry(data)
        let mut packed_vertices = Vec[f32]::new()
        for vertex in geometry.vertex_indices() {
            let base =(vertex as usize) * stride
            let mut component = 0_usize
            while component < 11_usize {
                match source_vertices.get(base + component) {
                    Option::Some(value) => {
                        packed_vertices.push(value)
                    }
                    Option::None => {
                        packed_vertices.push(if component == 8_usize {
                                1.0_f32
                            } else {
                                0.0_f32
                            }
                        )
                    }
                }
                component += 1_usize
            }
        }
        let mut white = Vec[u32]::new()
        white.push(4294967295_u32)
        ret GpuVirtualGeometry::create_textured(
            device, target, geometry, packed_vertices, maximum_instances,
            gi_scene, gi_surfaces, gi_history, white, 1_u32, 1_u32,)
    }
    pub fn create_from_mesh_textured(device: GraphicsDevice, target: Swapchain,
        data: MeshData, maximum_instances: usize,
        gi_scene: GpuBuffer, gi_surfaces: GpuBuffer, gi_history: GpuBuffer,
        texture_pixels: Vec[u32], texture_width: u32, texture_height: u32,) -> GpuVirtualGeometry<H> {
        ret GpuVirtualGeometry::create_from_mesh_textured_prepared(device, target, data,
            prepare_mesh_geometry(data), maximum_instances,
            gi_scene, gi_surfaces, gi_history, texture_pixels, texture_width, texture_height,)
    }
    /// Uses the validated cluster hierarchy stored in a native mesh asset.
    pub fn create_from_mesh_textured_prepared(device: GraphicsDevice, target: Swapchain,
        data: MeshData, geometry: VirtualGeometry, maximum_instances: usize,
        gi_scene: GpuBuffer, gi_surfaces: GpuBuffer, gi_history: GpuBuffer,
        texture_pixels: Vec[u32], texture_width: u32, texture_height: u32,) -> GpuVirtualGeometry<H> {
        let data = data.with_uvs()
        let source_vertices = data.vertices()
        let stride =(data.stride() / 4) as usize
        let mut packed_vertices = Vec[f32]::new()
        for vertex in geometry.vertex_indices() {
            let base =(vertex as usize) * stride
            let mut component = 0_usize
            while component < 11_usize {
                packed_vertices.push(match source_vertices.get(base + component) {
                        Option::Some(value) => value
                        Option::None => if component == 8_usize {
                            1.0_f32
                        } else {
                            0.0_f32
                        }
                    }
                )
                component += 1_usize
            }
        }
        ret GpuVirtualGeometry::create_textured(device, target, geometry, packed_vertices,
            maximum_instances, gi_scene, gi_surfaces, gi_history,
            texture_pixels, texture_width, texture_height,)
    }
    pub fn create(device: GraphicsDevice, target: Swapchain,
        geometry: VirtualGeometry, packed_vertices: Vec[f32],
        maximum_instances: usize,
        gi_scene: GpuBuffer, gi_surfaces: GpuBuffer,
        gi_history: GpuBuffer,) -> GpuVirtualGeometry<H> {
        let mut expanded = Vec[f32]::new()
        let mut base = 0_usize
        while base < packed_vertices.len() {
            let mut component = 0_usize
            while component < 9_usize {
                expanded.push(__borrowed_f32_at(packed_vertices, base + component))
                component += 1_usize
            }
            expanded.push(0.0_f32) expanded.push(0.0_f32)
            base += 9_usize
        }
        let mut white = Vec[u32]::new()
        white.push(4294967295_u32)
        ret GpuVirtualGeometry::create_textured(device, target, geometry, expanded,
            maximum_instances, gi_scene, gi_surfaces, gi_history, white, 1_u32, 1_u32,)
    }
    pub fn create_textured(device: GraphicsDevice, target: Swapchain,
        geometry: VirtualGeometry, packed_vertices: Vec[f32], maximum_instances: usize,
        gi_scene: GpuBuffer, gi_surfaces: GpuBuffer, gi_history: GpuBuffer,
        texture_pixels: Vec[u32], texture_width: u32, texture_height: u32,) -> GpuVirtualGeometry<H> {
        ret Self::create_textured_view(device,target,geometry,packed_vertices,maximum_instances,gi_scene,gi_surfaces,gi_history,texture_pixels,texture_width,texture_height,Option[VirtualGeometryResources<H>]::None,Option[SkinGpuSection<H>]::None)
    }
    fn create_textured_view(device: GraphicsDevice,target: Swapchain,geometry: VirtualGeometry,packed_vertices: Vec[f32],maximum_instances: usize,gi_scene: GpuBuffer,gi_surfaces: GpuBuffer,gi_history: GpuBuffer,texture_pixels: Vec[u32],texture_width: u32,texture_height: u32,shared: Option[VirtualGeometryResources<H>],skin: Option[SkinGpuSection<H>]) -> GpuVirtualGeometry<H> {
        let owns_resources=shared.is_none()
        let resources=match shared {Some(resources)=>resources None=>create_virtual_geometry_resources(device,geometry,packed_vertices)}
        let page_cache=resources.page_cache
        let page_archive=resources.page_archive
        let vertices=resources.vertices
        let triangles=resources.triangles
        let page_staging_vertices=resources.page_staging_vertices
        let page_staging_triangles=resources.page_staging_triangles
        let clusters=resources.clusters
        let hierarchy=resources.hierarchy
        let cluster_lods=resources.cluster_lods
        let lod_roots=resources.lod_roots
        let lod_budget=resources.lod_budget
        let cluster_slots=resources.cluster_slots
        let cluster_resident=resources.cluster_resident
        let frame_index=resources.frame_index
        let residency_version=resources.residency_version
        let resident_mask_version=resources.resident_mask_version
        let resident_mask=resources.resident_mask
        let maximum_lod=resources.maximum_lod
        let object_radius=resources.object_radius
        let object_center=resources.object_center
        let lods=geometry.lods()
        let root_error=if geometry.root_node() as usize<hierarchy.len(){hierarchy.get_unchecked_borrowed(geometry.root_node() as usize).geometric_error()}else{0_f32}
        let maximum_candidates=clusters.len()*maximum_instances
        let stream_words=64_usize+clusters.len()*16_usize+hierarchy.len()*12_usize+maximum_instances*28_usize+maximum_candidates*4_usize+clusters.len()+6134_usize+10_usize
        let initial_pages_uploaded=resources.available
        let safe_texture_width = if texture_width > 0_u32 {
            texture_width
        } else {
            1_u32
        }
        let safe_texture_height = if texture_height > 0_u32 {
            texture_height
        } else {
            1_u32
        }
        let texture_bytes =(safe_texture_width as u64) *(safe_texture_height as u64) * 4_u64
        let texture_staging = device.create_buffer(texture_bytes, buffer_transfer_source(), true)
        let texture = device.create_texture_2d(safe_texture_width, safe_texture_height, 1_u32,
            if skin.is_some(){format_rgba8_srgb()}else{format_rgba8_unorm()}, texture_sampled() | texture_transfer_destination(),)
        let texture_encoder = device.create_encoder()
        let texture_uploaded = texture_pixels.len() ==
        (safe_texture_width as usize) *(safe_texture_height as usize) &&
        texture_staging.write_u32s(0_u64, texture_pixels) && texture.available() &&
        texture_encoder.available() &&
        texture_encoder.transition_texture(texture, texture_layout_transfer_destination()) &&
        texture_encoder.copy_buffer_to_texture(texture_staging, texture,
            safe_texture_width, safe_texture_height, 0_u32,) &&
        texture_encoder.transition_texture(texture, texture_layout_shader_read()) &&
        texture_encoder.submit_and_wait()
        texture_encoder.destroy()
        texture_staging.destroy()
        let normal_upload = TextureUpload::begin_linear(device, TextureImage {
                1, 1, vec![4294934656_u32]
            }
            ,
        )
        let normal_texture = match normal_upload {
            Option::Some(upload) => {
                upload.wait()
                upload.finish()
            }
            Option::None => GpuTexture::unavailable()
        }
        let sampler = device.create_repeat_sampler()
        let mut entries = Vec[BindGroupLayoutEntry]::new()
        entries.push(BindGroupLayoutEntry::storage(0_u32,
                shader_stage_compute() | shader_stage_mesh(),))
        entries.push(BindGroupLayoutEntry::storage(1_u32, shader_stage_mesh() | shader_stage_compute()))
        entries.push(BindGroupLayoutEntry::storage(2_u32, shader_stage_mesh()))
        entries.push(BindGroupLayoutEntry::storage(3_u32, shader_stage_fragment()))
        entries.push(BindGroupLayoutEntry::storage(4_u32, shader_stage_fragment()))
        entries.push(BindGroupLayoutEntry::storage(5_u32, shader_stage_fragment()))
        entries.push(BindGroupLayoutEntry::texture_sampler(6_u32, shader_stage_fragment()))
        entries.push(BindGroupLayoutEntry::texture_sampler(7_u32, shader_stage_fragment()))
        entries.push(BindGroupLayoutEntry::texture_sampler(11_u32, shader_stage_fragment()))
        entries.push(BindGroupLayoutEntry::storage(8_u32, shader_stage_fragment()))
        entries.push(BindGroupLayoutEntry::storage(9_u32, shader_stage_mesh()))
        entries.push(BindGroupLayoutEntry::storage(10_u32, shader_stage_compute() | shader_stage_mesh()))
        if skin.is_some(){for binding in 12_usize..18_usize{let stages=if binding==12_usize{shader_stage_mesh()}elif binding==13_usize{shader_stage_compute()|shader_stage_mesh()}else{shader_stage_compute()} entries.push(BindGroupLayoutEntry::storage(binding as u32,stages))}}
        let layout = device.create_bind_group_layout(entries)
        let frame_count = target.frames_in_flight() as usize
        let lod_history = device.create_buffer((maximum_instances * 16_usize) as u64, buffer_storage(), true)
        let mut empty_lod_history = Vec[u32]::new()
        for i in 0..maximum_instances * 4_usize {
            empty_lod_history.push(0_u32)
        }
        lod_history.write_u32s(0, empty_lod_history)
        let mut streams = Vec[GpuBuffer]::new()
        let mut groups = Vec[BindGroup]::new()
        let mut light_buffers = Vec[GpuBuffer]::new()
        let mut temporal_buffers = Vec[GpuBuffer]::new()
        let mut slot_frames = Vec[u64]::new()
        let mut metadata_versions = Vec[u64]::new()
        let mut metadata_modes = Vec[u32]::new()
        let mut metadata_primitives = Vec[u32]::new()
        let mut stream_resources = frame_count > 0_usize
        let mut empty_lights = Vec[f32]::new()
        while empty_lights.len() < 3140_usize {
            empty_lights.push(0.0_f32)
        }
        let mut frame_slot = 0_usize
        while frame_slot < frame_count {
            let stream = device.create_buffer((stream_words as u64) * 4_u64,
                buffer_storage() | buffer_indirect() | buffer_transfer_destination(), true,)
            let light_buffer = device.create_buffer(12560_u64, buffer_storage(), true)
            light_buffer.write_f32s(0_u64, empty_lights)
            light_buffers.push(light_buffer)
            let temporal_buffer = device.create_buffer((64_usize + maximum_instances * 80_usize) as u64, buffer_storage(), true)
            temporal_buffers.push(temporal_buffer)
            let mut bindings = Vec[u32]::new()
            bindings.push(0_u32) bindings.push(1_u32) bindings.push(2_u32)
            bindings.push(3_u32) bindings.push(4_u32) bindings.push(5_u32) bindings.push(8_u32) bindings.push(9_u32) bindings.push(10_u32)
            let mut buffers = Vec[GpuBuffer]::new()
            buffers.push(stream) buffers.push(vertices) buffers.push(triangles)
            buffers.push(gi_scene) buffers.push(gi_surfaces) buffers.push(gi_history) buffers.push(light_buffer) buffers.push(temporal_buffer) buffers.push(lod_history)
            let mut offsets = Vec[u64]::new()
            offsets.push(0_u64) offsets.push(0_u64) offsets.push(0_u64)
            offsets.push(0_u64) offsets.push(0_u64) offsets.push(0_u64) offsets.push(0_u64) offsets.push(0_u64) offsets.push(0_u64)
            let mut ranges = Vec[u64]::new()
            ranges.push(stream.size()) ranges.push(vertices.size()) ranges.push(triangles.size())
            ranges.push(gi_scene.size()) ranges.push(gi_surfaces.size()) ranges.push(gi_history.size()) ranges.push(light_buffer.size()) ranges.push(temporal_buffer.size()) ranges.push(lod_history.size())
            match skin{Some(binding)=>{binding.append_bindings(bindings,buffers,offsets,ranges)}None=>{}}
            let group = device.create_buffer_textures_bind_group_many(
                layout, bindings, buffers, offsets, ranges, vec![6_u32, 7_u32, 11_u32],
                vec![texture, normal_texture, texture], vec![sampler, sampler, sampler],)
            stream_resources = stream_resources &&
            stream.available() && group.available()
            streams.push(stream)
            groups.push(group)
            slot_frames.push(0_u64)
            metadata_versions.push(0_u64)
            metadata_modes.push(0_u32)
            metadata_primitives.push(0_u32)
            frame_slot += 1_usize
        }
        let cull_shader = device.create_shader_module(
            if skin.is_some(){animation_spirv(3_u32)}else{virtual_scene_cull_spirv()}, shader_stage_compute(),)
        let cull_pipeline = device.create_compute_pipeline(cull_shader, layout)
        let post_cull_shader = device.create_shader_module(
            if skin.is_some(){animation_spirv(4_u32)}else{virtual_scene_post_cull_spirv()}, shader_stage_compute(),)
        let post_cull_pipeline = device.create_compute_pipeline(
            post_cull_shader, layout,)
        let mesh_shader = device.create_shader_module(
            if skin.is_some(){animation_spirv(5_u32)}else{virtual_scene_mesh_spirv()}, shader_stage_mesh(),)
        let fragment_shader = device.create_shader_module(
            virtual_scene_fragment_spirv(), shader_stage_fragment(),)
        // The barycentric shader is optional. The regular diagnostic fragment
        // shader remains the portable fallback when the adapter did not enable
        // VK_KHR_fragment_shader_barycentric.
        let triangle_debug_shader = device.create_shader_module(
            virtual_scene_triangle_spirv(), shader_stage_fragment(),)
        let render_pipeline = device.create_mesh_pipeline_with_bind_group(
            target, mesh_shader, fragment_shader, layout,)
        let triangle_debug_pipeline = device.create_mesh_pipeline_with_bind_group(
            target, mesh_shader, triangle_debug_shader, layout,)
        let overdraw_pipeline = device.create_mesh_pipeline_with_options(
            target, mesh_shader, fragment_shader, layout,
            RenderPipelineOptions::depth()
            .with_depth_test(false)
            .with_depth_write(false)
            .with_additive_blending()
            .with_color_load(false),)
        let request_shader=if skin.is_some(){device.create_shader_module(animation_spirv(2_u32),shader_stage_compute())}else{ShaderModule::unavailable()}
        let cache_dispatch_shader=if skin.is_some(){device.create_shader_module(animation_spirv(8_u32),shader_stage_compute())}else{ShaderModule::unavailable()}
        let request_pipeline=if skin.is_some(){device.create_compute_pipeline(request_shader,layout)}else{ComputePipeline::unavailable()}
        let cache_dispatch_pipeline=if skin.is_some(){device.create_compute_pipeline(cache_dispatch_shader,layout)}else{ComputePipeline::unavailable()}
        let dispatch_shader = device.create_shader_module(virtual_scene_dispatch_spirv(), shader_stage_compute())
        let dispatch_pipeline = device.create_compute_pipeline(dispatch_shader, layout)
        let skin_available=match skin{Some(binding)=>binding.matches(clusters.len(),hierarchy.len(),maximum_instances) && request_shader.available() && request_pipeline.available() && cache_dispatch_shader.available() && cache_dispatch_pipeline.available() None=>true}
        let available = skin_available && dispatch_shader.available() && dispatch_pipeline.available() && geometry.valid() && clusters.len() > 0_usize &&
        maximum_instances > 0_usize && maximum_candidates <= 4294967295_usize &&
        geometry_page_archive_available(page_archive) &&
        stream_resources && vertices.available() && triangles.available() &&
        texture_uploaded && texture.available() && normal_texture.available() && sampler.available() &&
        page_staging_vertices.available() && page_staging_triangles.available() &&
        initial_pages_uploaded &&
        layout.available() && cull_shader.available() &&
        cull_pipeline.available() && post_cull_shader.available() &&
        post_cull_pipeline.available() && mesh_shader.available() &&
        fragment_shader.available() && render_pipeline.available() &&
        overdraw_pipeline.available()
        println("VG ready=" + Debug::fmt(available) +
            " clusters=" + Debug::fmt(clusters.len()) +
            " levels=" + Debug::fmt(lods.len()) +
            " root_error=" + Debug::fmt(root_error) +
            " archive=" + Debug::fmt(geometry_page_archive_available(page_archive)) +
            " texture=" + Debug::fmt(safe_texture_width) + "x" + Debug::fmt(safe_texture_height))
        ret GpuVirtualGeometry<H> {
            resources,
            skin,
            layout,
            groups,
            light_buffers,
            Vec[f32]::new(),
            temporal_buffers,
            lod_history,
            Mat4::identity(),
            0_u32,
            "",
            "",
            Vec[Vec[u32]]::new(),
            cull_shader,
            cull_pipeline,
            post_cull_shader,
            post_cull_pipeline,
            dispatch_shader,
            dispatch_pipeline,
            mesh_shader,
            fragment_shader,
            triangle_debug_shader,
            render_pipeline,
            triangle_debug_pipeline,
            overdraw_pipeline,
            streams,
            texture,
            normal_texture,
            texture,
            false,
            sampler,
            vec![gi_scene, gi_surfaces, gi_history],
            false,
            Vec[LodCurvePoint]::new(),
            slot_frames,
            metadata_versions,
            metadata_modes,
            metadata_primitives,
            0_usize,
            0_u64,
            1.0_f32,
            true,
            0.0_f32,
            0.1_f32,
            maximum_instances,
            0_u32,
            0_u32,
            0_u32,
            0_u32,
            0_u32,
            0_u32,
            0_u32,
            0_u32,
            available,
            owns_resources,
            Vec[GpuCompletion]::new(),
            GpuCompletion::unavailable(),
            request_shader,
            request_pipeline,
            cache_dispatch_shader,
            cache_dispatch_pipeline,
            0_u64,
            false,
            false,
            Vec[RetiredVirtualPipelines]::new()
        }
    }
}

/// Creates independent replacement sets; callers retire old sets after consumer fences.
pub fn gpu_virtual_geometry_texture_groups(self: GpuVirtualGeometry&, device: GraphicsDevice,
    texture: GpuTexture, normal: GpuTexture, sampler: GpuSampler,) -> Vec[BindGroup] {
    let mut groups = Vec[BindGroup]::new()
    let mut slot = 0_usize
    for stream in self.streams {
        let mut buffers = vec![stream, self.resources.vertices, self.resources.triangles]
        for buffer in self.gi_buffers {
            buffers.push(buffer)
        }
        let mut bindings = Vec[u32]::new()
        let mut offsets = Vec[u64]::new()
        let mut ranges = Vec[u64]::new()
        for index in 0..buffers.len() {
            bindings.push(index as u32) offsets.push(0)
            ranges.push(buffers.get(index).unwrap_or(GpuBuffer::unavailable()).size())
        }
        let light_buffer = self.light_buffers.get(slot).unwrap_or(GpuBuffer::unavailable())
        bindings.push(8_u32) buffers.push(light_buffer) offsets.push(0_u64) ranges.push(light_buffer.size())
        let temporal_buffer = self.temporal_buffers.get(slot).unwrap_or(GpuBuffer::unavailable())
        bindings.push(9_u32) buffers.push(temporal_buffer) offsets.push(0_u64) ranges.push(temporal_buffer.size())
        bindings.push(10_u32) buffers.push(self.lod_history) offsets.push(0_u64) ranges.push(self.lod_history.size())
        let selected = if texture.available() {
            texture
        } else {
            self.texture
        }
        let selected_normal = if normal.available() {
            normal
        } else {
            self.normal_texture
        }
        match self.skin{Some(binding)=>{binding.append_bindings(bindings,buffers,offsets,ranges)}None=>{}}
        let group = device.create_buffer_textures_bind_group_many(
            self.layout, bindings, buffers, offsets, ranges, vec![6_u32, 7_u32, 11_u32],
            vec![selected, selected_normal, self.shelter_texture], vec![sampler, sampler, sampler],)
        if !group.available() {
            group.destroy()
            for previous in groups {
                previous.destroy()
            }
            ret Vec[BindGroup]::new()
        }
        groups.push(group)
        slot += 1_usize
    }
    ret groups
}

pub fn gpu_virtual_geometry_replace_texture_groups(self: mut GpuVirtualGeometry&, groups: Vec[BindGroup]) -> Vec[BindGroup] {
    let previous = self.groups self.groups = groups ret previous
}

pub fn gpu_virtual_geometry_available(
    self: GpuVirtualGeometry&,) -> bool {
    ret self.available
}

pub fn gpu_virtual_geometry_error(
    self: GpuVirtualGeometry&,) -> str {
    if !self.layout.available() {
        ret self.layout.error()
    }
    if !self.cull_shader.available() {
        ret self.cull_shader.error()
    }
    if !self.cull_pipeline.available() {
        ret self.cull_pipeline.error()
    }
    if !self.mesh_shader.available() {
        ret self.mesh_shader.error()
    }
    if !self.fragment_shader.available() {
        ret self.fragment_shader.error()
    }
    if !self.render_pipeline.available() {
        ret self.render_pipeline.error()
    }
    if !self.overdraw_pipeline.available() {
        ret self.overdraw_pipeline.error()
    }
    if !self.resources.vertices.available() {
        ret self.resources.vertices.error()
    }
    if !self.resources.triangles.available() {
        ret self.resources.triangles.error()
    }
    ret "Virtual geometry resource initialization failed"
}

pub fn gpu_virtual_geometry_pipeline(
    self: GpuVirtualGeometry&,) -> RenderPipeline {
    ret self.render_pipeline
}

pub fn gpu_virtual_geometry_pipeline_for_mode(
    self: GpuVirtualGeometry&, view_mode: u32,) -> RenderPipeline {
    ret if view_mode == 3_u32 && self.triangle_debug_pipeline.available() {
        self.triangle_debug_pipeline
    } elif view_mode == 10_u32 {
        self.overdraw_pipeline
    } else {
        self.render_pipeline
    }
}

pub fn gpu_virtual_geometry_triangle_debug_available(
    self: GpuVirtualGeometry&,) -> bool {
    ret self.triangle_debug_pipeline.available()
}

pub fn gpu_virtual_geometry_resident_pages(
    self: GpuVirtualGeometry&,) -> usize {
    ret geometry_page_pool_resident_count(
        self.resources.page_cache,)
}

pub fn gpu_virtual_geometry_page_capacity(
    self: GpuVirtualGeometry&,) -> usize {
    ret geometry_page_pool_capacity(
        self.resources.page_cache,)
}

/// Fixed GPU upload-ring footprint. This remains independent of source mesh
/// size; detailed source pages live in host/archive memory until requested.
pub fn gpu_virtual_geometry_staging_bytes(
    self: GpuVirtualGeometry&,) -> u64 {
    ret self.resources.page_staging_vertices.size() +
    self.resources.page_staging_triangles.size()
}

pub fn gpu_virtual_geometry_archive_bytes(
    self: GpuVirtualGeometry&,) -> usize {
    ret geometry_page_archive_bytes(self.resources.page_archive)
}

pub fn gpu_virtual_geometry_traversal_instances(
    self: GpuVirtualGeometry&,) -> u32 {
    ret self.active_traversal_instances
}

pub fn gpu_virtual_geometry_cluster_count(
    self: GpuVirtualGeometry&,) -> usize {
    ret self.resources.clusters.len()
}

pub fn gpu_virtual_geometry_triangle_count(
    self: GpuVirtualGeometry&,) -> usize {
    let mut triangles = 0_usize
    for cluster in self.resources.clusters {
        triangles += cluster.triangle_count()
    }
    ret triangles
}

pub fn gpu_virtual_geometry_maximum_lod(
    self: GpuVirtualGeometry&,) -> u32 {
    ret self.resources.maximum_lod
}

/// LOD selected by the completed GPU traversal, including residency fallback.
pub fn gpu_virtual_geometry_selected_lod(
    self: GpuVirtualGeometry&,) -> u32 {
    let maximum_candidates = self.resources.clusters.len() * self.maximum_instances
    let feedback_base = 64_usize + self.resources.clusters.len() * 16_usize +
    self.resources.hierarchy.len() * 12_usize +
    self.maximum_instances * 28_usize + maximum_candidates * 4_usize
    let indirect_base = feedback_base + self.resources.clusters.len() +
    3067_usize * 2_usize
    let stream = __borrowed_gpu_buffer_at(self.streams, self.active_slot)
    if !stream.available() {
        ret self.resources.maximum_lod
    }
    ret stream.read_u32((indirect_base as u64) * 4_u64 + 24_u64,)
}

pub fn gpu_virtual_geometry_selected_triangle_count(
    self: GpuVirtualGeometry&,) -> usize {
    let maximum_candidates = self.resources.clusters.len() * self.maximum_instances
    let hierarchy_base = 64_usize + self.resources.clusters.len() * 16_usize
    let instance_base = hierarchy_base + self.resources.hierarchy.len() * 12_usize
    let visible_base = instance_base + self.maximum_instances * 28_usize
    let feedback_base = instance_base + self.maximum_instances * 28_usize +
    maximum_candidates * 4_usize
    let indirect_base = feedback_base + self.resources.clusters.len() + 3067_usize * 2_usize
    let stream = __borrowed_gpu_buffer_at(self.streams, self.active_slot)
    if !stream.available() {
        ret 0_usize
    }
    let visible_count = stream.read_u32((indirect_base as u64) * 4_u64)
    let mut triangles = 0_usize
    let mut index = 0_u32
    while index < visible_count && index < maximum_candidates as u32 {
        let cluster_index = stream.read_u32(
            ((visible_base +(index as usize) * 2_usize) as u64) * 4_u64,)
        if cluster_index as usize < self.resources.clusters.len() {
            triangles += __borrowed_cluster_word(
                self.resources.clusters, cluster_index as usize, 3_usize,)
        }
        index += 1_u32
    }
    ret triangles
}

/// Average requested ratio for this asset's instances, as evaluated by the GPU.
pub fn gpu_virtual_geometry_target_ratio(self: GpuVirtualGeometry&) -> f32 {
    if self.active_traversal_instances == 0 {
        ret 0.0_f32
    }
    let mut sum = 0.0_f32
    let count = self.active_traversal_instances as usize
    for index in 0_usize..count {
        sum += self.lod_history.read_f32((index as u64) * 16_u64 + 8_u64)
    }
    ret sum /(self.active_traversal_instances as f32)
}
pub fn gpu_virtual_geometry_minimum_ratio(self: GpuVirtualGeometry&) -> f32 {
    ret if self.resources.lod_budget.source_triangles > 0 {
        (self.resources.lod_budget.minimum_triangles as f32) /(self.resources.lod_budget.source_triangles as f32)
    } else {
        1.0_f32
    }
}

pub fn gpu_virtual_geometry_candidate_count(
    self: GpuVirtualGeometry&,) -> u32 {
    ret self.active_candidates
}

pub fn gpu_virtual_geometry_post_candidate_count(
    self: GpuVirtualGeometry&,) -> u32 {
    let stream = __borrowed_gpu_buffer_at(self.streams, self.active_slot)
    if !stream.available() {
        ret 0_u32
    }
    ret stream.read_u32(self.active_indirect_offset + 12_u64)
}

pub fn gpu_virtual_geometry_main_visible_count(
    self: GpuVirtualGeometry&,) -> u32 {
    let stream = __borrowed_gpu_buffer_at(self.streams, self.active_slot)
    if !stream.available() {
        ret 0_u32
    }
    ret stream.read_u32(self.active_indirect_offset + 16_u64)
}

pub fn gpu_virtual_geometry_post_visible_count(
    self: GpuVirtualGeometry&,) -> u32 {
    let stream = __borrowed_gpu_buffer_at(self.streams, self.active_slot)
    if !stream.available() {
        ret 0_u32
    }
    ret stream.read_u32(self.active_indirect_offset + 20_u64)
}

/// Reads completed per-slot GPU counters without relying on the mutable host
/// telemetry mirror. The returned words are Main-visible, Post-visible and
/// Post-candidate maxima respectively.
pub fn gpu_virtual_geometry_occlusion_counts(
    self: GpuVirtualGeometry&,) -> Vec[u32] {
    let maximum_candidates = self.resources.clusters.len() * self.maximum_instances
    let feedback_base = 64_usize + self.resources.clusters.len() * 16_usize +
    self.resources.hierarchy.len() * 12_usize +
    self.maximum_instances * 28_usize + maximum_candidates * 4_usize
    let indirect_base = feedback_base + self.resources.clusters.len() +
    3067_usize * 2_usize
    let mut main_visible = 0_u32
    let mut post_visible = 0_u32
    let mut post_candidates = 0_u32
    let mut slot = 0_usize
    while slot < __borrowed_gpu_buffer_len(self.streams) {
        let stream = __borrowed_gpu_buffer_at(self.streams, slot)
        let slot_post_candidates = stream.read_u32(
            (indirect_base as u64) * 4_u64 + 12_u64,)
        let slot_main_visible = stream.read_u32(
            (indirect_base as u64) * 4_u64 + 16_u64,)
        let slot_post_visible = stream.read_u32(
            (indirect_base as u64) * 4_u64 + 20_u64,)
        if slot_main_visible > main_visible {
            main_visible = slot_main_visible
        }
        if slot_post_visible > post_visible {
            post_visible = slot_post_visible
        }
        if slot_post_candidates > post_candidates {
            post_candidates = slot_post_candidates
        }
        slot += 1_usize
    }
    let mut result = Vec[u32]::new()
    result.push(main_visible)
    result.push(post_visible)
    result.push(post_candidates)
    ret result
}

pub fn gpu_virtual_geometry_record_error(
    self: GpuVirtualGeometry&,) -> u32 {
    ret self.last_record_error
}

pub fn gpu_virtual_geometry_set_view_mode(
    self: mut GpuVirtualGeometry&, view_mode: u32, primitive_id: u32,) ->() {
    self.view_mode = if view_mode <= 11_u32 {
        view_mode
    } else {
        0_u32
    }
    self.primitive_id = primitive_id
    ret()
}

pub fn gpu_virtual_geometry_apply_view_mode(
    self: GpuVirtualGeometry&, view_mode: u32,) -> bool {
    let stream = match self.streams.get(self.active_slot) {
        Option::Some(value) => value
        Option::None => GpuBuffer::unavailable()
    }
    ret stream.available() && stream.write_u32(
        12_u64, if view_mode <= 11_u32 {
            view_mode
        } else {
            0_u32
        }
        ,)
}

pub fn gpu_virtual_geometry_record(
    self: mut GpuVirtualGeometry&, frame: RenderFrame,
    view_projection: Mat4, camera: Vec3,
    instances: Vec[VirtualGeometryInstance],
    maximum_distance: f32, light_direction: Vec3,
    light_color: Vec3, light_intensity: f32,
    indirect_ambient: Vec3, viewport_height: f32,) -> bool {
    ret gpu_virtual_geometry_record_debug(
        self, frame, view_projection, camera, instances,
        maximum_distance, light_direction, light_color, light_intensity,
        indirect_ambient, viewport_height, 0_u32, 0_u32,)
}

pub fn gpu_virtual_geometry_record_debug(
    self: mut GpuVirtualGeometry&, frame: RenderFrame,
    view_projection: Mat4, camera: Vec3,
    instances: Vec[VirtualGeometryInstance],
    maximum_distance: f32, light_direction: Vec3,
    light_color: Vec3, light_intensity: f32,
    indirect_ambient: Vec3, viewport_height: f32,
    view_mode: u32, primitive_id: u32,) -> bool {
    if !self.available || !frame.available() ||
    instances.len() == 0_usize || instances.len() > self.maximum_instances {
        println("VG record fail 1 avail=" + Debug::fmt(self.available) +
            " frame=" + Debug::fmt(frame.available()) +
            " instances=" + Debug::fmt(instances.len()))
        ret false
    }
    collect_virtual_pipelines(self.retired_pipelines)
    if !reconcile_virtual_page_uploads(self.resources,frame){ret false}
    // Retain before recording even the first streaming transfer. Partial failures
    // may still be submitted by a caller destroying its frame wrapper.
    if !retain_virtual_geometry_use(self.uses,frame) || !retain_virtual_geometry_use(self.resources.uses,frame){ret false}
    if self.record_completion.available(){
        if self.record_completion.status()==GpuCompletionStatus::Cancelled{
            for i in 0_usize..self.slot_frames.len(){__borrowed_u64_set(self.slot_frames,i,0_u64) __borrowed_u64_set(self.metadata_versions,i,0_u64)}
            self.skin_has_frame=false
        }
        self.record_completion.destroy()
    }
    self.record_completion=frame.completion()
    let slot = frame.slot() as usize
    let stream = match self.streams.get(slot) {
        Option::Some(value) => value
        Option::None => GpuBuffer::unavailable()
    }
    let light_buffer = self.light_buffers.get(slot).unwrap_or(GpuBuffer::unavailable())
    if self.light_values.len() == 3140_usize {
        light_buffer.write_f32s(0_u64, self.light_values)
    }
    let group = match self.groups.get(slot) {
        Option::Some(value) => value
        Option::None => BindGroup::unavailable()
    }
    if !stream.available() || !group.available() {
        println("VG record fail 2 stream=" + Debug::fmt(stream.available()) +
            " group=" + Debug::fmt(group.available()))
        ret false
    }
    let slot_frame = match self.slot_frames.get(slot) {
        Option::Some(value) => value
        Option::None => 0_u64
    }
    let candidate_count = self.resources.clusters.len() * instances.len()
    if candidate_count == 0_usize || candidate_count > 4294967295_usize {
        println("VG record fail 3 candidates=" + Debug::fmt(candidate_count))
        ret false
    }
    let maximum_candidates = self.resources.clusters.len() * self.maximum_instances
    let feedback_base = 64_usize + self.resources.clusters.len() * 16_usize +
    self.resources.hierarchy.len() * 12_usize +
    self.maximum_instances * 28_usize + maximum_candidates * 4_usize
    let hiz_base = feedback_base + self.resources.clusters.len()
    let indirect_base = hiz_base + 3067_usize * 2_usize
    let mut streaming_uploaded = true
    if slot_frame > 0_u64 && geometry_page_pool_capacity(self.resources.page_cache) < self.resources.clusters.len() {
        // Fully resident meshes cannot evict: feedback/LRU scans are unnecessary.
        // Bound uploads per frame to avoid camera-motion stalls. Visible
        // resident pages are still touched so the fixed pool evicts cold
        // detail instead of cycling by original upload order.
        let mut uploaded_pages = 0_usize
        let mut page = 0_usize
        while page < self.resources.clusters.len() {
            let feedback_priority = stream.read_u32(
                ((feedback_base + page) as u64) * 4_u64,)
            let already_resident = match self.resources.cluster_resident.get(page) {
                Option::Some(value) => value
                Option::None => false
            }
            if feedback_priority != 0_u32 &&
            (already_resident || uploaded_pages < 8_usize) {
                let lod = match self.resources.cluster_lods.get(page) {
                    Option::Some(value) => value
                    Option::None => self.resources.maximum_lod
                }
                let priority = if lod == self.resources.maximum_lod {
                    4294967295_u32
                } else {
                    feedback_priority
                }
                let allocation = geometry_page_pool_request(
                    self.resources.page_cache,
                    1_u64, page as u32, self.resources.frame_index, priority,)
                if allocation.evicted() ||(allocation.resident() && !already_resident) {
                    self.resources.residency_version += 1_u64
                }
                if allocation.evicted() &&
                allocation.evicted_asset() == 1_u64 {
                    __borrowed_bool_set(self.resources.cluster_resident,
                        allocation.evicted_page() as usize, false,)
                }
                if allocation.resident() {
                    __borrowed_u32_set(self.resources.cluster_slots, page,
                        allocation.slot(),)
                    __borrowed_bool_set(self.resources.cluster_resident, page, true)
                }
                if allocation.resident() && !already_resident {
                    let vertex_offset = __borrowed_cluster_word(
                        self.resources.clusters, page, 0_usize,) as u64
                    let vertex_count = __borrowed_cluster_word(
                        self.resources.clusters, page, 1_usize,) as u64
                    let triangle_offset = __borrowed_cluster_word(
                        self.resources.clusters, page, 2_usize,) as u64
                    let triangle_count = __borrowed_cluster_word(
                        self.resources.clusters, page, 3_usize,) as u64
                    let prefetched = geometry_page_archive_prefetch(
                        self.resources.page_archive,
                        (vertex_offset as usize) * 11_usize,
                        (vertex_count as usize) * 11_usize,
                        triangle_offset as usize,
                        (triangle_count as usize) * 3_usize,)
                    let staged_vertices = geometry_page_archive_vertices(
                        self.resources.page_archive,
                        (vertex_offset as usize) * 11_usize,
                        (vertex_count as usize) * 11_usize,)
                    let staged_triangles = geometry_page_archive_triangles(
                        self.resources.page_archive, triangle_offset as usize,
                        (triangle_count as usize) * 3_usize,)
                    if !self.resources.page_producer.available(){self.resources.page_producer=frame.completion()}
                    self.resources.pending_pages.push(page as u32)
                    let page_uploaded=prefetched && frame.update_f32s(self.resources.vertices,(allocation.slot() as u64)*64_u64*11_u64*4_u64,staged_vertices) && frame.update_u32s(self.resources.triangles,(allocation.slot() as u64)*126_u64*3_u64*4_u64,staged_triangles)
                    if !page_uploaded{__borrowed_bool_set(self.resources.cluster_resident,page,false) self.resources.residency_version+=1_u64}
                    streaming_uploaded = page_uploaded && streaming_uploaded
                    if page_uploaded {
                        uploaded_pages += 1_usize
                    }
                }
            }
            page += 1_usize
        }
    }
    if !streaming_uploaded {
        println("VG record fail 4")
        ret false
    }
    if self.skin.is_some(){
        let mut binding=match self.skin{Some(binding)=>binding None=>{ret false}}
        let logical=binding.frame()
        if !self.skin_has_frame || logical!=self.skin_frame{self.skin_view_history=self.skin_has_frame && logical==self.skin_frame+1_u64 self.skin_frame=logical self.skin_has_frame=true}
        if binding.record_bounds(frame,self.skin_view_history).is_err(){ret false}
    }
    let next_slot_frame = slot_frame + 1_u64
    let current_hiz =(next_slot_frame & 1_u64) as usize
    if self.resources.resident_mask_version != self.resources.residency_version {
        let mut missing = 0_u32
        let mut mask_cluster = 0_usize
        while mask_cluster < self.resources.clusters.len() {
            if !self.resources.cluster_resident.get(mask_cluster).unwrap_or(false) {
                let lod = self.resources.cluster_lods.get(mask_cluster).unwrap_or(self.resources.maximum_lod)
                if lod < 24_u32 {
                    missing = missing |(1_u32 << lod)
                }
            }
            mask_cluster += 1_usize
        }
        let levels = if self.resources.maximum_lod >= 23_u32 {
            16777215_u32
        } else {
            (1_u32 <<(self.resources.maximum_lod + 1_u32)) - 1_u32
        }
        self.resources.resident_mask = levels &(16777215_u32 ^ missing)
        self.resources.resident_mask_version = self.resources.residency_version
    }
    let resident_lod_mask = self.resources.resident_mask
    let mut values = Vec[f32]::new()
    for value in view_projection.values() {
        values.push(value)
    }
    values.push(camera.x()) values.push(camera.y()) values.push(camera.z())
    values.push(maximum_distance)
    values.push(light_direction.x())
    values.push(light_direction.y())
    values.push(light_direction.z())
    values.push(resident_lod_mask as f32)
    values.push(light_color.x())
    values.push(light_color.y())
    values.push(light_color.z())
    values.push(light_intensity)
    values.push(indirect_ambient.x())
    values.push(indirect_ambient.y())
    values.push(indirect_ambient.z())
    values.push(current_hiz as f32)
    values.push(viewport_height)
    values.push(self.resources.maximum_lod as f32)
    values.push(self.resources.object_radius)
    values.push(self.maximum_instances as f32)
    let mut root_lod = 0_usize
    while root_lod < 24_usize {
        values.push(if root_lod == 1_usize {
                // Per-asset projected geometric error in viewport pixels.
                if self.autolod_enabled {
                    self.target_pixel_error
                } else {
                    - 1.0_f32
                }
            } elif root_lod == 2_usize {
                (self.lod_curve.len() + if self.lod_smooth {
                        16_usize
                    } else {
                        0_usize
                    }
                ) as f32
            } elif root_lod >= 3_usize && root_lod < 19_usize {
                let point = self.lod_curve.get((root_lod - 3) / 2).unwrap_or(LodCurvePoint {
                        0.0_f32, 1.0_f32
                    }
                    ,
                )
                if (root_lod - 3) % 2 == 0 {
                    point.distance
                } else {
                    point.triangle_ratio
                }
            } elif root_lod == 19_usize {
                self.resources.object_center.x()
            } elif root_lod == 20_usize {
                self.resources.object_center.y()
            } elif root_lod == 21_usize {
                self.resources.object_center.z()
            } elif root_lod == 22_usize {
                self.lod_focal_y
            } elif root_lod == 23_usize {
                self.lod_near
            } elif root_lod < self.resources.lod_roots.len() {
                match self.resources.lod_roots.get(root_lod) {
                    Option::Some(value) => value as f32
                    Option::None => 4294967295.0_f32
                }
            } else {
                4294967295.0_f32
            }
        )
        root_lod += 1_usize
    }
    let header_uploaded = stream.write_f32s(16_u64, values)
    let metadata_stale = self.metadata_versions.get(slot).unwrap_or(0_u64) != self.resources.residency_version ||
    self.metadata_modes.get(slot).unwrap_or(0_u32) != view_mode ||
    self.metadata_primitives.get(slot).unwrap_or(0_u32) != primitive_id
    if metadata_stale {
        values.clear()
        let mut cluster_index = 0_usize
        for cluster in self.resources.clusters {
            values.push(cluster.center().x())
            values.push(cluster.center().y())
            values.push(cluster.center().z())
            values.push(cluster.radius())
            values.push(cluster.cone_axis().x())
            values.push(cluster.cone_axis().y())
            values.push(cluster.cone_axis().z())
            // Cone rejection is only enabled after the builder can prove a
            // conservative cutoff for every primitive in a cluster.
            values.push( - 2.0_f32)
            values.push((cluster.triangle_count() * 3_usize) as f32)
            let physical_slot = match self.resources.cluster_slots.get(cluster_index) {
                Option::Some(value) => value
                Option::None => 0_u32
            }
            values.push((physical_slot as f32) * 378.0_f32)
            values.push((physical_slot as f32) * 64.0_f32)
            values.push(match self.resources.cluster_lods.get(cluster_index) {
                    Option::Some(value) => value as f32
                    Option::None => 0.0_f32
                }
            )
            values.push(if match self.resources.cluster_resident.get(cluster_index) {
                    Option::Some(value) => value
                    Option::None => false
                }
                {
                    1.0_f32
                } else {
                    0.0_f32
                }
            )
            values.push(primitive_id as f32)
            values.push(view_mode as f32)
            values.push(if self.skin.is_some(){cluster.vertex_count() as f32}else{0_f32})
            cluster_index += 1_usize
        }
        let mut node_index = 0_usize
        for node in self.resources.hierarchy {
            values.push(node.center().x())
            values.push(node.center().y())
            values.push(node.center().z())
            values.push(node.radius())
            values.push(node.first_cluster() as f32)
            values.push(node.cluster_count() as f32)
            values.push(if node.leaf() {
                    - 1.0_f32
                } else {
                    node.left_child() as f32
                }
            )
            // A parent may have only a left child when a level has an odd node
            // count. UINT_MAX cannot be cast to f32: it rounds to 2^32 and the
            // shader then treats it as a real child, blocking close-up refinement.
            values.push(if node.right_child() == 4294967295_u32 {
                    - 1.0_f32
                } else {
                    node.right_child() as f32
                }
            )
            values.push(node.level() as f32)
            values.push(node.geometric_error())
            values.push(self.resources.lod_budget.refinement_ratios.get(node_index).unwrap_or(2.0_f32))
            values.push(self.resources.lod_budget.source_triangles as f32)
            node_index += 1_usize
        }
        if !stream.write_f32s(256_u64, values) {
            ret false
        }
        __borrowed_u64_set(self.metadata_versions, slot, self.resources.residency_version)
        __borrowed_u32_set(self.metadata_modes, slot, view_mode)
        __borrowed_u32_set(self.metadata_primitives, slot, primitive_id)
    }
    values.clear()
    for instance in instances {
        for value in instance.model.values() {
            values.push(value)
        }
        values.push(instance.base_color.x())
        values.push(instance.base_color.y())
        values.push(instance.base_color.z())
        values.push(1.0_f32)
        values.push(instance.metallic)
        values.push(instance.roughness)
        values.push(if instance.unlit {
                1.0_f32
            } else {
                0.0_f32
            }
        )
        values.push(view_mode as f32)
        values.push(instance.normal_scale)
        values.push(if instance.normal_flip_y {
                - 1.0_f32
            } else {
                1.0_f32
            }
        )
        values.push(0.0_f32) values.push(0.0_f32)
    }
    if self.aa_signature == 5_u32 {
        let mut temporal_values = self.previous_view_projection.values()
        for instance in instances {
            for value in instance.previous_model.values() {
                temporal_values.push(value)
            }
            temporal_values.push(if instance.previous_valid {
                    1.0_f32
                } else {
                    0.0_f32
                }
            )
            temporal_values.push(0.0_f32) temporal_values.push(0.0_f32) temporal_values.push(0.0_f32)
        }
        let buffer = self.temporal_buffers.get(slot).unwrap_or(GpuBuffer::unavailable())
        if !buffer.write_f32s(0, temporal_values) {
            ret false
        }
    }
    let uploaded = stream.write_u32(0_u64, self.resources.clusters.len() as u32) &&
    stream.write_u32(4_u64, instances.len() as u32) &&
    stream.write_u32(8_u64, self.resources.hierarchy.len() as u32) &&
    stream.write_u32(12_u64, view_mode) &&
    header_uploaded && stream.write_f32s(((64_usize + self.resources.clusters.len() * 16_usize + self.resources.hierarchy.len() * 12_usize) as u64) * 4_u64, values)
    let feedback_reset = frame.fill_buffer(stream,(feedback_base as u64) * 4_u64,(self.resources.clusters.len() as u64) * 4_u64, 0_u32)
    let indirect_reset = frame.fill_buffer(stream,(indirect_base as u64) * 4_u64, 4_u64, 0_u32) &&
    frame.fill_buffer(stream,(indirect_base as u64) * 4_u64 + 12_u64, 16_u64, 0_u32) &&
    stream.write_u32((indirect_base as u64) * 4_u64 + 4_u64, 1_u32) &&
    stream.write_u32((indirect_base as u64) * 4_u64 + 8_u64, 1_u32)
    let hiz_reset = frame.fill_buffer(stream,((hiz_base + current_hiz * 3067_usize) as u64) * 4_u64, 12268_u64, 4294967295_u32)
    let previous_reset = slot_frame != 0_u64 || frame.fill_buffer(stream,((hiz_base +(1_usize - current_hiz) * 3067_usize) as u64) * 4_u64, 12268_u64, 4294967295_u32)
    let resets_ordered = frame.transfer_storage_barrier()
    let history_ordered = frame.compute_barrier()
    frame.timing_mark(2_u32, true)
    let main_recorded = resets_ordered && history_ordered && uploaded && feedback_reset && indirect_reset &&
    hiz_reset &&
    previous_reset && frame.dispatch_compute(
        self.cull_pipeline, group,
        ((instances.len() + 63_usize) / 64_usize) as u32,
        1_u32, 1_u32,) && frame.compute_barrier()
    frame.timing_mark(2_u32, false)
    frame.timing_mark(3_u32, true)
    let recorded = main_recorded && frame.dispatch_compute(self.dispatch_pipeline, group, 1_u32, 1_u32, 1_u32) &&
    frame.compute_barrier() && frame.dispatch_compute_indirect(self.post_cull_pipeline, group,
        stream,((indirect_base + 7_usize) as u64) * 4_u64,) && frame.compute_barrier()
    frame.timing_mark(3_u32, false)
    let mut recorded=recorded
    if recorded && self.skin.is_some(){let mut binding=match self.skin{Some(binding)=>binding None=>{ret false}} recorded=binding.record_selected(frame,group,self.cache_dispatch_pipeline,self.request_pipeline)}
    if !recorded {
        println("VG record fail 5 main=" + Debug::fmt(main_recorded))
        self.last_record_error = 5_u32
    } else {
        self.resources.frame_index = self.resources.frame_index + 1_u64
        __borrowed_u64_set(self.slot_frames, slot, next_slot_frame)
        self.active_slot = slot
        self.active_indirect_offset =(indirect_base as u64) * 4_u64
        self.active_candidates = candidate_count as u32
        self.active_traversal_instances = instances.len() as u32
        self.active_post_candidates = 0_u32
        self.last_record_error = 0_u32
    }
    ret recorded
}

pub fn gpu_virtual_geometry_draw(
    self: GpuVirtualGeometry&, pass: RenderPassEncoder,) -> bool {
    let completion=pass.completion()
    let same=self.record_completion.same_submission(completion)
    if completion.available(){completion.destroy()}
    if !same{ret false}

    let group = match self.groups.get(self.active_slot) {
        Option::Some(value) => value
        Option::None => BindGroup::unavailable()
    }
    // The GPU indirect command is authoritative and a zero group count is
    // a valid no-op. Do not gate drawing on the host telemetry mirror:
    // callers using the convenience record wrapper may observe that
    // mirror one call later on current Encore, while the recorded command
    // is already correct.
    if !self.available {
        ret false
    }
    if !pass.bind_pipeline(self.render_pipeline) {
        ret false
    }
    if !pass.bind_group(group) {
        ret false
    }
    let drawn = pass.draw_mesh_tasks_indirect(
        match self.streams.get(self.active_slot) {
            Option::Some(value) => value
            Option::None => GpuBuffer::unavailable()
        }
        , self.active_indirect_offset,)
    ret drawn
}

pub fn gpu_virtual_geometry_draw_slot(
    self: GpuVirtualGeometry&, pass: RenderPassEncoder,
    slot: usize, view_mode: u32,) -> bool {
    let completion=pass.completion()
    let same=self.record_completion.same_submission(completion)
    if completion.available(){completion.destroy()}
    if !same{ret false}

    let group = match self.groups.get(slot) {
        Option::Some(value) => value
        Option::None => BindGroup::unavailable()
    }
    let maximum_candidates = self.resources.clusters.len() * self.maximum_instances
    let feedback_base = 64_usize + self.resources.clusters.len() * 16_usize +
    self.resources.hierarchy.len() * 12_usize +
    self.maximum_instances * 28_usize + maximum_candidates * 4_usize
    let indirect_base = feedback_base + self.resources.clusters.len() +
    3067_usize * 2_usize
    let pipeline = if view_mode == 3_u32 && self.triangle_debug_pipeline.available() {
        self.triangle_debug_pipeline
    } elif view_mode == 10_u32 {
        self.overdraw_pipeline
    } else {
        self.render_pipeline
    }
    ret self.available && group.available() &&
    pass.bind_pipeline(pipeline) &&
    pass.bind_group(group) &&
    pass.draw_mesh_tasks_indirect(
        match self.streams.get(slot) {
            Option::Some(value) => value
            Option::None => GpuBuffer::unavailable()
        }
        ,
        (indirect_base as u64) * 4_u64,)
}

pub fn gpu_virtual_geometry_visible_count_slot(
    self: GpuVirtualGeometry&, slot: usize,) -> u32 {
    let maximum_candidates = self.resources.clusters.len() * self.maximum_instances
    let feedback_base = 64_usize + self.resources.clusters.len() * 16_usize +
    self.resources.hierarchy.len() * 12_usize +
    self.maximum_instances * 28_usize + maximum_candidates * 4_usize
    let indirect_base = feedback_base + self.resources.clusters.len() +
    3067_usize * 2_usize
    match self.streams.get(slot) {
        Option::Some(stream) => {
            ret stream.read_u32((indirect_base as u64) * 4_u64)
        }
        Option::None => {
            ret 0_u32
        }
    }
}

pub fn gpu_virtual_geometry_destroy(self: GpuVirtualGeometry&) -> bool {
    for token in self.uses{if !token.ready(){ret false}}
    if self.owns_resources{for token in self.resources.uses{if !token.ready(){ret false}}}
    // All retired pipelines use subsets of these view submissions.
    for entry in self.retired_pipelines{for token in entry.uses{token.destroy()} entry.solid.destroy() entry.triangles.destroy() entry.overdraw.destroy()}
    for token in self.uses{token.destroy()}
    if self.record_completion.available(){self.record_completion.destroy()}
    self.render_pipeline.destroy() self.triangle_debug_pipeline.destroy() self.overdraw_pipeline.destroy()
    self.mesh_shader.destroy() self.fragment_shader.destroy() self.triangle_debug_shader.destroy()
    self.dispatch_pipeline.destroy() self.dispatch_shader.destroy() self.post_cull_pipeline.destroy() self.post_cull_shader.destroy() self.cull_pipeline.destroy() self.cull_shader.destroy()
    if self.request_pipeline.available(){self.request_pipeline.destroy()} if self.request_shader.available(){self.request_shader.destroy()}
    if self.cache_dispatch_pipeline.available(){self.cache_dispatch_pipeline.destroy()} if self.cache_dispatch_shader.available(){self.cache_dispatch_shader.destroy()}
    for i in 0_usize..self.groups.len(){self.groups.get_unchecked_borrowed(i).destroy()}
    for i in 0_usize..self.streams.len(){self.streams.get_unchecked_borrowed(i).destroy()}
    for i in 0_usize..self.light_buffers.len(){self.light_buffers.get_unchecked_borrowed(i).destroy()}
    for i in 0_usize..self.temporal_buffers.len(){self.temporal_buffers.get_unchecked_borrowed(i).destroy()}
    self.lod_history.destroy() self.layout.destroy() self.sampler.destroy() self.texture.destroy() self.normal_texture.destroy()
    if self.owns_resources{ret destroy_virtual_geometry_resources(self.resources)} ret true
}
/// Call once, after all forked views have successfully retired. The asset owner
/// holds this explicit shared resource reference; views never guess its lifetime.
pub fn destroy_virtual_geometry_resources(resources: VirtualGeometryResources&) -> bool {
    for token in resources.uses{if !token.ready(){ret false}}
    for token in resources.uses{token.destroy()}
    if resources.page_producer.available(){resources.page_producer.destroy()}
    resources.vertices.destroy() resources.triangles.destroy() resources.page_staging_vertices.destroy() resources.page_staging_triangles.destroy()
    geometry_page_pool_destroy(resources.page_cache) geometry_page_archive_destroy(resources.page_archive) ret true
}
fn retain_virtual_geometry_use(uses: mut Vec[GpuCompletion],frame: RenderFrame) -> bool {
    let mut count=0_usize
    for i in 0_usize..uses.len(){let token=uses.get_unchecked_borrowed(i) if token.ready(){token.destroy()}else{uses.set(count,token) count+=1_usize}}
    while uses.len()>count{uses.pop()}
    let token=frame.completion() if !token.available(){ret false}
    for old in uses{if old.same_submission(token){token.destroy() ret true}}
    uses.push(token) ret true
}

pub struct GpuClusterCullResult {
    valid: bool
    error: str
    visible_clusters: Vec[u32]
    indirect_buffer: GpuBuffer
    command_offset: u64
    maximum_draw_count: u32
}

impl for GpuClusterCullResult {
    pub fn valid(self: Self) -> bool {
        ret self.valid
    }
    pub fn error(self: Self) -> str {
        ret self.error
    }
    pub fn visible_clusters(self: Self) -> Vec[u32] {
        ret self.visible_clusters
    }
    pub fn visible_count(self: Self) -> u32 {
        ret self.visible_clusters.len() as u32
    }
    pub fn storage_buffer(self: Self) -> GpuBuffer {
        ret self.indirect_buffer
    }
    /// Issues the compacted commands after the caller binds the packed virtual
    /// geometry vertex and index buffers.
    pub fn draw(self: Self, pass: RenderPassEncoder) -> bool {
        ret self.valid && self.maximum_draw_count > 0_u32 &&
        pass.draw_indexed_indirect_count(self.indirect_buffer, self.command_offset,
            self.indirect_buffer, 4_u64, self.maximum_draw_count,)
    }
    pub fn destroy(self: Self) -> bool {
        ret if self.indirect_buffer.available() {
            self.indirect_buffer.destroy()
        } else {
            true
        }
    }
}

fn failed_cluster_cull(message: str) -> GpuClusterCullResult {
    ret GpuClusterCullResult {
        false, message, Vec[u32]::new(), GpuBuffer::unavailable(), 0_u64, 0_u32
    }
}

/// Runs sphere-distance cluster rejection on the Vulkan compute queue.
///
/// The packed storage buffer deliberately contains both input metadata and the
/// compacted output list so the current one-storage-binding RHI path can issue
/// the pass without an intermediate CPU copy.
pub fn gpu_cull_clusters(device: GraphicsDevice,
    clusters: Vec[GeometryCluster], maximum_distance: f32,) -> GpuClusterCullResult {
    let cluster_count = clusters.len()
    if cluster_count == 0_usize {
        ret GpuClusterCullResult {
            true, "", Vec[u32]::new(), GpuBuffer::unavailable(), 0_u64, 0_u32
        }
    }
    if cluster_count > 4294967295_usize {
        ret failed_cluster_cull("Cluster count exceeds the GPU index range")
    }

    let word_count = 4_usize + cluster_count * 13_usize
    let byte_count =(word_count as u64) * 4_u64
    let mut entries = Vec[BindGroupLayoutEntry]::new()
    entries.push(BindGroupLayoutEntry::storage(0_u32, shader_stage_compute()))
    let layout = device.create_bind_group_layout(entries)
    let buffer = device.create_buffer(byte_count, buffer_storage() | buffer_indirect(), true)
    let group = device.create_storage_bind_group(layout, buffer, 0_u64, byte_count)
    let shader = device.create_shader_module(cluster_cull_spirv(), shader_stage_compute())
    let pipeline = device.create_compute_pipeline(shader, layout)

    let mut failure = ""
    let mut initialized = layout.available()
    if !initialized {
        failure = "Cluster-culling bind group layout: " + layout.error()
    }
    if !buffer.available() {
        initialized = false
        failure = "Cluster-culling storage buffer: " + buffer.error()
    }
    if !group.available() {
        initialized = false
        failure = "Cluster-culling bind group: " + group.error()
    }
    if !shader.available() {
        initialized = false
        failure = "Cluster-culling shader: " + shader.error()
    }
    if !pipeline.available() {
        initialized = false
        failure = "Cluster-culling pipeline: " + pipeline.error()
    }
    if !buffer.write_u32(0_u64, cluster_count as u32) {
        initialized = false
        failure = "Unable to upload the cluster count"
    }
    if !buffer.write_u32(4_u64, 0_u32) {
        initialized = false
        failure = "Unable to reset the visible-cluster count"
    }
    let mut metadata = Vec[f32]::new()
    metadata.push(maximum_distance)
    metadata.push(0.0_f32)
    for cluster in clusters {
        let center = cluster.center()
        metadata.push(center.x())
        metadata.push(center.y())
        metadata.push(center.z())
        metadata.push(cluster.radius())
        metadata.push((cluster.triangle_count() * 3_usize) as f32)
        metadata.push(cluster.triangle_offset() as f32)
        metadata.push(cluster.vertex_offset() as f32)
        metadata.push(0.0_f32)
    }
    if !buffer.write_f32s(8_u64, metadata) {
        initialized = false
        failure = "Unable to upload cluster bounds"
    }

    let encoder = device.create_encoder()
    let group_count =((cluster_count + 63_usize) / 64_usize) as u32
    let mut executed = initialized && encoder.available()
    if initialized && !encoder.available() {
        failure = "Cluster-culling encoder: " + encoder.error()
    }
    if executed && !encoder.bind_compute_pipeline(pipeline) {
        executed = false
        failure = "Unable to bind the cluster-culling pipeline"
    }
    if executed && !encoder.bind_compute_group(pipeline, group) {
        executed = false
        failure = "Unable to bind cluster-culling resources"
    }
    if executed && !encoder.dispatch(group_count, 1_u32, 1_u32) {
        executed = false
        failure = "Unable to dispatch cluster culling"
    }
    if executed && !encoder.storage_host_barrier() {
        executed = false
        failure = "Unable to record the cluster-culling host barrier"
    }
    if executed && !encoder.submit_and_wait() {
        executed = false
        failure = "Cluster-culling submission failed: " + encoder.error()
    }
    encoder.destroy()

    let visible_count = if executed {
        buffer.read_u32(4_u64) as usize
    } else {
        0_usize
    }
    let mut visible = Vec[u32]::new()
    if executed && visible_count <= cluster_count {
        let output_base =((4_usize + cluster_count * 8_usize) as u64) * 4_u64
        let mut output_index = 0_usize
        while output_index < visible_count {
            visible.push(buffer.read_u32(output_base +(output_index as u64) * 20_u64 + 16_u64))
            output_index += 1_usize
        }
    }

    pipeline.destroy()
    shader.destroy()
    group.destroy()
    layout.destroy()

    if !executed {
        buffer.destroy()
        ret failed_cluster_cull(failure)
    }
    if visible_count > cluster_count {
        buffer.destroy()
        ret failed_cluster_cull("GPU cluster compaction overflowed its output range")
    }
    ret GpuClusterCullResult {
        true, "", visible,
        buffer,((4_usize + cluster_count * 8_usize) as u64) * 4_u64,
        cluster_count as u32
    }
}
// GPU-driven virtual geometry, cluster culling, and page residency.

impl for GpuVirtualGeometry {
    /// Called only after the previous scene producer has completed.
    pub fn set_graph_shaders(self: mut Self&, key: str, shaders: Vec[Vec[u32]]) ->() {
        if self.graph_key == key {
            ret()
        }
        self.graph_key = key self.graph_shaders = shaders
    }
    pub fn configure_anti_aliasing(self: mut Self&, device: GraphicsDevice, target: Swapchain, samples: u32, temporal: bool, previous: Mat4) -> bool {
        self.previous_view_projection = previous
        let signature = if temporal {
            5_u32
        } else {
            samples
        }
        if signature == self.aa_signature && self.graph_key == self.graph_applied {
            ret true
        }
        let mesh = device.create_shader_module(if self.skin.is_some(){animation_spirv(if temporal{7_u32}else{6_u32})}elif temporal {
                aa_temporal_mesh()
            } else {
                aa_linear_mesh()
            }
            , shader_stage_mesh(),)
        let fragment = device.create_shader_module(if self.graph_shaders.len() == 6 {
                self.graph_shaders.get(if temporal {
                        3
                    } else {
                        2
                    }
                ).unwrap_or(Vec[u32]::new())
            } elif temporal {
                aa_temporal_virtual_fragment()
            } else {
                aa_linear_virtual_fragment()
            }
            , shader_stage_fragment(),)
        let triangle = device.create_shader_module(if self.graph_shaders.len() == 6 {
                self.graph_shaders.get(if temporal {
                        5
                    } else {
                        4
                    }
                ).unwrap_or(Vec[u32]::new())
            } elif temporal {
                aa_temporal_virtual_triangle()
            } else {
                aa_linear_virtual_triangle()
            }
            , shader_stage_fragment(),)
        let solid = device.create_mesh_pipeline_with_bind_group(target, mesh, fragment, self.layout)
        let triangles = device.create_mesh_pipeline_with_bind_group(target, mesh, triangle, self.layout)
        let overdraw = device.create_mesh_pipeline_with_options(target, mesh, fragment, self.layout, RenderPipelineOptions::depth().with_depth_test(false).with_depth_write(false).with_additive_blending())
        if !solid.available() || !overdraw.available() {
            solid.destroy() triangles.destroy() overdraw.destroy() mesh.destroy() fragment.destroy() triangle.destroy() ret false
        }
        retire_virtual_pipelines(self)
        self.mesh_shader.destroy() self.fragment_shader.destroy() self.triangle_debug_shader.destroy()
        self.render_pipeline = solid self.triangle_debug_pipeline = triangles self.overdraw_pipeline = overdraw
        self.mesh_shader = mesh self.fragment_shader = fragment self.triangle_debug_shader = triangle self.aa_signature = signature self.graph_applied = self.graph_key
        ret true
    }
}

impl for GpuVirtualGeometry {
    pub fn shared_resources(self: Self&) -> VirtualGeometryResources<H> {ret self.resources}
    pub fn fork_view(self: mut Self&,device: GraphicsDevice,target: Swapchain,gi_scene: GpuBuffer,gi_surfaces: GpuBuffer,gi_history: GpuBuffer,texture_pixels: Vec[u32],texture_width: u32,texture_height: u32) -> GpuVirtualGeometry<H> {
        self.owns_resources=false
        let mut view=Self::create_textured_view(device,target,self.resources.data,Vec[f32]::new(),self.maximum_instances,gi_scene,gi_surfaces,gi_history,texture_pixels,texture_width,texture_height,Option[VirtualGeometryResources<H>]::Some(self.resources),self.skin)
        view.lod_curve=self.lod_curve view.lod_smooth=self.lod_smooth view.autolod_enabled=self.autolod_enabled view.target_pixel_error=self.target_pixel_error
        view.lod_focal_y=self.lod_focal_y view.lod_near=self.lod_near view.graph_key=self.graph_key view.graph_shaders=self.graph_shaders
        ret view
    }
    pub fn create_skinned(device: GraphicsDevice,target: Swapchain,geometry: VirtualGeometry,packed_vertices: Vec[f32],maximum_instances: usize,gi_scene: GpuBuffer,gi_surfaces: GpuBuffer,gi_history: GpuBuffer,texture_pixels: Vec[u32],texture_width: u32,texture_height: u32,skin: SkinGpuSection<H>) -> GpuVirtualGeometry<H> {
        ret Self::create_textured_view(device,target,geometry,packed_vertices,maximum_instances,gi_scene,gi_surfaces,gi_history,texture_pixels,texture_width,texture_height,Option[VirtualGeometryResources<H>]::None,Option[SkinGpuSection<H>]::Some(skin))
    }
}

impl for GpuVirtualGeometry {
    /// A dedicated view uses the same selected-vertex cache and VG stream for
    /// selection depth/silhouette. Called once before this view is submitted.
    pub fn configure_selection(self: mut Self&,device: GraphicsDevice,target: Swapchain) -> bool {
        if self.aa_signature==4294967295_u32 {ret true}
        let fragment=device.create_shader_module(animation_spirv(9_u32),shader_stage_fragment())
        let pipeline=device.create_mesh_pipeline_with_bind_group(target,self.mesh_shader,fragment,self.layout)
        if !fragment.available() || !pipeline.available(){pipeline.destroy() fragment.destroy() ret false}
        retire_virtual_pipelines(self)
        self.triangle_debug_pipeline=RenderPipeline::unavailable() self.overdraw_pipeline=RenderPipeline::unavailable()
        self.fragment_shader.destroy()
        self.render_pipeline=pipeline self.fragment_shader=fragment self.aa_signature=4294967295_u32 ret true
    }
}
