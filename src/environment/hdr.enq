//! Radiance panoramas import to linear native assets on a worker.
import core::option::Option
import core::result::Result
import refrain::native_asset::{save_environment_payload, load_environment_payload, asset_source_stamp}
import refrain::rhi::*
import std::os::read_file
extern fn graphene_hdr_decode(source: str) -> str
extern fn graphene_hdr_dimension(data: str, axis: u32) -> u32
extern fn graphene_hdr_upload(buffer: usize, data: str) -> bool
pub struct HdrImage {
    width: u32
    height: u32
    data: str
}
fn import_hdr(path: str, stamp: str) -> Result[str, str] {
    let mut decoded = ""
    unsafe {
        decoded = graphene_hdr_decode(read_file(path))
    }
    if decoded.byte_len() == 0 {
        ret Result::Err("Invalid Radiance HDR panorama")
    }
    if !save_environment_payload(path + ".gtexture", "texture-hdr", path, stamp, decoded) {
        ret Result::Err("Unable to save native HDR texture")
    }
    ret Result::Ok(decoded)
}
pub fn load_hdr(path: str) -> Result[HdrImage, str] {
    let stamp = asset_source_stamp(path)
    let data = match load_environment_payload(path + ".gtexture", "texture-hdr", stamp) {
        Ok(data) => data
        Err(_) => import_hdr(path, stamp)?
    }
    unsafe {
        let width = graphene_hdr_dimension(data, 0) let height = graphene_hdr_dimension(data, 1)
        if width == 0 || height == 0 {
            ret Result::Err("Invalid native HDR dimensions")
        }
        ret Result::Ok(HdrImage { width, height, data })
    }
}
pub struct HdrUpload {
    texture: GpuTexture
    staging: GpuBuffer
    encoder: CommandEncoder
    submission: GpuSubmission
}

impl for HdrUpload {
    pub fn begin(device: GraphicsDevice, image: HdrImage) -> Option[Self] {
        let texture = device.create_texture_2d(image.width, image.height, 1, format_rgba32_float(), texture_sampled() | texture_transfer_destination())
        let staging = device.create_buffer((image.width as u64) *(image.height as u64) * 16, buffer_transfer_source(), true)
        let encoder = device.create_encoder()
        let mut uploaded = false
        unsafe {
            uploaded = graphene_hdr_upload(staging.handle(), image.data)
        }
        if !texture.available() || !staging.available() || !encoder.available() || !uploaded || !encoder.transition_texture(texture, texture_layout_transfer_destination()) || !encoder.copy_buffer_to_texture(staging, texture, image.width, image.height, 0) || !encoder.transition_texture(texture, texture_layout_shader_read()) {
            encoder.destroy() staging.destroy() texture.destroy() ret Option::None
        }
        let submission = encoder.submit()
        if !submission.available() {
            submission.destroy() encoder.destroy() staging.destroy() texture.destroy() ret Option::None
        }
        ret Option::Some(Self { texture, staging, encoder, submission })
    }
    pub fn wait(self: Self) -> bool {
        ret self.submission.wait(18446744073709551615_u64)
    }
    pub fn complete(self: Self) -> bool {
        ret self.submission.complete()
    }
    pub fn finish(self: Self) -> GpuTexture {
        self.submission.destroy() self.encoder.destroy() self.staging.destroy() ret self.texture
    }
}
