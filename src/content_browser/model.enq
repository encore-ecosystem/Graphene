pub fn content_less(a: str, b: str) -> bool {
    let count = if a.byte_len() < b.byte_len() {
        a.byte_len()
    } else {
        b.byte_len()
    }
    for i in 0..count {
        if a.byte_at(i) < b.byte_at(i) {
            ret true
        }
        if a.byte_at(i) > b.byte_at(i) {
            ret false
        }
    }
    ret a.byte_len() < b.byte_len()
}
