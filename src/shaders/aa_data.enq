//! Cooked native words avoid expanding shader blobs into thousands of Encore calls.
import core::vec::Vec
extern fn graphene_aa_shader_length(shader: u32) -> u32
extern fn graphene_aa_shader_word(shader: u32, index: u32) -> u32
pub fn aa_spirv(shader: u32) -> Vec[u32] {
    let mut words = Vec[u32]::new()
    unsafe {
        let count = graphene_aa_shader_length(shader)
        words.reserve(count as usize)
        let mut i = 0_u32
        while i < count {
            words.push(graphene_aa_shader_word(shader, i)) i += 1
        }
    }
    ret words
}
