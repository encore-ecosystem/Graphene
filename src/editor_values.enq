import core::option::Option
import linalg::Vec3

/// Gives interactive retained controls layered over the viewport priority over
/// its render surface. Both occupy the same screen rectangle, so geometry
/// alone cannot determine the pointer target.
pub fn resolve_editor_pointer_target(
    over_viewport: bool, retained_target: str,) -> str {
    if !over_viewport {
        ret retained_target
    }
    if retained_target == "" || retained_target == "viewport-surface" {
        ret "viewport-surface"
    }
    ret retained_target
}

pub struct EditorTransform {
    position: Vec3 rotation: Vec3 scale: Vec3
}

impl for EditorTransform {
    pub fn position(self: Self) -> Vec3 {
        ret self.position
    }
    pub fn rotation(self: Self) -> Vec3 {
        ret self.rotation
    }
    pub fn scale(self: Self) -> Vec3 {
        ret self.scale
    }
}

pub fn parse_editor_scalar(source: str) -> Option[f32] {
    if source.byte_len() == 0_usize {
        ret Option[f32]::None
    }
    let mut index = 0_usize
    let mut sign = 1.0_f32
    if source.byte_at(index) == 45_u8 {
        sign = - 1.0_f32 index = index + 1_usize
    } elif source.byte_at(index) == 43_u8 {
        index = index + 1_usize
    }
    let mut value = 0.0_f32
    let mut digits = 0_usize
    while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <= 57_u8
    {
        value = value * 10.0_f32 +((source.byte_at(index) - 48_u8) as f32)
        digits = digits + 1_usize
        index = index + 1_usize
    }
    if index < source.byte_len() && source.byte_at(index) == 46_u8 {
        index = index + 1_usize
        let mut place = 0.1_f32
        while index < source.byte_len() && source.byte_at(index) >= 48_u8 && source.byte_at(index) <=
        57_u8 {
            value = value +((source.byte_at(index) - 48_u8) as f32) * place
            place = place * 0.1_f32
            digits = digits + 1_usize
            index = index + 1_usize
        }
    }
    if digits == 0_usize || index != source.byte_len() {
        ret Option[f32]::None
    }
    ret Option[f32]::Some(value * sign)
}

fn replace_axis(value: Vec3, axis: str, scalar: f32) -> Option[Vec3] {
    if axis == "x" {
        ret Option[Vec3]::Some(Vec3::new(scalar, value.y(), value.z()))
    }
    if axis == "y" {
        ret Option[Vec3]::Some(Vec3::new(value.x(), scalar, value.z()))
    }
    if axis == "z" {
        ret Option[Vec3]::Some(Vec3::new(value.x(), value.y(), scalar))
    }
    ret Option[Vec3]::None
}

pub fn apply_editor_transform(field: str, source: str, position: Vec3, rotation: Vec3, scale: Vec3) ->
Option[EditorTransform] {
    let mut scalar = 0.0_f32
    let mut valid = false
    match parse_editor_scalar(source) {
        Option::Some(value) => {
            scalar = value valid = true
        }
        Option::None => {
        }
    }
    if !valid {
        ret Option[EditorTransform]::None
    }
    if field == "transform-location-x" || field == "transform-location-y" || field == "transform-location-z"
    {
        match replace_axis(position, field.slice(field.byte_len() - 1_usize, 1_usize), scalar) {
            Option::Some(next) => {
                ret Option[EditorTransform]::Some(EditorTransform {
                        next, rotation, scale
                    }
                    ,
                )
            }
            Option::None => {
            }
        }
    }
    if field == "transform-rotation-x" || field == "transform-rotation-y" || field == "transform-rotation-z"
    {
        match replace_axis(rotation, field.slice(field.byte_len() - 1_usize, 1_usize), scalar * 0.017453292_f32)
        {
            Option::Some(next) => {
                ret Option[EditorTransform]::Some(EditorTransform {
                        position, next, scale
                    }
                    ,
                )
            }
            Option::None => {
            }
        }
    }
    if field == "transform-scale-x" || field == "transform-scale-y" || field == "transform-scale-z" {
        if scalar <= 0.0_f32 {
            ret Option[EditorTransform]::None
        }
        match replace_axis(scale, field.slice(field.byte_len() - 1_usize, 1_usize), scalar) {
            Option::Some(next) => {
                ret Option[EditorTransform]::Some(EditorTransform {
                        position, rotation, next
                    }
                    ,
                )
            }
            Option::None => {
            }
        }
    }
    ret Option[EditorTransform]::None
}

/// Converts a pointer delta into a world-space single-axis gizmo delta.
/// X/Z use horizontal drag; Y uses the inverted screen vertical drag.
pub fn gizmo_move_delta(axis: u32, pointer_dx: f32, pointer_dy: f32, camera_distance: f32) -> Vec3 {
    let amount = if axis == 2_u32 {
        - pointer_dy
    } else {
        pointer_dx
    }
    let distance = amount * camera_distance * 0.012_f32
    if axis == 1_u32 {
        ret Vec3::new(distance, 0.0_f32, 0.0_f32)
    }
    if axis == 2_u32 {
        ret Vec3::new(0.0_f32, distance, 0.0_f32)
    }
    if axis == 3_u32 {
        ret Vec3::new(0.0_f32, 0.0_f32, distance)
    }
    ret Vec3::zero()
}

/// Projects a world-space drag onto one gizmo axis.
pub fn gizmo_axis_drag_scalar(axis: u32, start: Vec3, current: Vec3) -> f32 {
    let delta = current.sub(start)
    if axis == 1_u32 {
        ret delta.x()
    }
    if axis == 2_u32 {
        ret delta.y()
    }
    if axis == 3_u32 {
        ret delta.z()
    }
    ret 0.0_f32
}

pub fn gizmo_rotation_from_drag(axis: u32, initial: Vec3, pointer_dx: f32, pointer_dy: f32) -> Vec3 {
    if axis == 1_u32 {
        ret Vec3::new(initial.x() - pointer_dy * 0.01_f32, initial.y(), initial.z())
    }
    if axis == 2_u32 {
        ret Vec3::new(initial.x(), initial.y() + pointer_dx * 0.01_f32, initial.z())
    }
    if axis == 3_u32 {
        ret Vec3::new(initial.x(), initial.y(), initial.z() + pointer_dy * 0.01_f32)
    }
    ret initial
}

pub fn gizmo_scale_from_drag(axis: u32, initial: Vec3, pointer_dx: f32, pointer_dy: f32) -> Vec3 {
    let amount = if axis == 2_u32 {
        - pointer_dy
    } else {
        pointer_dx
    }
    let value = if axis == 1_u32 {
        initial.x() + amount * 0.01_f32
    } elif axis == 2_u32 {
        initial.y() + amount * 0.01_f32
    } elif axis == 3_u32 {
        initial.z() + amount * 0.01_f32
    } else {
        initial.x() + amount * 0.01_f32
    }
    let clamped = if value < 0.1_f32 {
        0.1_f32
    } else {
        value
    }
    if axis == 1_u32 {
        ret Vec3::new(clamped, initial.y(), initial.z())
    }
    if axis == 2_u32 {
        ret Vec3::new(initial.x(), clamped, initial.z())
    }
    if axis == 3_u32 {
        ret Vec3::new(initial.x(), initial.y(), clamped)
    }
    ret Vec3::new(clamped, clamped, clamped)
}
