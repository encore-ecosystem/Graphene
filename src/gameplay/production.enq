//! Fixed-step machines reserve inputs once and retain blocked finished products.
import core::vec::Vec
import mod::inventory::{ActorInventory, ItemStack}
import mod::recipe::ProductionRecipe

pub struct ProductionMachine {
    actor: u64
    inventory: usize
    grid: u32
    recipe: ProductionRecipe
    enabled: bool
    running: bool
    remaining: f32
    completed: u32
    status: str
}

impl for ProductionMachine {
    pub fn new(actor: u64, inventory: usize, grid: u32, recipe: ProductionRecipe) -> Self {
        ret Self { actor, inventory, grid, recipe, true, false, 0, 0, "waiting-input" }
    }
    pub fn snapshot(self: Self) -> Self {
        ret Self {
            self.actor, self.inventory, self.grid, self.recipe, self.enabled, self.running, self.remaining, self.completed, self.status
        }
    }
    pub fn ready(self: Self, inventories: Vec[ActorInventory]) -> bool {
        if !self.enabled || self.inventory >= inventories.len() {
            ret false
        }
        if self.running {
            ret self.remaining > 0
        }
        let mut cargo = inventories.get_unchecked_borrowed(self.inventory).cargo.snapshot()
        ret cargo.exchange(self.recipe.inputs, self.recipe.outputs)
    }
    pub fn step(self: mut Self, inventories: mut Vec[ActorInventory], seconds: f32, powered: bool) -> bool {
        if !self.enabled {
            self.status = "disabled" ret false
        }
        if !powered {
            self.status = "no-power" ret false
        }
        if self.inventory >= inventories.len() {
            self.status = "missing-inventory" ret false
        }
        let owner = inventories.get_unchecked_borrowed(self.inventory)
        let mut cargo = owner.cargo.snapshot()
        if !self.running {
            let mut test = cargo.snapshot()
            if !test.exchange(self.recipe.inputs, self.recipe.outputs) {
                self.status = "waiting-input-or-space" ret false
            }
            for input in self.recipe.inputs {
                cargo.remove(input.item, input.count)
            }
            self.running = true self.remaining = self.recipe.seconds
        }
        if self.remaining > 0 {
            self.remaining -= seconds
            if self.remaining < 0 {
                self.remaining = 0
            }
        }
        self.status = "running"
        if self.remaining == 0 {
            if !cargo.exchange(Vec[ItemStack]::new(), self.recipe.outputs) {
                self.status = "output-full" inventories.set(self.inventory, ActorInventory {
                        owner.actor, cargo
                    }
                    ,
                ) ret false
            }
            self.running = false self.completed += 1 self.status = "completed"
            inventories.set(self.inventory, ActorInventory { owner.actor, cargo }) ret true
        }
        inventories.set(self.inventory, ActorInventory { owner.actor, cargo })
        ret false
    }
}
pub struct ProductionSystem {
    machines: Vec[ProductionMachine]
}

impl for ProductionSystem {
    pub fn new() -> Self {
        ret Self { Vec[ProductionMachine]::new() }
    }
    pub fn step(self: mut Self, inventories: mut Vec[ActorInventory], seconds: f32) -> Vec[u64] {
        let mut completed = Vec[u64]::new()
        // Sparse explicit grid IDs, bounded by the authoring API; no actor pairs.
        let mut supply = Vec[f32]::new() let mut demand = Vec[f32]::new()
        for _ in 0_usize..256_usize {
            supply.push(0) demand.push(0)
        }
        for i in 0_usize..self.machines.len() {
            let mut machine = self.machines.get_unchecked_borrowed(i).snapshot()
            if machine.grid >= 256 {
                continue
            }
            if machine.recipe.power < 0 {
                let ready = machine.ready(inventories)
                if machine.step(inventories, seconds, true) {
                    completed.push(machine.actor)
                }
                if ready {
                    let grid = machine.grid as usize supply.set(grid, supply.get_unchecked_borrowed(grid) - machine.recipe.power)
                }
                self.machines.set(i, machine)
            } elif machine.ready(inventories) {
                let grid = machine.grid as usize demand.set(grid, demand.get_unchecked_borrowed(grid) + machine.recipe.power)
            }
        }
        for i in 0_usize..self.machines.len() {
            let mut machine = self.machines.get_unchecked_borrowed(i).snapshot()
            if machine.recipe.power < 0 || machine.grid >= 256 {
                continue
            }
            let grid = machine.grid as usize
            if machine.step(inventories, seconds, machine.recipe.power == 0 || supply.get_unchecked_borrowed(grid) >= demand.get_unchecked_borrowed(grid)) {
                completed.push(machine.actor)
            }
            self.machines.set(i, machine)
        }
        ret completed
    }
}
