//! Session-only frame profiler controls and retained charts. Native fixed-size
//! history keeps measurement allocation out of the editor's frame loop.
import core::vec::Vec
import core::option::Option

import json::{Json, field}
import luma::{Color, DisplayList, DisplayPoint, Event, PreparedFrame, Rect, Style, StyleSheet, UiStageTimings, UiTimings, UiUpdateTimings, Widget, WidgetLayout, event_key_down, event_pointer_down, horizontal, key_left, key_right, vertical}

import mod::performance::performance_counter_ns
extern fn graphene_profiler_enable(device: usize, enabled: bool) ->()
extern fn graphene_profiler_begin() ->()
extern fn graphene_profiler_phase(phase: u32) ->()
extern fn graphene_profiler_finish(presented: bool) ->()
extern fn graphene_profiler_event_wait(ns: u64) ->()
extern fn graphene_profiler_ui(acquire: u64, present: u64, prepare: u64, bytes: u64) ->()
extern fn graphene_profiler_clear() ->()
extern fn graphene_profiler_select(index: u32) ->()
extern fn graphene_profiler_live() ->()
extern fn graphene_profiler_step(step: i32) ->()
extern fn graphene_profiler_value(index: u32, field: u32) -> u64
extern fn graphene_profiler_event(gpu: u32, index: u32, field: u32) -> u64
extern fn graphene_profiler_stat(field: u32) -> u64
extern fn graphene_profiler_bottleneck() -> u32

pub fn profile_event_wait(ns: u64) ->() {
    unsafe {
        graphene_profiler_event_wait(ns)
    }
}
pub fn profile_ui(timings: UiTimings) ->() {
    unsafe {
        graphene_profiler_ui(timings.acquire_ns(), timings.present_ns(), timings.gpu_preparation_ns(), timings.geometry_upload_bytes())
    }
}
pub fn profile_begin() ->() {
    unsafe {
        graphene_profiler_begin()
    }
}
pub fn profile_phase(phase: u32) ->() {
    unsafe {
        graphene_profiler_phase(phase)
    }
}
pub fn profile_finish(presented: bool) ->() {
    unsafe {
        graphene_profiler_finish(presented)
    }
}
fn value(index: usize, field: u32) -> u64 {
    unsafe {
        ret graphene_profiler_value(index as u32, field)
    }
}
fn selected(field: u32) -> u64 {
    ret value(4294967295_usize, field)
}
fn event_value(gpu: usize, index: usize, field: u32) -> u64 {
    unsafe {
        ret graphene_profiler_event(gpu as u32, index as u32, field)
    }
}
fn milliseconds(ns: u64) -> str {
    let hundredths =(ns + 5000_u64) / 10000_u64
    let remainder = hundredths % 100_u64
    ret(hundredths / 100_u64).fmt() + "." + if remainder < 10 {
        "0" + remainder.fmt()
    } else {
        remainder.fmt()
    }
}
fn duration(ns: u64) -> str {
    ret milliseconds(ns) + " ms"
}
fn gpu_state(state: u64) -> str {
    ret if state == 0 {
        "Pending"
    } elif state == 1 {
        duration(selected(5_u32))
    } elif state == 2 {
        "Incomplete"
    } else {
        "Unavailable"
    }
}
