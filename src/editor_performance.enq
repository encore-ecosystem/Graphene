// Profiler roles belong to Graphene. Resolve their CSS only when the theme
// changes; chart samples never change selector inputs or inherited colors.
struct PerformanceColors {
    revision: Option[u64]
    values: Vec[(str, Color)]
}

impl for PerformanceColors {
    pub fn new() -> Self<H> {
        ret PerformanceColors<H>{ Option[u64]::None, Vec[(str, Color)]::with_capacity(16) }
    }
    pub fn matches(self: Self&, sheet: StyleSheet) -> bool {
        ret match self.revision {
            Some(value) => value == sheet.revision() None => false
        }
    }
    pub fn get(self: mut Self&, sheet: StyleSheet, name: str) -> Color {
        if !self.matches(sheet) {
            self.values.clear()
            self.revision = Option[u64]::Some(sheet.revision())
        }
        for entry in self.values {
            if entry.0 == name {
                ret entry.1
            }
        }
        let result = if name == "hud" {
            sheet.style(Widget::panel("").with_classes("g-perf-hud"), false, false, false).background()
        } else {
            sheet.style(Widget::label("").with_classes("g-perf-" + name), false, false, false).foreground()
        }
        if self.values.len() < 16 {
            self.values.push((name, result))
        }
        ret result
    }
}
fn control(id: str, text: str, active: bool, disabled: bool) -> Widget {
    ret Widget::button(id, text).with_classes("g-perf-button" + if active {
            " is-active"
        } else {
            ""
        }
    ).with_disabled(disabled).with_attribute("aria-pressed", if active {
            "true"
        } else {
            "false"
        }
        ,
    )
}

pub struct PerformancePanel {
    colors: PerformanceColors<H>
    stats_cache: DisplayList
    stats_bounds: Rect
    stats_refreshed: u64
    opened: bool
    running: bool
    focused: bool
    collapsed: bool
    budget: u32
    refreshed: u64
    changed: bool
    history_bounds: Rect
    timeline_bounds: Rect
    history: DisplayList
    timeline: DisplayList
    summary_bounds: Rect
    table_bounds: Rect
    table_clip: Rect
    footer_bounds: Rect
    summary: DisplayList
    table: DisplayList
    footer: DisplayList
    row_count: usize
    had_frames: bool
    reconstruction_summary: str
    displacement_summary: str
    reconstruction_sample: u64
    reconstruction_counts:(u64, u64, u64)
    input_age: Option[u64]
    input_queued: usize
    input_coalesced: u32
}

impl for PerformancePanel {
    pub fn new() -> Self {
        ret Self {
            PerformanceColors::new(), DisplayList::new(), Rect::new(0, 0, 0, 0), 0_u64, false, false, false, false, 60_u32, 0_u64, true, Rect::new(0, 0, 0, 0), Rect::new(0, 0, 0, 0), DisplayList::new(), DisplayList::new(), Rect::new(0, 0, 0, 0), Rect::new(0, 0, 0, 0), Rect::new(0, 0, 0, 0), Rect::new(0, 0, 0, 0), DisplayList::new(), DisplayList::new(), DisplayList::new(), 0_usize, false, "", "", 0_u64,(0_u64, 0_u64, 0_u64), Option[u64]::None, 0_usize, 0_u32
        }
    }
    pub fn input_sample(self: mut Self, age: Option[u64], queued: usize, coalesced: u32, sampled: bool) ->() {
        if sampled {
            self.input_age = age self.input_coalesced = coalesced
        }
        self.input_queued = queued
    }
    pub fn input_snapshot(self: Self) -> Json {
        ret Json::Object(vec![field("ageNs", match self.input_age {
                        Some(ns) => Json::Number(ns.fmt()) None => Json::Null
                    }
                    ,
                ), field("queued", Json::Number(self.input_queued.fmt())), field("coalesced", Json::Number(self.input_coalesced.fmt()))])
    }
    pub fn sync(self: mut Self, device: usize, opened: bool, drawable: bool) ->() {
        self.sync_capture(device, opened, drawable, false)
    }
    /// Capture profiler samples without building a hidden panel's charts.
    pub fn sync_capture(self: mut Self, device: usize, opened: bool, drawable: bool, capture: bool) ->() {
        let running =(opened || capture) && drawable
        if self.running != running || self.opened != opened {
            unsafe {
                graphene_profiler_enable(device, running)
            }
            self.running = running self.opened = opened self.changed = true
        }
    }
    pub fn displacement(self: mut Self, bytes: u64, error: str, source: u64, triangles: u64, pending: bool) ->() {
        let summary = if error != "" {
            "Displacement: " + error
        } elif bytes > 0 {
            "Displacement " +((bytes + 524288_u64) / 1048576_u64).fmt() + " / 256 MiB" + if pending {
                " · triangles pending"
            } else {
                " · " + source.fmt() + " → " + triangles.fmt() + " tris"
            }
        } else {
            ""
        }
        if self.displacement_summary != summary {
            self.displacement_summary = summary self.changed = true
        }
    }
    pub fn reconstruction(self: mut Self, counts:(u64, u64, u64), input_width: u32, input_height: u32, output_width: u32, output_height: u32, tracked_bytes: u64) ->() {
        if !self.opened {
            ret()
        }
        let now = performance_counter_ns()
        if self.reconstruction_sample > 0_u64 && now - self.reconstruction_sample < 500000000_u64 {
            ret()
        }
        if self.reconstruction_sample > 0_u64 && now > self.reconstruction_sample && counts.0 >= self.reconstruction_counts.0 && counts.1 >= self.reconstruction_counts.1 && counts.2 >= self.reconstruction_counts.2 {
            let elapsed = now - self.reconstruction_sample
            self.reconstruction_summary = "Render " +((counts.0 - self.reconstruction_counts.0) * 1000000000_u64 / elapsed).fmt() + " FPS  ·  Generated " +((counts.1 - self.reconstruction_counts.1) * 1000000000_u64 / elapsed).fmt() + "/s  ·  Submitted " +((counts.2 - self.reconstruction_counts.2) * 1000000000_u64 / elapsed).fmt() + "/s  ·  " + input_width.fmt() + "×" + input_height.fmt() + " → " + output_width.fmt() + "×" + output_height.fmt() + "  ·  AA targets " +(tracked_bytes / 1048576_u64).fmt() + " MiB"
        }
        self.reconstruction_sample = now self.reconstruction_counts = counts
    }
    pub fn running(self: Self) -> bool {
        ret self.running
    }
    pub fn handle(self: mut Self, event: Event, target: str, focused: str) -> bool {
        if !self.opened {
            ret false
        }
        if event.kind() == event_pointer_down() {
            self.focused = target == "perf-history"
            if self.focused && self.history_bounds.width() > 48 && value(0_usize, 0_u32) > 0 {
                let count = value(0_usize, 0_u32)
                let fraction =(event.x() - self.history_bounds.x() - 42) /(self.history_bounds.width() - 52)
                let position = if fraction <= 0 {
                    0_u64
                } elif fraction >= 1 {
                    count - 1
                } else {
                    (((count - 1) as f32) * fraction) as u64
                }
                unsafe {
                    graphene_profiler_select(position as u32)
                }
                self.changed = true ret true
            }
        }
        if event.kind() == event_key_down() && focused == "perf-history" {
            if event.key() == key_left() || event.key() == key_right() {
                unsafe {
                    graphene_profiler_step(if event.key() == key_left() {
                            - 1_i32
                        } else {
                            1_i32
                        }
                    )
                }
                self.changed = true ret true
            }
        }
        ret false
    }
    pub fn action(self: mut Self, target: str) -> bool {
        if target == "perf-live" {
            unsafe {
                graphene_profiler_live()
            }
        } elif target == "perf-clear" {
            unsafe {
                graphene_profiler_clear()
            }
        } elif target == "perf-hierarchy" {
            self.collapsed = !self.collapsed
        } elif target == "perf-budget-30" {
            self.budget = 30_u32
        } elif target == "perf-budget-60" {
            self.budget = 60_u32
        } elif target == "perf-budget-120" {
            self.budget = 120_u32
        } elif target == "perf-budget-144" {
            self.budget = 144_u32
        } else {
            ret false
        }
        self.changed = true ret true
    }
    pub fn tick(self: mut Self, sheet: StyleSheet) -> bool {
        if !self.opened {
            ret false
        }
        let now = performance_counter_ns()
        if !self.changed && now - self.refreshed < 100000000_u64 {
            ret false
        }
        let rows = self.table_rows().len()
        let has_frames = value(0_usize, 0_u32) > 0
        // Variable deferred/worker samples must not continuously relayout the
        // dock. Keep sufficient table capacity until an explicit control change.
        let rows = if has_frames && self.had_frames && !self.changed && rows < self.row_count {
            self.row_count
        } else {
            rows
        }
        let controls_changed = self.changed || rows != self.row_count || has_frames != self.had_frames
        self.row_count = rows self.had_frames = has_frames
        self.refreshed = now self.changed = false
        self.history = self.history_display(sheet)
        self.timeline = self.timeline_display(sheet)
        self.summary = self.summary_display(sheet)
        self.table = self.table_display(sheet)
        self.footer = self.footer_display(sheet)
        ret controls_changed
    }
    pub fn layout(self: mut Self, layout: WidgetLayout) ->() {
        let history = layout.find_bounds("perf-history").unwrap_or(Rect::new(0, 0, 0, 0))
        let timeline = layout.find_bounds("perf-timeline").unwrap_or(Rect::new(0, 0, 0, 0))
        self.summary_bounds = layout.find_bounds("perf-summary").unwrap_or(Rect::new(0, 0, 0, 0))
        self.table_bounds = layout.find_bounds("perf-table-values").unwrap_or(Rect::new(0, 0, 0, 0))
        self.table_clip = layout.find_bounds("perf-table").unwrap_or(Rect::new(0, 0, 0, 0))
        self.footer_bounds = layout.find_bounds("perf-footer").unwrap_or(Rect::new(0, 0, 0, 0))
        if history.x() != self.history_bounds.x() || history.y() != self.history_bounds.y() || history.width() != self.history_bounds.width() || history.height() != self.history_bounds.height() || timeline.y() != self.timeline_bounds.y() || timeline.width() != self.timeline_bounds.width() || timeline.height() != self.timeline_bounds.height() {
            self.history_bounds = history self.timeline_bounds = timeline self.changed = true
        }
    }
    pub fn widget(self: Self) -> Widget {
        let count = value(0_usize, 0_u32)
        let mut root = Widget::panel("performance-panel").with_classes("g-perf-panel").with_direction(vertical())
        let mut toolbar = Widget::panel("perf-toolbar").with_classes("g-perf-toolbar").with_direction(horizontal())
        toolbar.push(control("perf-live", "Live", value(0_usize, 1_u32) != 0, false).with_attribute("title", "Follow the newest frame; click the graph to inspect a frame"))
        toolbar.push(control("perf-clear", "Clear", false, count == 0).with_attribute("title", "Clear frame history"))
        toolbar.push(Widget::label("Budget").with_classes("g-perf-muted"))
        for budget in vec![30_u32, 60_u32, 120_u32, 144_u32] {
            toolbar.push(control("perf-budget-" + budget.fmt(), budget.fmt(), self.budget == budget, false).with_attribute("title", "Frame-time reference only; does not limit FPS"))
        }
        toolbar.push(Widget::label("Frame").with_classes("g-perf-frame"))
        toolbar.push(Widget::label("CPU").with_classes("g-perf-cpu"))
        toolbar.push(Widget::label("GPU").with_classes("g-perf-gpu"))
        root.push(toolbar)
        root.push(Widget::canvas("perf-summary").with_classes("g-perf-summary"))
        let mut body = Widget::panel("perf-body").with_classes("g-perf-body").with_direction(horizontal())
        let mut charts = Widget::panel("perf-charts").with_classes("g-perf-charts").with_direction(vertical())
        charts.push(Widget::canvas("perf-history").with_classes("g-perf-history").with_focus(self.focused).with_attribute("tabindex", "0").with_attribute("data-luma-focusable", "true").with_attribute("role", "group").with_attribute("aria-label", "Frame history. Click to select; left and right arrows step through frames"))
        charts.push(Widget::canvas("perf-timeline").with_classes("g-perf-timeline"))
        body.push(charts)
        let mut table = Widget::panel("perf-table").with_classes("g-perf-table").with_direction(vertical()).with_attribute("data-luma-scrollable", "true")
        table.push(control("perf-hierarchy", if self.collapsed {
                    "+ GPU details"
                } else {
                    "− GPU details"
                }
                , !self.collapsed, false,))
        table.push(Widget::canvas("perf-table-values").with_classes("g-perf-table-values").with_computed_style(Style::default().with_height((self.table_rows().len() as f32) * 18 + 8)))
        body.push(table) root.push(body)
        root.push(Widget::canvas("perf-footer").with_classes("g-perf-footer"))
        ret root
    }
    fn table_rows(self: Self) -> Vec[str] {
        let mut rows = Vec[str]::new()
        rows.push("CPU stages · work / wait")
        for index in 0_usize..selected(8_u32) as usize {
            let elapsed = event_value(0_usize, index, 2_u32)
            let wait = event_value(0_usize, index, 4_u32)
            let work = if elapsed > wait {
                elapsed - wait
            } else {
                0_u64
            }
            let share = if selected(4_u32) > 0 {
                work * 100 / selected(4_u32)
            } else {
                0_u64
            }
            rows.push(cpu_name(event_value(0_usize, index, 0_u32)) + "   " + duration(work) + " " + share.fmt() + "%" + if wait > 0 {
                    " / " + duration(wait)
                } else {
                    ""
                }
            )
        }
        rows.push("UI upload / record " + duration(selected(14_u32)) + " · " +(selected(15_u32) / 1024_u64).fmt() + " KiB")
        rows.push("GPU stages · inclusive")
        if selected(7_u32) == 1 {
            for index in 0_usize..selected(9_u32) as usize {
                let depth = event_value(1_usize, index, 3_u32)
                if !self.collapsed || depth == 0 {
                    let share = if selected(5_u32) > 0 {
                        event_value(1_usize, index, 2_u32) * 100 / selected(5_u32)
                    } else {
                        0_u64
                    }
                    rows.push(if depth > 0 {
                            "  · "
                        } else {
                            ""
                        }
                        + gpu_name(event_value(1_usize, index, 0_u32)) + "   " + duration(event_value(1_usize, index, 2_u32)) + "  " + share.fmt() + "%")
                }
            }
            for label in vec![1_u64, 2_u64, 3_u64, 4_u64, 5_u64, 6_u64, 7_u64, 8_u64, 9_u64, 10_u64] {
                let mut found = false
                for index in 0_usize..selected(9_u32) as usize {
                    if event_value(1_usize, index, 0_u32) == label {
                        found = true
                    }
                }
                if !found {
                    rows.push(gpu_name(label) + " · Skipped")
                }
            }
        } else {
            rows.push(gpu_state(selected(7_u32)))
        }
        ret rows
    }
    fn table_display(self: Self, sheet: StyleSheet) -> DisplayList {
        let mut list = DisplayList::new()
        let text = self.colors.get(sheet, "text") let muted = self.colors.get(sheet, "muted")
        let rows = self.table_rows()
        for index in 0_usize..rows.len() {
            let y = self.table_bounds.y() + 4 +(index as f32) * 18
            if y + 18 > self.table_clip.y() && y < self.table_clip.bottom() {
                list.text(self.table_bounds.x() + 4, y, rows.get_unchecked_borrowed(index), if index == 0 {
                        text
                    } else {
                        muted
                    }
                    ,
                )
            }
        }
        ret list
    }
    fn summary_display(self: Self, sheet: StyleSheet) -> DisplayList {
        let mut list = DisplayList::new()
        let x = self.summary_bounds.x() let y = self.summary_bounds.y() + 4
        let count = value(0_usize, 0_u32)
        let mean = unsafe {
            graphene_profiler_stat(0_u32)
        }
        let p95 = unsafe {
            graphene_profiler_stat(1_u32)
        }
        list.text(x, y, if count == 0 {
                "Waiting for frames"
            } else {
                "Frame #" + selected(2_u32).fmt() + "  " + duration(selected(3_u32)) + "  ·  CPU " + duration(selected(4_u32)) + "  ·  GPU " + gpu_state(selected(7_u32)) + "  ·  Wait " + duration(selected(6_u32))
            }
            , self.colors.get(sheet, "text"),)
        list.text(x, y + 18, self.reconstruction_summary + if self.displacement_summary != "" {
                "  ·  " + self.displacement_summary
            } else {
                ""
            }
            , self.colors.get(sheet, "muted"),)
        if self.summary_bounds.width() > 1050 {
            list.text(self.summary_bounds.right() - 210, y, "Mean " + duration(mean) + "  P95 " + duration(p95), self.colors.get(sheet, "muted"))
        }
        ret list
    }
    fn footer_display(self: Self, sheet: StyleSheet) -> DisplayList {
        let mut list = DisplayList::new()
        let bottleneck = unsafe {
            graphene_profiler_bottleneck()
        }
        let message = if selected(11_u32) != 0 {
            "Marker capacity exceeded · incomplete sample"
        } elif value(0_usize, 10_u32) == 0 {
            "GPU timestamps unavailable · CPU stages remain available"
        } elif bottleneck == 1 {
            "Likely CPU limited · inspect CPU stages"
        } elif bottleneck == 2 {
            "Likely GPU limited · inspect GPU stages"
        } elif bottleneck == 3 {
            "Wait / Present dominates · includes driver and presentation pacing"
        } elif bottleneck == 4 {
            "Mixed CPU / GPU workload"
        } else {
            "Collecting 60 complete CPU/GPU frames for analysis"
        }
        list.text(self.footer_bounds.x() + 3, self.footer_bounds.y() + 2, message, self.colors.get(sheet, "muted"))
        ret list
    }
    fn history_display(self: Self, sheet: StyleSheet) -> DisplayList {
        let frame_color = self.colors.get(sheet, "frame") let cpu_color = self.colors.get(sheet, "cpu") let gpu_color = self.colors.get(sheet, "gpu")
        let grid_color = self.colors.get(sheet, "grid") let budget_color = self.colors.get(sheet, "budget") let muted_color = self.colors.get(sheet, "muted") let text_color = self.colors.get(sheet, "text")
        let mut list = DisplayList::with_capacity(32, 0) let bounds = self.history_bounds
        if bounds.width() < 60 || bounds.height() < 40 {
            ret list
        }
        let surface = sheet.style(Widget::panel("").with_classes("g-perf-history"), false, false, false)
        list.fill_rect(bounds, surface.background())
        let x = bounds.x() + 42 let y = bounds.y() + 12 let width = bounds.width() - 52 let height = bounds.height() - 29
        let budget = 1000000000_u64 / self.budget as u64
        let count = value(0_usize, 0_u32)
        let mut maximum = budget * 2
        for index in 0_usize..count as usize {
            let ns = value(index, 3_u32)
            if ns > maximum {
                maximum = ns
            }
        }
        for index in 0_usize..4_usize {
            let ratio = index as f32 / 3
            let line_y = y + height * ratio
            list.line(x, line_y, x + width, line_y, 1, grid_color)
        }
        list.text(bounds.x() + 3, y, milliseconds(maximum), muted_color)
        list.text(bounds.x() + 3, y + height - 12, "0 ms", muted_color)
        let budget_y = y + height *(1 - budget as f32 / maximum as f32)
        list.line(x, budget_y, x + width, budget_y, 1, budget_color)
        list.text(x + 4, budget_y - 13, duration(budget), budget_color)
        for series in 0_usize..3_usize {
            let tint = if series == 0 {
                frame_color
            } elif series == 1 {
                cpu_color
            } else {
                gpu_color
            }
            let mut points = Vec[DisplayPoint]::with_capacity(count as usize)
            let mut selected_x = Option[f32]::None
            for index in 0_usize..count as usize {
                let valid = series != 2 || value(index, 7_u32) == 1
                let ns = value(index, if series == 0 {
                        3_u32
                    } elif series == 1 {
                        4_u32
                    } else {
                        5_u32
                    }
                    ,
                )
                let px = x + if count > 1 {
                    width *(index as f32) /((count - 1) as f32)
                } else {
                    0_f32
                }
                let fraction = ns as f32 / maximum as f32
                let py = y + height *(1 - if fraction > 1 {
                        1_f32
                    } else {
                        fraction
                    }
                )
                if valid {
                    points.push(DisplayPoint::new(px, py))
                } elif points.len() > 0 {
                    list.path(points, 1.5_f32, tint, false)
                    points = Vec[DisplayPoint]::with_capacity(count as usize)
                }
                if value(index, 2_u32) == selected(2_u32) && series == 0 {
                    selected_x = Option[f32]::Some(px)
                }
            }
            list.path(points, 1.5_f32, tint, false)
            match selected_x {
                Some(px) => list.line(px, y, px, y + height, 1, text_color) None => {
                }
            }
        }
        list.text(x, y + height + 3, "Last " + count.fmt() + " frames · click to inspect", muted_color)
        ret list
    }
    fn timeline_display(self: Self, sheet: StyleSheet) -> DisplayList {
        let cpu_color = self.colors.get(sheet, "cpu") let gpu_color = self.colors.get(sheet, "gpu") let child_color = self.colors.get(sheet, "gpu-child") let muted_color = self.colors.get(sheet, "muted")
        let mut list = DisplayList::new() let bounds = self.timeline_bounds
        if bounds.width() < 60 || bounds.height() < 60 {
            ret list
        }
        let x = bounds.x() + 42 let width = bounds.width() - 52
        list.text(bounds.x() + 3, bounds.y() + 8, "CPU", cpu_color)
        list.text(bounds.x() + 3, bounds.y() + 50, "GPU", gpu_color)
        for gpu in 0_usize..2_usize {
            let count = selected(if gpu == 0 {
                    8_u32
                } else {
                    9_u32
                }
            ) as usize
            let mut maximum = 1_u64
            for index in 0_usize..count {
                let end = event_value(gpu, index, 1_u32) + event_value(gpu, index, 2_u32)
                if end > maximum {
                    maximum = end
                }
            }
            for index in 0_usize..count {
                if gpu == 0 || selected(7_u32) == 1 {
                    let start = event_value(gpu, index, 1_u32) as f32 / maximum as f32
                    let duration = event_value(gpu, index, 2_u32) as f32 / maximum as f32
                    let depth = event_value(gpu, index, 3_u32) as f32
                    let y = bounds.y() + 8 +(gpu as f32) * 42 + depth * 15
                    let bar_width = if width * duration < 1 {
                        1_f32
                    } else {
                        width * duration
                    }
                    list.fill_rect(Rect::new(x + width * start, y, bar_width, 12), if gpu == 0 {
                            cpu_color
                        } elif depth > 0 {
                            child_color
                        } else {
                            gpu_color
                        }
                        ,
                    )
                }
            }
        }
        list.text(x, bounds.bottom() - 15, "Separate CPU / GPU origins · nested GPU bars are inclusive", muted_color)
        ret list
    }
    pub fn compose_stats(self: mut Self, frame: PreparedFrame, sheet: StyleSheet, enabled: bool) -> PreparedFrame {
        if !enabled {
            self.stats_refreshed = 0
            ret frame
        }
        let bounds = match frame.surface("viewport-surface") {
            Some(slot) => slot.logical_bounds()
            None => {
                ret frame
            }
        }
        if bounds.width() < 40 || bounds.height() < 40 {
            ret frame
        }
        let width = if bounds.width() < 320 {
            bounds.width() - 20
        } else {
            300_f32
        }
        let x = bounds.right() - width - 10 let y = bounds.y() + 10
        let now = performance_counter_ns()
        if self.stats_refreshed == 0 || now - self.stats_refreshed >= 100000000_u64 || self.stats_bounds != bounds || !self.colors.matches(sheet) {
            self.stats_refreshed = now self.stats_bounds = bounds
            let mut list = DisplayList::with_capacity(32, 0)
            list.fill_rect(Rect::new(x, y, width, 206), self.colors.get(sheet, "hud"))
            let count = value(0_usize, 0_u32) as usize
            let first = if count > 120 {
                count - 120
            } else {
                0_usize
            }
            let mut sample = if count > 0 {
                count - 1
            } else {
                0_usize
            }
            let mut cursor = count
            while cursor > first {
                cursor -= 1_usize
                if value(cursor, 7_u32) == 1 {
                    sample = cursor break
                }
            }
            let frame_ns = value(sample, 3_u32)
            let fps = if frame_ns > 0 {
                1000000000_u64 / frame_ns
            } else {
                0_u64
            }
            list.text(x + 8, y + 6, if count == 0 {
                    "Waiting for frames"
                } else {
                    fps.fmt() + " FPS · Frame " + duration(frame_ns)
                }
                , self.colors.get(sheet, "text"),)
            list.text(x + 8, y + 24, "CPU work " + duration(value(sample, 4_u32)), self.colors.get(sheet, "cpu"))
            let state = value(sample, 7_u32)
            list.text(x + 8, y + 42, "GPU " + if count == 0 {
                    "Pending"
                } elif state == 1 {
                    duration(value(sample, 5_u32))
                } elif state == 0 {
                    "Pending"
                } elif state == 2 {
                    "Incomplete"
                } else {
                    "Unavailable"
                }
                , self.colors.get(sheet, "gpu"),)
            list.text(x + 8, y + 60, "Wait / Present " + duration(value(sample, 6_u32)), self.colors.get(sheet, "muted"))
            let bottleneck = unsafe {
                graphene_profiler_bottleneck()
            }
            list.text(x + 8, y + 78, if bottleneck == 1 {
                    "Likely CPU limited"
                } elif bottleneck == 2 {
                    "Likely GPU limited"
                } elif bottleneck == 3 {
                    "Wait / Present dominates"
                } elif bottleneck == 4 {
                    "Mixed CPU / GPU"
                } else {
                    "Collecting samples"
                }
                , self.colors.get(sheet, "muted"),)
            let mut maximum = 16666667_u64
            for i in first..count {
                for channel in 0_usize..3_usize {
                    let field =(channel as u32) + 3_u32
                    if field != 5_u32 || value(i, 7_u32) == 1 {
                        let ns = value(i, field)
                        if ns > maximum {
                            maximum = ns
                        }
                    }
                }
            }
            list.text(x + 8, y + 96, "Input " + match self.input_age {
                    Some(ns) => duration(ns) None => "—"
                }
                + " · queue " + self.input_queued.fmt(), self.colors.get(sheet, "muted"),)
            let gx = x + 8 let gy = y + 120 let gw = width - 16 let gh = 60_f32
            let reference = gy + gh *(1_f32 - 16666667_f32 / maximum as f32)
            list.line(gx, reference, gx + gw, reference, 1_f32, self.colors.get(sheet, "budget"))
            for series in 0_usize..3_usize {
                let field = if series == 0 {
                    3_u32
                } elif series == 1 {
                    4_u32
                } else {
                    5_u32
                }
                let tint = self.colors.get(sheet, if series == 0 {
                        "frame"
                    } elif series == 1 {
                        "cpu"
                    } else {
                        "gpu"
                    }
                    ,
                )
                let mut points = Vec[DisplayPoint]::with_capacity(count - first)
                for i in first..count {
                    let valid = series != 2 || value(i, 7_u32) == 1
                    let nx = gx + gw *((i - first) as f32) / 119_f32
                    let ny = gy + gh *(1_f32 - value(i, field) as f32 / maximum as f32)
                    if valid {
                        points.push(DisplayPoint::new(nx, ny))
                    } elif points.len() > 0 {
                        list.path(points, 1.5_f32, tint, false)
                        points = Vec[DisplayPoint]::with_capacity(count - first)
                    }
                }
                list.path(points, 1.5_f32, tint, false)
            }
            list.text(x + 8, y + 188, "Frame", self.colors.get(sheet, "frame"))
            list.text(x + 68, y + 188, "CPU", self.colors.get(sheet, "cpu"))
            list.text(x + 112, y + 188, "GPU", self.colors.get(sheet, "gpu"))
            list.text(x + width - 80, y + 188, "16.7 ms ref", self.colors.get(sheet, "muted"))
            self.stats_cache = list
        }
        ret frame.with_display_overlay(self.stats_cache, bounds)
    }
    pub fn compose(self: Self, frame: PreparedFrame, _layout: WidgetLayout, sheet: StyleSheet) -> PreparedFrame {
        if !self.opened {
            ret frame
        }
        let mut composed = frame
        if self.history_bounds.width() > 0 {
            composed = composed.with_display_overlay(self.history, self.history_bounds)
        }
        if self.timeline_bounds.width() > 0 {
            composed = composed.with_display_overlay(self.timeline, self.timeline_bounds)
        }
        if self.summary_bounds.width() > 0 {
            composed = composed.with_display_overlay(self.summary, self.summary_bounds)
        }
        if self.table_clip.width() > 0 {
            composed = composed.with_display_overlay(self.table, self.table_clip)
        }
        if self.footer_bounds.width() > 0 {
            composed = composed.with_display_overlay(self.footer, self.footer_bounds)
        }
        ret composed
    }
}

/// Bounded profiler data for automation without opening the performance panel.
pub fn profile_snapshot(limit: usize) -> Json {
    let mut samples = Vec[Json]::new()
    let count = value(0, 0) as usize
    let actual = if limit > 120 {
        120_usize
    } else {
        limit
    }
    let first = if count > actual {
        count - actual
    } else {
        0_usize
    }
    for i in first..count {
        samples.push(Json::Object(vec![field("frame", Json::Number(value(i, 2).fmt())), field("frameNs", Json::Number(value(i, 3).fmt())), field("cpuNs", Json::Number(value(i, 4).fmt())), field("gpuNs", Json::Number(value(i, 5).fmt())), field("waitNs", Json::Number(value(i, 6).fmt())), field("gpuState", Json::String(gpu_state(value(i, 7))))]))
    }
    let mut events = Vec[Json]::new()
    for gpu in 0_usize..2_usize {
        let event_count = selected(if gpu == 0 {
                8_u32
            } else {
                9_u32
            }
        ) as usize
        for i in 0_usize..event_count {
            let label = event_value(gpu, i, 0)
            events.push(Json::Object(vec![field("processor", Json::String(if gpu == 0 {
                                    "cpu"
                                } else {
                                    "gpu"
                                }
                            )), field("name", Json::String(if gpu == 0 {
                                    cpu_name(label)
                                } else {
                                    gpu_name(label)
                                }
                            )), field("startNs", Json::Number(event_value(gpu, i, 1).fmt())), field("durationNs", Json::Number(event_value(gpu, i, 2).fmt())), field("depth", Json::Number(event_value(gpu, i, 3).fmt()))]))
        }
    }
    let average = unsafe {
        graphene_profiler_stat(0)
    }
    let p95 = unsafe {
        graphene_profiler_stat(1)
    }
    let bottleneck = unsafe {
        graphene_profiler_bottleneck()
    }
    let native_ui = Json::Object(vec![field("acquireNs", Json::Number(selected(12_u32).fmt())), field("presentNs", Json::Number(selected(13_u32).fmt())), field("gpuPreparationNs", Json::Number(selected(14_u32).fmt())), field("geometryUploadBytes", Json::Number(selected(15_u32).fmt()))])
    ret Json::Object(vec![field("ok", Json::Bool(true)), field("samples", Json::Array(samples)), field("events", Json::Array(events)), field("eventFrame", Json::Number(selected(2_u32).fmt())), field("uiNative", native_ui), field("averageFrameNs", Json::Number(average.fmt())), field("p95FrameNs", Json::Number(p95.fmt())), field("bottleneck", Json::String(if bottleneck == 1 {
                        "cpu"
                    } elif bottleneck == 2 {
                        "gpu"
                    } elif bottleneck == 3 {
                        "wait"
                    } elif bottleneck == 4 {
                        "balanced"
                    } else {
                        "insufficient-samples"
                    }
                ))])
}

fn ui_stage_snapshot(stage: UiStageTimings) -> Json {
    ret Json::Object(vec![field("elapsedNs", Json::Number(stage.elapsed_ns().fmt())), field("maximumNs", Json::Number(stage.maximum_ns().fmt())), field("calls", Json::Number(stage.calls().fmt())), field("units", Json::Number(stage.units().fmt()))])
}
/// Cumulative, opt-in retained work. Compare snapshots to isolate an interval.
pub fn ui_update_snapshot(timings: UiUpdateTimings) -> Json {
    ret Json::Object(vec![field("transaction", ui_stage_snapshot(timings.transaction())), field("other", ui_stage_snapshot(timings.other())), field("bindings", ui_stage_snapshot(timings.bindings())), field("styles", ui_stage_snapshot(timings.styles())), field("reconcile", ui_stage_snapshot(timings.reconcile())), field("layout", ui_stage_snapshot(timings.layout())), field("paint", ui_stage_snapshot(timings.paint())), field("fullCascades", Json::Number(timings.full_cascades().fmt())), field("subtreeCascades", Json::Number(timings.subtree_cascades().fmt()))])
}
