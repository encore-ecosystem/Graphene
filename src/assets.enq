import core::option::Option
import core::vec::Vec

import linalg::Vec3

import mod::mesh_prepare::prepare_mesh_geometry
import mod::rhi::{AccelerationStructure, GpuBuffer, GpuMesh, GraphicsDevice, RenderPassEncoder, buffer_acceleration_structure_input, buffer_shader_device_address, buffer_storage}
import mod::scene::primitive::MeshData
import mod::scene::renderable::{MaterialId, MeshId}
pub import mod::standard_material::StandardMaterial
import mod::virtual_geometry::{GeometryCluster, VirtualGeometry, build_virtual_geometry}
import mod::virtual_geometry_gpu::GpuClusterCullResult

struct MeshAssetEntry {
    id: MeshId
    mesh: GpuMesh
    virtual_mesh: GpuMesh
    virtual_geometry: VirtualGeometry
    ray_vertices: GpuBuffer
    ray_indices: GpuBuffer
    ray_blas: AccelerationStructure
}
struct MaterialAssetEntry {
    id: MaterialId
    material: StandardMaterial
}

pub struct MeshAssets {
    entries: Vec[MeshAssetEntry]
    next_id: u64
}
pub struct MaterialAssets {
    entries: Vec[MaterialAssetEntry]
    next_id: u64
}

impl for MeshAssets {
    pub fn new() -> MeshAssets {
        ret MeshAssets {
            Vec[MeshAssetEntry]::new(), 1_u64
        }
    }
    pub fn len(self: Self) -> usize {
        ret self.entries.len()
    }
    pub fn upload(self: mut Self, device: GraphicsDevice, data: MeshData) -> MeshId {
        ret self.upload_prepared(device, data, prepare_mesh_geometry(data))
    }
    /// Uploads an imported mesh without running the AutoLOD simplifier.
    pub fn upload_prepared(self: mut Self, device: GraphicsDevice, data: MeshData,
        virtual_geometry: VirtualGeometry,) -> MeshId {
        let data = data.with_uvs()
        let values = data.vertices()
        let indices = data.indices()
        let stride =(data.stride() / 4) as usize
        if !virtual_geometry.valid() {
            ret MeshId::new(0_u64)
        }
        let packed_vertex_indices = virtual_geometry.vertex_indices()
        let packed_triangle_indices = virtual_geometry.triangle_indices()
        let mut packed_values = Vec[f32]::new()
        for vertex in packed_vertex_indices {
            let source =(vertex as usize) * stride
            let mut component = 0_usize
            while component < stride {
                match values.get(source + component) {
                    Option::Some(value) => {
                        packed_values.push(value)
                    }
                    Option::None => {
                        packed_values.push(0.0_f32)
                    }
                }
                component += 1_usize
            }
        }
        let virtual_mesh = device.create_mesh(packed_values, packed_triangle_indices)
        if !virtual_mesh.available() {
            ret MeshId::new(0_u64)
        }
        let mesh = device.create_mesh(values, indices)
        if !mesh.available() {
            virtual_mesh.destroy()
            ret MeshId::new(0_u64)
        }
        // Keep one reusable BLAS per mesh asset. TLAS construction can then
        // instance the actual mesh assigned to each actor instead of treating
        // every editor object as the built-in cube.
        let ray_usage = buffer_storage() |
        buffer_shader_device_address() |
        buffer_acceleration_structure_input()
        let ray_vertices = device.create_buffer(
            (values.len() as u64) * 4_u64, ray_usage, true,)
        let ray_indices = device.create_buffer(
            (indices.len() as u64) * 4_u64, ray_usage, true,)
        let ray_uploaded = ray_vertices.available() && ray_indices.available() &&
        ray_vertices.write_f32s(0_u64, values) &&
        ray_indices.write_u32s(0_u64, indices)
        let ray_blas = if ray_uploaded {
            device.create_triangle_blas(
                ray_vertices, data.stride() as u64,
                (data.vertices().len() / stride) as u32,
                ray_indices, data.indices().len() as u32,)
        } else {
            AccelerationStructure::unavailable()
        }
        let id = MeshId::new(self.next_id)
        self.next_id = self.next_id + 1_u64
        self.entries.push(MeshAssetEntry {
                id, mesh, virtual_mesh, virtual_geometry,
                ray_vertices, ray_indices, ray_blas
            }
            ,
        )
        ret id
    }
    /// Classic editable geometry bypasses mesh simplification and mesh-shader resources.
    /// The caller must retire all frame consumers before replacing an existing mesh.
    pub fn update_editable(self: mut Self, device: GraphicsDevice, id: MeshId, data: MeshData) -> MeshId {
        let data = data.with_uvs()
        let mesh = device.create_mesh(data.vertices(), data.indices())
        if !mesh.available() {
            ret MeshId::new(0_u64)
        }
        if id.valid() {
            for i in 0_usize..self.entries.len() {
                let mut entry = self.entries.get_unchecked_borrowed(i)
                if entry.id.value() == id.value() {
                    // Only entries created here may enter this path.
                    if entry.virtual_mesh.available() {
                        mesh.destroy() ret MeshId::new(0_u64)
                    }
                    entry.mesh.destroy() entry.mesh = mesh self.entries.set(i, entry) ret id
                }
            }
            mesh.destroy() ret MeshId::new(0_u64)
        }
        let next = MeshId::new(self.next_id) self.next_id += 1_u64
        self.entries.push(MeshAssetEntry {
                next, mesh, GpuMesh::unavailable(),
                build_virtual_geometry(Vec[Vec3]::new(), Vec[u32]::new(), 64, 126),
                GpuBuffer::unavailable(), GpuBuffer::unavailable(), AccelerationStructure::unavailable()
            }
        )
        ret next
    }
    pub fn contains(self: Self, id: MeshId) -> bool {
        if !id.valid() {
            ret false
        }
        for entry in self.entries {
            if entry.id.value() == id.value() {
                ret entry.mesh.available()
            }
        }
        ret false
    }
    pub fn draw(self: Self, pass: RenderPassEncoder, id: MeshId) -> bool {
        for entry in self.entries {
            if entry.id.value() == id.value() {
                ret pass.draw_mesh(entry.mesh)
            }
        }
        ret false
    }
    pub fn draw_instanced(self: Self, pass: RenderPassEncoder, id: MeshId,
        instance_count: u32, first_instance: u32,) -> bool {
        for entry in self.entries {
            if entry.id.value() == id.value() {
                ret entry.mesh.draw_instanced(pass, instance_count, first_instance)
            }
        }
        ret false
    }
    /// Draws the compacted GPU-selected cluster stream for this mesh.
    pub fn draw_virtual(self: Self, pass: RenderPassEncoder, id: MeshId,
        cull: GpuClusterCullResult,) -> bool {
        for entry in self.entries {
            if entry.id.value() == id.value() {
                ret entry.virtual_mesh.available() &&
                pass.bind_vertex_buffer(entry.virtual_mesh.vertex_buffer()) &&
                pass.bind_index_buffer(entry.virtual_mesh.index_buffer()) &&
                cull.draw(pass)
            }
        }
        ret false
    }
    pub fn virtual_clusters(self: Self, id: MeshId) -> Vec[GeometryCluster] {
        for entry in self.entries {
            if entry.id.value() == id.value() {
                ret entry.virtual_geometry.clusters()
            }
        }
        ret Vec[GeometryCluster]::new()
    }
    /// Returns the immutable bottom-level acceleration structure cached for
    /// this mesh. Unsupported devices expose an unavailable handle so callers
    /// can retain the software tracing fallback.
    pub fn acceleration(self: Self, id: MeshId) -> AccelerationStructure {
        for entry in self.entries {
            if entry.id.value() == id.value() {
                ret entry.ray_blas
            }
        }
        ret AccelerationStructure::unavailable()
    }
    pub fn destroy(self: Self) -> bool {
        let mut destroyed = true
        for entry in self.entries {
            if entry.ray_blas.available() && !entry.ray_blas.destroy() {
                destroyed = false
            }
            if entry.ray_indices.available() && !entry.ray_indices.destroy() {
                destroyed = false
            }
            if entry.ray_vertices.available() && !entry.ray_vertices.destroy() {
                destroyed = false
            }
            if !entry.mesh.destroy() {
                destroyed = false
            }
            if entry.virtual_mesh.available() && !entry.virtual_mesh.destroy() {
                destroyed = false
            }
        }
        ret destroyed
    }
}

impl for MaterialAssets {
    pub fn new() -> MaterialAssets {
        ret MaterialAssets {
            Vec[MaterialAssetEntry]::new(), 1_u64
        }
    }
    pub fn len(self: Self) -> usize {
        ret self.entries.len()
    }
    pub fn add(self: mut Self, material: StandardMaterial) -> MaterialId {
        let id = MaterialId::new(self.next_id)
        self.next_id = self.next_id + 1_u64
        self.entries.push(MaterialAssetEntry {
                id, material
            }
            ,
        )
        ret id
    }
    pub fn get(self: Self, id: MaterialId) -> Option[StandardMaterial] {
        if !id.valid() {
            ret Option[StandardMaterial]::None
        }
        for entry in self.entries {
            if entry.id.value() == id.value() {
                ret Option[StandardMaterial]::Some(entry.material)
            }
        }
        ret Option[StandardMaterial]::None
    }
    pub fn set(self: mut Self, id: MaterialId, material: StandardMaterial) -> bool {
        if !id.valid() {
            ret false
        }
        let mut index = 0_usize
        while index < self.entries.len() {
            match self.entries.get(index) {
                Option[MaterialAssetEntry]::Some(entry) => {
                    if entry.id.value() == id.value() {
                        self.entries.set(index, MaterialAssetEntry {
                                id, material
                            }
                            ,
                        )
                        ret true
                    }
                }
                Option[MaterialAssetEntry]::None => {
                }
            }
            index = index + 1_usize
        }
        ret false
    }
}
