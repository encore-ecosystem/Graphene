//! File-picker imports retain R16 height data and use stable native asset paths.
import core::vec::Vec
import std::os::{mkdir_all,write_file}
import std::time::perf_counter_ns
import std::io::println
import graphene::material_images::import_pbr_map
import graphene::native_asset::{load_native_height,load_native_texture}
extern fn graphene_asset_bytes(data: u8*,count: usize) -> str
#attr(safe)
fn png() -> str {let bytes=vec![137_u8,80_u8,78_u8,71_u8,13_u8,10_u8,26_u8,10_u8,0_u8,0_u8,0_u8,13_u8,73_u8,72_u8,68_u8,82_u8,0_u8,0_u8,0_u8,6_u8,0_u8,0_u8,0_u8,1_u8,16_u8,0_u8,0_u8,0_u8,0_u8,136_u8,50_u8,92_u8,111_u8,0_u8,0_u8,0_u8,21_u8,73_u8,68_u8,65_u8,84_u8,120_u8,156_u8,99_u8,96_u8,96_u8,96_u8,96_u8,172_u8,255_u8,223_u8,192_u8,240_u8,255_u8,223_u8,255_u8,255_u8,0_u8,23_u8,250_u8,5_u8,251_u8,67_u8,104_u8,90_u8,138_u8,0_u8,0_u8,0_u8,0_u8,73_u8,69_u8,78_u8,68_u8,174_u8,66_u8,96_u8,130_u8] unsafe {ret graphene_asset_bytes(bytes.as_ptr(),bytes.len())}}
fn main() -> u32 {
 let root="/tmp/graphene-pbr-map-import-"+perf_counter_ns().fmt()
 if mkdir_all(root)!=0 || write_file(root+"/height.png",png())!=0 {ret 1}
 let height_worker=spawn import_pbr_map(root,root+"/height.png",true) let height=height_worker.join()
 if height.error!="" {println(height.error) ret 2}
 let native=match load_native_height(root+"/"+height.path,"") {Ok(h)=>h Err(_)=>{ret 3}}
 let expected=vec![0_u16,1_u16,32767_u16,32768_u16,65534_u16,65535_u16]
 for i in 0_usize..6_usize {if native.samples.get_unchecked_borrowed(i)!=expected.get_unchecked_borrowed(i) {ret 4}}
 let repeat_worker=spawn import_pbr_map(root,root+"/height.png",true)
 if repeat_worker.join().path!=height.path {ret 5}
 let mask_worker=spawn import_pbr_map(root,root+"/height.png",false) let mask=mask_worker.join()
 if mask.error!="" || mask.path==height.path {ret 6}
 let texture=match load_native_texture(root+"/"+mask.path,"") {Ok(t)=>t Err(_)=>{ret 7}}
 if (texture.pixels.get_unchecked_borrowed(2)&255)!=127 || (texture.pixels.get_unchecked_borrowed(3)&255)!=128 {ret 8}
 let native_worker=spawn import_pbr_map(root,root+"/"+height.path,true) let copy=native_worker.join()
 if copy.error!="" {ret 9}
 let copied=match load_native_height(root+"/"+copy.path,"") {Ok(h)=>h Err(_)=>{ret 10}}
 for i in 0_usize..6_usize {if copied.samples.get_unchecked_borrowed(i)!=expected.get_unchecked_borrowed(i) {ret 11}}
 let missing=spawn import_pbr_map(root,root+"/missing.png",true)
 if missing.join().error=="" {ret 12}
 println("PBR map imports: stable native paths, PNG/native R16 precision, grayscale masks, errors: PASS") ret 0
}
