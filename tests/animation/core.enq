    if has_morph {
        morphs.push(MorphTarget { "Face", 0_f32, 1_f32, 0_f32, Vec[MorphDelta]::new() }) tracks.push(AnimationTrack {
                0_u32, TrackPath::Morph, KeyInterpolation::Linear, vec![key(0_f32, AnimationValue::zero()), key(2_f32, value(1_f32, 0_f32, 0_f32, 0_f32))]
            }
            ,
        )
    }
    let mesh = SkeletalMesh {
        1_u32, "additive-notify", rig.identity, "Mesh", vec![vertex], vec![0_u32, 0_u32, 0_u32], vec![PoseMatrix::identity(), PoseMatrix::identity()], vec![SkinSection {
                "Default", 0_u32, 3_u32, "Material"
            }
        ], morphs
    }
    let base = AnimationClip {
        1_u32, "base", rig.identity, "Base", 2_f32, Vec[AnimationTrack]::new(), vec![AnimationNotify {
                0.25_f32, "base", ""
            }
        ]
    }
    let layer = AnimationClip {
        1_u32, "layer", rig.identity, "Layer", 2_f32, tracks, vec![AnimationNotify {
                0.25_f32, "layer", ""
            }
        ]
    }
    let reference = AnimationClip {
        1_u32, "reference", rig.identity, "Reference", 2_f32, Vec[AnimationTrack]::new(), vec![AnimationNotify {
                0.25_f32, "reference", ""
            }
        ]
    }
    let graph = AnimationGraph {
        1_u32, rig.identity, Vec[AnimationParameter]::new(), vec![BoneMask {
                rig.identity, vec![0_f32, 0_f32]
            }
        ], vec![AnimationNode {
                1_u64, PoseOperation::Clip, Vec[u64]::new(), 0_u32, 0_f32, Option[u32]::None, 0_u32
            }
            , AnimationNode {
                2_u64, PoseOperation::Clip, Vec[u64]::new(), 1_u32, 0_f32, Option[u32]::None, 0_u32
            }
            , AnimationNode {
                3_u64, PoseOperation::Clip, Vec[u64]::new(), 2_u32, 0_f32, Option[u32]::None, 0_u32
            }
            , AnimationNode {
                4_u64, PoseOperation::Additive, vec![1_u64, 2_u64, 3_u64], 0_u32, 1_f32, Option[u32]::None, 0_u32
            }
        ], 4_u64
    }
    let mut world = AnimationWorld::new()
    let id = match world.instantiate(rig, mesh, vec![base, layer, reference], 0_u32) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if world.bind_graph(id, graph).is_err() || world.advance(1_u64, 0.5_f64).is_err() {
        ret false
    }
    let events = world.take_events(id).unwrap_or(Vec[AnimationEvent]::new())
    if events.len() != if has_morph {
        2_usize
    } else {
        1_usize
    }
    {
        ret false
    }
    if events.get_unchecked_borrowed(0_usize).node.unwrap_or(0_u64) != 1_u64 {
        ret false
    }
    if has_morph {
        if events.get_unchecked_borrowed(1_usize).node.unwrap_or(0_u64) != 2_u64 {
            ret false
        }
        let snapshot = match world.snapshot(id) {
            Ok(v) => v Err(_) => {
                ret false
            }
        }
        let morphs = world.morphs(snapshot).unwrap_or(Vec[f32]::new()) if morphs.len() != 1_usize || !near(morphs.get_unchecked_borrowed(0_usize), 0.25_f32) {
            ret false
        }
    }
    ret true
}
