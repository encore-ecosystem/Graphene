        }
    }
    if unchanged_weights.get_unchecked_borrowed(0_usize) != 1_f32 {
        ret 91_u32
    }
    if world.set_morphs(shared, Vec[str]::new(), Vec[f32]::new()).is_err() {
        ret 92_u32
    }
    let reset = match world.advance(7_u64, 0_f64) {
        Ok(v) => v Err(_) => {
            ret 93_u32
        }
    }
    if reset.sampled != 1_u32 {
        ret 94_u32
    }
    let mut bad = rig let mut b = bad.bones.get_unchecked_borrowed(1_usize) b.parent = 1_i32 bad.bones.set(1_usize, b)
    if bad.validate().is_ok() {
        ret 29_u32
    }
    ret 0_u32
}

fn child_root_motion() -> bool {
    let parent = LocalTransform {
        PoseVector { 3_f32, 4_f32, 5_f32 }, PoseRotation {
            0_f32, 0_f32, 0.70710678118_f32, 0.70710678118_f32
        }
        , PoseVector {
            2_f32, 2_f32, 2_f32
        }
    }
    let rig = Skeleton {
        1_u32, "child-root", "Child root", vec![SkeletonBone { "Armature", - 1_i32, parent }, SkeletonBone {
                "Hips", 0_i32, LocalTransform::identity()
            }
        ], Vec[SkeletonSocket]::new()
    }
    let parent_track = AnimationTrack {
        0_u32, TrackPath::Translation, KeyInterpolation::Linear, vec![key(0_f32, value(3_f32, 4_f32, 5_f32, 0_f32)), key(2_f32, value(5_f32, 4_f32, 5_f32, 0_f32))]
    }
    let child_track = AnimationTrack {
        1_u32, TrackPath::Translation, KeyInterpolation::Linear, vec![key(0_f32, AnimationValue::zero()), key(2_f32, value(2_f32, 0_f32, 0_f32, 0_f32))]
    }
    let clip = AnimationClip {
        1_u32, "child-motion", rig.identity, "Move", 2_f32, vec![parent_track, child_track], Vec[AnimationNotify]::new()
    }
    let motion = match extract_root_motion(clip, rig, 1_u32, 0_f64, 1_f64, false) {
        Ok(m) => m Err(_) => {
            ret false
        }
    }
    if !near(motion.translation.x, 1_f32) || !near(motion.translation.y, 2_f32) {
        ret false
    }
    let v = SkinVertex {
        PoseVector::zero(), PoseVector { 0_f32, 0_f32, 1_f32 }, value(1_f32, 0_f32, 0_f32, 1_f32), AnimationValue::zero(), vec![SkinInfluence {
                1_u32, 1_f32
            }
        ]
    }
    let mesh = SkeletalMesh {
        1_u32, "child-mesh", rig.identity, "One", vec![v], vec![0_u32, 0_u32, 0_u32], vec![PoseMatrix::identity(), PoseMatrix::identity()], vec![SkinSection {
                "Default", 0_u32, 3_u32, "Material"
            }
        ], Vec[MorphTarget]::new()
    }
    let mut world = AnimationWorld::new()
    let instance = match world.instantiate(rig, mesh, vec![clip], 0_u32) {
        Ok(i) => i Err(_) => {
            ret false
        }
    }
    if world.root_motion(instance, Option::Some(1_u32)).is_err() || world.advance(1_u64, 1_f64).is_err() {
        ret false
    }
    let snapshot = match world.snapshot(instance) {
        Ok(s) => s Err(_) => {
            ret false
        }
    }
    let model = match world.model(snapshot) {
        Ok(m) => m Err(_) => {
            ret false
        }
    }
    let position = model.get_unchecked_borrowed(1_usize).translation()
    ret near(position.x, 3_f32) && near(position.y, 4_f32) && near(position.z, 5_f32)
}

fn blend_near(a: f32, b: f32) -> bool {
    ret animation_abs(a - b) < 0.0001_f32
}
fn blend_space_checks() -> u32 {
    let mut space = BlendSpace {
        1_u32, "test", 1_u32, BlendAxis { "Speed", 0_f32, 10_f32 }, BlendAxis {
            "Direction", 0_f32, 1_f32
        }
        , vec![BlendSample {
                0_f32, 0_f32, 0_u32, 1_f32
            }
            , BlendSample {
                10_f32, 0_f32, 1_u32, 1_f32
            }
        ]
    }
    let cooked = match cook_blend_space(space, 2_usize) {
        Ok(c) => c Err(_) => {
            ret 1_u32
        }
    }
    let mut cursor = BlendSpaceCursor::new()
    let w = match cursor.weights(cooked, 2.5_f32, 0_f32) {
        Ok(w) => w Err(_) => {
            ret 2_u32
        }
    }
    if !blend_near(w.wa, 0.75_f32) || !blend_near(w.wb, 0.25_f32) {
        ret 3_u32
    }
    space.dimensions = 2_u32
    space.samples = vec![BlendSample { 0_f32, 0_f32, 0_u32, 1_f32 }, BlendSample {
            10_f32, 0_f32, 1_u32, 1_f32
        }
        , BlendSample {
            0_f32, 1_f32, 2_u32, 1_f32
        }
        , BlendSample {
            10_f32, 1_f32, 3_u32, 1_f32
        }
    ]
    let cooked = match cook_blend_space(space, 4_usize) {
        Ok(c) => c Err(_) => {
            ret 4_u32
        }
    }
    if cooked.triangles.len() != 2_usize {
        ret 5_u32
    }
    for x in 0_usize..21_usize {
        for y in 0_usize..21_usize {
            let x =(x as f32) * 0.5_f32 let y =(y as f32) * 0.05_f32
            let w = match cursor.weights(cooked, x, y) {
                Ok(w) => w Err(_) => {
                    ret 6_u32
                }
            }
            let a = space.samples.get_unchecked_borrowed(w.a as usize) let b = space.samples.get_unchecked_borrowed(w.b as usize) let c = space.samples.get_unchecked_borrowed(w.c as usize)
            if w.wa < 0_f32 || w.wb < 0_f32 || w.wc < 0_f32 || !blend_near(w.wa + w.wb + w.wc, 1_f32) || !blend_near(a.x * w.wa + b.x * w.wb + c.x * w.wc, x) || !blend_near(a.y * w.wa + b.y * w.wb + c.y * w.wc, y) {
                ret 7_u32
            }
        }
    }
    if !blend_properties() {
        ret 8_u32
    }
    ret 0_u32
}

fn blend_properties() -> bool {
    let axis = BlendAxis { "Axis", 0_f32, 1_f32 }
    let mut space = BlendSpace {
        1_u32, "test", 2_u32, axis, axis, vec![BlendSample { 0_f32, 0_f32, 0_u32, 1_f32 }, BlendSample {
                0.5_f32, 0.5_f32, 1_u32, 1_f32
            }
            , BlendSample {
                1_f32, 1_f32, 2_u32, 1_f32
            }
        ]
    }
    let line = match cook_blend_space(space, 3_usize) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if line.triangles.len() != 0_usize || line.line.len() != 3_usize {
        ret false
    }
    let mut cursor = BlendSpaceCursor::new()
    let w = match cursor.weights(line, 0.25_f32, 0.25_f32) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if !blend_near(w.wa, 0.5_f32) || !blend_near(w.wb, 0.5_f32) {
        ret false
    }
    let mut seed = 713_u64
    for dataset in 0_usize..12_usize {
        let mut samples = Vec[BlendSample]::new()
        for i in 0_usize..64_usize {
            seed =(seed * 1664525_u64 + 1013904223_u64) % 4294967296_u64 let x =((seed % 1000000_u64) as f32) / 1000000_f32
            seed =(seed * 1664525_u64 + 1013904223_u64) % 4294967296_u64 let y =((seed % 1000000_u64) as f32) / 1000000_f32
            samples.push(BlendSample { x, y, i as u32, 1_f32 })
        }
        space.samples = samples
        let cooked = match cook_blend_space(space, 64_usize) {
            Ok(v) => v Err(_) => {
                ret false
            }
        }
        if cooked.triangles.len() < 1_usize {
            ret false
        }
        for i in 0_usize..64_usize {
            let p = samples.get_unchecked_borrowed(i)
            let q = samples.get_unchecked_borrowed((i + 17_usize) % 64_usize)
            for fraction in vec![0_f32, 0.25_f32, 0.5_f32, 0.75_f32, 1_f32] {
                let x = p.x *(1_f32 - fraction) + q.x * fraction let y = p.y *(1_f32 - fraction) + q.y * fraction
                let w = match cursor.weights(cooked, x, y) {
                    Ok(v) => v Err(_) => {
                        ret false
                    }
                }
                let a = samples.get_unchecked_borrowed(w.a as usize) let b = samples.get_unchecked_borrowed(w.b as usize) let c = samples.get_unchecked_borrowed(w.c as usize)
                if !blend_near(a.x * w.wa + b.x * w.wb + c.x * w.wc, x) || !blend_near(a.y * w.wa + b.y * w.wb + c.y * w.wc, y) || !blend_near(w.wa + w.wb + w.wc, 1_f32) {
                    ret false
                }
            }
        }
    }
    ret true
}

fn blend_pose_checks(rig: Skeleton, mesh: SkeletalMesh, clip: AnimationClip) -> bool {
    let rest = AnimationClip {
        1_u32, "rest", rig.identity, "Rest", 4_f32, Vec[AnimationTrack]::new(), Vec[AnimationNotify]::new()
    }
    let clips = vec![clip, rest]
    let source = BlendSpace {
        1_u32, rig.identity, 1_u32, BlendAxis { "Speed", 0_f32, 10_f32 }, BlendAxis {
            "Unused", 0_f32, 1_f32
        }
        , vec![BlendSample {
                0_f32, 0_f32, 0_u32, 1_f32
            }
            , BlendSample {
                10_f32, 0_f32, 1_u32, 1_f32
            }
        ]
    }
    let cooked = match cook_blend_space(source, 2_usize) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    let graph = AnimationGraph {
        1_u32, rig.identity, vec![AnimationParameter { "Speed", 5_f32, 0_f32, 10_f32 }], Vec[BoneMask]::new(), vec![AnimationNode {
                1_u64, PoseOperation::BlendSpace(BlendSpaceNode {
                        cooked, 0_u32, Option[u32]::None
                    }
                    ,
                ), Vec[u64]::new(), 0_u32, 0_f32, Option[u32]::None, 0_u32
            }
        ], 1_u64
    }
    let program = match compile_animation_graph(graph, rig, clips, mesh.morphs.len()) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    let mut graph_workspace = match AnimationWorkspace::new(program, rig, mesh) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    let graph_pose = match graph_workspace.evaluate_nodes(program, rig, mesh, vec![NodeSampleTime {
                0_f32, 0.5_f32
            }
        ], vec![5_f32],) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if !near(graph_pose.translations.get_unchecked_borrowed(0_usize).x, 1_f32) {
        ret false
    }
    let mut workspace = match BlendSpaceWorkspace::new(cooked, rig, mesh, clips) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    let pose = match workspace.evaluate(cooked, rig, mesh, clips, 5_f32, 0_f32, 0.5_f32) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if !near(pose.translations.get_unchecked_borrowed(0_usize).x, 1_f32) {
        ret false
    }
    let mut cursor = BlendSpaceCursor::new()
    let weights = match cursor.weights(cooked, 5_f32, 0_f32) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    let mut clock = BlendSpaceClock::new()
    let step = match clock.advance(cooked, clips, weights, 0.75_f64) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if !near(step.phase, 0.25_f32) {
        ret false
    }
    let other = match cursor.weights(cooked, 10_f32, 0_f32) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    let stable = match clock.advance(cooked, clips, other, 0_f64) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if !near(stable.phase, 0.25_f32) {
        ret false
    }
    let next = match clock.advance(cooked, clips, other, 1_f64) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if !near(next.phase, 0.5_f32) {
        ret false
    }
    if clock.playback( - 1_f32, true).is_err() {
        ret false
    }
    let reversed = match clock.advance(cooked, clips, other, 3_f64) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if !near(reversed.phase, 0.75_f32) {
        ret false
    }
    let full = match workspace.evaluate(cooked, rig, mesh, clips, 0_f32, 0_f32, 1_f32) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if !near(full.translations.get_unchecked_borrowed(0_usize).x, 4_f32) {
        ret false
    }
    ret true
}

fn controller_checks() -> u32 {
    let rig = skeleton()
    let vertex = SkinVertex {
        PoseVector::zero(), PoseVector { 0_f32, 0_f32, 1_f32 }, AnimationValue {
            1_f32, 0_f32, 0_f32, 1_f32
        }
        , AnimationValue::zero(), vec![SkinInfluence {
                0_u32, 1_f32
            }
        ]
    }
    let mesh = SkeletalMesh {
        1_u32, "controller-mesh", rig.identity, "Mesh", vec![vertex], vec![0_u32, 0_u32, 0_u32], vec![PoseMatrix::identity(), PoseMatrix::identity()], vec![SkinSection {
                "Default", 0_u32, 3_u32, "Material"
            }
        ], Vec[MorphTarget]::new()
    }
    let clip = AnimationClip {
        1_u32, "controller-move", rig.identity, "Move", 2_f32, vec![AnimationTrack {
                0_u32, TrackPath::Translation, KeyInterpolation::Linear, vec![key(0_f32, value(0_f32, 0_f32, 0_f32, 0_f32)), key(2_f32, value(4_f32, 0_f32, 0_f32, 0_f32))]
            }
        ], vec![AnimationNotify {
                1_f32, "middle", ""
            }
        ]
    }
    let graph = AnimationGraph {
        1_u32, rig.identity, Vec[AnimationParameter]::new(), Vec[BoneMask]::new(), vec![AnimationNode {
                1_u64, PoseOperation::Clip, Vec[u64]::new(), 0_u32, 0_f32, Option[u32]::None, 0_u32
            }
        ], 1_u64
    }
    let program = match compile_animation_graph(graph, rig, vec![clip], 0_usize) {
        Ok(v) => v Err(_) => {
            ret 1_u32
        }
    }
    let mut controller = match AnimationController::new(program, rig, mesh) {
        Ok(v) => v Err(_) => {
            ret 2_u32
        }
    }
    if controller.root_motion(Option[u32]::Some(0_u32)).is_err() {
        ret 3_u32
    }
    if controller.prepare(1_u64, 0.5_f64, true, 16_usize).is_err() {
        ret 4_u32
    }
    let pose = match controller.pending_pose() {
        Ok(v) => v Err(_) => {
            ret 5_u32
        }
    }
    if !near(pose.translations.get_unchecked_borrowed(0_usize).x, 1_f32) || !near(controller.pose().translations.get_unchecked_borrowed(0_usize).x, 0_f32) || !near(controller.pending_root().unwrap_or(RootMotionDelta::identity()).translation.x, 1_f32) {
        ret 6_u32
    }
    controller.discard()
    if controller.frame().time != 0_f64 || controller.prepare(1_u64, 0.5_f64, true, 16_usize).is_err() || controller.commit().is_err() {
        ret 7_u32
    }
    if controller.frame().time != 0.5_f64 || !near(controller.pose().translations.get_unchecked_borrowed(0_usize).x, 1_f32) {
        ret 8_u32
    }
    if controller.prepare(2_u64, 0.5_f64, true, 0_usize).is_ok() {
        ret 9_u32
    }
    if controller.frame().time != 0.5_f64 || !near(controller.pose().translations.get_unchecked_borrowed(0_usize).x, 1_f32) {
        ret 10_u32
    }
    if controller.prepare(2_u64, 0.5_f64, true, 16_usize).is_err() || controller.commit().is_err() {
        ret 11_u32
    }
    if controller.events().len() != 1_usize || controller.events().get_unchecked_borrowed(0_usize).node != 1_u64 || controller.events().get_unchecked_borrowed(0_usize).event.name != "middle" {
        ret 12_u32
    }
    match controller.prepare(2_u64, 1_f64, true, 16_usize) {
        Ok(fresh) => {
            if fresh {
                ret 13_u32
            }
        }
        Err(_) => {
            ret 14_u32
        }
    }
    if controller.frame().time != 1_f64 {
        ret 15_u32
    }
    if controller.playback(0_f32, false).is_err() || controller.prepare(3_u64, 2_f64, true, 16_usize).is_err() {
        ret 16_u32
    }
    let step = match controller.commit() {
        Ok(v) => v Err(_) => {
            ret 17_u32
        }
    }
    if step.sampled || step.time != 1_f64 || controller.events().len() != 0_usize {
        ret 18_u32
    }
    if controller.configure_clock(1_u64, 1_f32, 0.25_f64, true, true).is_err() || controller.prepare(4_u64, 0_f64, true, 16_usize).is_err() || controller.commit().is_err() {
        ret 19_u32
    }
    if !near(controller.pose().translations.get_unchecked_borrowed(0_usize).x, 2.5_f32) {
        ret 20_u32
    }
    if controller.seek(0_f64).is_err() || controller.events().len() != 0_usize || controller.prepare(5_u64, 0_f64, true, 16_usize).is_err() || controller.commit().is_err() {
        ret 21_u32
    }
    if !near(controller.pose().translations.get_unchecked_borrowed(0_usize).x, 0.5_f32) {
        ret 22_u32
    }
    if controller.seek(1000000000000_f64).is_ok() || controller.frame().time != 0_f64 {
        ret 23_u32
    }
    if !controller.pending_root().is_err() || !controller.pending_events().is_err() {
        ret 24_u32
    }
    if !controller_blend_space(rig, mesh, clip) {
        ret 25_u32
    }
    let many = AnimationClip {
        1_u32, "many", rig.identity, "Many", 2_f32, clip.tracks, vec![AnimationNotify {
                0.25_f32, "e0", ""
            }
            , AnimationNotify {
                0.5_f32, "e1", ""
            }
            , AnimationNotify {
                0.75_f32, "e2", ""
            }
        ]
    }
    let many_program = match compile_animation_graph(graph, rig, vec![many], 0_usize) {
        Ok(v) => v Err(_) => {
            ret 26_u32
        }
    }
    let mut many_controller = match AnimationController::new(many_program, rig, mesh) {
        Ok(v) => v Err(_) => {
            ret 27_u32
        }
    }
    if many_controller.prepare(1_u64, 0.8_f64, true, 2_usize).is_ok() || many_controller.frame().time != 0_f64 {
        ret 28_u32
    }
    if many_controller.prepare(1_u64, 0.8_f64, true, 3_usize).is_err() || many_controller.commit().is_err() {
        ret 29_u32
    }
    let emitted = many_controller.events() if emitted.len() != 3_usize {
        ret 30_u32
    }
    for i in 0_usize..3_usize {
        let e = emitted.get_unchecked_borrowed(i) if e.node != 1_u64 || e.event.name != "e" + i.fmt() {
            ret 31_u32
        }
    }

    ret 0_u32
}

fn controller_blend_space(rig: Skeleton, mesh: SkeletalMesh, clip: AnimationClip) -> bool {
    let rest = AnimationClip {
        1_u32, "controller-rest", rig.identity, "Rest", 4_f32, Vec[AnimationTrack]::new(), Vec[AnimationNotify]::new()
    }
    let source = BlendSpace {
        1_u32, rig.identity, 1_u32, BlendAxis { "Speed", 0_f32, 10_f32 }, BlendAxis {
            "Unused", 0_f32, 1_f32
        }
        , vec![BlendSample {
                0_f32, 0_f32, 0_u32, 1_f32
            }
            , BlendSample {
                10_f32, 0_f32, 1_u32, 1_f32
            }
        ]
    }
    let cooked = match cook_blend_space(source, 2_usize) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    let graph = AnimationGraph {
        1_u32, rig.identity, vec![AnimationParameter { "Speed", 5_f32, 0_f32, 10_f32 }], Vec[BoneMask]::new(), vec![AnimationNode {
                1_u64, PoseOperation::BlendSpace(BlendSpaceNode {
                        cooked, 0_u32, Option[u32]::None
                    }
                    ,
                ), Vec[u64]::new(), 0_u32, 0_f32, Option[u32]::None, 0_u32
            }
        ], 1_u64
    }
    let program = match compile_animation_graph(graph, rig, vec![clip, rest], 0_usize) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    let mut controller = match AnimationController::new(program, rig, mesh) {
        Ok(v) => v Err(_) => {
            ret false
        }
    }
    if controller.root_motion(Option[u32]::Some(0_u32)).is_err() || controller.prepare(1_u64, 0.75_f64, true, 16_usize).is_err() {
        ret false
    }
    if !near(controller.pending_pose().unwrap_or(controller.pose()).translations.get_unchecked_borrowed(0_usize).x, 0.5_f32) || !near(controller.pending_root().unwrap_or(RootMotionDelta::identity()).translation.x, 0.5_f32) {
        ret false
    }
    if controller.commit().is_err() || controller.parameter("Speed", 10_f32).is_err() || controller.prepare(2_u64, 0_f64, true, 16_usize).is_err() {
        ret false
    }
    if !near(controller.pending_root().unwrap_or(RootMotionDelta::identity()).translation.x, 0_f32) || !near(controller.pending_pose().unwrap_or(controller.pose()).translations.get_unchecked_borrowed(0_usize).x, 0_f32) {
        ret false
    }
    if controller.commit().is_err() || controller.seek(1_f64).is_err() || controller.prepare(3_u64, 0_f64, true, 16_usize).is_err() || controller.commit().is_err() {
        ret false
    }
    ret controller.events().len() == 0_usize
}

fn world_graph_checks() -> u32 {
    let mut rig = skeleton()
    let vertex = SkinVertex {
        PoseVector::zero(), PoseVector { 0_f32, 0_f32, 1_f32 }, value(1_f32, 0_f32, 0_f32, 1_f32), AnimationValue::zero(), vec![SkinInfluence {
                0_u32, 1_f32
            }
        ]
    }
    let mesh = SkeletalMesh {
        1_u32, "world-graph", rig.identity, "Mesh", vec![vertex], vec![0_u32, 0_u32, 0_u32], vec![PoseMatrix::identity(), PoseMatrix::identity()], vec![SkinSection {
                "Default", 0_u32, 3_u32, "Material"
            }
        ], Vec[MorphTarget]::new()
