import graphene::animation::state_machine::{AnimationStateMachine, AnimationState, AnimationTransition, TransitionComparison, StateMachinePlayer}
fn near(a: f32, b: f32) -> bool {
    ret animation_abs(a - b) < 0.0001_f32
}
fn value(x: f32, y: f32, z: f32, w: f32) -> AnimationValue {
    ret AnimationValue { x, y, z, w }
}
fn key(time: f32, v: AnimationValue) -> AnimationKey {
    ret AnimationKey {
        time, v, AnimationValue::zero(), AnimationValue::zero()
    }
}
fn skeleton() -> Skeleton {
    let mut child = LocalTransform::identity() child.translation = PoseVector {
        0_f32, 1_f32, 0_f32
    }
    ret Skeleton {
        1_u32, "rig-test", "Rig", vec![SkeletonBone { "root", - 1_i32, LocalTransform::identity() }, SkeletonBone {
                "child", 0_i32, child
            }
        ], Vec[SkeletonSocket]::new()
    }
}
fn main() -> u32 {
