import std::time::sleep_ms
import core::vec::Vec
import core::vec::Vec3
import graphene::{camera_step, camera_wheel_dolly, frame_statistics, navigation_delta_seconds,
    performance_counter_ns}

fn performance_statistics_contract() -> u32 {
    let mut samples = Vec[u64]::new()
    samples.push(1000000_u64)
    samples.push(2000000_u64)
    samples.push(3000000_u64)
    samples.push(4000000_u64)
    let result = frame_statistics(samples, 10000000_u64)
    if result.frames() != 4_u64 || result.average_fps() != 400.0_f64 ||
        result.mean_frame_ns() != 2500000_u64 ||
        result.p50_frame_ns() != 2000000_u64 ||
        result.p95_frame_ns() != 3000000_u64 ||
        result.p99_frame_ns() != 3000000_u64 ||
        result.one_percent_low_fps() != 250.0_f64 {
        ret 1_u32
    }
    ret 0_u32
}

fn performance_counter_contract() -> u32 {
    let before = performance_counter_ns()
    sleep_ms(2_u64)
    let after = performance_counter_ns()
    ret if before > 0_u64 && after > before { 0_u32 } else { 1_u32 }
}

fn direct_camera_step_contract() -> u32 {
    let zero = camera_step(Vec3::zero(), 100.0_f32, 1000000000_u64)
    if zero.x() != 0.0_f32 || zero.y() != 0.0_f32 || zero.z() != 0.0_f32 { ret 10_u32 }
    if navigation_delta_seconds(1000000000_u64) > 0.016667_f32 { ret 11_u32 }
    let step = camera_step(Vec3::new(1.0_f32, 0.0_f32, 0.0_f32), 60.0_f32, 16666666_u64)
    if step.x() < 0.999_f32 || step.x() > 1.001_f32 || step.y() != 0.0_f32 || step.z() != 0.0_f32 {
        ret 12_u32
    }
    let dolly_forward = camera_wheel_dolly(Vec3::new(0.0_f32, 0.0_f32, -1.0_f32),
        1.0_f32, 10.0_f32, 1.0_f32,)
    let dolly_back = camera_wheel_dolly(Vec3::new(0.0_f32, 0.0_f32, -1.0_f32),
        - 1.0_f32, 10.0_f32, 1.0_f32,)
    if dolly_forward.z() > - 1.199_f32 || dolly_forward.z() < - 1.201_f32 ||
    dolly_back.z() < 1.199_f32 || dolly_back.z() > 1.201_f32 {
        ret 13_u32
    }
    ret 0_u32
}

fn main() -> u32 {
    let statistics = performance_statistics_contract()
    if statistics != 0_u32 { ret statistics }
    let direct_step = direct_camera_step_contract()
    if direct_step != 0_u32 { ret direct_step }
    ret performance_counter_contract()
}
