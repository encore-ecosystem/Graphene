import core::vec::Vec

struct NestedResource {
    values: Vec[u32]
}

#attr(borrowed_return)
fn borrowed_resource(handle: usize) -> NestedResource {
    unsafe {
        unsafe ehir {
            pointer: NestedResource* = pcast handle: usize, NestedResource*
            value: NestedResource = load pointer: NestedResource*
        }
        ret value
    }
}

fn main() -> u32 {
    let mut values = Vec[u32]::new()
    values.push(91_u32)
    let mut resources = Vec[NestedResource]::new()
    resources.push(NestedResource{values})
    let mut iteration = 0_usize
    while iteration < 100000_usize {
        let handle = resources.get_handle(0_usize)
        let resource = borrowed_resource(handle)
        if handle == 0_usize || resource.values.len() != 1_usize {
            ret 1_u32
        }
        iteration += 1_usize
    }
    ret if resources.len() == 1_usize {
        0_u32
    } else {
        2_u32
    }
}
