//! CPU frame caches and camera backlog regressions in one focused runner.
import graphene::editor_input::CameraInputBatch
import core::vec::Vec

import graphene::{FlightInput, Transform}
import graphene::environment::model::WeatherSample
import graphene::environment::system::{EnvironmentSystem, WeatherVolume}
import graphene::gi_surface_cache::{GiSurfaceCache, GiSurfaceInput}
import graphene::virtual_instance_index::VirtualInstanceIndex
import linalg::Vec3
import luma::{Event, UiInputQueue, event_pointer_up}

//! Releasing flight within a backlog stops at the next frame, preserving UI barriers.

fn camera_case() -> u32 {
    let mut queue = UiInputQueue::new()
    let release = Event { event_pointer_up(), 30, 40, 0, 0, 0, 3, 0, 0, 0, "", 0 }
    for _ in 0_usize..50_usize {
        queue.append(vec![Event::key_down(119, 0), Event::pointer_move(30, 40, 2, - 1, 4)])
    }
    queue.append(vec![Event::key_up(119, 0), release, Event::text_input("untouched")])
    let mut batch = CameraInputBatch::new(FlightInput::new())
    let next = batch.drain(Event::key_down(119, 0), queue)
    if next.kind() != event_pointer_up() || batch.flight.active() || batch.dx != 100 || batch.dy != - 50 || batch.consumed != 102 {
        ret 1
    }
    if queue.pending_count() != 1 || queue.peek().unwrap_or(Event::none()).text() != "untouched" {
        ret 2
    }
    let mut barrier = CameraInputBatch::new(FlightInput::new())
    if barrier.drain(Event::key_down(122, 0), queue).key() != 122 || barrier.consumed != 0 || queue.pending_count() != 1 {
        ret 3
    }
    ret 0
}

//! GI cards retain identity until geometry, material values or source order changes.

fn input(x: f32, red: f32, mesh: u64) -> GiSurfaceInput {
    ret GiSurfaceInput {
        1, mesh, 3, Transform::identity().with_position(Vec3::new(x, 0, 0)).matrix(), Vec3::new( - 1, - 1, - 1), Vec3::new(1, 1, 1), Vec3::new(red, 0.2_f32, 0.3_f32)
    }
}
fn gi_case() -> u32 {
    let mut cache = GiSurfaceCache::new()
    if !cache.update(vec![input(0, 1, 2)]) || cache.samples.len() != 24 || cache.boxes.len() != 1 {
        ret 1
    }
    if cache.update(vec![input(0, 1, 2)]) || cache.rebuilds != 1 {
        ret 2
    }
    if !cache.update(vec![input(2, 1, 2)]) || cache.boxes.get_unchecked_borrowed(0).center.x() != 2 {
        ret 3
    }
    if !cache.update(vec![input(2, 0.5_f32, 2)]) || cache.samples.get_unchecked_borrowed(0).albedo.x() != 0.5_f32 {
        ret 4
    }
    if !cache.update(vec![input(2, 0.5_f32, 7)]) || cache.rebuilds != 4 {
        ret 5
    }
    if !cache.update(Vec[GiSurfaceInput]::new()) || cache.samples.len() != 0 || cache.boxes.len() != 0 {
        ret 6
    }
    let mut many = Vec[GiSurfaceInput]::new()
    for i in 0_usize..20_usize {
        many.push(input(i as f32, 1, 2))
    }
    cache.update(many)
    if cache.samples.len() != 312 || cache.boxes.len() != 13 {
        ret 7
    }
    ret 0
}

//! In-place owned lighting packets match the original complete shader payload.

fn environment_case() -> u32 {
    let mut environment = EnvironmentSystem::new()
    let mut frame = environment.frame(Vec3::zero())
    let mut packet = Vec[f32]::new()
    for _ in 0_usize..3140_usize {
        packet.push(0)
    }
    for count in vec![0_usize, 3_usize, 1_usize, 0_usize] {
        let mut volumes = Vec[WeatherVolume]::new()
        for i in 0_usize..count {
            volumes.push(WeatherVolume {
                    i as u64 + 1, 0, Vec3::new(i as f32, 3, 4), vec![Vec3::new(1, 0, 0), Vec3::new(0, 2, 0), Vec3::new(0, 0, 3)], 2, WeatherSample::preset("rain")
                }
            )
        }
        frame.volumes = volumes
        frame.write_shader_values(packet, 1028)
        let reference = frame.shader_values()
        for i in 0_usize..reference.len() {
            if packet.get_unchecked_borrowed(1028 + i) != reference.get_unchecked_borrowed(i) {
                ret 1
            }
        }
    }
    ret 0
}

fn main() -> u32 {
    let mut index = VirtualInstanceIndex::new()
    let keys = vec![(2_u64, 0_u64),(3_u64, 0_u64),(2_u64, 5_u64),(900000001_u64, 7_u64),(900000001_u64, 8_u64),(0_u64, 0_u64)]
    if !index.update(keys) || index.update(keys) || index.rebuilds != 1 {
        ret 41
    }
    let head = index.head(2).unwrap_or(99)
    if head != 2 || index.material(head) != 5 || index.next(head).unwrap_or(99) != 0 || index.next(0).is_some() {
        ret 42
    }
    let large = index.head(900000001).unwrap_or(99)
    if large != 4 || index.next(large).unwrap_or(99) != 3 || index.head(0).is_some() || index.head(99999).is_some() {
        ret 43
    }
    let camera = camera_case()
    if camera != 0 {
        ret 10 + camera
    }
    let gi = gi_case()
    if gi != 0 {
        ret 20 + gi
    }
    let environment = environment_case()
    if environment != 0 {
        ret 30 + environment
    }
    ret 0
}
