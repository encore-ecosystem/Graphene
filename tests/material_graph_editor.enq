import core::option::Option
import graphene::material_graph::*
import graphene::material_graph::editor::{MaterialEditor, material_display_number}
import luma::{Event, Rect, StyleSheet, Widget, layout_widget, event_pointer_down, event_pointer_up, widget_render_surface}
import std::os::{read_file, mkdir_all, write_file_atomic}
import std::time::perf_counter_ms

fn pointer(kind: u32, x: f32, y: f32, buttons: u32) -> Event {
    ret Event { kind, x, y, 0, 0, buttons, 0, 0, 0, 0, "", 0 }
}
fn main() -> u32 {
    let sheet = StyleSheet::default().merge(StyleSheet::parse(read_file("graphene.css")))
    let mut editor = MaterialEditor::new()
    let project = f "target/material-editor-test-{perf_counter_ms()}"
    editor.open(project, sheet)
    // Restoring the Material tab precedes the asynchronous shader build.
    // A surface with no producer image makes the initial frame unpresentable.
    if editor.widget().find("material-preview-surface").unwrap_or(Widget::label("")).kind() == widget_render_surface() {
        ret 32
    }
    let layout = layout_widget(sheet.apply(editor.widget(), "", "", ""), Rect::new(0, 0, 1200, 800))
    let bounds = match layout.find_bounds("material-canvas") {
        Some(b) => b None => {
            ret 1
        }
    }
    let preview = layout.find_bounds("material-preview-surface").unwrap_or(Rect::new(0, 0, 0, 0))
    if bounds.width() < 600 || bounds.height() < 400 || preview.height() < 150 {
        ret 2
    }
    let _down = editor.input(pointer(event_pointer_down(), bounds.x() + 100, bounds.y() + 90, 1), "material-canvas", bounds, preview, sheet)
    let _move = editor.input(Event::pointer_move(bounds.x() + 140, bounds.y() + 120, 40, 30, 1), "material-canvas", bounds, preview, sheet)
    let _up = editor.input(pointer(event_pointer_up(), bounds.x() + 140, bounds.y() + 120, 0), "material-canvas", bounds, preview, sheet)
    if editor.graph().node(1).unwrap_or(MaterialNode::new(0, "", 0, 0)).x != 80 {
        ret 3
    }
    let _undo = editor.input(Event::key_down(122, 192), "", bounds, preview, sheet)
    if editor.graph().node(1).unwrap_or(MaterialNode::new(0, "", 0, 0)).x != 40 {
        ret 4
    }
    let _field = editor.input(pointer(event_pointer_down(), 0, 0, 1), "mg-value-0", bounds, preview, sheet)
    let _all = editor.input(Event::key_down(97, 192), "", bounds, preview, sheet)
    let _text = editor.input(Event::text_input("0.8"), "", bounds, preview, sheet)
    let _commit = editor.input(Event::key_down(13, 0), "", bounds, preview, sheet)
    if editor.graph().node(1).unwrap_or(MaterialNode::new(0, "", 0, 0)).value.x() < 0.799 {
        ret 5
    }
    if editor.widget().find("mg-save").unwrap_or(Widget::label("")).disabled() {
        ret 30
    }
    if editor.widget().find("mg-undo").unwrap_or(Widget::label("")).disabled() {
        ret 31
    }
    let _field_again = editor.input(pointer(event_pointer_down(), 0, 0, 1), "mg-value-0", bounds, preview, sheet)
    let _all_again = editor.input(Event::key_down(97, 192), "", bounds, preview, sheet)
    let _bad_text = editor.input(Event::text_input("invalid"), "", bounds, preview, sheet)
    let _reject = editor.input(Event::key_down(13, 0), "", bounds, preview, sheet)
    if editor.message() == "" || editor.graph().node(1).unwrap_or(MaterialNode::new(0, "", 0, 0)).value.x() < 0.799 {
        ret 6
    }
    let _escape = editor.input(Event::key_down(27, 0), "", bounds, preview, sheet)
    let count = editor.graph().nodes.len()
    let _add = editor.input(pointer(event_pointer_down(), 0, 0, 1), "mg-add-multiply", bounds, preview, sheet)
    if editor.graph().nodes.len() != count + 1 {
        ret 7
    }
    let _undo_add = editor.input(Event::key_down(122, 192), "", bounds, preview, sheet)
    if editor.graph().nodes.len() != count {
        ret 8
    }
    let _search = editor.input(pointer(event_pointer_down(), 0, 0, 1), "mg-search", bounds, preview, sheet)
    let _query = editor.input(Event::text_input("MuLti"), "", bounds, preview, sheet)
    let widget = editor.widget()
    if widget.find("mg-add-multiply").is_none() || widget.find("mg-add-color").is_some() {
        ret 9
    }
    let _tab = editor.input(Event::key_down(9, 0), "", bounds, preview, sheet)
    if !editor.widget().find("mg-add-multiply").unwrap_or(Widget::label("")).focused() {
        ret 10
    }
    let _activate = editor.input(Event::key_down(13, 0), "", bounds, preview, sheet)
    if editor.graph().nodes.len() != count + 1 {
        ret 11
    }
    if material_display_number(0.12) != "0.12" || material_display_number( - 0.1236) != "-0.124" {
        ret 12
    }
    let _shortcut = editor.input(Event::key_down(32, 0), "", bounds, preview, sheet)
    let _opening_space = editor.input(Event::text_input(" "), "", bounds, preview, sheet)
    let _shortcut_query = editor.input(Event::text_input("Add"), "", bounds, preview, sheet)
    if editor.widget().find("mg-add-add").is_none() {
        ret 17
    }
    let _escape_search = editor.input(Event::key_down(27, 0), "", bounds, preview, sheet)
    if !editor.save(sheet) {
        ret 13
    }
    let invalid = project + "/invalid/Content/Materials"
    if mkdir_all(invalid) != 0 || write_file_atomic(invalid + "/M_Graph.graphene-material-graph.json", "invalid") != 0 {
        ret 14
    }
    let before = editor.graph().nodes.len()
    editor.open(project + "/invalid", sheet)
    if editor.message() == "" || editor.graph().nodes.len() != before {
        ret 15
    }
    if !editor.save(sheet) || read_file(invalid + "/M_Graph.graphene-material-graph.json") != "invalid" {
        ret 16
    }
    ret 0
}
