import core::vec::Vec
import graphene::{LodBudget, build_virtual_geometry_lods, sphere_mesh}
import linalg::Vec3

fn main() -> u32 {
    let mesh = sphere_mesh(1.0_f32, 20_u32, 32_u32).parts()
    let mut positions = Vec[Vec3]::new()
    let mut index = 0_usize
    while index < mesh.0.len() {
        positions.push(Vec3::new(mesh.0.get_unchecked_borrowed(index), mesh.0.get_unchecked_borrowed(index + 1), mesh.0.get_unchecked_borrowed(index + 2)))
        index += 9_usize
    }
    let geometry = build_virtual_geometry_lods(positions, mesh.1, 64_usize, 126_usize)
    if !geometry.valid() {
        ret 1
    }
    let budget = LodBudget::build(geometry)
    if budget.source_triangles != mesh.1.len() / 3_usize || budget.minimum_triangles == 0 || budget.selected_triangles(geometry, 1) != budget.source_triangles {
        ret 2
    }
    let mut previous = 0_usize
    for step in 0_usize..1001_usize {
        let ratio =(step as f32) / 1000.0_f32
        let selected = budget.selected_triangles(geometry, ratio)
        if selected < previous || selected < budget.minimum_triangles || selected > budget.source_triangles ||(selected > budget.minimum_triangles &&(selected as f32) > ratio *(budget.source_triangles as f32) + 0.01_f32) {
            ret 3
        }
        previous = selected
    }
    // Parent refinements cannot require a larger budget than descendants.
    for i in 0_usize..geometry.hierarchy().len() {
        let node = geometry.hierarchy().get_unchecked_borrowed(i)
        if !node.leaf() {
            let threshold = budget.refinement_ratios.get_unchecked_borrowed(i)
            if threshold > budget.refinement_ratios.get_unchecked_borrowed(node.left_child() as usize) {
                ret 4
            }
            if node.right_child() != 4294967295_u32 && threshold > budget.refinement_ratios.get_unchecked_borrowed(node.right_child() as usize) {
                ret 5
            }
        }
    }
    ret 0
}
